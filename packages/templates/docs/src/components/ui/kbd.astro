---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'kbd'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<kbd
  class={cn(
    'inline-flex items-center justify-center min-w-[22px] h-[22px] px-1.5 rounded-sm bg-surface-2 text-fg border border-border border-b-2 font-mono text-[11px] leading-none whitespace-nowrap',
    className
  )}
  {...rest}
>
  <slot />
</kbd>
