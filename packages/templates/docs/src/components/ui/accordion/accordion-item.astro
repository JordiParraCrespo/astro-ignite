---
import { cn } from '@/lib/cn';

export type Props = {
  title: string;
  open?: boolean;
  class?: string;
};

const { title, open = false, class: className } = Astro.props;
---

<details class={cn('group border-b border-border', className)} open={open}>
  <summary
    class="flex items-center justify-between gap-4 py-4 cursor-pointer font-medium text-fg select-none list-none [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring focus-visible:rounded-[2px]"
  >
    <span>{title}</span>
    <svg
      class="text-fg-muted shrink-0 transition-transform duration-200 group-open:rotate-180"
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M3.5 5.25L7 8.75L10.5 5.25"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </summary>
  <div class="pb-4 text-fg-muted text-sm leading-relaxed"><slot /></div>
</details>
