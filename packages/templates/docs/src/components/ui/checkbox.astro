---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'input'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<span class="relative inline-grid size-4 shrink-0 place-items-center align-middle">
  <input
    type="checkbox"
    class={cn(
      'peer col-start-1 row-start-1 m-0 size-4 cursor-pointer appearance-none rounded-[4px] border border-border bg-transparent transition-[background-color,border-color,box-shadow] duration-150 checked:border-primary checked:bg-primary indeterminate:border-primary indeterminate:bg-primary focus-visible:border-ring focus-visible:[box-shadow:0_0_0_1px_var(--color-ring)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-danger',
      className
    )}
    {...rest}
  />
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    class="pointer-events-none col-start-1 row-start-1 h-3 w-3 text-primary-fg opacity-0 transition-opacity duration-150 peer-checked:opacity-100"
  >
    <path
      d="M3.5 8.5l3 3 6-7"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</span>
