---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'div'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<div
  class={cn(
    'flex flex-col gap-5 overflow-hidden rounded-lg border border-border bg-surface py-5 text-fg',
    className
  )}
  {...rest}
>
  <slot />
</div>
