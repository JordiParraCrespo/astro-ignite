---
/**
 * Search box — command palette.
 *
 * Trigger button renders inline. Press it (or ⌘K / Ctrl+K anywhere) to open
 * a <dialog> that lazy-loads `/pagefind/pagefind.js` on first open. The
 * bundle is generated by `postbuild: pagefind --site dist`, so search only
 * works against a built site (`pnpm build && pnpm preview`). Under `astro
 * dev` the dialog shows a hint pointing to the production build.
 *
 * Mirrors Starlight's behaviour: each page result expands into nested
 * sub-results (one per matching heading), with anchors that scroll directly
 * to the section.
 */
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const kbdBase =
  'inline-block rounded-[var(--radius-sm)] border border-b-2 border-[var(--color-border)] bg-[var(--color-surface-2)] px-1.5 py-0.5 font-mono text-[10px] leading-none text-[var(--color-fg-muted)]';
---

<button
  type="button"
  class="flex w-full cursor-pointer appearance-none items-center gap-1.5 rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] px-2.5 py-[7px] text-left font-[inherit] text-[12px] leading-none text-[var(--color-fg-subtle)] transition-colors duration-100 hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg-muted)]"
  data-search-open
  aria-label={t('search.label')}
>
  <span class="mono text-[11px]" aria-hidden="true">⌕</span>
  <span class="mono text-[12px]">{t('search.label')}</span>
  <span class="mono ml-auto inline-flex gap-0.5"
    ><kbd class={kbdBase}>⌘</kbd><kbd class={kbdBase}>K</kbd></span
  >
</button>

<dialog
  class="search-dialog fixed left-1/2 top-[12vh] m-0 -translate-x-1/2 overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-0 font-[inherit] text-[14px] leading-[1.4] text-[var(--color-fg)] w-[min(640px,calc(100vw-32px))] max-h-[min(560px,calc(100vh-64px))]"
  id="search-dialog"
  aria-label={t('search.label')}
  data-i18n-empty={t('search.empty')}
  data-i18n-no-results={t('search.noResults')}
  data-i18n-unavailable={t('search.unavailable')}
  data-i18n-unavailable-hint={t('search.unavailableHint')}
  data-i18n-docs-root={t('search.docsRoot')}
>
  <form method="dialog" class="flex max-h-[inherit] flex-col" autocomplete="off">
    <div class="flex items-center gap-2.5 border-b border-[var(--color-border)] px-4 py-3.5">
      <span class="mono text-sm text-[var(--color-fg-muted)]" aria-hidden="true">⌕</span>
      <input
        type="search"
        name="q"
        class="m-0 flex-1 border-0 bg-transparent p-0 font-[inherit] text-[15px] text-[var(--color-fg)] outline-none placeholder:text-[var(--color-fg-subtle)]"
        placeholder={t('search.placeholder')}
        aria-label={t('search.query')}
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class={kbdBase}>{t('search.esc')}</kbd>
    </div>
    <div
      class="search-dialog__results min-h-[120px] flex-1 overflow-y-auto p-1.5"
      data-search-results
      aria-live="polite"
    >
    </div>
    <div
      class="mono flex items-center gap-3.5 border-t border-[var(--color-border)] px-4 py-2.5 text-[11px] text-[var(--color-fg-subtle)]"
    >
      <span class="inline-flex items-center gap-1">
        <kbd class={kbdBase}>↑</kbd><kbd class={kbdBase}>↓</kbd>{' '}{t('search.navigate')}
      </span>
      <span class="inline-flex items-center gap-1">
        <kbd class={kbdBase}>↵</kbd>{' '}{t('search.open')}
      </span>
      <span class="inline-flex items-center gap-1">
        <kbd class={kbdBase}>Esc</kbd>{' '}{t('search.close')}
      </span>
    </div>
  </form>
</dialog>

<script>
  type PagefindSubResult = {
    title: string;
    url: string;
    excerpt: string;
  };
  type PagefindResultData = {
    url: string;
    excerpt: string;
    meta: { title: string };
    sub_results?: PagefindSubResult[];
  };
  type PagefindResult = {
    id: string;
    data: () => Promise<PagefindResultData>;
  };
  type Pagefind = {
    search: (q: string) => Promise<{ results: PagefindResult[] }>;
    options?: (opts: Record<string, unknown>) => Promise<void>;
  };

  type FlatItem = {
    url: string;
    title: string;
    excerpt: string;
    kind: 'page' | 'sub';
  };
  type Group = {
    page: FlatItem;
    breadcrumb: string;
    subs: FlatItem[];
  };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const trigger = document.querySelector<HTMLButtonElement>('[data-search-open]');
  const input = dialog?.querySelector<HTMLInputElement>('input[type="search"]');
  const resultsEl = dialog?.querySelector<HTMLDivElement>('[data-search-results]');

  if (dialog && trigger && input && resultsEl) {
    let pagefind: Pagefind | null = null;
    let pagefindError = false;
    let activeIndex = 0;
    let groups: Group[] = [];
    let flatItems: FlatItem[] = [];

    const open = () => {
      dialog.showModal();
      requestAnimationFrame(() => input.focus());
      void load();
    };

    const close = () => {
      dialog.close();
      input.value = '';
      groups = [];
      flatItems = [];
      activeIndex = 0;
      render('');
    };

    const load = async () => {
      if (pagefind || pagefindError) return;
      try {
        const url = ['', 'pagefind', 'pagefind.js'].join('/');
        pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
        await pagefind.options?.({ excerptLength: 15 });
      } catch {
        pagefindError = true;
        render('');
      }
    };

    const escapeHtml = (s: string) =>
      s.replace(
        /[&<>"']/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c
      );

    const i18n = {
      empty: dialog.dataset.i18nEmpty ?? 'Start typing to search the docs.',
      noResults: dialog.dataset.i18nNoResults ?? 'No results for',
      unavailable: dialog.dataset.i18nUnavailable ?? 'Search is only available on a built site.',
      unavailableHint:
        dialog.dataset.i18nUnavailableHint ??
        'Run <code>pnpm build &amp;&amp; pnpm preview</code>.',
      docsRoot: dialog.dataset.i18nDocsRoot ?? 'Docs',
    };

    const breadcrumbFromUrl = (url: string): string => {
      try {
        const path = url.split('#')[0]?.replace(/\/$/, '') ?? '';
        const parts = path.split('/').filter(Boolean);
        if (parts.length === 0) return i18n.docsRoot;
        return parts.map((p) => decodeURIComponent(p).replace(/-/g, ' ')).join(' / ');
      } catch {
        return url;
      }
    };

    const renderUnavailable = () => {
      resultsEl.innerHTML = `
        <div class="search-dialog__empty">
          ${i18n.unavailable}<br />
          ${i18n.unavailableHint}
        </div>`;
    };

    const render = (query: string) => {
      if (pagefindError) {
        renderUnavailable();
        return;
      }
      if (!query) {
        resultsEl.innerHTML = `<div class="search-dialog__empty">${i18n.empty}</div>`;
        return;
      }
      if (groups.length === 0) {
        resultsEl.innerHTML = `<div class="search-dialog__empty">${i18n.noResults} <strong>${escapeHtml(query)}</strong>.</div>`;
        return;
      }
      let cursor = 0;
      const html = groups
        .map((group) => {
          const pageIdx = cursor++;
          const subsHtml = group.subs
            .map((sub) => {
              const idx = cursor++;
              return `
                <a
                  href="${sub.url}"
                  class="sd-sub"
                  data-search-result
                  data-index="${idx}"
                  aria-selected="${idx === activeIndex ? 'true' : 'false'}"
                >
                  <span class="sd-sub__hash mono" aria-hidden="true">#</span>
                  <span class="sd-sub__body">
                    <span class="sd-sub__title">${escapeHtml(sub.title)}</span>
                    ${sub.excerpt ? `<span class="sd-sub__excerpt">${sub.excerpt}</span>` : ''}
                  </span>
                </a>`;
            })
            .join('');
          return `
            <div class="sd-group">
              <div class="sd-group__label mono">${escapeHtml(group.breadcrumb)}</div>
              <a
                href="${group.page.url}"
                class="sd-page"
                data-search-result
                data-index="${pageIdx}"
                aria-selected="${pageIdx === activeIndex ? 'true' : 'false'}"
              >
                <span class="sd-page__title">${escapeHtml(group.page.title)}</span>
              </a>
              ${group.subs.length > 0 ? `<div class="sd-subs">${subsHtml}</div>` : ''}
            </div>`;
        })
        .join('');
      resultsEl.innerHTML = html;
      scrollActiveIntoView();
    };

    const scrollActiveIntoView = () => {
      const el = resultsEl.querySelector<HTMLElement>(`[data-index="${activeIndex}"]`);
      el?.scrollIntoView({ block: 'nearest' });
    };

    let searchToken = 0;
    const runSearch = async (query: string) => {
      const token = ++searchToken;
      if (!pagefind && !pagefindError) {
        await load();
        if (token !== searchToken) return;
      }
      const trimmed = query.trim();
      if (!trimmed || pagefindError) {
        groups = [];
        flatItems = [];
        render(trimmed);
        return;
      }
      const { results } = await pagefind!.search(trimmed);
      if (token !== searchToken) return;
      const top = await Promise.all(results.slice(0, 5).map((r) => r.data()));
      if (token !== searchToken) return;
      groups = top.map((d) => {
        const page: FlatItem = {
          url: d.url,
          title: d.meta.title || d.url,
          excerpt: d.excerpt,
          kind: 'page',
        };
        const subs: FlatItem[] = (d.sub_results ?? [])
          .filter((s) => s.url !== d.url)
          .slice(0, 4)
          .map((s) => ({ url: s.url, title: s.title, excerpt: s.excerpt, kind: 'sub' }));
        return { page, breadcrumb: breadcrumbFromUrl(d.url), subs };
      });
      flatItems = groups.flatMap((g) => [g.page, ...g.subs]);
      activeIndex = 0;
      render(query);
    };

    trigger.addEventListener('click', open);

    document.addEventListener('keydown', (e) => {
      const mod = e.metaKey || e.ctrlKey;
      if (mod && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) close();
        else open();
      }
    });

    input.addEventListener('input', () => {
      void runSearch(input.value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, flatItems.length - 1);
        render(input.value);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        render(input.value);
      } else if (e.key === 'Enter') {
        const sel = flatItems[activeIndex];
        if (sel) {
          e.preventDefault();
          window.location.href = sel.url;
        }
      }
    });

    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog) {
        close();
        return;
      }
      const link = target.closest<HTMLAnchorElement>('[data-search-result]');
      if (link) {
        close();
      }
    });

    dialog.addEventListener('close', () => {
      input.value = '';
      groups = [];
      flatItems = [];
      activeIndex = 0;
    });
  }
</script>

<style>
  /* Why kept: ::backdrop pseudo-element on <dialog> cannot be styled by Tailwind. */
  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(2px);
  }

  /*
   * Why kept: result rows are injected via innerHTML at runtime, so Astro's
   * scoped-CSS data-attribute won't match them and Tailwind's class-scan
   * cannot see classes that exist only as JS string literals. Expressed via
   * @apply so the rules still reuse Tailwind utilities and the token layer.
   */
  .search-dialog :global(.search-dialog__empty) {
    @apply px-4 py-7 text-center text-[13px] leading-[1.6] text-[var(--color-fg-subtle)];
  }
  .search-dialog :global(.search-dialog__empty strong) {
    @apply font-medium text-[var(--color-fg)];
  }
  .search-dialog :global(.search-dialog__empty code) {
    @apply rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface-2)] px-1.5 py-px font-mono text-[12px] text-[var(--color-fg)];
  }
  .search-dialog :global(.sd-group) {
    @apply flex flex-col gap-0.5 py-1.5;
  }
  .search-dialog :global(.sd-group + .sd-group) {
    @apply border-t border-[var(--color-border)];
  }
  .search-dialog :global(.sd-group__label) {
    @apply overflow-hidden text-ellipsis whitespace-nowrap px-2.5 py-0.5 font-mono text-[10px] uppercase leading-[1.4] tracking-[0.12em] text-[var(--color-fg-subtle)];
  }
  .search-dialog :global(.sd-page),
  .search-dialog :global(.sd-sub) {
    @apply flex cursor-pointer items-start gap-2 rounded-[var(--radius-sm)] px-2.5 py-[5px] text-[var(--color-fg-muted)] no-underline transition-colors duration-100 hover:bg-[var(--color-surface-2)] hover:text-[var(--color-fg)];
  }
  .search-dialog :global(.sd-page[aria-selected='true']),
  .search-dialog :global(.sd-sub[aria-selected='true']) {
    @apply bg-[var(--color-surface-2)] text-[var(--color-fg)] shadow-[inset_2px_0_0_var(--color-fg)];
  }
  .search-dialog :global(.sd-page__title) {
    @apply flex-1 overflow-hidden text-ellipsis whitespace-nowrap text-[14px] font-medium leading-[1.4] text-[inherit];
  }
  .search-dialog :global(.sd-subs) {
    @apply ml-3.5 mt-0.5 flex flex-col border-l border-[var(--color-border)] pl-2.5;
  }
  .search-dialog :global(.sd-sub__hash) {
    @apply shrink-0 font-mono text-[12px] leading-[1.45] text-[var(--color-fg-subtle)];
  }
  .search-dialog :global(.sd-sub__body) {
    @apply flex min-w-0 flex-1 flex-col gap-px;
  }
  .search-dialog :global(.sd-sub__title) {
    @apply overflow-hidden text-ellipsis whitespace-nowrap text-[13px] font-normal leading-[1.4] text-[inherit];
  }
  .search-dialog :global(.sd-sub__excerpt) {
    @apply overflow-hidden text-ellipsis whitespace-nowrap text-[12px] leading-[1.4] text-[var(--color-fg-subtle)];
  }
  .search-dialog :global(mark) {
    background: color-mix(in oklch, var(--color-fg) 18%, transparent);
    @apply rounded-[2px] px-0.5 font-medium text-[var(--color-fg)];
  }
</style>
