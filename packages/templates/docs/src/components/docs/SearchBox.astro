---
/**
 * Search box — command palette.
 *
 * Trigger button renders inline. Press it (or ⌘K / Ctrl+K anywhere) to open
 * a <dialog> that lazy-loads `/pagefind/pagefind.js` on first open. When the
 * Pagefind bundle is missing (typical under `astro dev`), the box falls back
 * to a JSON index served at `/search-index.json` and a client-side substring
 * matcher — so search works without `pnpm build`.
 */
---

<button type="button" class="search-box" data-search-open aria-label="Search docs">
  <span class="search-icon mono" aria-hidden="true">⌕</span>
  <span class="search-label mono">Search docs</span>
  <span class="search-kbd mono"><kbd>⌘</kbd><kbd>K</kbd></span>
</button>

<dialog class="search-dialog" id="search-dialog" aria-label="Search docs">
  <form method="dialog" class="search-dialog__form" autocomplete="off">
    <div class="search-dialog__field">
      <span class="search-dialog__icon mono" aria-hidden="true">⌕</span>
      <input
        type="search"
        name="q"
        class="search-dialog__input"
        placeholder="Search docs…"
        aria-label="Search query"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-dialog__esc mono">Esc</kbd>
    </div>
    <div class="search-dialog__results" data-search-results aria-live="polite"></div>
    <div class="search-dialog__footer mono">
      <span>
        <kbd>↑</kbd><kbd>↓</kbd> navigate
      </span>
      <span>
        <kbd>↵</kbd> open
      </span>
      <span>
        <kbd>Esc</kbd> close
      </span>
    </div>
  </form>
</dialog>

<script>
  type PagefindResult = {
    id: string;
    data: () => Promise<{
      url: string;
      excerpt: string;
      meta: { title: string };
    }>;
  };
  type Pagefind = {
    search: (q: string) => Promise<{ results: PagefindResult[] }>;
  };
  type FallbackEntry = {
    url: string;
    title: string;
    description: string;
    body: string;
  };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const trigger = document.querySelector<HTMLButtonElement>('[data-search-open]');
  const input = dialog?.querySelector<HTMLInputElement>('input[type="search"]');
  const resultsEl = dialog?.querySelector<HTMLDivElement>('[data-search-results]');

  if (!dialog || !trigger || !input || !resultsEl) {
    // Component absent on this page — nothing to wire.
  } else {
    let pagefind: Pagefind | null = null;
    let pagefindError = false;
    let fallbackIndex: FallbackEntry[] | null = null;
    let fallbackLoading: Promise<void> | null = null;
    let activeIndex = 0;
    let currentResults: { url: string; title: string; excerpt: string }[] = [];

    const open = () => {
      dialog.showModal();
      requestAnimationFrame(() => input.focus());
      void load();
    };

    const close = () => {
      dialog.close();
      input.value = '';
      currentResults = [];
      activeIndex = 0;
      render('');
    };

    const load = async () => {
      if (pagefind || pagefindError) return;
      try {
        // Build the URL at runtime so Vite/Rollup doesn't try to resolve it
        // — the pagefind bundle is generated by `pnpm build`, not shipped to node_modules.
        const url = ['', 'pagefind', 'pagefind.js'].join('/');
        // @ts-expect-error — pagefind bundle is generated by the build, not a typed module.
        pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
      } catch {
        pagefindError = true;
        await loadFallback();
        render('');
      }
    };

    const loadFallback = async () => {
      if (fallbackIndex) return;
      if (!fallbackLoading) {
        fallbackLoading = (async () => {
          try {
            const res = await fetch('/search-index.json', { credentials: 'same-origin' });
            if (!res.ok) throw new Error(`status ${res.status}`);
            const data = (await res.json()) as { entries: FallbackEntry[] };
            fallbackIndex = data.entries;
          } catch {
            fallbackIndex = [];
          }
        })();
      }
      await fallbackLoading;
    };

    const highlight = (text: string, terms: string[]): string => {
      const safe = escapeHtml(text);
      if (terms.length === 0) return safe;
      const pattern = terms
        .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
        .filter(Boolean)
        .join('|');
      if (!pattern) return safe;
      return safe.replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>');
    };

    const fallbackSearch = (query: string) => {
      const trimmed = query.trim().toLowerCase();
      if (!trimmed || !fallbackIndex) return [];
      const terms = trimmed.split(/\s+/).filter(Boolean);
      const scored = fallbackIndex
        .map((e) => {
          const title = e.title.toLowerCase();
          const desc = e.description.toLowerCase();
          const body = e.body.toLowerCase();
          let score = 0;
          for (const term of terms) {
            if (title.includes(term)) score += 8;
            if (desc.includes(term)) score += 3;
            if (body.includes(term)) score += 1;
          }
          if (title === trimmed) score += 20;
          return { entry: e, score };
        })
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8);
      return scored.map(({ entry }) => {
        const haystack = entry.body || entry.description;
        const idx = haystack.toLowerCase().indexOf(terms[0] ?? '');
        const start = Math.max(0, idx - 40);
        const snippet = haystack.slice(start, start + 160).trim();
        const prefix = start > 0 ? '…' : '';
        const suffix = start + 160 < haystack.length ? '…' : '';
        return {
          url: entry.url,
          title: entry.title,
          excerpt: prefix + highlight(snippet || entry.description, terms) + suffix,
        };
      });
    };

    const render = (query: string) => {
      if (!query) {
        resultsEl.innerHTML =
          '<div class="search-dialog__empty">Start typing to search the docs.</div>';
        return;
      }
      if (currentResults.length === 0) {
        resultsEl.innerHTML = `<div class="search-dialog__empty">No matches for "${escapeHtml(query)}".</div>`;
        return;
      }
      resultsEl.innerHTML = currentResults
        .map(
          (r, i) => `
          <a
            href="${r.url}"
            class="search-dialog__result"
            data-search-result
            data-index="${i}"
            aria-selected="${i === activeIndex ? 'true' : 'false'}"
          >
            <div class="search-dialog__result-title">${escapeHtml(r.title)}</div>
            <div class="search-dialog__result-excerpt">${r.excerpt}</div>
          </a>`
        )
        .join('');
    };

    const escapeHtml = (s: string) =>
      s.replace(
        /[&<>"']/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c
      );

    let searchToken = 0;
    const runSearch = async (query: string) => {
      const token = ++searchToken;
      if (!pagefind && !pagefindError) {
        await load();
        if (token !== searchToken) return;
      }
      const trimmed = query.trim();
      if (!trimmed) {
        currentResults = [];
        render('');
        return;
      }
      if (pagefind) {
        const { results } = await pagefind.search(trimmed);
        if (token !== searchToken) return;
        const top = await Promise.all(results.slice(0, 8).map((r) => r.data()));
        currentResults = top.map((d) => ({
          url: d.url,
          title: d.meta.title,
          excerpt: d.excerpt,
        }));
      } else {
        await loadFallback();
        if (token !== searchToken) return;
        currentResults = fallbackSearch(trimmed);
      }
      activeIndex = 0;
      render(query);
    };

    trigger.addEventListener('click', open);

    document.addEventListener('keydown', (e) => {
      const mod = e.metaKey || e.ctrlKey;
      if (mod && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) close();
        else open();
      }
    });

    input.addEventListener('input', () => {
      void runSearch(input.value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, currentResults.length - 1);
        render(input.value);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        render(input.value);
      } else if (e.key === 'Enter') {
        const sel = currentResults[activeIndex];
        if (sel) {
          e.preventDefault();
          window.location.href = sel.url;
        }
      }
    });

    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog) {
        close();
        return;
      }
      const link = target.closest<HTMLAnchorElement>('[data-search-result]');
      if (link) {
        // Allow native nav; just close so it doesn't linger.
        close();
      }
    });

    dialog.addEventListener('close', () => {
      input.value = '';
      currentResults = [];
      activeIndex = 0;
    });
  }
</script>

<style>
  .search-box {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 7px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-fg-subtle);
    cursor: pointer;
    font-family: inherit;
    font-size: 12px;
    line-height: 1;
    text-align: left;
    appearance: none;
    transition: border-color 0.12s var(--ease-out-soft);
  }
  .search-box:hover {
    border-color: var(--color-border-strong);
    color: var(--color-fg-muted);
  }
  .search-icon {
    font-size: 11px;
  }
  .search-label {
    font-size: 12px;
  }
  .search-kbd {
    margin-left: auto;
    display: inline-flex;
    gap: 2px;
  }
  .search-kbd kbd,
  .search-dialog__footer kbd,
  .search-dialog__esc {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    padding: 2px 5px;
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    color: var(--color-fg-muted);
  }

  .search-dialog {
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-fg);
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 64px));
    position: fixed;
    top: 15vh;
    left: 50%;
    transform: translateX(-50%);
    overflow: hidden;
  }
  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(2px);
  }

  .search-dialog__form {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .search-dialog__field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--color-border);
  }
  .search-dialog__icon {
    color: var(--color-fg-muted);
    font-size: 14px;
  }
  .search-dialog__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-fg);
    font: inherit;
    font-size: 15px;
    padding: 0;
  }
  .search-dialog__input::placeholder {
    color: var(--color-fg-subtle);
  }

  .search-dialog__results {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
    min-height: 120px;
  }
  .search-dialog__empty {
    padding: 24px 12px;
    text-align: center;
    color: var(--color-fg-subtle);
    font-size: 13px;
  }
  .search-dialog__empty code {
    font-family: var(--font-mono);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
    font-size: 12px;
    color: var(--color-fg);
  }
  .search-dialog__result {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-fg);
    cursor: pointer;
  }
  .search-dialog__result:hover,
  .search-dialog__result[aria-selected='true'] {
    background: var(--color-surface-2);
  }
  .search-dialog__result-title {
    font-size: 14px;
    font-weight: 500;
  }
  .search-dialog__result-excerpt {
    font-size: 12px;
    color: var(--color-fg-muted);
    line-height: 1.5;
  }
  .search-dialog__result-excerpt :global(mark) {
    background: color-mix(in oklch, var(--color-primary) 30%, transparent);
    color: var(--color-fg);
    padding: 0 2px;
    border-radius: 2px;
  }

  .search-dialog__footer {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 10px 16px;
    border-top: 1px solid var(--color-border);
    color: var(--color-fg-subtle);
    font-size: 11px;
  }
  .search-dialog__footer span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
</style>
