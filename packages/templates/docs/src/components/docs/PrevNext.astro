---
/**
 * Previous / Next navigation at the bottom of each docs page.
 *
 * Walks the flat sidebar order to find the doc before and after the
 * current slug. Skips items that are external links AND items that don't
 * exist in the current locale.
 */

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

import { sidebar } from '@/config/sidebar';
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';

interface Props {
  /** Bare slug, e.g. "introduction" (no locale prefix). */
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const allDocs = await getCollection('docs', (e: CollectionEntry<'docs'>) => !e.data.draft);

const flat = sidebar
  .flatMap((g) => g.items)
  .filter((it) => !it.slug.startsWith('http'))
  .filter((it) => allDocs.some((e) => e.id === `${locale}/${it.slug}`));

const idx = flat.findIndex((it) => it.slug === currentSlug);
const prev = idx > 0 ? flat[idx - 1] : null;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null;

const titleForSlug = (slug: string): string =>
  allDocs.find((e) => e.id === `${locale}/${slug}`)?.data.title ?? slug;

const linkBase =
  'flex flex-col gap-1 rounded-[var(--radius)] border border-[var(--color-border)] px-3.5 py-3 text-[var(--color-fg)] no-underline transition-colors duration-100 hover:border-[var(--color-border-strong)]';
---

{
  (prev || next) && (
    <nav
      class="mt-16 grid grid-cols-2 gap-3 border-t border-[var(--color-border)] pt-6"
      aria-label={t('nav.pageNavigation')}
    >
      {prev ? (
        <a class={linkBase} href={getRelativeLocaleUrl(locale, `/${prev.slug}`)}>
          <span class="mono text-[11px] text-[var(--color-fg-muted)]">
            ← {t('blog.previousPost')}
          </span>
          <span class="text-sm font-medium tracking-[-0.01em]">
            {prev.label ?? titleForSlug(prev.slug)}
          </span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class={linkBase + ' text-right'} href={getRelativeLocaleUrl(locale, `/${next.slug}`)}>
          <span class="mono text-[11px] text-[var(--color-fg-muted)]">{t('blog.nextPost')} →</span>
          <span class="text-sm font-medium tracking-[-0.01em]">
            {next.label ?? titleForSlug(next.slug)}
          </span>
        </a>
      )}
    </nav>
  )
}
