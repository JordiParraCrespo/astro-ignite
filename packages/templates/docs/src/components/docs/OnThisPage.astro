---
/**
 * Right-column "On this page" TOC.
 *
 * Receives Astro's `headings` array (from `entry.render()`) and builds an
 * outline of H2 + H3 anchors. Active heading is tracked via IntersectionObserver
 * so the highlight follows the reader's scroll position.
 */

import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** Optional title shown above the TOC. */
  title?: string;
}

const { headings, title = 'On this page' } = Astro.props;

// Filter to depth 2 + 3 — H1 is the page title, H4+ is too granular.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <aside
      class="on-this-page sticky top-8 hidden max-h-[calc(100vh-64px)] flex-col gap-2.5 self-start overflow-y-auto px-4 lg:flex"
      aria-label={title}
    >
      <div class="mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-fg-muted)]">
        {title}
      </div>
      <ul class="m-0 flex list-none flex-col gap-1 p-0">
        {items.map((h) => (
          <li class:list={[h.depth === 3 && 'pl-3']}>
            <a
              class="block rounded-r-[var(--radius-sm)] border-l-2 border-transparent px-2.5 py-1 text-[12px] leading-[1.45] text-[var(--color-fg-muted)] no-underline transition-colors duration-100 hover:text-[var(--color-fg)] data-[active]:border-l-[var(--color-fg)] data-[active]:font-medium data-[active]:text-[var(--color-fg)]"
              href={`#${h.slug}`}
              data-heading={h.slug}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}

<script>
  // Highlight the heading currently in view.
  const links = document.querySelectorAll<HTMLAnchorElement>('.on-this-page a[data-heading]');
  if (links.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          links.forEach((a) => {
            a.toggleAttribute('data-active', a.dataset.heading === id);
          });
          break;
        }
      },
      { rootMargin: '0px 0px -70% 0px' }
    );
    links.forEach((a) => {
      const target = document.getElementById(a.dataset.heading!);
      if (target) observer.observe(target);
    });
  }
</script>
