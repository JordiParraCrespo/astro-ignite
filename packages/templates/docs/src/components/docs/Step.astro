---
/**
 * Step — a single item inside <Steps>. The number badge and the rail that
 * connects consecutive steps are drawn with a CSS counter + pseudo-elements,
 * so reordering renumbers automatically.
 */

import { cn } from '@/lib/cn';

interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<li
  class={cn(
    'step relative pb-7 pl-10 last:pb-0 [counter-increment:step]',
    'before:absolute before:top-0 before:left-0 before:z-[1] before:grid before:size-6 before:place-items-center before:rounded-full before:border before:border-border before:bg-surface-2 before:font-mono before:text-[11px] before:font-medium before:text-fg before:content-[counter(step)]',
    'after:absolute after:top-7 after:bottom-0 after:left-[calc(0.75rem-0.5px)] after:w-px after:bg-border last:after:hidden',
    className
  )}
>
  {title && <div class="mb-1.5 text-[15px] leading-6 font-medium text-fg">{title}</div>}
  <div class="text-sm leading-relaxed text-fg-muted [&_p]:mb-3 [&_p:last-child]:mb-0"><slot /></div>
</li>
