---
import { useTranslations, type TranslationKey } from '@/i18n';
import Text from '@/components/ui/text.astro';

export type Props = {
  name: string;
  description: string;
  kind?: 'component' | 'block';
};

const { name, description, kind = 'component' } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const install = `npx astro-ignite add ${name}`;
const root = kind === 'block' ? '/blocks' : '/components';
const backKey = (kind === 'block' ? 'blocks.back' : 'components.back') as TranslationKey;
const installKey = (kind === 'block' ? 'blocks.install' : 'components.install') as TranslationKey;
const previewAriaKey = (
  kind === 'block' ? 'blocks.previewAria' : 'components.previewAria'
) as TranslationKey;
---

<article class="showcase">
  <header class="showcase__head">
    <a href={root} class="showcase__back">{t(backKey)}</a>
    <Text variant="h1" class="showcase__title">{name}</Text>
    <Text variant="lead" class="showcase__desc">{description}</Text>
    <div class="showcase__install">
      <span class="showcase__install-label">{t(installKey)}</span>
      <code>{install}</code>
    </div>
  </header>

  <section class="showcase__preview" aria-label={t(previewAriaKey)}>
    <slot />
  </section>
</article>

<style>
  .showcase {
    max-width: 880px;
  }
  .showcase__head {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }
  .showcase__back {
    display: inline-block;
    margin-bottom: 16px;
    font-size: 13px;
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .showcase__back:hover {
    color: var(--color-fg);
  }
  .showcase__title {
    margin: 0 0 12px;
    text-transform: lowercase;
    font-family: var(--font-mono, monospace);
  }
  .showcase__desc {
    margin: 0 0 16px;
    max-width: 60ch;
  }
  .showcase__install {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-mono, monospace);
    font-size: 13px;
  }
  .showcase__install-label {
    color: var(--color-fg-muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .showcase__preview {
    padding: 48px 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
</style>
