---
/**
 * Code block with copy button.
 *
 * For MDX use, prefer this over raw ```fenced``` when you want the copy
 * affordance. Astro's built-in syntax highlighting via Shiki still applies
 * inside the <pre> if you pass the highlighted output as the slot.
 *
 * Usage:
 *   <CodeBlock filename="terminal" language="bash">
 *     {`$ npm create astro-ignite@latest`}
 *   </CodeBlock>
 */

interface Props {
  /** Optional title row label (e.g. "terminal", "src/site.ts"). */
  filename?: string;
  /** Display-only language label; doesn't drive highlighting. */
  language?: string;
}

const { filename, language } = Astro.props;
---

<div class="code-block">
  <div class="code-header">
    <span class="code-filename mono">{filename ?? 'snippet'}</span>
    {language && <span class="code-lang mono">{language}</span>}
    <button type="button" class="code-copy mono" data-copy-source> copy </button>
  </div>
  <pre class="code-body mono"><code><slot /></code></pre>
</div>

<script>
  // Click handler: read the <pre>'s text and write to clipboard.
  document.querySelectorAll<HTMLButtonElement>('.code-block [data-copy-source]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const block = btn.closest('.code-block');
      const pre = block?.querySelector('pre');
      if (!pre || !navigator.clipboard) return;
      const text = pre.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1200);
      } catch {
        // Permissions denied — silently fail.
      }
    });
  });
</script>

<style>
  .code-block {
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
    overflow: hidden;
  }
  .code-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--color-border);
    font-size: 11px;
    color: var(--color-fg-muted);
  }
  .code-filename {
    flex: 1;
  }
  .code-lang {
    color: var(--color-fg-subtle);
  }
  .code-copy {
    appearance: none;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-fg-muted);
    font-size: 11px;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    transition:
      background 0.1s,
      color 0.1s;
  }
  .code-copy:hover {
    color: var(--color-fg);
    background: var(--color-surface);
  }
  .code-body {
    margin: 0;
    padding: 14px 16px;
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-fg);
    overflow-x: auto;
  }
  .code-body code {
    font-family: var(--font-mono);
    background: transparent;
    padding: 0;
  }
</style>
