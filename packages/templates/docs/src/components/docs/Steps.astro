---
/**
 * Steps — ordered, numbered walkthrough for tutorials and quickstarts.
 *
 * Numbers and the connecting rail are drawn by `Step.astro` via a CSS counter,
 * so steps renumber automatically when reordered. No client JS.
 *
 * Usage in MDX:
 *   <Steps>
 *     <Step title="Install">…</Step>
 *     <Step title="Configure">…</Step>
 *   </Steps>
 */

import { cn } from '@/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ol class={cn('steps my-6 list-none p-0 [counter-reset:step]', className)}>
  <slot />
</ol>
