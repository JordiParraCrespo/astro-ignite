---
/**
 * LegalLayout — wraps BaseLayout for privacy/terms/cookies pages.
 *
 * Narrow reading column, "last updated" header prominently displayed,
 * automatic disclaimer banner reminding users this is a template.
 */

import type { CollectionEntry } from 'astro:content';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import { breadcrumbListSchema, webPageSchema } from '@/lib/jsonld';
import Text from '@/components/ui/text.astro';

import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'legal'>;
}

const { entry } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const slugSegments = entry.id.split('/');
const slug = slugSegments.slice(1).join('/');
const url = `/legal/${slug}`;

const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: t('footer.legal'), url: '/legal/privacy' },
  { name: entry.data.title, url },
];

const schemas = [
  breadcrumbListSchema(crumbs),
  webPageSchema({
    url,
    title: entry.data.title,
    description: entry.data.description,
    inLanguage: locale,
    dateModified: entry.data.lastUpdated,
  }),
];

const dateFmt = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="website"
  schemas={schemas}
>
  <article class="mx-auto max-w-[42rem] px-5 pt-8 pb-16">
    <header class="mb-8">
      <Text variant="h1">{entry.data.title}</Text>
      <Text variant="muted" class="m-0 flex flex-wrap gap-2">
        <span>
          {t('legal.lastUpdated')}:
          <time datetime={entry.data.lastUpdated.toISOString()}>
            {dateFmt.format(entry.data.lastUpdated)}
          </time>
        </span>
        <span aria-hidden="true">·</span>
        <span>{t('legal.version')} {entry.data.version}</span>
      </Text>
    </header>

    <div class="docs-prose legal-prose max-w-[64ch] text-[15px] leading-[1.65] text-(--color-fg)">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  @reference "../styles/global.css";
  /* Why kept: MDX-emitted blockquote in legal pages needs the warning-tinted
     callout treatment; MDX output is not in Tailwind's class-scan path. */
  .legal-prose blockquote {
    @apply my-6 rounded-r-md border-l-[3px] border-[var(--color-warning)] bg-[var(--color-surface-2)] px-4 py-3;
  }
</style>
