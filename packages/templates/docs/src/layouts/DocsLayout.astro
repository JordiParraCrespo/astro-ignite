---
/**
 * DocsLayout — three-column docs page.
 *
 * Layout: 240px sidebar | flexible main | 220px on-this-page.
 * On smaller viewports the sidebar collapses behind a toggle and the
 * on-this-page TOC moves above the content.
 *
 * Pulls the title/description from the entry frontmatter and renders:
 *   - Sidebar nav with active-link highlighting
 *   - Breadcrumbs + page header (title + lede + tags)
 *   - Slot for the rendered MDX content
 *   - Prev / Next navigation
 *   - On-this-page TOC (right column)
 */

import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import type { Thing } from 'schema-dts';

import BaseLayout from './BaseLayout.astro';
import SidebarNav from '@/components/docs/SidebarNav.astro';
import OnThisPage from '@/components/docs/OnThisPage.astro';
import Breadcrumbs from '@/components/docs/Breadcrumbs.astro';
import PrevNext from '@/components/docs/PrevNext.astro';
import ThemeToggle from '@/components/common/ThemeToggle.astro';
import LocaleSwitcher from '@/components/common/LocaleSwitcher.astro';
import { breadcrumbListSchema, webPageSchema } from '@/lib/jsonld';
import { siteConfig } from '@/config/site';

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description, tags, lastUpdated, noindex } = entry.data;

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;

// entry.id format: `<locale>/<slug>`. Strip the locale to get the bare slug.
const slug = entry.id.split('/').slice(1).join('/');
const url = locale === siteConfig.defaultLocale ? `/${slug}` : `/${locale}/${slug}`;

const schemas: Thing[] = [
  breadcrumbListSchema([
    { name: 'Docs', url: '/' },
    { name: title, url },
  ]),
  webPageSchema({
    url,
    title,
    description,
    inLanguage: locale,
    dateModified: lastUpdated,
  }),
];

const dateFmt = new Intl.DateTimeFormat(Astro.currentLocale ?? 'en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} schemas={schemas} noindex={noindex}>
  <div
    class="grid min-h-screen items-start grid-cols-1 md:grid-cols-[240px_1fr] lg:grid-cols-[240px_1fr_220px]"
  >
    <SidebarNav currentPath={Astro.url.pathname} />

    <main id="main" class="min-w-0 max-w-full px-5 pb-12 pt-6 md:px-12 md:pb-16 md:pt-7">
      <div class="mb-6 flex items-center justify-between">
        <Breadcrumbs currentSlug={slug} currentTitle={title} />
        <div class="flex items-center gap-1.5">
          <LocaleSwitcher />
          <ThemeToggle />
        </div>
      </div>

      <article data-pagefind-body>
        <header class="mb-7">
          {
            tags.length > 0 && (
              <div class="mb-3 flex gap-1.5">
                {tags.map((t: string) => (
                  <span class="mono rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface-2)] px-[7px] py-[3px] text-[11px] text-[var(--color-fg-muted)]">
                    {t}
                  </span>
                ))}
              </div>
            )
          }
          <h1
            class="m-0 mb-3 font-medium leading-[1.05] tracking-[-0.04em] text-[var(--color-fg)] text-[clamp(1.75rem,3vw,2.375rem)]"
          >
            {title}
          </h1>
          <p class="m-0 mb-4 max-w-[60ch] text-base leading-[1.55] text-[var(--color-fg-muted)]">
            {description}
          </p>
          {
            lastUpdated && (
              <div class="mono flex items-center gap-1.5 text-[11px] tracking-[-0.005em] text-[var(--color-fg-muted)]">
                <span>Last updated</span>
                <time datetime={lastUpdated.toISOString()}>{dateFmt.format(lastUpdated)}</time>
              </div>
            )
          }
        </header>

        <div class="docs-prose max-w-[64ch] text-[15px] leading-[1.65] text-[var(--color-fg)]">
          <slot />
        </div>

        <PrevNext currentSlug={slug} />
      </article>
    </main>

    <OnThisPage headings={headings} />
  </div>
</BaseLayout>

<style is:global>
  @reference "../styles/global.css";
  /* Why kept: MDX-emitted prose elements are not in Tailwind's class-scan path.
     @apply re-uses Tailwind utilities (and the token layer) so the rules
     stay token-resolved without a parallel design system. */
  .docs-prose h2 {
    @apply mb-4 mt-10 scroll-mt-4 text-[22px] font-medium leading-[1.3] tracking-[-0.03em] text-[var(--color-fg)];
  }
  .docs-prose h3 {
    @apply mb-2 mt-8 scroll-mt-4 text-[18px] font-medium leading-[1.4] tracking-[-0.02em] text-[var(--color-fg)];
  }
  .docs-prose :is(h2, h3) a {
    @apply text-[inherit] no-underline;
  }
  .docs-prose p {
    @apply mb-4 mt-0;
  }
  .docs-prose a {
    @apply text-[var(--color-fg)] underline decoration-[var(--color-border-strong)] decoration-[1px] underline-offset-[3px];
  }
  .docs-prose a:hover {
    @apply decoration-[var(--color-fg)];
  }
  .docs-prose :is(ul, ol) {
    @apply mb-4 mt-0 pl-5;
  }
  .docs-prose li {
    @apply mb-1;
  }
  .docs-prose code {
    @apply rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface-2)] px-[5px] py-px font-mono text-[0.875em];
  }
  .docs-prose pre {
    @apply my-5 overflow-x-auto rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface-2)] px-4 py-[14px] text-[13px] leading-[1.65];
  }
  .docs-prose pre code {
    @apply border-0 bg-transparent p-0 text-[length:inherit];
  }
  .docs-prose hr {
    @apply my-8 border-0 border-t border-[var(--color-border)];
  }
  .docs-prose blockquote {
    @apply my-5 border-l-2 border-[var(--color-border-strong)] pl-4 text-[var(--color-fg-muted)];
  }
  .docs-prose table {
    @apply my-5 w-full border-collapse text-[14px];
  }
  .docs-prose :is(th, td) {
    @apply border-b border-[var(--color-border)] px-3 py-2 text-left;
  }
  .docs-prose th {
    @apply font-medium;
  }
</style>
