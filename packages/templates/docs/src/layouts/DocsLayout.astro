---
/**
 * DocsLayout — three-column docs page.
 *
 * Layout: 240px sidebar | flexible main | 220px on-this-page.
 * On smaller viewports the sidebar collapses behind a toggle and the
 * on-this-page TOC moves above the content.
 *
 * Pulls the title/description from the entry frontmatter and renders:
 *   - Sidebar nav with active-link highlighting
 *   - Breadcrumbs + page header (title + lede + tags)
 *   - Slot for the rendered MDX content
 *   - Prev / Next navigation
 *   - On-this-page TOC (right column)
 */

import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import type { Thing } from 'schema-dts';

import BaseLayout from './BaseLayout.astro';
import SidebarNav from '@/components/docs/SidebarNav.astro';
import OnThisPage from '@/components/docs/OnThisPage.astro';
import Breadcrumbs from '@/components/docs/Breadcrumbs.astro';
import PrevNext from '@/components/docs/PrevNext.astro';
import AiActions from '@/components/docs/AiActions.astro';
import ThemeToggle from '@/components/common/ThemeToggle.astro';
import LocaleSwitcher from '@/components/common/LocaleSwitcher.astro';
import Text from '@/components/ui/text.astro';
import { breadcrumbListSchema, webPageSchema } from '@/lib/jsonld';
import { mdHref } from '@/lib/docs-md';
import { siteConfig } from '@/config/site';

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description, tags, lastUpdated, noindex } = entry.data;

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;

// entry.id format: `<locale>/<slug>`. Strip the locale to get the bare slug.
const slug = entry.id.split('/').slice(1).join('/');
const url = locale === siteConfig.defaultLocale ? `/${slug}` : `/${locale}/${slug}`;

const schemas: Thing[] = [
  breadcrumbListSchema([
    { name: 'Docs', url: '/' },
    { name: title, url },
  ]),
  webPageSchema({
    url,
    title,
    description,
    inLanguage: locale,
    dateModified: lastUpdated,
  }),
];

const dateFmt = new Intl.DateTimeFormat(Astro.currentLocale ?? 'en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} schemas={schemas} noindex={noindex}>
  <div
    class="grid min-h-screen grid-cols-1 items-start md:grid-cols-[240px_1fr] lg:grid-cols-[240px_1fr_220px]"
  >
    <SidebarNav currentPath={Astro.url.pathname} />

    <main id="main" class="max-w-full min-w-0 px-5 pt-6 pb-12 md:px-12 md:pt-7 md:pb-16">
      <div class="mb-6 flex items-center justify-between">
        <Breadcrumbs currentSlug={slug} currentTitle={title} />
        <div class="flex items-center gap-1.5">
          <AiActions markdownPath={mdHref(entry.id)} />
          <LocaleSwitcher />
          <ThemeToggle />
        </div>
      </div>

      <article data-pagefind-body>
        <header class="mb-7">
          {
            tags.length > 0 && (
              <div class="mb-3 flex gap-1.5">
                {tags.map((t: string) => (
                  <span class="mono rounded-(--radius-sm) border border-(--color-border) bg-(--color-surface-2) px-[7px] py-[3px] text-[11px] text-(--color-fg-muted)">
                    {t}
                  </span>
                ))}
              </div>
            )
          }
          <Text variant="h1">{title}</Text>
          <Text variant="lead" class="m-0 mb-4 max-w-[60ch]">{description}</Text>
          {
            lastUpdated && (
              <div class="mono flex items-center gap-1.5 text-[11px] tracking-[-0.005em] text-(--color-fg-muted)">
                <span>Last updated</span>
                <time datetime={lastUpdated.toISOString()}>{dateFmt.format(lastUpdated)}</time>
              </div>
            )
          }
        </header>

        <div class="docs-prose max-w-[64ch] text-[15px] leading-[1.65] text-(--color-fg)">
          <slot />
        </div>

        <PrevNext currentSlug={slug} />
      </article>
    </main>

    <OnThisPage headings={headings} />
  </div>
</BaseLayout>

<style is:global>
  @reference "../styles/global.css";
  /* Why kept: MDX-emitted prose elements are not in Tailwind's class-scan path.
     @apply re-uses Tailwind utilities (and the token layer) so the rules
     stay token-resolved without a parallel design system.
     Why layered: in `components` these rules sit below `utilities`, so an atom
     rendered inside prose (Card, Callout, Steps) keeps its own margins and
     type instead of inheriting the prose h3/p spacing. */
  @layer components {
    .docs-prose h2 {
      @apply mb-4 mt-10 scroll-mt-4 text-[22px] font-medium leading-[1.3] tracking-[-0.03em] text-[var(--color-fg)];
    }
    .docs-prose h3 {
      @apply mb-2 mt-8 scroll-mt-4 text-[18px] font-medium leading-[1.4] tracking-[-0.02em] text-[var(--color-fg)];
    }
    .docs-prose :is(h2, h3) a {
      @apply text-[inherit] no-underline;
    }
    .docs-prose p {
      @apply mb-4 mt-0;
    }
    .docs-prose a {
      @apply text-[var(--color-fg)] underline decoration-[var(--color-border-strong)] decoration-[1px] underline-offset-[3px];
    }
    .docs-prose a:hover {
      @apply decoration-[var(--color-fg)];
    }
    .docs-prose :is(ul, ol) {
      @apply mb-4 mt-0 pl-5;
    }
    .docs-prose li {
      @apply mb-1;
    }
    .docs-prose code {
      @apply rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface-2)] px-[5px] py-px font-mono text-[0.875em];
    }
    .docs-prose pre {
      @apply my-5 overflow-x-auto rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface-2)] px-4 py-[14px] text-[13px] leading-[1.65];
    }
    .docs-prose pre code {
      @apply border-0 bg-transparent p-0 text-[length:inherit];
    }
    /* Shiki emits `--shiki-light` / `--shiki-dark` per token (defaultColor:
       false in astro.config); pick the pair that matches the theme class so
       fenced blocks share the token surface with CodeBlock in both themes. */
    .docs-prose .astro-code,
    .docs-prose .astro-code span {
      color: var(--shiki-dark);
    }
    :root.light .docs-prose .astro-code,
    :root.light .docs-prose .astro-code span {
      color: var(--shiki-light);
    }
    .docs-prose pre.astro-code {
      @apply relative;
    }
    .docs-prose .code-copy {
      @apply absolute top-2 right-2 inline-flex cursor-pointer items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface)] px-1.5 py-0.5 font-mono text-[11px] leading-[1.4] text-[var(--color-fg-muted)] opacity-0 transition-opacity duration-100 hover:text-[var(--color-fg)];
    }
    .docs-prose pre:hover .code-copy,
    .docs-prose .code-copy:focus-visible,
    .docs-prose .code-copy[data-copied] {
      @apply opacity-100;
    }
    .docs-prose .code-copy svg {
      @apply size-3;
    }
    /* Shiki transformers: full-width line bands for `{1,3}` / `[!code highlight]`
     and `[!code ++]` / `[!code --]`, plus a line-number gutter on multi-line
     blocks. Token-resolved, build-time only. */
    .docs-prose .astro-code code {
      @apply inline-block min-w-full;
    }
    .docs-prose .astro-code .line {
      @apply inline-block w-full;
    }
    .docs-prose .astro-code code:has(.line:nth-child(2)) {
      counter-reset: docs-ln;
    }
    .docs-prose .astro-code code:has(.line:nth-child(2)) .line {
      counter-increment: docs-ln;
    }
    .docs-prose .astro-code code:has(.line:nth-child(2)) .line::before {
      content: counter(docs-ln);
      @apply mr-5 inline-block w-6 text-right text-[var(--color-fg-subtle)] select-none;
    }
    .docs-prose .astro-code .line.highlighted {
      background: color-mix(in oklch, var(--color-fg) 7%, transparent);
      box-shadow: inset 2px 0 var(--color-fg);
    }
    .docs-prose .astro-code .line.diff.add {
      background: color-mix(in oklch, var(--color-success) 16%, transparent);
      box-shadow: inset 2px 0 var(--color-success);
    }
    .docs-prose .astro-code .line.diff.remove {
      background: color-mix(in oklch, var(--color-danger) 16%, transparent);
      box-shadow: inset 2px 0 var(--color-danger);
      opacity: 0.65;
    }
    .docs-prose hr {
      @apply my-8 border-0 border-t border-[var(--color-border)];
    }
    .docs-prose blockquote {
      @apply my-5 border-l-2 border-[var(--color-border-strong)] pl-4 text-[var(--color-fg-muted)];
    }
    .docs-prose table {
      @apply my-5 w-full border-collapse text-[14px];
    }
    .docs-prose :is(th, td) {
      @apply border-b border-[var(--color-border)] px-3 py-2 text-left;
    }
    .docs-prose th {
      @apply font-medium;
    }
  }
</style>

<script>
  // Copy button on fenced code blocks (CodeBlock.astro ships its own).
  const copyIcon =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  document.querySelectorAll<HTMLPreElement>('.docs-prose pre.astro-code').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.innerHTML = `${copyIcon}<span>copy</span>`;
    btn.addEventListener('click', async () => {
      const text = pre.querySelector('code')?.textContent ?? '';
      if (!navigator.clipboard) return;
      try {
        await navigator.clipboard.writeText(text);
        btn.dataset.copied = '';
        btn.lastElementChild!.textContent = 'copied';
        setTimeout(() => {
          delete btn.dataset.copied;
          btn.lastElementChild!.textContent = 'copy';
        }, 1200);
      } catch {
        // Clipboard permission denied — leave the button as is.
      }
    });
    pre.appendChild(btn);
  });
</script>
