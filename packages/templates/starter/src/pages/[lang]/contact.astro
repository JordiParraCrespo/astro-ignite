---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactSection from '@/components/contact/ContactSection.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { breadcrumbListSchema, contactPageSchema } from '@/lib/jsonld';

export async function getStaticPaths() {
  return siteConfig.locales
    .filter((l) => l !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const schemas = [
  breadcrumbListSchema([
    { name: t('nav.home'), url: '/' },
    { name: t('nav.contact'), url: '/contact' },
  ]),
  contactPageSchema({
    url: '/contact',
    title: t('seo.contact.title'),
    description: t('seo.contact.description'),
    inLanguage: locale,
  }),
];
---

<BaseLayout
  title={t('seo.contact.title')}
  description={t('seo.contact.description')}
  schemas={schemas}
>
  <ContactSection />
</BaseLayout>
