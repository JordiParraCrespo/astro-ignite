---
/**
 * Per-locale blog post route — handles non-default locales.
 *
 * Default-locale posts render at /blog/[slug] via the sibling file at
 * src/pages/blog/[...slug].astro. This file generates paths for every
 * locale in siteConfig.locales EXCEPT the default.
 */

import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { mdxComponents } from '@/components/mdx/mdx-components';
import {
  getPostsForLocale,
  adjacentPosts,
  relatedPosts,
  nonDefaultLocales,
  postSlug,
} from '@/lib/blog';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of nonDefaultLocales()) {
    const posts = await getPostsForLocale(lang);
    for (const entry of posts) {
      paths.push({
        params: { lang, slug: postSlug(entry) },
        props: { entry, ...adjacentPosts(posts, entry), related: relatedPosts(posts, entry) },
      });
    }
  }
  return paths;
}

interface Props {
  entry: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} prev={prev} next={next} related={related} headings={headings}>
  <Content components={mdxComponents} />
</ArticleLayout>
