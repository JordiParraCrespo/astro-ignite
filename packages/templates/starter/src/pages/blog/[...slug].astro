---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { mdxComponents } from '@/components/mdx/mdx-components';
import { siteConfig } from '@/config/site';
import { getPostsForLocale, adjacentPosts, relatedPosts, postSlug } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getPostsForLocale(siteConfig.defaultLocale);
  return posts.map((entry) => ({
    params: { slug: postSlug(entry) },
    props: { entry, ...adjacentPosts(posts, entry), related: relatedPosts(posts, entry) },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { entry, prev, next, related } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} prev={prev} next={next} related={related} headings={headings}>
  <Content components={mdxComponents} />
</ArticleLayout>
