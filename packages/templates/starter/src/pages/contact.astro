---
import { actions, isInputError } from 'astro:actions';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/button.astro';
import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { breadcrumbListSchema, contactPageSchema } from '@/lib/jsonld';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// Astro Actions form handling — works with progressive enhancement.
// Method-override for the form means submissions land here as POST.
const result = Astro.getActionResult(actions.contact);
const inputError = result?.error && isInputError(result.error) ? result.error : null;

const schemas = [
  breadcrumbListSchema([
    { name: t('nav.home'), url: '/' },
    { name: t('nav.contact'), url: '/contact' },
  ]),
  contactPageSchema({
    url: '/contact',
    title: t('seo.contact.title'),
    description: t('seo.contact.description'),
    inLanguage: locale,
  }),
];
---

<BaseLayout
  title={t('seo.contact.title')}
  description={t('seo.contact.description')}
  schemas={schemas}
>
  <section class="page">
    <header class="page-header">
      <Text variant="h1">{t('seo.contact.title')}</Text>
      <Text variant="lead" class="mt-3">{t('seo.contact.description')}</Text>
    </header>

    {
      result && !result.error && (
        <div class="alert alert-success" role="status">
          ✓ {t('contact.success')}
        </div>
      )
    }

    {
      result?.error && !inputError && (
        <div class="alert alert-error" role="alert">
          ✗ {t('contact.error')}
        </div>
      )
    }

    <form method="POST" action={actions.contact} class="contact-form" novalidate>
      <div class="field">
        <label for="name">{t('contact.name')}</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          aria-invalid={inputError?.fields.name ? 'true' : undefined}
          aria-describedby={inputError?.fields.name ? 'name-error' : undefined}
        />
        {
          inputError?.fields.name && (
            <Text variant="small" id="name-error" class="field-error">
              {t('contact.validation.nameRequired')}
            </Text>
          )
        }
      </div>

      <div class="field">
        <label for="email">{t('contact.email')}</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          aria-invalid={inputError?.fields.email ? 'true' : undefined}
          aria-describedby={inputError?.fields.email ? 'email-error' : undefined}
        />
        {
          inputError?.fields.email && (
            <Text variant="small" id="email-error" class="field-error">
              {t('contact.validation.emailInvalid')}
            </Text>
          )
        }
      </div>

      <div class="field">
        <label for="message">{t('contact.message')}</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          aria-invalid={inputError?.fields.message ? 'true' : undefined}
          aria-describedby={inputError?.fields.message ? 'message-error' : undefined}></textarea>
        {
          inputError?.fields.message && (
            <Text variant="small" id="message-error" class="field-error">
              {t('contact.validation.messageTooShort')}
            </Text>
          )
        }
      </div>

      {/* Honeypot — bots fill this, humans don't */}
      <div class="honeypot" aria-hidden="true">
        <label for="_website">{t('contact.honeypot')}</label>
        <input id="_website" name="_website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <Button type="submit" variant="default" class="contact-submit">
        {t('contact.send')}
      </Button>
    </form>
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 36rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }
  .page-header {
    margin-bottom: 2rem;
  }

  .alert {
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
  }
  .alert-success {
    background: color-mix(in oklch, var(--color-success) 12%, var(--color-bg));
    border: 1px solid color-mix(in oklch, var(--color-success) 30%, transparent);
    color: var(--color-success);
  }
  .alert-error {
    background: color-mix(in oklch, var(--color-danger) 10%, var(--color-bg));
    border: 1px solid color-mix(in oklch, var(--color-danger) 30%, transparent);
    color: var(--color-danger);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .field label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-fg);
  }
  .field input,
  .field textarea {
    font-family: inherit;
    font-size: 1rem;
    padding: 0.625rem 0.75rem;
    background: var(--color-bg);
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    transition: border-color 0.15s var(--ease-out-soft);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-primary) 25%, transparent);
  }
  /* `.field-error` only carries the semantic danger color — the typography
     comes from <Text variant="small">. */
  .field-error {
    color: var(--color-danger);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    top: -9999px;
    height: 0;
    width: 0;
    overflow: hidden;
  }

  /* `align-self: flex-start` pins the submit Button to the left edge of the
     flex column. The Button atom owns colors / hover / sizing — only layout
     belongs here. */
  .contact-submit {
    align-self: flex-start;
  }
</style>
