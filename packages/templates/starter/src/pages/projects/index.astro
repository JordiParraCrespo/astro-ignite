---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectsIndexList from '@/components/sections/projects/ProjectsIndexList.astro';
import type { ProjectCard } from '@/components/sections/projects/ProjectsIndexList.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { breadcrumbListSchema, collectionPageSchema } from '@/lib/jsonld';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const projects = (
  await getCollection(
    'projects',
    (entry: CollectionEntry<'projects'>) => entry.id.startsWith(`${locale}/`) && !entry.data.draft
  )
).sort(
  (a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
    +b.data.datePublished - +a.data.datePublished
);

const projectCards: ProjectCard[] = projects.map((project: CollectionEntry<'projects'>) => {
  // entry.id format from Astro 5 i18n collection: "<locale>/<slug>" (folder /index stripped).
  const slug = project.id.split('/').slice(1).join('/');
  return {
    project,
    href: getRelativeLocaleUrl(locale, `/projects/${slug}`),
  };
});

const schemas = [
  breadcrumbListSchema([
    { name: t('nav.home'), url: '/' },
    { name: t('nav.projects'), url: '/projects' },
  ]),
  collectionPageSchema({
    url: '/projects',
    title: t('seo.projects.title'),
    description: t('seo.projects.description'),
    inLanguage: locale,
  }),
];
---

<BaseLayout
  title={t('seo.projects.title')}
  description={t('seo.projects.description')}
  schemas={schemas}
>
  <ProjectsIndexList projectCards={projectCards} />
</BaseLayout>
