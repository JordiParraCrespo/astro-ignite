---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/button.astro';
import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
---

<BaseLayout title={t('seo.404.title')} description={t('seo.404.description')} noindex={true}>
  <section class="not-found">
    <div class="text-stack">
      <Text variant="eyebrow" class="font-mono">404</Text>
      <Text variant="h1">{t('errors.404.heading')}</Text>
      <Text variant="lead">{t('errors.404.body')}</Text>
    </div>
    <Button href="/" variant="default">{t('errors.404.back')} →</Button>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 40rem;
    margin: 0 auto;
    padding: 5rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }
  .text-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
</style>
