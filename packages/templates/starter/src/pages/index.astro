---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import FeaturesGrid from '@/components/sections/landing/FeaturesGrid.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
---

<BaseLayout title={t('seo.home.title')} description={t('seo.home.description')}>
  <Hero
    eyebrow={t('home.eyebrow')}
    title={siteConfig.name[locale] ?? siteConfig.name[siteConfig.defaultLocale]!}
    description={t('seo.home.description')}
    primaryCta={{ label: t('home.primaryCta'), href: '/blog' }}
    secondaryCta={{ label: t('home.secondaryCta'), href: '/projects' }}
  />
  <FeaturesGrid />
</BaseLayout>
