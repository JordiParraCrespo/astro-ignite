---
/**
 * Universal head tags — title, meta description, canonical, OG, Twitter,
 * hreflang, robots. Composed alongside <JsonLd> for structured data.
 *
 * Per-page props override site config defaults. When `alternates` is omitted,
 * hreflang links are auto-computed from the i18n locale list and the current
 * pathname (works for the 80% case where translations share path slugs).
 */

import { getRelativeLocaleUrl } from 'astro:i18n';
import type { ImageMetadata } from 'astro';

import { siteConfig } from '@/config/site';
import { localize } from '@/i18n';
import { absoluteUrl } from '@/lib/jsonld/types';

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  image?: ImageMetadata | string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'profile';
  /** Locale override — defaults to Astro.currentLocale. */
  locale?: string;
  /**
   * Hreflang alternates. Omit to auto-compute from i18n locales + current
   * pathname. Pass explicitly when slugs differ across locales.
   */
  alternates?: Array<{ lang: string; href: string }>;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  noindex = false,
  type = 'website',
  locale: localeProp,
  alternates,
} = Astro.props;

const locale = localeProp ?? Astro.currentLocale ?? siteConfig.defaultLocale;

// Canonical URL — emit the no-slash form regardless of how the route was hit (astro.config uses `trailingSlash: 'ignore'`).
const canonicalUrl = canonical
  ? typeof canonical === 'string'
    ? new URL(canonical, siteConfig.url)
    : canonical
  : new URL(Astro.url.pathname.replace(/\/$/, '') || '/', siteConfig.url);

// Site name (locale-aware).
const siteName = siteConfig.name[locale] ?? siteConfig.name[siteConfig.defaultLocale]!;
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

// Image resolution: prop override → locale-aware siteConfig.defaultOgImage.
const resolvedImage = image
  ? typeof image === 'string'
    ? image
    : image.src
  : localize(siteConfig.defaultOgImage, locale);
const ogImageUrl = resolvedImage ? absoluteUrl(resolvedImage) : undefined;

// Auto-compute hreflang alternates if not provided.
const computedAlternates: Array<{ lang: string; href: string }> = alternates
  ? alternates
  : siteConfig.locales.map((lang) => ({
      lang: siteConfig.hreflang[lang] ?? lang,
      href: absoluteUrl(getRelativeLocaleUrl(lang, Astro.url.pathname)),
    }));

// og:locale_alternate values for non-current locales.
const altLocales = siteConfig.locales
  .filter((l) => l !== locale)
  .map((l) => siteConfig.hreflang[l] ?? l);
---

<!-- Title + description -->
<title>{fullTitle}</title>
<meta name="description" content={description} />

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl.href} />

<!-- Robots -->
{noindex && <meta name="robots" content="noindex,nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={siteConfig.hreflang[locale] ?? locale} />
{altLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
{
  ogImageUrl && (
    <>
      <meta property="og:image" content={ogImageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
{siteConfig.twitterHandle && <meta name="twitter:site" content={siteConfig.twitterHandle} />}

<!-- Hreflang alternates -->
{computedAlternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
{
  computedAlternates.length > 1 && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrl(getRelativeLocaleUrl(siteConfig.defaultLocale, Astro.url.pathname))}
    />
  )
}
