---
import { cn } from '@/lib/cn';

export type Props = {
  position?: 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left';
  class?: string;
};

const { position = 'bottom-right', class: className } = Astro.props;

const positions: Record<NonNullable<Props['position']>, string> = {
  'top-right': 'top-0 right-0',
  'top-left': 'top-0 left-0',
  'bottom-right': 'bottom-0 right-0',
  'bottom-left': 'bottom-0 left-0',
};
---

<ai-toaster
  data-position={position}
  class={cn(
    'pointer-events-none fixed z-[100] flex max-w-[min(420px,calc(100vw-32px))] flex-col gap-2 p-4',
    positions[position],
    className
  )}
  aria-live="polite"
  aria-atomic="false"></ai-toaster>

<script>
  const TOAST_CLASS =
    'pointer-events-auto bg-surface text-fg border border-border rounded-md py-3 px-3.5 shadow-[0_10px_30px_-10px_rgb(0_0_0/0.6)] text-[13px] leading-snug flex items-center gap-3 min-w-[320px]';
  const ICON_BASE_CLASS =
    'w-4 h-4 shrink-0 rounded-full border-[1.5px] grid place-items-center font-mono text-[10px] leading-none';
  const ICON_TONE: Record<string, string> = {
    default: 'border-fg-muted text-fg-muted',
    success: 'border-success text-success',
    warning: 'border-warning text-warning',
    destructive: 'border-danger text-danger',
  };
  const CLOSE_CLASS =
    'ml-auto bg-transparent border-none text-fg-muted cursor-pointer px-1 text-sm leading-none hover:text-fg';

  if (!customElements.get('ai-toaster')) {
    class AiToaster extends HTMLElement {
      connectedCallback() {
        window.addEventListener('ai-toast', (e: Event) => {
          const detail = (e as CustomEvent).detail as {
            message: string;
            variant?: 'default' | 'success' | 'destructive' | 'warning';
            duration?: number;
          };
          this.show(detail);
        });
      }
      show(opts: { message: string; variant?: string; duration?: number }) {
        const variant = opts.variant ?? 'default';
        const glyph: Record<string, string> = {
          default: 'i',
          success: '✓',
          warning: '!',
          destructive: '×',
        };
        const el = document.createElement('div');
        el.className = TOAST_CLASS;
        el.setAttribute('role', variant === 'destructive' ? 'alert' : 'status');
        const icon = document.createElement('span');
        icon.className = `${ICON_BASE_CLASS} ${ICON_TONE[variant] ?? ICON_TONE.default}`;
        icon.textContent = glyph[variant] ?? 'i';
        el.appendChild(icon);
        const text = document.createElement('span');
        text.className = 'flex-1';
        text.textContent = opts.message;
        el.appendChild(text);
        const close = document.createElement('button');
        close.className = CLOSE_CLASS;
        close.setAttribute('aria-label', 'Close');
        close.textContent = '×';
        close.addEventListener('click', () => el.remove());
        el.appendChild(close);
        this.appendChild(el);
        const ms = opts.duration ?? 4000;
        if (ms > 0) setTimeout(() => el.remove(), ms);
      }
    }
    customElements.define('ai-toaster', AiToaster);
  }
</script>
