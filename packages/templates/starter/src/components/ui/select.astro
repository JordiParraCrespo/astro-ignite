---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'select'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<div class="relative inline-grid w-full items-center">
  <select
    class={cn(
      'col-start-1 row-start-1 h-9 w-full cursor-pointer appearance-none rounded-md border border-border bg-transparent pr-8 pl-3 text-sm leading-none text-fg transition-[border-color,box-shadow] duration-150 focus:border-ring focus:[box-shadow:0_0_0_1px_var(--color-ring)] focus:outline-none focus-visible:border-ring focus-visible:[box-shadow:0_0_0_1px_var(--color-ring)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-danger',
      className
    )}
    {...rest}
  >
    <slot />
  </select>
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    class="pointer-events-none col-start-1 row-start-1 mr-2.5 h-4 w-4 justify-self-end text-fg-muted"
  >
    <path
      d="M4 6l4 4 4-4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</div>
