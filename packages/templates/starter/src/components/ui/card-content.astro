---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'div'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<div class={cn('card-content', className)} {...rest}><slot /></div>

<style>
  .card-content {
    padding: 24px;
  }
</style>
