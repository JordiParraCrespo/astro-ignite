---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'div'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<div class={cn('card-header', className)} {...rest}><slot /></div>

<style>
  .card-header {
    padding: 24px 24px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
</style>
