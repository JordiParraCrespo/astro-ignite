---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'input'> & { class?: string };
const { class: className, type = 'text', ...rest } = Astro.props;
---

<input
  type={type}
  class={cn(
    'block w-full h-9 px-3 bg-transparent text-fg border border-border rounded-md text-sm leading-none transition-[border-color,box-shadow] duration-150 placeholder:text-fg-subtle focus:outline-none focus:border-ring focus:[box-shadow:0_0_0_1px_var(--color-ring)] focus-visible:outline-none focus-visible:border-ring focus-visible:[box-shadow:0_0_0_1px_var(--color-ring)] disabled:opacity-50 disabled:cursor-not-allowed aria-invalid:border-danger aria-invalid:focus-visible:[box-shadow:0_0_0_3px_color-mix(in_oklch,var(--color-danger)_25%,transparent)]',
    className,
  )}
  {...rest}
/>
