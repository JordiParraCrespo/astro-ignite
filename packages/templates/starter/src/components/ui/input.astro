---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'input'> & { class?: string };
const { class: className, type = 'text', ...rest } = Astro.props;
---

<input
  type={type}
  class={cn(
    'block h-9 w-full rounded-md border border-border bg-transparent px-3 text-sm leading-none text-fg transition-[border-color,box-shadow] duration-150 placeholder:text-fg-subtle focus:border-ring focus:[box-shadow:0_0_0_1px_var(--color-ring)] focus:outline-none focus-visible:border-ring focus-visible:[box-shadow:0_0_0_1px_var(--color-ring)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-danger aria-invalid:focus-visible:[box-shadow:0_0_0_3px_color-mix(in_oklch,var(--color-danger)_25%,transparent)]',
    className
  )}
  {...rest}
/>
