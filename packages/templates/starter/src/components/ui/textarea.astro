---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'textarea'> & { class?: string };
const { class: className, rows = 4, ...rest } = Astro.props;
---

<textarea
  rows={rows}
  class={cn(
    'block min-h-20 w-full resize-y rounded-md border border-border bg-transparent px-3 py-2 text-sm leading-normal text-fg transition-[border-color,box-shadow] duration-150 placeholder:text-fg-subtle focus:border-ring focus:[box-shadow:0_0_0_1px_var(--color-ring)] focus:outline-none focus-visible:border-ring focus-visible:[box-shadow:0_0_0_1px_var(--color-ring)] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-danger',
    className
  )}
  {...rest}><slot /></textarea
>
