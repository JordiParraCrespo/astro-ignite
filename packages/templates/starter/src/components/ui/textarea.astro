---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'textarea'> & { class?: string };
const { class: className, rows = 4, ...rest } = Astro.props;
---

<textarea
  rows={rows}
  class={cn(
    'block w-full min-h-20 px-3 py-2 bg-transparent text-fg border border-border rounded-md text-sm leading-normal resize-y transition-[border-color,box-shadow] duration-150 placeholder:text-fg-subtle focus:outline-none focus:border-ring focus:[box-shadow:0_0_0_1px_var(--color-ring)] focus-visible:outline-none focus-visible:border-ring focus-visible:[box-shadow:0_0_0_1px_var(--color-ring)] disabled:opacity-50 disabled:cursor-not-allowed aria-invalid:border-danger',
    className,
  )}
  {...rest}><slot /></textarea>
