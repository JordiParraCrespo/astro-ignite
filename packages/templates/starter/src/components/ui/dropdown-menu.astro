---
import { cn } from '@/lib/cn';

export type Props = {
  id: string;
  align?: 'start' | 'end';
  class?: string;
};

const { id, align = 'start', class: className } = Astro.props;

const alignClass =
  align === 'end' ? '[position-area:bottom_span-left]' : '[position-area:bottom_span-right]';
---

<div
  id={id}
  popover="auto"
  class={cn(
    'absolute [inset:auto] mt-1 min-w-[180px] rounded-md border border-border bg-surface p-1 text-fg shadow-[0_4px_6px_-1px_rgb(0_0_0/0.3),0_2px_4px_-2px_rgb(0_0_0/0.2)] [position-anchor:--anchor] [&:not(:popover-open)]:hidden',
    alignClass,
    className
  )}
>
  <slot />
</div>
