---
/**
 * Blog post card — gradient cover, title, date + reading time, description,
 * tag chips. The whole card is a single link, so tags render as plain chips
 * (a nested <a> would be invalid). Tag links live on the post page header
 * instead.
 *
 * The cover is a token-resolved gradient rather than a hero image: each post
 * gets one of a few grayscale gradient variants (picked deterministically
 * from its id) so a grid of cards reads as varied without shipping any
 * placeholder art.
 */

import type { CollectionEntry } from 'astro:content';

import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { readingTimeMinutes } from '@/lib/reading-time';

interface Props {
  post: CollectionEntry<'blog'>;
  href: string;
}

const { post, href } = Astro.props;

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
const dateFmt = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const minutes = readingTimeMinutes(post.body);

// Token-resolved gradient covers — one per post, chosen deterministically so
// the same post always renders the same variant across index + related grids.
const COVER_VARIANTS = [
  'bg-[radial-gradient(ellipse_80%_100%_at_30%_40%,var(--color-cover-accent),var(--color-bg))]',
  'bg-[radial-gradient(circle_at_72%_28%,var(--color-cover-accent),var(--color-bg)_70%)]',
  'bg-[linear-gradient(135deg,var(--color-cover-accent),var(--color-bg)_72%)]',
  'bg-[conic-gradient(from_210deg_at_35%_40%,var(--color-cover-accent),var(--color-bg),var(--color-cover-accent))]',
];
const variant = [...post.id].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % COVER_VARIANTS.length;
---

<a
  href={href}
  class="block overflow-hidden rounded-xl border border-(--color-border) text-inherit no-underline transition-[border-color,transform] duration-150 ease-(--ease-out-soft) hover:border-(--color-primary)"
>
  <div
    class:list={[
      'relative aspect-[16/9] border-b border-(--color-border)',
      COVER_VARIANTS[variant],
    ]}
  >
    <span
      aria-hidden="true"
      class="pointer-events-none absolute right-4 bottom-3 font-mono text-4xl font-medium text-(--color-fg) opacity-[0.07] select-none"
      >&gt;_</span
    >
  </div>
  <div class="p-5">
    <Text variant="h3" as="h2" class="mb-2">{post.data.title}</Text>
    <Text variant="muted" as="p" class="mb-3 flex flex-wrap items-center gap-x-2">
      <time datetime={post.data.datePublished.toISOString()}>
        {dateFmt.format(post.data.datePublished)}
      </time>
      <span aria-hidden="true">·</span>
      <span>{t('blog.readingTime', { minutes })}</span>
    </Text>
    <Text variant="body" tone="muted" class="mb-3">{post.data.description}</Text>
    {
      post.data.tags.length > 0 && (
        <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
          {post.data.tags.slice(0, 4).map((tag: string) => (
            <li class="rounded bg-(--color-surface-2) px-2 py-0.5 text-[0.75rem] text-(--color-fg-muted)">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</a>
