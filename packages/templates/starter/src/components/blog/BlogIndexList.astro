---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

import PostCard from '@/components/blog/PostCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { postSlug, type PageMeta } from '@/lib/blog';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Heading override — defaults to the blog SEO title. */
  title?: string;
  /** Subheading override — defaults to the blog SEO description. */
  description?: string;
  /** Pagination metadata; when omitted (or single-page) no control renders. */
  page?: PageMeta;
}

const { posts, title, description, page } = Astro.props;

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const heading = title ?? t('seo.blog.title');
const subheading = description ?? t('seo.blog.description');
---

<section class="relative isolate mx-auto max-w-[64rem] px-5 pt-12 pb-16">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[26rem] bg-[radial-gradient(ellipse_60%_100%_at_50%_0%,var(--color-surface-2),transparent_70%)]"
  >
  </div>
  <header class="mb-10">
    <Text variant="h1" class="mb-3">{heading}</Text>
    <Text variant="lead">{subheading}</Text>
  </header>

  {
    posts.length === 0 ? (
      <Text variant="lead" class="py-12 text-center">
        {t('blog.noPosts')}
      </Text>
    ) : (
      <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-2">
        {posts.map((post) => (
          <li>
            <PostCard post={post} href={getRelativeLocaleUrl(locale, `/blog/${postSlug(post)}`)} />
          </li>
        ))}
      </ul>
    )
  }

  {page && <Pagination page={page} />}
</section>
