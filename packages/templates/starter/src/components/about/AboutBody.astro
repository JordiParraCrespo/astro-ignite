---
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
---

<article class="mx-auto max-w-[48rem] px-5 pt-12 pb-16">
  <header class="mb-8">
    <h1
      class="m-0 mb-3 text-[clamp(2rem,5vw,2.75rem)] leading-[1.1] font-bold tracking-[-0.02em] text-(--color-fg)"
    >
      {t('seo.about.title')}
    </h1>
    <p class="m-0 text-lg leading-[1.5] text-(--color-fg-muted)">
      {t('seo.about.description')}
    </p>
  </header>
  <div class="prose">
    <p>{t('about.body.p1')}</p>
    <p>{t('about.body.p2')}</p>
    <h2>{t('about.body.heading')}</h2>
    <ul>
      <li>{t('about.body.li1')}</li>
      <li>{t('about.body.li2')}</li>
      <li>{t('about.body.li3')}</li>
    </ul>
  </div>
</article>
