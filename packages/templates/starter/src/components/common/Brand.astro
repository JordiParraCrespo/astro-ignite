---
/**
 * Brand mark — the cursor `>_` lockup.
 *
 * Sourced from the Claude Design handoff (Mark A).
 * - Geist Mono `>` glyph + a solid caret block (blinking via `.caret`)
 * - Optional `astro-ignite` wordmark in Geist Sans (always lowercase)
 * - All sizing scales with the `size` prop (1 = display sizes from the spec)
 *
 * Variants:
 *   <Brand variant="lockup" />   default — mark + wordmark side by side
 *   <Brand variant="mark" />     just `>_` (favicon, small icon contexts)
 *   <Brand variant="word" />     just the wordmark (footer, dense places)
 *
 * Sizes computed from the `size` prop are exposed as inline CSS variables on
 * the host element; the Tailwind utilities below consume them so the
 * styling stays Tailwind-first while remaining prop-driven.
 */

interface Props {
  variant?: 'lockup' | 'mark' | 'word';
  /** Multiplier for all spec sizes. 1 = display (56pt mono / 40pt sans). */
  size?: number;
  /** Optional href; renders as a link (used by Nav). */
  href?: string;
  /** Aria label override; defaults to "astro-ignite". */
  label?: string;
  class?: string;
}

const {
  variant = 'lockup',
  size = 1,
  href,
  label = 'astro-ignite',
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'span';

// Spec sizes (all in pt/px, scaled by size prop)
const monoSize = 56 * size;
const sansSize = 40 * size;
const gap = 14 * size;
const caretWidth = 22 * size;
const caretHeight = 6 * size;
const caretLift = 4 * size;
const caretMargin = 4 * size;

const gapClass = variant === 'lockup' ? 'gap-[var(--ig-gap)]' : 'gap-0';
---

<Tag
  class:list={[
    'inline-flex items-center text-[var(--color-fg)] leading-none tracking-[-0.04em] no-underline hover:text-[var(--color-fg)] [&:hover_.ig-caret]:bg-[var(--color-primary)]',
    gapClass,
    className,
  ]}
  href={href}
  aria-label={href ? label : undefined}
  style={`
    --ig-mono-size: ${monoSize}px;
    --ig-sans-size: ${sansSize}px;
    --ig-gap: ${gap}px;
    --ig-caret-w: ${caretWidth}px;
    --ig-caret-h: ${caretHeight}px;
    --ig-caret-lift: ${caretLift}px;
    --ig-caret-margin: ${caretMargin}px;
  `}
>
  {
    variant !== 'word' && (
      <span
        class="mono inline-flex items-baseline font-mono text-[length:var(--ig-mono-size)] leading-none font-medium text-[var(--color-fg)]"
        aria-hidden={variant === 'lockup' ? 'true' : undefined}
      >
        <span class="inline-block">{'>'}</span>
        <span class="ig-caret caret ml-[var(--ig-caret-margin)] inline-block h-[var(--ig-caret-h)] w-[var(--ig-caret-w)] translate-y-[calc(var(--ig-caret-lift)*-1)] bg-[var(--color-fg)]" />
      </span>
    )
  }
  {
    variant !== 'mark' && (
      <span class="font-sans text-[length:var(--ig-sans-size)] font-medium tracking-[-0.04em] text-[var(--color-fg)] lowercase">
        astro-ignite
      </span>
    )
  }
</Tag>
