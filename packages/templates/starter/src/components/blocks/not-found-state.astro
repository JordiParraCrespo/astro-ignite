---
import Text from '@/components/ui/text.astro';
import { cn } from '@/lib/cn';

export type Props = {
  code?: string;
  title: string;
  description?: string;
  class?: string;
};

const { code = 'Error · 404', title, description, class: className } = Astro.props;
---

<section
  class={cn('max-w-[480px] mx-auto mt-16 text-center flex flex-col gap-4 items-center', className)}
>
  <Text variant="eyebrow" class="mono">{code}</Text>
  <Text variant="h1">{title}</Text>
  {
    description && (
      <Text variant="muted" class="max-w-[36ch]">
        {description}
      </Text>
    )
  }
  {
    Astro.slots.has('default') && (
      <div class="flex gap-2.5 mt-2 flex-wrap justify-center">
        <slot />
      </div>
    )
  }
</section>
