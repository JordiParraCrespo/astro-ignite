---
import { cn } from '@/lib/cn';

export type Props = {
  command: string;
  prompt?: string;
  copy?: boolean;
  class?: string;
};

const { command, prompt = '$', copy = true, class: className } = Astro.props;
---

<div class={cn('command-block mono', className)} data-command={command}>
  <span class="command-block__text">
    <span class="command-block__prompt" aria-hidden="true">{prompt}</span>
    <span>{command}</span>
  </span>
  {
    copy && (
      <button type="button" class="command-block__copy" data-command-copy aria-label="Copy command">
        <span class="command-block__copy-label">Copy</span>
      </button>
    )
  }
</div>

<style>
  .command-block {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--color-surface-2) 50%, transparent);
    font-size: 13px;
    color: var(--color-fg);
    max-width: 100%;
    width: fit-content;
  }
  .command-block__text {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .command-block__prompt {
    color: var(--color-fg-subtle);
  }
  .command-block__copy {
    appearance: none;
    border: 0;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    background: var(--color-border);
    color: var(--color-fg-muted);
    font: inherit;
    font-size: 11px;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 120ms ease,
      color 120ms ease;
  }
  .command-block__copy:hover {
    background: var(--color-border-strong);
    color: var(--color-fg);
  }
  .command-block__copy[data-copied='true'] .command-block__copy-label {
    color: var(--color-success);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-command]').forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>('[data-command-copy]');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const cmd = el.dataset.command ?? '';
      try {
        await navigator.clipboard.writeText(cmd);
        btn.dataset.copied = 'true';
        const label = btn.querySelector('.command-block__copy-label');
        const prev = label?.textContent ?? 'Copy';
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          btn.dataset.copied = 'false';
          if (label) label.textContent = prev;
        }, 1500);
      } catch {
        // Clipboard blocked — silently fail.
      }
    });
  });
</script>
