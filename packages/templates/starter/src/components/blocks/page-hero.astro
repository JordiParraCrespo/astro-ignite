---
import { cn } from '@/lib/cn';

export type Props = {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'start' | 'center';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
};

const { eyebrow, title, lede, align = 'start', size = 'lg', class: className } = Astro.props;

const alignClass = align === 'center' ? 'mx-auto text-center' : '';
const ledeAlignClass = align === 'center' ? 'mx-auto' : '';

const titleSize: Record<NonNullable<Props['size']>, string> = {
  sm: 'text-[clamp(32px,5vw,40px)]',
  md: 'text-[clamp(36px,6vw,48px)]',
  lg: 'text-[clamp(40px,7vw,56px)] tracking-[-0.045em]',
};
---

<header class={cn('flex flex-col gap-2 max-w-[720px]', alignClass, className)}>
  {
    eyebrow && (
      <span class="mono text-[11px] text-fg-subtle tracking-[0.18em] uppercase">{eyebrow}</span>
    )
  }
  <h1
    class={cn(
      'm-0 font-medium tracking-[-0.04em] leading-none text-fg text-balance',
      titleSize[size]
    )}
  >
    {title}
  </h1>
  {
    lede && (
      <p
        class={cn(
          'mt-1 mb-0 text-lg leading-[1.55] text-fg-muted max-w-[60ch] text-pretty',
          ledeAlignClass
        )}
      >
        {lede}
      </p>
    )
  }
  <slot />
</header>
