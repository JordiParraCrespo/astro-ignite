---
import type { CollectionEntry } from 'astro:content';

import Image from '@/components/image/Image.astro';
import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

export type ProjectCard = {
  project: CollectionEntry<'projects'>;
  href: string;
};

interface Props {
  projectCards: ProjectCard[];
}

const { projectCards } = Astro.props;

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
---

<section class="mx-auto max-w-[80rem] px-5 pt-12 pb-16">
  <header class="mb-10 text-center">
    <Text variant="h1" class="mb-3">{t('seo.projects.title')}</Text>
    <Text variant="lead" class="mx-auto max-w-[40rem]">{t('seo.projects.description')}</Text>
  </header>

  {
    projectCards.length === 0 ? (
      <Text variant="lead" class="py-12 text-center">
        {t('projects.noProjects')}
      </Text>
    ) : (
      <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2">
        {projectCards.map(({ project, href }: ProjectCard) => (
          <li>
            <a
              href={href}
              class="block overflow-hidden rounded-xl border border-(--color-border) text-inherit no-underline transition-colors duration-150 ease-(--ease-out-soft) hover:border-(--color-primary) [&_img]:block [&_img]:aspect-[16/9] [&_img]:h-auto [&_img]:w-full [&_img]:object-cover [&_picture]:block [&_picture]:aspect-[16/9] [&_picture]:h-auto [&_picture]:w-full [&_picture]:object-cover"
            >
              <div>
                <Image
                  src={project.data.heroImage}
                  alt={project.data.heroImageAlt}
                  width={800}
                  height={420}
                  sizes="(min-width: 768px) 50vw, 100vw"
                />
              </div>
              <div class="p-5">
                <Text variant="h3" as="h2" class="mb-2">
                  {project.data.title}
                </Text>
                <Text variant="body" tone="muted" class="mb-4">
                  {project.data.summary}
                </Text>
                {project.data.techStack.length > 0 && (
                  <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
                    {project.data.techStack.slice(0, 4).map((tech: string) => (
                      <li class="rounded bg-(--color-surface-2) px-2 py-0.5 text-xs text-(--color-fg-muted)">
                        {tech}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
