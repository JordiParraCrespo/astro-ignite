---
import type { CollectionEntry } from 'astro:content';

import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

export type ProjectCard = {
  project: CollectionEntry<'projects'>;
  href: string;
};

interface Props {
  projectCards: ProjectCard[];
}

const { projectCards } = Astro.props;

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const statusLabels = {
  shipped: t('projects.status.shipped'),
  'in-progress': t('projects.status.in-progress'),
  archived: t('projects.status.archived'),
} as const;
---

<section class="mx-auto max-w-[80rem] px-5 pt-12 pb-16">
  <header class="mb-10 text-center">
    <Text variant="h1" class="mb-3">{t('seo.projects.title')}</Text>
    <Text variant="lead" class="mx-auto max-w-[40rem]">{t('seo.projects.description')}</Text>
  </header>

  {
    projectCards.length === 0 ? (
      <Text variant="lead" class="py-12 text-center">
        {t('projects.noProjects')}
      </Text>
    ) : (
      <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2">
        {projectCards.map(({ project, href }: ProjectCard) => (
          <li>
            <a
              href={href}
              class="block overflow-hidden rounded-xl border border-(--color-border) text-inherit no-underline transition-colors duration-150 ease-(--ease-out-soft) hover:border-(--color-primary)"
            >
              <div class="relative aspect-[16/9] border-b border-(--color-border) bg-[length:18px_18px] bg-[linear-gradient(135deg,var(--color-border)_25%,var(--color-surface-2)_25%,var(--color-surface-2)_50%,var(--color-border)_50%,var(--color-border)_75%,var(--color-surface-2)_75%)]">
                <span class="absolute top-2.5 left-2.5 rounded-full border border-(--color-border-strong) bg-(--color-surface) px-2 py-0.5 font-mono text-[0.625rem] text-(--color-fg-muted)">
                  {statusLabels[project.data.status as keyof typeof statusLabels]}
                </span>
              </div>
              <div class="p-5">
                <Text variant="h3" as="h2" class="mb-2">
                  {project.data.title}
                </Text>
                <Text variant="body" tone="muted" class="mb-4">
                  {project.data.summary}
                </Text>
                {project.data.techStack.length > 0 && (
                  <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
                    {project.data.techStack.slice(0, 4).map((tech: string) => (
                      <li class="rounded bg-(--color-surface-2) px-2 py-0.5 text-xs text-(--color-fg-muted)">
                        {tech}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
