---
/**
 * ArticleLayout — wraps BaseLayout with blog-post structure.
 *
 * - Auto-supplies BlogPosting + BreadcrumbList JSON-LD from the entry
 * - Hero image with eager loading + preload
 * - Title + author + date byline + reading time + tag links
 * - In-page table of contents from the article's headings
 * - Prose container for the slot (MDX content)
 * - Related posts + previous/next navigation in the footer
 */

import { getRelativeLocaleUrl } from 'astro:i18n';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

import type { Thing } from 'schema-dts';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import { blogPostingSchema, breadcrumbListSchema, personSchema } from '@/lib/jsonld';
import { readingTimeMinutes } from '@/lib/reading-time';
import { tagSlug } from '@/lib/blog';

import BaseLayout from './BaseLayout.astro';
import Text from '@/components/ui/text.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import PostNav from '@/components/blog/PostNav.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
  related?: CollectionEntry<'blog'>[];
  headings?: MarkdownHeading[];
}

const { entry, prev, next, related = [], headings = [] } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const minutes = readingTimeMinutes(entry.body);

// entry.id format: `<locale>/<slug>` (e.g. "en/welcome").
const slugSegments = entry.id.split('/');
const slug = slugSegments.slice(1).join('/');

const author = await getEntry(entry.data.author);
const authorBio = author?.data.bio[locale] ?? author?.data.bio[siteConfig.defaultLocale] ?? '';

const url = `/blog/${slug}`;

// Posts no longer ship a hero image; OG falls back to a per-post ogImage when
// set, otherwise the site-wide default banner.
const defaultOg =
  typeof siteConfig.defaultOgImage === 'string'
    ? siteConfig.defaultOgImage
    : (siteConfig.defaultOgImage[locale] ?? siteConfig.defaultOgImage[siteConfig.defaultLocale]);

const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: t('nav.blog'), url: '/blog' },
  { name: entry.data.title, url },
];

const schemas: Thing[] = [
  breadcrumbListSchema(crumbs),
  blogPostingSchema({
    url,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.datePublished,
    dateModified: entry.data.dateModified,
    authorSlug: entry.data.author.id,
    image: entry.data.ogImage?.src ?? defaultOg,
    keywords: entry.data.tags,
    inLanguage: locale,
  }),
];

if (author) {
  schemas.push(
    personSchema(
      {
        slug: author.id,
        name: author.data.name,
        bio: authorBio,
        image: author.data.image.src,
        url: author.data.url,
        email: author.data.email,
        social: author.data.social,
      },
      locale
    )
  );
}

const dateFmt = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.ogImage}
  type="article"
  noindex={entry.data.noindex}
  schemas={schemas}
  preloadImages={entry.data.ogImage ? [entry.data.ogImage] : []}
>
  <article class="mx-auto max-w-[48rem] px-5 pt-8 pb-16">
    <header class="mb-10">
      <nav class="mb-6 text-sm" aria-label={t('nav.breadcrumbs')}>
        <a
          href={getRelativeLocaleUrl(locale, '/blog')}
          class="text-(--color-fg-muted) no-underline hover:text-(--color-fg)"
        >
          ← {t('blog.backToBlog')}
        </a>
      </nav>
      <Text variant="h1" class="mb-4">{entry.data.title}</Text>
      <Text variant="muted" class="mb-4 flex flex-wrap items-center gap-2">
        {
          author && (
            <>
              <span>
                {t('blog.byAuthor')} {author.data.name}
              </span>
              <span aria-hidden="true">·</span>
            </>
          )
        }
        <time datetime={entry.data.datePublished.toISOString()}>
          {dateFmt.format(entry.data.datePublished)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{t('blog.readingTime', { minutes })}</span>
      </Text>
      {
        entry.data.tags.length > 0 && (
          <ul class="m-0 mb-8 flex list-none flex-wrap gap-2 p-0" aria-label={t('blog.tagsLabel')}>
            {entry.data.tags.map((tag: string) => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, `/blog/tags/${tagSlug(tag)}`)}
                  class="inline-block rounded bg-(--color-surface-2) px-2 py-0.5 text-[0.8125rem] text-(--color-fg-muted) no-underline transition-colors duration-150 ease-(--ease-out-soft) hover:text-(--color-fg)"
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <div
        class="relative aspect-[1200/420] overflow-hidden rounded-xl border border-(--color-border) bg-[radial-gradient(ellipse_80%_120%_at_30%_30%,var(--color-surface-2),var(--color-bg))]"
        aria-hidden="true"
      >
        <span
          class="pointer-events-none absolute right-6 bottom-4 font-mono text-6xl font-medium text-(--color-fg) opacity-[0.07] select-none"
          >&gt;_</span
        >
      </div>
    </header>

    <TableOfContents headings={headings} />

    <div class="prose">
      <slot />
    </div>

    <PostNav prev={prev} next={next} />

    <RelatedPosts posts={related} />
  </article>
</BaseLayout>
