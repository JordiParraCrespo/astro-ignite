{
  "name": "@astro-ignite/registry",
  "version": "0.1.0",
  "private": true,
  "description": "Source registry for astro-ignite base components. Pre-installed in the templates and shadcn-consumable via the @astro-ignite namespace.",
  "type": "module",
  "scripts": {
    "build:registry": "node ./scripts/build-registry.mjs",
    "test": "vitest run",
    "lint": "eslint base lib",
    "lint:fix": "eslint base lib --fix",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "base",
    "blocks",
    "lib",
    "registry.json"
  ],
  "exports": {
    "./registry.json": "./registry.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-better-tailwindcss": "4.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
