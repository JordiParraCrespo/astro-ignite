{
  "name": "@astro-ignite/registry",
  "version": "0.1.0",
  "private": true,
  "description": "Source registry for astro-ignite base components and blocks. Consumed by create-astro-ignite at scaffold/add time.",
  "type": "module",
  "files": [
    "base",
    "blocks",
    "lib",
    "registry.json"
  ],
  "exports": {
    "./registry.json": "./registry.json"
  },
  "scripts": {
    "lint": "eslint base lib",
    "lint:fix": "eslint base lib --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-better-tailwindcss": "4.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
