---
import { cn } from '@/lib/cn';

export type Props = {
  content: string;
  side?: 'top' | 'bottom';
  class?: string;
};

const { content, side = 'top', class: className } = Astro.props;

const sidePos = side === 'top' ? 'bottom-[calc(100%+6px)]' : 'top-[calc(100%+6px)]';
---

<span class={cn('group relative inline-flex', className)}>
  <slot />
  <span
    role="tooltip"
    class={cn(
      'pointer-events-none absolute left-1/2 -translate-x-1/2 scale-[0.96] opacity-0 transition-[opacity,transform] duration-150 ease-out z-50 bg-fg text-bg text-xs leading-tight px-2 py-1.5 rounded-sm whitespace-nowrap group-hover:opacity-100 group-hover:scale-100 group-focus-within:opacity-100 group-focus-within:scale-100',
      sidePos
    )}
  >
    {content}
  </span>
</span>
