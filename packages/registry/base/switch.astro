---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'input'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<label
  class={cn(
    'relative inline-flex items-center align-middle cursor-pointer has-[:disabled]:opacity-50 has-[:disabled]:cursor-not-allowed',
    className
  )}
>
  <input type="checkbox" role="switch" class="peer sr-only" {...rest} />
  <span
    class="w-9 h-5 rounded-full bg-surface-2 border border-border transition-colors duration-150 peer-checked:bg-primary peer-checked:border-primary peer-focus-visible:[box-shadow:0_0_0_2px_var(--color-bg),0_0_0_4px_var(--color-ring)]"
  ></span>
  <span
    class="pointer-events-none absolute top-0.5 left-0.5 size-4 rounded-full bg-fg transition-transform duration-150 peer-checked:translate-x-4 peer-checked:bg-primary-fg"
  ></span>
</label>
