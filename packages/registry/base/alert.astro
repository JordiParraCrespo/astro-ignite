---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'destructive' | 'warning' | 'success';

export type Props = HTMLAttributes<'div'> & {
  variant?: Variant;
  class?: string;
};

const { variant = 'default', class: className, ...rest } = Astro.props;

const boxByVariant: Record<Variant, string> = {
  default: 'border-border bg-surface-2',
  destructive:
    'border-[color-mix(in_oklch,var(--color-danger)_35%,transparent)] bg-[color-mix(in_oklch,var(--color-danger)_7%,transparent)]',
  warning:
    'border-[color-mix(in_oklch,var(--color-warning)_38%,transparent)] bg-[color-mix(in_oklch,var(--color-warning)_9%,transparent)]',
  success:
    'border-[color-mix(in_oklch,var(--color-success)_32%,transparent)] bg-[color-mix(in_oklch,var(--color-success)_8%,transparent)]',
};

const accentByVariant: Record<Variant, string> = {
  default: 'text-fg',
  destructive: 'text-danger',
  warning: 'text-warning',
  success: 'text-success',
};

const hasIcon = Astro.slots.has('icon');
---

<div
  role="alert"
  class={cn(
    'grid items-start gap-y-1 rounded-lg border px-4 py-3 text-sm text-fg',
    hasIcon ? 'grid-cols-[1.125rem_1fr] gap-x-3' : 'grid-cols-[0_1fr]',
    boxByVariant[variant],
    className
  )}
  {...rest}
>
  {
    hasIcon && (
      <div
        class={cn(
          'grid size-[18px] translate-y-px place-items-center rounded-full border-[1.5px] border-current font-mono text-[11px] leading-none font-semibold',
          accentByVariant[variant]
        )}
      >
        <slot name="icon" />
      </div>
    )
  }
  {
    Astro.slots.has('title') && (
      <div
        class={cn(
          'col-start-2 min-h-4 leading-tight font-medium tracking-tight',
          accentByVariant[variant]
        )}
      >
        <slot name="title" />
      </div>
    )
  }
  <div class="col-start-2 leading-relaxed text-fg-muted"><slot /></div>
</div>
