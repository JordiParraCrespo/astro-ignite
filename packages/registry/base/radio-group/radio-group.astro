---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'fieldset'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<fieldset class={cn('flex flex-col gap-2 m-0 p-0 min-w-0 border-0', className)} {...rest}>
  <slot />
</fieldset>
