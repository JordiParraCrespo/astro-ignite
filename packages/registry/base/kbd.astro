---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'kbd'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<kbd
  class={cn(
    'inline-flex h-[22px] min-w-[22px] items-center justify-center rounded-sm border border-b-2 border-border bg-surface-2 px-1.5 font-mono text-[11px] leading-none whitespace-nowrap text-fg',
    className
  )}
  {...rest}
>
  <slot />
</kbd>
