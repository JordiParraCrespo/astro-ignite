---
import { cn } from '@/lib/cn';

export type Props = {
  id: string;
  align?: 'start' | 'end';
  class?: string;
};

const { id, align = 'start', class: className } = Astro.props;
---

<div id={id} popover="auto" class={cn('menu', `menu--${align}`, className)}>
  <slot />
</div>

<style>
  .menu {
    position: absolute;
    margin: 4px 0 0;
    padding: 4px;
    min-width: 180px;
    background: var(--color-surface);
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.3),
      0 2px 4px -2px rgb(0 0 0 / 0.2);
    inset: auto;
    position-anchor: --anchor;
    position-area: bottom span-right;
  }
  .menu--end {
    position-area: bottom span-left;
  }
  .menu:not(:popover-open) {
    display: none;
  }
</style>
