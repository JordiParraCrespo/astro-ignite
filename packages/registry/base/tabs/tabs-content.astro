---
import { cn } from '@/lib/cn';

export type Props = {
  value: string;
  class?: string;
};

const { value, class: className } = Astro.props;
---

<div
  role="tabpanel"
  data-tab-panel
  data-value={value}
  hidden
  class={cn(
    'pt-4 focus-visible:rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring',
    className
  )}
>
  <slot />
</div>
