---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'div'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<div
  class={cn('animate-pulse rounded-md bg-surface-2 motion-reduce:animate-none', className)}
  aria-hidden="true"
  {...rest}
>
</div>
