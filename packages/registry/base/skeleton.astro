---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'div'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<div
  class={cn(
    'bg-surface-2 rounded-md animate-pulse motion-reduce:animate-none',
    className,
  )}
  aria-hidden="true"
  {...rest}
></div>
