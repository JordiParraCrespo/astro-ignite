---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type AsLink = { href: string } & HTMLAttributes<'a'>;
type AsSpan = { href?: undefined } & HTMLAttributes<'span'>;

export type Props = (AsLink | AsSpan) & {
  label: string;
  detail?: string;
  pulse?: boolean;
  class?: string;
};

const { href, label, detail, pulse = true, class: className, ...rest } = Astro.props;

const base =
  'mono inline-flex items-center gap-2 px-2.5 py-1 border border-border rounded-full bg-surface-2 text-fg-muted text-xs leading-none no-underline whitespace-nowrap transition-colors duration-150';
const linkHover = 'hover:border-border-strong hover:text-fg';

const dotBase = 'w-1.5 h-1.5 rounded-full bg-fg shrink-0';
const dotPulse = pulse
  ? 'animate-pulse motion-reduce:animate-none'
  : '';
---

{
  href ? (
    <a href={href} class={cn(base, linkHover, className)} {...(rest as HTMLAttributes<'a'>)}>
      <span class={cn(dotBase, dotPulse)} aria-hidden="true" />
      <span>{label}</span>
      {detail && (
        <>
          <span class="text-border-strong" aria-hidden="true">
            |
          </span>
          <span>{detail}</span>
        </>
      )}
    </a>
  ) : (
    <span class={cn(base, className)} {...(rest as HTMLAttributes<'span'>)}>
      <span class={cn(dotBase, dotPulse)} aria-hidden="true" />
      <span>{label}</span>
      {detail && (
        <>
          <span class="text-border-strong" aria-hidden="true">
            |
          </span>
          <span>{detail}</span>
        </>
      )}
    </span>
  )
}
