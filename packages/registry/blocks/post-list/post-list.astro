---
import { cn } from '@/lib/cn';

export type Props = { class?: string };
const { class: className } = Astro.props;
---

<div class={cn('post-list', className)}>
  <slot />
</div>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
    max-width: 720px;
    margin-inline: auto;
  }
</style>
