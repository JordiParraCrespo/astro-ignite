---
import { cn } from '@/lib/cn';

export type Props = {
  command: string;
  prompt?: string;
  copy?: boolean;
  class?: string;
};

const { command, prompt = '$', copy = true, class: className } = Astro.props;
---

<div
  class={cn(
    'mono inline-flex items-center gap-3 pr-2 pl-3.5 py-2 border border-border rounded-md bg-[color-mix(in_oklch,var(--color-surface-2)_50%,transparent)] text-[13px] text-fg max-w-full w-fit',
    className,
  )}
  data-command={command}
>
  <span class="inline-flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap">
    <span class="text-fg-subtle" aria-hidden="true">{prompt}</span>
    <span>{command}</span>
  </span>
  {
    copy && (
      <button
        type="button"
        data-command-copy
        aria-label="Copy command"
        class="appearance-none border-0 py-1 px-2 rounded-sm bg-border text-fg-muted text-[11px] cursor-pointer shrink-0 transition-[background-color,color] duration-150 hover:bg-border-strong hover:text-fg data-[copied=true]:[&>.cmd-label]:text-success"
      >
        <span class="cmd-label">Copy</span>
      </button>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-command]').forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>('[data-command-copy]');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const cmd = el.dataset.command ?? '';
      try {
        await navigator.clipboard.writeText(cmd);
        btn.dataset.copied = 'true';
        const label = btn.querySelector('.cmd-label');
        const prev = label?.textContent ?? 'Copy';
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
          btn.dataset.copied = 'false';
          if (label) label.textContent = prev;
        }, 1500);
      } catch {
        // Clipboard blocked — silently fail.
      }
    });
  });
</script>
