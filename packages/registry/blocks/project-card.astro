---
import { cn } from '@/lib/cn';

export type ProjectStatus = 'shipped' | 'in-progress' | 'archived' | string;

export type Props = {
  href?: string;
  title: string;
  description?: string;
  status?: ProjectStatus;
  cover?: string;
  tags?: string[];
  class?: string;
};

const { href, title, description, status, cover, tags = [], class: className } = Astro.props;

const Wrapper = href ? 'a' : 'div';

const coverGradient =
  'bg-[linear-gradient(135deg,var(--color-border)_25%,var(--color-surface-2)_25%,var(--color-surface-2)_50%,var(--color-border)_50%,var(--color-border)_75%,var(--color-surface-2)_75%)] bg-[length:18px_18px]';
---

<Wrapper
  class={cn(
    'border border-border rounded-lg overflow-hidden bg-[color-mix(in_oklch,var(--color-surface-2)_30%,transparent)] flex flex-col no-underline text-inherit',
    href &&
      'transition-[border-color,transform] duration-150 hover:border-border-strong',
    className,
  )}
  href={href}
>
  <div
    class={cn(
      'aspect-[16/9] border-b border-border relative overflow-hidden',
      coverGradient,
    )}
  >
    {cover && <img src={cover} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover block" />}
    {
      status && (
        <span class="mono absolute top-2.5 left-2.5 text-[10px] py-[3px] px-[7px] rounded-full bg-[color-mix(in_oklch,var(--color-bg)_80%,transparent)] text-fg border border-border-strong backdrop-blur-[4px]">
          {status}
        </span>
      )
    }
  </div>
  <div class="py-3.5 px-4 flex flex-col gap-2">
    <h3 class="m-0 text-[17px] font-medium tracking-[-0.02em] text-fg">{title}</h3>
    {description && (
      <p class="m-0 text-[12.5px] text-fg-subtle leading-[1.5]">{description}</p>
    )}
    {
      tags.length > 0 && (
        <div class="flex gap-[5px] flex-wrap mt-0.5">
          {tags.map((t) => (
            <span class="mono inline-flex items-center text-[11px] py-0.5 px-[7px] rounded-full border border-border text-fg-muted bg-transparent">
              {t}
            </span>
          ))}
        </div>
      )
    }
  </div>
</Wrapper>
