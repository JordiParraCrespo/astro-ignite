---
import { cn } from '@/lib/cn';

export type ProjectStatus = 'shipped' | 'in-progress' | 'archived' | string;

export type Props = {
  href?: string;
  title: string;
  description?: string;
  status?: ProjectStatus;
  cover?: string;
  tags?: string[];
  class?: string;
};

const { href, title, description, status, cover, tags = [], class: className } = Astro.props;

const Wrapper = href ? 'a' : 'div';
---

<Wrapper class={cn('project-card', href && 'project-card--link', className)} href={href}>
  <div class="project-card__cover">
    {cover && <img src={cover} alt="" loading="lazy" decoding="async" />}
    {status && <span class="project-card__status mono">{status}</span>}
  </div>
  <div class="project-card__meta">
    <h3 class="project-card__title">{title}</h3>
    {description && <p class="project-card__desc">{description}</p>}
    {
      tags.length > 0 && (
        <div class="project-card__chips">
          {tags.map((t) => (
            <span class="project-card__chip mono">{t}</span>
          ))}
        </div>
      )
    }
  </div>
</Wrapper>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: color-mix(in oklch, var(--color-surface-2) 30%, transparent);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .project-card--link {
    transition:
      border-color 120ms ease,
      transform 120ms ease;
  }
  .project-card--link:hover {
    border-color: var(--color-border-strong);
  }
  .project-card__cover {
    aspect-ratio: 16 / 9;
    background: linear-gradient(
      135deg,
      var(--color-border) 25%,
      var(--color-surface-2) 25%,
      var(--color-surface-2) 50%,
      var(--color-border) 50%,
      var(--color-border) 75%,
      var(--color-surface-2) 75%
    );
    background-size: 18px 18px;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }
  .project-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .project-card__status {
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 10px;
    padding: 3px 7px;
    border-radius: 999px;
    background: color-mix(in oklch, var(--color-bg) 80%, transparent);
    color: var(--color-fg);
    border: 1px solid var(--color-border-strong);
    backdrop-filter: blur(4px);
  }
  .project-card__meta {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .project-card__title {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-fg);
  }
  .project-card__desc {
    margin: 0;
    font-size: 12.5px;
    color: var(--color-fg-subtle);
    line-height: 1.5;
  }
  .project-card__chips {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin-top: 2px;
  }
  .project-card__chip {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    background: transparent;
  }
</style>
