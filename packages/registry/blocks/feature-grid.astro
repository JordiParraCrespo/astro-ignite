---
import { cn } from '@/lib/cn';

export type Feature = {
  index?: string;
  tag?: string;
  title: string;
  body: string;
};

export type Props = {
  features: Feature[];
  columns?: 2 | 3;
  class?: string;
};

const { features, columns = 3, class: className } = Astro.props;

const gridCols =
  columns === 2
    ? 'md:grid-cols-2 [&>*:nth-child(2n)]:md:border-r-0'
    : 'md:grid-cols-3 [&>*:nth-child(3n)]:md:border-r-0';
---

<div
  class={cn(
    'grid grid-cols-1 border border-border rounded-lg overflow-hidden',
    gridCols,
    className
  )}
>
  {
    features.map((f, i) => (
      <div class="flex flex-col gap-2 px-5 py-4 border-b border-border md:border-r md:border-r-border max-md:border-r-0">
        {(f.index || f.tag) && (
          <div class="flex items-center gap-2.5">
            {f.index !== undefined && (
              <span class="mono text-[10px] text-fg-muted border border-border px-1.5 py-px rounded-[3px]">
                {f.index || String(i + 1).padStart(2, '0')}
              </span>
            )}
            {f.tag && (
              <span class="mono text-[10px] text-fg-subtle tracking-[0.08em] uppercase">
                {f.tag}
              </span>
            )}
          </div>
        )}
        <h4 class="mt-0.5 mb-0 text-sm font-medium tracking-[-0.02em] text-fg">{f.title}</h4>
        <p class="m-0 text-xs leading-[1.55] text-fg-subtle">{f.body}</p>
      </div>
    ))
  }
</div>
