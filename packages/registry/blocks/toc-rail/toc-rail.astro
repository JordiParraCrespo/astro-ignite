---
import { cn } from '@/lib/cn';

export type TocEntry = {
  id: string;
  label: string;
  depth?: number;
};

export type Props = {
  entries: TocEntry[];
  title?: string;
  class?: string;
};

const { entries, title = 'On this page', class: className } = Astro.props;
---

<aside
  aria-label={title}
  class={cn(
    'sticky top-4 self-start p-3.5 border border-border rounded-lg flex flex-col gap-1',
    className
  )}
>
  <span class="mono text-[10px] text-fg-subtle tracking-[0.12em] uppercase mb-1">
    {title}
  </span>
  <nav>
    <ul class="list-none m-0 p-0 flex flex-col gap-0.5">
      {
        entries.map((entry) => (
          <li>
            <a
              href={`#${entry.id}`}
              data-toc-link
              data-target={entry.id}
              class={cn(
                'block text-xs text-fg-subtle py-[3px] pr-0 border-l-2 border-transparent no-underline transition-[color,border-color] duration-150 hover:text-fg aria-[current=true]:text-fg aria-[current=true]:border-l-fg aria-[current=true]:font-medium',
                entry.depth && entry.depth > 2 ? 'pl-5' : 'pl-2.5'
              )}
            >
              {entry.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const idToLink = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => idToLink.set(l.dataset.target!, l));
    const targets = Array.from(idToLink.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);

    const setCurrent = (id: string | null) => {
      links.forEach((l) => {
        if (l.dataset.target === id) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setCurrent(visible[0].target.id);
      },
      { rootMargin: '0% 0% -70% 0%', threshold: 0 }
    );

    targets.forEach((t) => observer.observe(t));
  }
</script>
