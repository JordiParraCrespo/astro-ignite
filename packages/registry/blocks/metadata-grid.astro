---
import { cn } from '@/lib/cn';

export type MetadataItem = {
  label: string;
  value: string;
};

export type Props = {
  items: MetadataItem[];
  columns?: 2 | 3 | 4;
  class?: string;
};

const { items, columns = 4, class: className } = Astro.props;

const cols: Record<NonNullable<Props['columns']>, string> = {
  2: 'sm:grid-cols-2 [&>*:nth-child(2n)]:sm:border-r-0',
  3: 'grid-cols-2 sm:grid-cols-3 [&>*:nth-child(3n)]:sm:border-r-0',
  4: 'grid-cols-2 sm:grid-cols-4 [&>*:nth-child(4n)]:sm:border-r-0',
};
---

<dl
  class={cn('grid border border-border rounded-md overflow-hidden m-0', cols[columns], className)}
>
  {
    items.map((item) => (
      <div class="py-3.5 px-4 border-b border-border sm:border-b-0 sm:border-r sm:border-r-border last:border-r-0 last:border-b-0">
        <dt class="mono text-[10px] text-fg-subtle tracking-[0.1em] uppercase m-0">{item.label}</dt>
        <dd class="mt-1 mb-0 ml-0 text-sm font-medium text-fg">{item.value}</dd>
      </div>
    ))
  }
</dl>
