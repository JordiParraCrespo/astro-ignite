---
/**
 * CodeGroup — combines several <CodeBlock> children into one tabbed panel.
 * Each child's `filename` becomes a tab label (the npm/pnpm/yarn pattern, or
 * curl/python/node for an API). The custom element synthesizes the tab strip
 * and a single copy button, then shows one block at a time. The active tab
 * persists via localStorage and syncs every group on the page, so picking
 * `pnpm` once holds across snippets and visits.
 *
 * Usage in MDX:
 *   <CodeGroup>
 *     <CodeBlock filename="npm" prompt>{`npm i astro-ignite`}</CodeBlock>
 *     <CodeBlock filename="pnpm" prompt>{`pnpm add astro-ignite`}</CodeBlock>
 *   </CodeGroup>
 */

import { cn } from '@/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ai-code-group
  class={cn(
    'code-group my-6 block overflow-hidden rounded-(--radius-md) border border-(--color-border) bg-(--color-surface) [&_.code-block]:m-0 [&_.code-block]:rounded-none [&_.code-block]:border-0 [&_.code-block]:bg-transparent [&_.code-block>pre]:m-0! [&_.code-block>pre]:rounded-none! [&_.code-block>pre]:border-0! [&_.code-block>pre]:bg-transparent! [&_.code-block>pre]:px-5! [&_.code-block>pre]:py-[18px]! [&_.code-block>pre]:leading-normal! [&_[data-cb-header]]:hidden',
    className
  )}
>
  <slot />
</ai-code-group>

<script>
  const STORAGE_KEY = 'code-group-tab';

  if (!customElements.get('ai-code-group')) {
    class AiCodeGroup extends HTMLElement {
      activateByName: ((name: string) => void) | undefined;

      connectedCallback() {
        const blocks = Array.from(this.querySelectorAll<HTMLElement>(':scope > .code-block'));
        if (blocks.length === 0) return;

        const tabs = document.createElement('div');
        tabs.className = 'flex border-b border-border bg-surface-2';
        tabs.setAttribute('role', 'tablist');

        const buttons: HTMLButtonElement[] = [];

        const activate = (idx: number) => {
          blocks.forEach((b, i) => {
            b.hidden = i !== idx;
          });
          buttons.forEach((b, i) => {
            const on = i === idx;
            b.dataset.active = on ? 'true' : 'false';
            b.setAttribute('aria-selected', on ? 'true' : 'false');
            b.tabIndex = on ? 0 : -1;
          });
        };

        const names = blocks.map((b, i) => b.dataset.filename || `tab ${i + 1}`);

        const select = (idx: number) => {
          activate(idx);
          localStorage.setItem(STORAGE_KEY, names[idx]!);
          window.dispatchEvent(new CustomEvent('code-group:change', { detail: names[idx] }));
        };

        this.activateByName = (name: string) => {
          const idx = names.indexOf(name);
          if (idx >= 0) activate(idx);
        };

        names.forEach((name, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            '-mb-px cursor-pointer appearance-none border-0 border-b-[1.5px] border-solid border-transparent bg-transparent px-[18px] py-2.5 font-mono text-xs text-fg-muted transition-colors duration-100 hover:text-fg data-[active=true]:border-fg data-[active=true]:font-medium data-[active=true]:text-fg';
          btn.setAttribute('role', 'tab');
          btn.textContent = name;
          btn.addEventListener('click', () => select(i));
          btn.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + blocks.length) % blocks.length;
            buttons[next]!.focus();
            select(next);
          });
          buttons.push(btn);
          tabs.appendChild(btn);
        });

        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className =
          'ml-auto inline-flex cursor-pointer appearance-none items-center gap-1.5 border-0 bg-transparent px-3.5 font-mono text-[11px] text-fg-muted transition-colors duration-100 hover:text-fg';
        copy.innerHTML =
          '<svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span data-copy-label>Copy</span>';
        const copyLabel = copy.querySelector('[data-copy-label]')!;
        copy.addEventListener('click', async () => {
          const active = blocks.find((b) => !b.hidden);
          const pre = active?.querySelector('pre');
          if (!pre || !navigator.clipboard) return;
          try {
            await navigator.clipboard.writeText(pre.textContent ?? '');
            copyLabel.textContent = 'Copied';
            setTimeout(() => {
              copyLabel.textContent = 'Copy';
            }, 1200);
          } catch {
            // Permissions denied — silently fail.
          }
        });
        tabs.appendChild(copy);

        this.prepend(tabs);

        const stored = localStorage.getItem(STORAGE_KEY);
        const storedIdx = stored ? names.indexOf(stored) : -1;
        activate(storedIdx >= 0 ? storedIdx : 0);

        window.addEventListener('code-group:change', (e) => {
          this.activateByName?.((e as CustomEvent<string>).detail);
        });
      }
    }
    customElements.define('ai-code-group', AiCodeGroup);
  }
</script>
