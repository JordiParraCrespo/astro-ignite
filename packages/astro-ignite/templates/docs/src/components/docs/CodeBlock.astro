---
/**
 * Code block with copy button.
 *
 * For MDX use, prefer this over raw ```fenced``` when you want the copy
 * affordance. Astro's built-in syntax highlighting via Shiki still applies
 * inside the <pre> if you pass the highlighted output as the slot.
 *
 * Usage:
 *   <CodeBlock filename="terminal" language="bash">
 *     {`$ npm create astro-ignite@latest`}
 *   </CodeBlock>
 */

interface Props {
  filename?: string;
  language?: string;
}

const { filename, language } = Astro.props;
---

<div
  class="code-block my-6 overflow-hidden rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface-2)]"
>
  <div
    class="flex items-center gap-2.5 border-b border-[var(--color-border)] px-3.5 py-2 text-[11px] text-[var(--color-fg-muted)]"
  >
    <span class="mono flex-1">{filename ?? 'snippet'}</span>
    {language && <span class="mono text-[var(--color-fg-subtle)]">{language}</span>}
    <button
      type="button"
      class="mono cursor-pointer appearance-none rounded-[var(--radius-sm)] border-0 bg-transparent px-1.5 py-0.5 text-[11px] text-[var(--color-fg-muted)] transition-colors duration-100 hover:bg-[var(--color-surface)] hover:text-[var(--color-fg)]"
      data-copy-source
    >
      copy
    </button>
  </div>
  <pre
    class="mono m-0 overflow-x-auto px-4 py-3.5 text-[13px] leading-[1.65] text-[var(--color-fg)]"><code class="bg-transparent p-0 font-mono"><slot /></code></pre>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.code-block [data-copy-source]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const block = btn.closest('.code-block');
      const pre = block?.querySelector('pre');
      if (!pre || !navigator.clipboard) return;
      const text = pre.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = 'copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1200);
      } catch {
        // Permissions denied — silently fail.
      }
    });
  });
</script>
