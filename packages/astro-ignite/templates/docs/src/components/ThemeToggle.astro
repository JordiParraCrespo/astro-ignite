---
/**
 * Theme toggle — binary light/dark switch.
 *
 * Single Contrast icon (lucide-style: half-filled circle) as the button.
 * Click flips between light and dark; the choice persists in localStorage.
 *
 * The anti-flash inline script in BaseLayout still falls back to system
 * preference when localStorage is empty (first visit). Once the user clicks
 * the toggle they commit to an explicit value.
 */

import { useTranslations } from '@/i18n';

const locale = Astro.currentLocale;
const t = useTranslations(locale);
---

<button class="theme-toggle" type="button" aria-label={t('theme.label')} title={t('theme.label')}>
  <svg
    class="icon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M12 18a6 6 0 0 0 0-12v12z" fill="currentColor"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    const root = document.documentElement;
    btn.addEventListener('click', () => {
      const isLight = root.classList.toggle('light');
      const next = isLight ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      root.dataset.theme = next;
    });
  })();
</script>

<style>
  .theme-toggle {
    appearance: none;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.5rem;
    color: var(--color-fg-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      color 0.15s var(--ease-out-soft),
      background-color 0.15s var(--ease-out-soft);
  }
  .theme-toggle:hover {
    color: var(--color-fg);
    background: var(--color-surface-2);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-ring, var(--color-fg));
    outline-offset: 2px;
  }
  .theme-toggle .icon {
    width: 1.125rem;
    height: 1.125rem;
    display: block;
    transition: transform 200ms var(--ease-out-soft);
  }
  /* Flip the filled half when light theme is active so the icon visually
     mirrors the current state. */
  :global(html.light) .theme-toggle .icon {
    transform: rotate(180deg);
  }
</style>
