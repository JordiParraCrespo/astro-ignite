---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'fieldset'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<fieldset class={cn('m-0 flex min-w-0 flex-col gap-2 border-0 p-0', className)} {...rest}>
  <slot />
</fieldset>
