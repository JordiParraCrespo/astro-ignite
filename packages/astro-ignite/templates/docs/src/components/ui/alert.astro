---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'destructive' | 'warning' | 'success';

export type Props = HTMLAttributes<'div'> & {
  variant?: Variant;
  class?: string;
};

const { variant = 'default', class: className, ...rest } = Astro.props;

const borderByVariant: Record<Variant, string> = {
  default: 'border-border',
  destructive: 'border-[color-mix(in_oklch,var(--color-danger)_50%,var(--color-border))]',
  warning: 'border-[color-mix(in_oklch,var(--color-warning)_50%,var(--color-border))]',
  success: 'border-[color-mix(in_oklch,var(--color-success)_50%,var(--color-border))]',
};

const accentByVariant: Record<Variant, string> = {
  default: 'text-fg-muted',
  destructive: 'text-danger',
  warning: 'text-warning',
  success: 'text-success',
};
---

<div
  role="alert"
  class={cn(
    'flex gap-3 rounded-md border bg-surface-2 px-4 py-3.5 text-fg',
    borderByVariant[variant],
    className
  )}
  {...rest}
>
  {
    Astro.slots.has('icon') && (
      <div
        class={cn(
          'grid h-[18px] w-[18px] shrink-0 place-items-center rounded-full border-[1.5px] border-current font-mono text-[11px] leading-none font-semibold',
          accentByVariant[variant]
        )}
      >
        <slot name="icon" />
      </div>
    )
  }
  <div class="flex min-w-0 flex-1 flex-col gap-1">
    {
      Astro.slots.has('title') && (
        <div
          class={cn(
            'text-sm leading-tight font-semibold',
            variant !== 'default' && accentByVariant[variant]
          )}
        >
          <slot name="title" />
        </div>
      )
    }
    <div class="text-[13px] leading-normal text-fg-muted"><slot /></div>
  </div>
</div>
