---
/**
 * Brand mark — the cursor `>_` lockup.
 *
 * Sourced from the Claude Design handoff (Mark A).
 * - Geist Mono `>` glyph + a solid caret block (blinking via `.caret`)
 * - Optional `astro-ignite` wordmark in Geist Sans (always lowercase)
 * - All sizing scales with the `size` prop (1 = display sizes from the spec)
 *
 * Variants:
 *   <Brand variant="lockup" />   default — mark + wordmark side by side
 *   <Brand variant="mark" />     just `>_` (favicon, small icon contexts)
 *   <Brand variant="word" />     just the wordmark (footer, dense places)
 */

interface Props {
  variant?: 'lockup' | 'mark' | 'word';
  /** Multiplier for all spec sizes. 1 = display (56pt mono / 40pt sans). */
  size?: number;
  /** Optional href; renders as a link (used by Nav). */
  href?: string;
  /** Aria label override; defaults to "astro-ignite". */
  label?: string;
  class?: string;
}

const {
  variant = 'lockup',
  size = 1,
  href,
  label = 'astro-ignite',
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'span';

// Spec sizes (all in pt/px, scaled by size prop)
const monoSize = 56 * size;
const sansSize = 40 * size;
const gap = 14 * size;
const caretWidth = 22 * size;
const caretHeight = 6 * size;
const caretLift = 4 * size;
const caretMargin = 4 * size;

const wrapperBase =
  'inline-flex items-center text-[var(--color-fg)] no-underline leading-none tracking-[-0.04em]';
const wrapperGap = variant === 'lockup' ? 'gap-[var(--ig-gap)]' : 'gap-0';
---

<Tag
  class:list={[wrapperBase, wrapperGap, 'ig-brand', className]}
  href={href}
  aria-label={href ? label : undefined}
  style={`
    --ig-mono-size: ${monoSize}px;
    --ig-sans-size: ${sansSize}px;
    --ig-gap: ${gap}px;
    --ig-caret-w: ${caretWidth}px;
    --ig-caret-h: ${caretHeight}px;
    --ig-caret-lift: ${caretLift}px;
    --ig-caret-margin: ${caretMargin}px;
  `}
>
  {
    variant !== 'word' && (
      <span
        class="mono inline-flex items-baseline text-(length:--ig-mono-size) leading-none font-medium text-(--color-fg)"
        aria-hidden={variant === 'lockup' ? 'true' : undefined}
      >
        <span class="inline-block">{'>'}</span>
        <span
          class="ig-caret caret ml-(--ig-caret-margin) inline-block h-(--ig-caret-h) w-(--ig-caret-w) bg-(--color-fg)"
          style={`transform: translateY(calc(var(--ig-caret-lift) * -1));`}
        />
      </span>
    )
  }
  {
    variant !== 'mark' && (
      <span class="text-(length:--ig-sans-size) font-medium tracking-[-0.04em] text-(--color-fg) lowercase">
        astro-ignite
      </span>
    )
  }
</Tag>

<style>
  /* Why kept: hover-driven descendant style (a:hover .ig-caret) cannot be
     expressed with Tailwind utilities alone — group-hover would need an
     additional wrapper element. */
  a.ig-brand:hover .ig-caret {
    background: var(--color-primary);
  }
</style>
