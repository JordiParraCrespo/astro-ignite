---
/**
 * Locale switcher — `<details>` dropdown listing all configured locales.
 *
 * If the site is monolingual (single locale), this component renders nothing.
 * Each link points to the equivalent path in the target locale via
 * getRelativeLocaleUrl.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';

const currentLocale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(currentLocale);

// Strip the current locale prefix from the path so we can rebuild it per target locale.
let path = Astro.url.pathname;
const segments = path.split('/').filter(Boolean);
if (segments[0] && siteConfig.locales.includes(segments[0])) {
  segments.shift();
}
path = '/' + segments.join('/');

const localeLabels: Record<string, string> = {
  en: 'English',
  es: 'Español',
  fr: 'Français',
  de: 'Deutsch',
  pt: 'Português',
  it: 'Italiano',
  ja: '日本語',
  zh: '中文',
};
---

{
  siteConfig.locales.length > 1 && (
    <details class="locale-switcher relative">
      <summary
        class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-lg p-2 text-sm text-[var(--color-fg-muted)] hover:bg-[var(--color-surface-2)] hover:text-[var(--color-fg)]"
        aria-label={t('locale.switch')}
        title={t('locale.switch')}
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
        <span class="font-medium">{currentLocale.toUpperCase()}</span>
      </summary>
      <ul
        role="menu"
        class="absolute right-0 top-[calc(100%+0.5rem)] z-30 m-0 min-w-[8rem] list-none rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] p-1 shadow-[0_8px_16px_-8px_rgb(0_0_0_/_0.2)]"
      >
        {siteConfig.locales.map((loc) => (
          <li>
            <a
              class="block rounded-md px-2.5 py-2 text-sm text-[var(--color-fg)] no-underline transition-colors duration-100 hover:bg-[var(--color-surface-2)] data-[active]:font-medium data-[active]:text-[var(--color-primary)]"
              href={getRelativeLocaleUrl(loc, path)}
              hreflang={siteConfig.hreflang[loc] ?? loc}
              aria-current={loc === currentLocale ? 'true' : undefined}
              data-active={loc === currentLocale ? '' : null}
            >
              {localeLabels[loc] ?? loc}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<style>
  /* Why kept: `<summary>::-webkit-details-marker` is a vendor pseudo-element
     that Tailwind cannot target. Hiding it keeps the native disclosure
     triangle out of the rendered chrome. */
  .locale-switcher summary::-webkit-details-marker {
    display: none;
  }
</style>
