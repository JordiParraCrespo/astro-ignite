---
import { getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import DocsLayout from '@/layouts/DocsLayout.astro';
import { mdxComponents } from '@/components/docs/mdx-components';
import { siteConfig } from '@/config/site';

export async function getStaticPaths() {
  const homeSlug = siteConfig.homePath.replace(/^\//, '');
  const langs = siteConfig.locales.filter((l) => l !== siteConfig.defaultLocale);
  const entries = await Promise.all(
    langs.map(async (lang) => {
      const entry = await getEntry('docs', `${lang}/${homeSlug}`);
      return entry ? { params: { lang }, props: { entry } } : null;
    })
  );
  return entries.filter(
    (e): e is { params: { lang: string }; props: { entry: CollectionEntry<'docs'> } } => e !== null
  );
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings}>
  <Content components={mdxComponents} />
</DocsLayout>
