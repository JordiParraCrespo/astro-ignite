---
/**
 * Default-locale docs route.
 *
 * Generates pages for docs entries whose id starts with the default locale
 * (e.g. `en/introduction` → `/introduction`). Non-default locales render at
 * `/<locale>/<slug>` via `src/pages/[lang]/[...slug].astro`.
 */

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import DocsLayout from '@/layouts/DocsLayout.astro';
import { mdxComponents } from '@/components/docs/mdx-components';
import { siteConfig } from '@/config/site';

export async function getStaticPaths() {
  const homeId = `${siteConfig.defaultLocale}/${siteConfig.homePath.replace(/^\//, '')}`;
  const docs = await getCollection(
    'docs',
    (e: CollectionEntry<'docs'>) =>
      !e.data.draft && e.id.startsWith(`${siteConfig.defaultLocale}/`) && e.id !== homeId
  );
  return docs.map((entry) => {
    const slug = entry.id.split('/').slice(1).join('/');
    return { params: { slug }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings}>
  <Content components={mdxComponents} />
</DocsLayout>
