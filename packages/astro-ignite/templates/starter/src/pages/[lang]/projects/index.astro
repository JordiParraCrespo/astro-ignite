---
import { getRelativeLocaleUrl } from 'astro:i18n';

import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectsIndexList from '@/components/projects/ProjectsIndexList.astro';
import type { ProjectCard } from '@/components/projects/ProjectsIndexList.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { breadcrumbListSchema, collectionPageSchema } from '@/lib/jsonld';
import { getProjectsForLocale, projectSlug } from '@/lib/projects';

export async function getStaticPaths() {
  return siteConfig.locales
    .filter((l) => l !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const projects = await getProjectsForLocale(locale, 'desc');

const projectCards: ProjectCard[] = projects.map((project) => ({
  project,
  href: getRelativeLocaleUrl(locale, `/projects/${projectSlug(project)}`),
}));

const schemas = [
  breadcrumbListSchema([
    { name: t('nav.home'), url: '/' },
    { name: t('nav.projects'), url: '/projects' },
  ]),
  collectionPageSchema({
    url: '/projects',
    title: t('seo.projects.title'),
    description: t('seo.projects.description'),
    inLanguage: locale,
  }),
];
---

<BaseLayout
  title={t('seo.projects.title')}
  description={t('seo.projects.description')}
  schemas={schemas}
>
  <ProjectsIndexList projectCards={projectCards} />
</BaseLayout>
