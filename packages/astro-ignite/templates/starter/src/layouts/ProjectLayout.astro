---
/**
 * ProjectLayout — wraps BaseLayout with project case-study structure.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import { breadcrumbListSchema, creativeWorkSchema } from '@/lib/jsonld';

import BaseLayout from './BaseLayout.astro';
import HeroImage from '@/components/image/HeroImage.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// entry.id format from Astro 5 i18n collection: "<locale>/<slug>" (folder /index stripped).
const slug = entry.id.split('/').slice(1).join('/');
const url = `/projects/${slug}`;

const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: t('nav.projects'), url: '/projects' },
  { name: entry.data.title, url },
];

const schemas = [
  breadcrumbListSchema(crumbs),
  creativeWorkSchema({
    url,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.datePublished,
    dateModified: entry.data.dateUpdated,
    image: entry.data.ogImage?.src ?? entry.data.heroImage.src,
    imageAlt: entry.data.heroImageAlt,
    keywords: entry.data.techStack,
    inLanguage: locale,
    status: entry.data.status,
  }),
];

const dateFmt = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long' });

const statusLabels = {
  shipped: t('projects.status.shipped'),
  'in-progress': t('projects.status.in-progress'),
  archived: t('projects.status.archived'),
} as const;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.ogImage ?? entry.data.heroImage}
  imageAlt={entry.data.heroImageAlt}
  type="article"
  noindex={entry.data.draft}
  schemas={schemas}
  preloadImages={[entry.data.heroImage]}
>
  <article class="project">
    <header class="project-header">
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href={getRelativeLocaleUrl(locale, '/projects')}>← {t('projects.backToProjects')}</a>
      </nav>
      <h1>{entry.data.title}</h1>
      <p class="project-summary">{entry.data.summary}</p>
      <HeroImage
        src={entry.data.heroImage}
        alt={entry.data.heroImageAlt}
        width={1200}
        height={630}
      />
    </header>

    <div class="project-body">
      <aside class="project-meta">
        <dl>
          {
            entry.data.role && (
              <>
                <dt>{t('projects.role')}</dt>
                <dd>{entry.data.role}</dd>
              </>
            )
          }
          {
            entry.data.client && (
              <>
                <dt>{t('projects.client')}</dt>
                <dd>{entry.data.client}</dd>
              </>
            )
          }
          <dt>Status</dt>
          <dd>{statusLabels[entry.data.status as keyof typeof statusLabels]}</dd>
          {
            entry.data.datePublished && (
              <>
                <dt>Date</dt>
                <dd>
                  <time datetime={entry.data.datePublished.toISOString()}>
                    {dateFmt.format(entry.data.datePublished)}
                  </time>
                </dd>
              </>
            )
          }
          {
            entry.data.techStack.length > 0 && (
              <>
                <dt>{t('projects.techStack')}</dt>
                <dd>
                  <ul class="tech-list">
                    {entry.data.techStack.map((tech: string) => (
                      <li>{tech}</li>
                    ))}
                  </ul>
                </dd>
              </>
            )
          }
        </dl>
        {
          (entry.data.links.live || entry.data.links.repo || entry.data.links.demo) && (
            <ul class="project-links">
              {entry.data.links.live && (
                <li>
                  <a href={entry.data.links.live} target="_blank" rel="noopener noreferrer">
                    {t('projects.viewLive')} ↗
                  </a>
                </li>
              )}
              {entry.data.links.repo && (
                <li>
                  <a href={entry.data.links.repo} target="_blank" rel="noopener noreferrer">
                    {t('projects.viewRepo')} ↗
                  </a>
                </li>
              )}
              {entry.data.links.demo && (
                <li>
                  <a href={entry.data.links.demo} target="_blank" rel="noopener noreferrer">
                    {t('projects.viewDemo')} ↗
                  </a>
                </li>
              )}
            </ul>
          )
        }
      </aside>

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .project-header {
    margin-bottom: 3rem;
  }
  .breadcrumbs {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }
  .breadcrumbs a {
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--color-fg);
  }
  .project-header h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 1rem;
    color: var(--color-fg);
  }
  .project-summary {
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-fg-muted);
    margin: 0 0 2rem;
    max-width: 48rem;
  }
  .project-header :global(picture),
  .project-header :global(img) {
    border-radius: 0.75rem;
    overflow: hidden;
    width: 100%;
    height: auto;
    display: block;
  }
  .project-body {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  .project-meta dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1rem;
    font-size: 0.9375rem;
  }
  .project-meta dt {
    color: var(--color-fg-muted);
    font-weight: 500;
  }
  .project-meta dd {
    margin: 0;
    color: var(--color-fg);
  }
  .tech-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .tech-list li {
    background: var(--color-surface-2);
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.8125rem;
  }
  .project-links {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }
  .project-links a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }
  .project-links a:hover {
    text-decoration: underline;
  }
  @media (min-width: 900px) {
    .project-body {
      grid-template-columns: 16rem 1fr;
    }
    .project-meta {
      position: sticky;
      top: 5rem;
      align-self: start;
    }
  }
</style>
