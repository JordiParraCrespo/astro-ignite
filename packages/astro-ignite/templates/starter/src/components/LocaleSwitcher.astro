---
/**
 * Locale switcher — `<details>` dropdown listing all configured locales.
 *
 * If the site is monolingual (single locale), this component renders nothing.
 * Each link points to the equivalent path in the target locale via
 * getRelativeLocaleUrl.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';

const currentLocale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(currentLocale);

// Strip the current locale prefix from the path so we can rebuild it per target locale.
let path = Astro.url.pathname;
const segments = path.split('/').filter(Boolean);
if (segments[0] && siteConfig.locales.includes(segments[0])) {
  segments.shift();
}
path = '/' + segments.join('/');

const localeLabels: Record<string, string> = {
  en: 'English',
  es: 'Español',
  fr: 'Français',
  de: 'Deutsch',
  pt: 'Português',
  it: 'Italiano',
  ja: '日本語',
  zh: '中文',
};
---

{
  siteConfig.locales.length > 1 && (
    <details class="locale-switcher">
      <summary aria-label={t('locale.switch')} title={t('locale.switch')}>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
        <span class="locale-current">{currentLocale.toUpperCase()}</span>
      </summary>
      <ul role="menu" class="locale-menu">
        {siteConfig.locales.map((loc) => (
          <li>
            <a
              href={getRelativeLocaleUrl(loc, path)}
              hreflang={siteConfig.hreflang[loc] ?? loc}
              aria-current={loc === currentLocale ? 'true' : undefined}
              data-active={loc === currentLocale ? '' : null}
            >
              {localeLabels[loc] ?? loc}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<style>
  .locale-switcher {
    position: relative;
  }
  .locale-switcher summary {
    list-style: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.5rem;
    color: var(--color-fg-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
  }
  .locale-switcher summary::-webkit-details-marker {
    display: none;
  }
  .locale-switcher summary:hover {
    color: var(--color-fg);
    background: var(--color-surface-2);
  }
  .locale-current {
    font-weight: 500;
  }
  .locale-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.25rem;
    margin: 0;
    list-style: none;
    min-width: 8rem;
    box-shadow: 0 8px 16px -8px rgb(0 0 0 / 0.2);
    z-index: 30;
  }
  .locale-menu a {
    display: block;
    padding: 0.5rem 0.625rem;
    border-radius: 0.375rem;
    text-decoration: none;
    color: var(--color-fg);
    font-size: 0.875rem;
    transition: background-color 0.1s var(--ease-out-soft);
  }
  .locale-menu a:hover {
    background: var(--color-surface-2);
  }
  .locale-menu a[data-active] {
    color: var(--color-primary);
    font-weight: 500;
  }
</style>
