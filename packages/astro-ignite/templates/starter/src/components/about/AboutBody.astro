---
import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
---

<article class="mx-auto max-w-[48rem] px-5 pt-12 pb-16">
  <header class="mb-8">
    <Text variant="h1" class="mb-3">{t('seo.about.title')}</Text>
    <Text variant="lead">{t('seo.about.description')}</Text>
  </header>
  <div class="flex flex-col gap-4">
    <Text variant="body">{t('about.body.p1')}</Text>
    <Text variant="body">{t('about.body.p2')}</Text>
    <Text variant="h2" class="mt-4">{t('about.body.heading')}</Text>
    <ul class="m-0 flex list-disc flex-col gap-2 pl-5">
      <Text variant="body" as="li">{t('about.body.li1')}</Text>
      <Text variant="body" as="li">{t('about.body.li2')}</Text>
      <Text variant="body" as="li">{t('about.body.li3')}</Text>
    </ul>
  </div>
</article>
