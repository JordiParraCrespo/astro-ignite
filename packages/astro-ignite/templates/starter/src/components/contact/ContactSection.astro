---
import { actions, isInputError } from 'astro:actions';

import Button from '@/components/ui/button.astro';
import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// Astro Actions form handling — works with progressive enhancement.
// Method-override for the form means submissions land here as POST.
const result = Astro.getActionResult(actions.contact);
const inputError = result?.error && isInputError(result.error) ? result.error : null;
---

<section class="mx-auto max-w-[36rem] px-5 pt-12 pb-16">
  <header class="mb-8">
    <Text variant="h1" class="mb-3">{t('seo.contact.title')}</Text>
    <Text variant="lead">{t('seo.contact.description')}</Text>
  </header>

  {
    result && !result.error && (
      <div
        class="mb-6 rounded-lg border border-[color-mix(in_oklch,var(--color-success)_30%,transparent)] bg-[color-mix(in_oklch,var(--color-success)_12%,var(--color-bg))] px-4 py-3.5 text-[0.9375rem] text-(--color-success)"
        role="status"
      >
        ✓ {t('contact.success')}
      </div>
    )
  }

  {
    result?.error && !inputError && (
      <div
        class="mb-6 rounded-lg border border-[color-mix(in_oklch,var(--color-danger)_30%,transparent)] bg-[color-mix(in_oklch,var(--color-danger)_10%,var(--color-bg))] px-4 py-3.5 text-[0.9375rem] text-(--color-danger)"
        role="alert"
      >
        ✗ {t('contact.error')}
      </div>
    )
  }

  <form
    method="POST"
    action={actions.contact}
    class="flex flex-col gap-5 [&_input]:rounded-lg [&_input]:border [&_input]:border-(--color-border) [&_input]:bg-(--color-bg) [&_input]:px-3 [&_input]:py-2.5 [&_input]:font-[inherit] [&_input]:text-base [&_input]:text-(--color-fg) [&_input]:transition-colors [&_input]:duration-150 [&_input]:ease-(--ease-out-soft) focus-visible:[&_input]:border-(--color-primary) focus-visible:[&_input]:shadow-[0_0_0_3px_color-mix(in_oklch,var(--color-primary)_25%,transparent)] focus-visible:[&_input]:outline-none [&_textarea]:rounded-lg [&_textarea]:border [&_textarea]:border-(--color-border) [&_textarea]:bg-(--color-bg) [&_textarea]:px-3 [&_textarea]:py-2.5 [&_textarea]:font-[inherit] [&_textarea]:text-base [&_textarea]:text-(--color-fg) [&_textarea]:transition-colors [&_textarea]:duration-150 [&_textarea]:ease-(--ease-out-soft) focus-visible:[&_textarea]:border-(--color-primary) focus-visible:[&_textarea]:shadow-[0_0_0_3px_color-mix(in_oklch,var(--color-primary)_25%,transparent)] focus-visible:[&_textarea]:outline-none"
    novalidate
  >
    <div class="flex flex-col gap-1.5">
      <label for="name" class="text-sm font-medium text-(--color-fg)">{t('contact.name')}</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        autocomplete="name"
        aria-invalid={inputError?.fields.name ? 'true' : undefined}
        aria-describedby={inputError?.fields.name ? 'name-error' : undefined}
      />
      {
        inputError?.fields.name && (
          <Text variant="small" id="name-error" class="text-(--color-danger)">
            {t('contact.validation.nameRequired')}
          </Text>
        )
      }
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="email" class="text-sm font-medium text-(--color-fg)">{t('contact.email')}</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        aria-invalid={inputError?.fields.email ? 'true' : undefined}
        aria-describedby={inputError?.fields.email ? 'email-error' : undefined}
      />
      {
        inputError?.fields.email && (
          <Text variant="small" id="email-error" class="text-(--color-danger)">
            {t('contact.validation.emailInvalid')}
          </Text>
        )
      }
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="message" class="text-sm font-medium text-(--color-fg)"
        >{t('contact.message')}</label
      >
      <textarea
        id="message"
        name="message"
        rows="6"
        required
        aria-invalid={inputError?.fields.message ? 'true' : undefined}
        aria-describedby={inputError?.fields.message ? 'message-error' : undefined}></textarea>
      {
        inputError?.fields.message && (
          <Text variant="small" id="message-error" class="text-(--color-danger)">
            {t('contact.validation.messageTooShort')}
          </Text>
        )
      }
    </div>

    {/* Honeypot — bots fill this, humans don't */}
    <div class="absolute -top-[9999px] -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
      <label for="_website">{t('contact.honeypot')}</label>
      <input id="_website" name="_website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <Button type="submit" variant="default" class="self-start">
      {t('contact.send')}
    </Button>
  </form>
</section>
