---
/**
 * Below-the-fold features grid. Uses Tailwind classes (per the layered CSS
 * convention — only above-the-fold uses scoped styles).
 */

interface Feature {
  title: string;
  description: string;
  icon?: string;
}

interface Props {
  heading?: string;
  features: Feature[];
}

const { heading, features } = Astro.props;
---

<section class="py-12 md:py-20 px-5">
  <div class="max-w-[80rem] mx-auto">
    {
      heading && (
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-10 text-center">{heading}</h2>
      )
    }
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] hover:border-[var(--color-primary)]/40 transition-colors">
            {f.icon && (
              <div class="text-2xl mb-3" aria-hidden="true">
                {f.icon}
              </div>
            )}
            <h3 class="text-base font-semibold mb-2">{f.title}</h3>
            <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed">{f.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
