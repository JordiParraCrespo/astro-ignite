---
import { cn } from '@/lib/cn';

export type Crumb = {
  label: string;
  href?: string;
};

export type Props = {
  items: Crumb[];
  separator?: string;
  class?: string;
};

const { items, separator = '/', class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class={cn('breadcrumb mono', className)}>
  <ol>
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <li>
            {item.href && !isLast ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              <span aria-current={isLast ? 'page' : undefined} class={isLast ? 'is-current' : ''}>
                {item.label}
              </span>
            )}
            {!isLast && (
              <span class="breadcrumb__sep" aria-hidden="true">
                {separator}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumb {
    font-size: 12px;
    color: var(--color-fg-subtle);
  }
  .breadcrumb ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 120ms ease;
  }
  .breadcrumb a:hover {
    color: var(--color-fg);
  }
  .breadcrumb .is-current {
    color: var(--color-fg);
  }
  .breadcrumb__sep {
    color: var(--color-border-strong);
  }
</style>
