---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type AsLink = { href: string } & HTMLAttributes<'a'>;
type AsSpan = { href?: undefined } & HTMLAttributes<'span'>;

export type Props = (AsLink | AsSpan) & {
  label: string;
  detail?: string;
  pulse?: boolean;
  class?: string;
};

const { href, label, detail, pulse = true, class: className, ...rest } = Astro.props;
const classes = cn('release-pill mono', className);
---

{
  href ? (
    <a href={href} class={classes} {...(rest as HTMLAttributes<'a'>)}>
      <span
        class={cn('release-pill__dot', pulse && 'release-pill__dot--pulse')}
        aria-hidden="true"
      />
      <span class="release-pill__label">{label}</span>
      {detail && (
        <>
          <span class="release-pill__divider" aria-hidden="true">
            |
          </span>
          <span class="release-pill__detail">{detail}</span>
        </>
      )}
    </a>
  ) : (
    <span class={classes} {...(rest as HTMLAttributes<'span'>)}>
      <span
        class={cn('release-pill__dot', pulse && 'release-pill__dot--pulse')}
        aria-hidden="true"
      />
      <span class="release-pill__label">{label}</span>
      {detail && (
        <>
          <span class="release-pill__divider" aria-hidden="true">
            |
          </span>
          <span class="release-pill__detail">{detail}</span>
        </>
      )}
    </span>
  )
}

<style>
  .release-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-fg-muted);
    font-size: 12px;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 120ms ease;
  }
  a.release-pill:hover {
    border-color: var(--color-border-strong);
    color: var(--color-fg);
  }
  .release-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-fg);
    flex-shrink: 0;
  }
  .release-pill__dot--pulse {
    animation: release-pulse 2s ease-in-out infinite;
  }
  @keyframes release-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .release-pill__dot--pulse {
      animation: none;
    }
  }
  .release-pill__divider {
    color: var(--color-border-strong);
  }
</style>
