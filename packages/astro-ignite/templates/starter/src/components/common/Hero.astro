---
/**
 * Above-the-fold hero. Tailwind utilities resolve colors via the
 * --color-* tokens declared in src/styles/global.css.
 *
 * Buttons route through `ui/button.astro` — don't redefine them here.
 *
 * Edit freely — this is a reference layout, not a contract.
 */

import Button from '@/components/ui/button.astro';
import Text from '@/components/ui/text.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { eyebrow, title, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="overflow-hidden px-5 pt-[clamp(3rem,8vw,6rem)] pb-[clamp(2rem,6vw,4rem)]">
  <div class="mx-auto max-w-[56rem] text-center">
    {
      eyebrow && (
        <Text
          variant="small"
          as="p"
          weight="medium"
          tone="muted"
          class="mb-6 inline-block rounded-full bg-(--color-surface-2) px-3 py-1 tracking-[0.01em]"
        >
          {eyebrow}
        </Text>
      )
    }
    <Text variant="display" as="h1" class="mb-5 text-balance">{title}</Text>
    <Text variant="lead" class="mx-auto mb-8 max-w-[40rem] text-balance">{description}</Text>
    {
      (primaryCta || secondaryCta) && (
        <div class="flex flex-wrap justify-center gap-3">
          {primaryCta && (
            <Button href={primaryCta.href} variant="default">
              {primaryCta.label}
            </Button>
          )}
          {secondaryCta && (
            <Button href={secondaryCta.href} variant="ghost">
              {secondaryCta.label} →
            </Button>
          )}
        </div>
      )
    }
  </div>
</section>
