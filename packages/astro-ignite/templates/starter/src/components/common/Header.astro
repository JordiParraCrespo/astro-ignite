---
/**
 * Site navigation.
 *
 * Tailwind utilities resolve colors through the --color-* tokens in
 * src/styles/global.css. Mobile menu state is driven by a `.open` class
 * flipped from the inline script; the `[&.open]:flex` arbitrary variant
 * picks it up.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import ThemeToggle from './ThemeToggle.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';
import Brand from './Brand.astro';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const links = [
  { label: t('nav.blog'), href: getRelativeLocaleUrl(locale, '/blog') },
  { label: t('nav.projects'), href: getRelativeLocaleUrl(locale, '/projects') },
  { label: t('nav.about'), href: getRelativeLocaleUrl(locale, '/about') },
  { label: t('nav.contact'), href: getRelativeLocaleUrl(locale, '/contact') },
];

const homeUrl = getRelativeLocaleUrl(locale, '/');
const siteName = siteConfig.name[locale] ?? siteConfig.name[siteConfig.defaultLocale]!;
---

<header
  class="sticky top-0 z-40 border-b border-(--color-border) bg-[color-mix(in_oklch,var(--color-bg)_92%,transparent)] backdrop-blur-[12px]"
>
  <nav
    class="mx-auto flex max-w-[80rem] items-center justify-between gap-4 px-5 py-3.5"
    aria-label={t('nav.primary')}
  >
    <Brand href={homeUrl} variant="lockup" size={0.32} label={siteName} />

    <button
      type="button"
      class="nav-toggle inline-flex cursor-pointer appearance-none items-center rounded-lg border-none bg-transparent p-2 text-(--color-fg) hover:bg-(--color-surface-2) md:hidden"
      aria-controls="primary-nav-menu"
      aria-expanded="false"
      aria-label={t('nav.openMenu')}
    >
      <span class="flex w-5 flex-col gap-[4px]" aria-hidden="true">
        <span class="block h-[2px] rounded-[1px] bg-current"></span>
        <span class="block h-[2px] rounded-[1px] bg-current"></span>
        <span class="block h-[2px] rounded-[1px] bg-current"></span>
      </span>
    </button>

    <div
      id="primary-nav-menu"
      class="nav-menu hidden md:flex md:items-center md:gap-4 [&.open]:absolute [&.open]:top-full [&.open]:right-0 [&.open]:left-0 [&.open]:block [&.open]:border-b [&.open]:border-(--color-border) [&.open]:bg-(--color-bg) [&.open]:px-5 [&.open]:pt-4 [&.open]:pb-6 md:[&.open]:static md:[&.open]:border-0 md:[&.open]:bg-transparent md:[&.open]:p-0"
    >
      <ul
        class="m-0 flex list-none gap-6 p-0 [.nav-menu.open_&]:flex-col [.nav-menu.open_&]:items-start [.nav-menu.open_&]:gap-3.5 md:[.nav-menu.open_&]:flex-row md:[.nav-menu.open_&]:items-center md:[.nav-menu.open_&]:gap-6"
      >
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[0.9375rem] font-medium text-(--color-fg-muted) no-underline transition-colors duration-150 ease-(--ease-out-soft) hover:text-(--color-fg) [.nav-menu.open_&]:text-[1.125rem] md:[.nav-menu.open_&]:text-[0.9375rem]"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div
        class="ml-4 flex items-center gap-2 [.nav-menu.open_&]:mt-4 [.nav-menu.open_&]:ml-0 [.nav-menu.open_&]:w-full [.nav-menu.open_&]:justify-start [.nav-menu.open_&]:border-t [.nav-menu.open_&]:border-(--color-border) [.nav-menu.open_&]:pt-4 md:[.nav-menu.open_&]:mt-0 md:[.nav-menu.open_&]:ml-4 md:[.nav-menu.open_&]:w-auto md:[.nav-menu.open_&]:border-0 md:[.nav-menu.open_&]:pt-0"
      >
        <LocaleSwitcher />
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const toggle = document.querySelector('.nav-toggle');
    const menu = document.getElementById('primary-nav-menu');
    if (!toggle || !menu) return;
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.classList.toggle('open', !isOpen);
      document.body.classList.toggle('nav-open', !isOpen);
    });
    // Close on resize to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('open');
        document.body.classList.remove('nav-open');
      }
    });
  })();
</script>
