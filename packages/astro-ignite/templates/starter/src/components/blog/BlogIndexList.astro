---
import type { CollectionEntry } from 'astro:content';

import Image from '@/components/image/Image.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

export type PostCard = {
  post: CollectionEntry<'blog'>;
  href: string;
  dateText: string;
  dateIso: string;
};

interface Props {
  postCards: PostCard[];
}

const { postCards } = Astro.props;

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
---

<section class="mx-auto max-w-[64rem] px-5 pt-12 pb-16">
  <header class="mb-10">
    <h1 class="m-0 mb-3 text-[clamp(2rem,5vw,2.75rem)] leading-[1.1] font-bold tracking-[-0.02em]">
      {t('seo.blog.title')}
    </h1>
    <p class="m-0 text-lg text-[var(--color-fg-muted)]">{t('seo.blog.description')}</p>
  </header>

  {
    postCards.length === 0 ? (
      <p class="py-12 text-center text-base text-[var(--color-fg-muted)]">{t('blog.noPosts')}</p>
    ) : (
      <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-2">
        {postCards.map(({ post, href, dateText, dateIso }: PostCard) => (
          <li>
            <a
              href={href}
              class="block overflow-hidden rounded-xl border border-[var(--color-border)] text-inherit no-underline transition-[border-color,transform] duration-150 ease-[var(--ease-out-soft)] hover:border-[var(--color-primary)] [&_picture]:block [&_picture]:aspect-[16/9] [&_picture]:h-auto [&_picture]:w-full [&_picture]:object-cover [&_img]:block [&_img]:aspect-[16/9] [&_img]:h-auto [&_img]:w-full [&_img]:object-cover"
            >
              <div>
                <Image
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt}
                  width={800}
                  height={420}
                  sizes="(min-width: 768px) 384px, 100vw"
                />
              </div>
              <div class="p-5">
                <h2 class="m-0 mb-2 text-xl leading-[1.3] font-semibold tracking-[-0.01em]">
                  {post.data.title}
                </h2>
                <p class="m-0 mb-3 text-[0.8125rem] text-[var(--color-fg-muted)]">
                  <time datetime={dateIso}>{dateText}</time>
                </p>
                <p class="m-0 text-[0.9375rem] leading-[1.5] text-[var(--color-fg-muted)]">
                  {post.data.description}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
