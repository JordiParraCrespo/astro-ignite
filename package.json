{
  "name": "astro-ignite-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "shadcn-style CLI for bootstrapping production-grade Astro sites with top-tier SEO and performance defaults",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm --filter @astro-ignite/site dev",
    "dev:site": "pnpm --filter @astro-ignite/site dev",
    "dev:docs": "pnpm --filter @astro-ignite/docs dev",
    "dev:starter": "pnpm --filter @astro-ignite/template-starter dev",
    "dev:docs-template": "pnpm --filter @astro-ignite/template-docs dev",
    "dev:cli": "pnpm --filter astro-ignite dev",
    "dev:cli:shim": "pnpm --filter create-astro-ignite dev",
    "test": "pnpm -r --filter=!playground test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,astro,md,mdx,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,md,mdx,json,yaml,yml}\"",
    "typecheck": "pnpm -r typecheck",
    "scaffold:test": "node ./scripts/scaffold-test.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.2"
  }
}
