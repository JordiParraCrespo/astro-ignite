---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'p'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<p class={cn('card-description', className)} {...rest}><slot /></p>

<style>
  .card-description {
    color: var(--color-fg-muted);
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
  }
</style>
