---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'destructive' | 'warning' | 'success';

export type Props = HTMLAttributes<'div'> & {
  variant?: Variant;
  class?: string;
};

const { variant = 'default', class: className, ...rest } = Astro.props;
---

<div role="alert" class={cn('alert', `alert--${variant}`, className)} {...rest}>
  {
    Astro.slots.has('icon') && (
      <div class="alert__icon">
        <slot name="icon" />
      </div>
    )
  }
  <div class="alert__body">
    {
      Astro.slots.has('title') && (
        <div class="alert__title">
          <slot name="title" />
        </div>
      )
    }
    <div class="alert__desc"><slot /></div>
  </div>
</div>

<style>
  .alert {
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-fg);
  }
  .alert__icon {
    flex-shrink: 0;
    color: var(--color-fg-muted);
    line-height: 1;
    padding-top: 2px;
  }
  .alert__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  .alert__title {
    font-weight: 600;
    font-size: 14px;
    line-height: 1.3;
  }
  .alert__desc {
    color: var(--color-fg-muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .alert--destructive {
    border-color: color-mix(in oklch, var(--color-danger) 50%, var(--color-border));
  }
  .alert--destructive .alert__title,
  .alert--destructive .alert__icon {
    color: var(--color-danger);
  }
  .alert--warning {
    border-color: color-mix(in oklch, var(--color-warning) 50%, var(--color-border));
  }
  .alert--warning .alert__title,
  .alert--warning .alert__icon {
    color: var(--color-warning);
  }
  .alert--success {
    border-color: color-mix(in oklch, var(--color-success) 50%, var(--color-border));
  }
  .alert--success .alert__title,
  .alert--success .alert__icon {
    color: var(--color-success);
  }
</style>
