---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'div'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<div
  class={cn('bg-surface border border-border rounded-lg text-fg overflow-hidden', className)}
  {...rest}
>
  <slot />
</div>
