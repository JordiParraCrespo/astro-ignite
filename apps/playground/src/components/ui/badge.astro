---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'secondary' | 'outline' | 'destructive' | 'success' | 'warning';

export type Props = HTMLAttributes<'span'> & {
  variant?: Variant;
  class?: string;
};

const { variant = 'default', class: className, ...rest } = Astro.props;

const base =
  'inline-flex items-center gap-1 h-[22px] px-2 rounded-full text-xs font-medium leading-none border border-transparent whitespace-nowrap';

const variants: Record<Variant, string> = {
  default: 'bg-primary text-primary-fg',
  secondary: 'bg-surface-2 text-fg',
  outline: 'bg-transparent text-fg border-border',
  destructive: 'bg-danger text-zinc-50',
  success: 'bg-success text-zinc-950',
  warning: 'bg-warning text-zinc-950',
};
---

<span class={cn(base, variants[variant], className)} {...rest}><slot /></span>
