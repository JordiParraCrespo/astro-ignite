---
import { cn } from '@/lib/cn';

export type Props = { id?: string; class?: string };
const { id, class: className } = Astro.props;
---

<h2 id={id} class={cn('dialog-title', className)}><slot /></h2>

<style>
  .dialog-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-fg);
    margin: 0;
  }
</style>
