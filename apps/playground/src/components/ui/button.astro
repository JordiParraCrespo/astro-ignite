---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'secondary' | 'outline' | 'ghost' | 'destructive' | 'link';
type Size = 'sm' | 'md' | 'lg' | 'icon';

type AsButton = { href?: undefined } & HTMLAttributes<'button'>;
type AsAnchor = { href: string } & HTMLAttributes<'a'>;

export type Props = (AsButton | AsAnchor) & {
  variant?: Variant;
  size?: Size;
  class?: string;
};

const { variant = 'default', size = 'md', class: className, href, ...rest } = Astro.props;

const classes = cn('btn', `btn--${variant}`, `btn--${size}`, className);
---

{
  href ? (
    <a href={href} class={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius);
    font-weight: 500;
    font-family: inherit;
    line-height: 1;
    white-space: nowrap;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      background 120ms ease,
      border-color 120ms ease,
      color 120ms ease,
      opacity 120ms ease;
    user-select: none;
    text-decoration: none;
  }
  .btn:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.5;
    pointer-events: none;
  }

  .btn--sm {
    height: 32px;
    padding-inline: 12px;
    font-size: 13px;
  }
  .btn--md {
    height: 40px;
    padding-inline: 16px;
    font-size: 14px;
  }
  .btn--lg {
    height: 48px;
    padding-inline: 20px;
    font-size: 16px;
  }
  .btn--icon {
    height: 40px;
    width: 40px;
    padding: 0;
  }

  .btn--default {
    background: var(--color-primary);
    color: var(--color-primary-fg);
  }
  .btn--default:hover {
    opacity: 0.9;
  }

  .btn--secondary {
    background: var(--color-surface-2);
    color: var(--color-fg);
    border-color: var(--color-border);
  }
  .btn--secondary:hover {
    border-color: var(--color-border-strong);
  }

  .btn--outline {
    background: transparent;
    color: var(--color-fg);
    border-color: var(--color-border);
  }
  .btn--outline:hover {
    background: var(--color-surface-2);
    border-color: var(--color-border-strong);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-fg);
  }
  .btn--ghost:hover {
    background: var(--color-surface-2);
  }

  .btn--destructive {
    background: var(--color-danger);
    color: var(--color-zinc-50);
  }
  .btn--destructive:hover {
    opacity: 0.9;
  }

  .btn--link {
    background: transparent;
    color: var(--color-fg);
    height: auto;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
