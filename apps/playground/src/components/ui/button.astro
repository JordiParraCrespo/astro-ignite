---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'secondary' | 'outline' | 'ghost' | 'destructive' | 'link';
type Size = 'sm' | 'md' | 'lg' | 'icon';

type AsButton = { href?: undefined } & HTMLAttributes<'button'>;
type AsAnchor = { href: string } & HTMLAttributes<'a'>;

export type Props = (AsButton | AsAnchor) & {
  variant?: Variant;
  size?: Size;
  class?: string;
};

const { variant = 'default', size = 'md', class: className, href, ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-md font-medium leading-none whitespace-nowrap border border-transparent cursor-pointer transition-[background-color,border-color,color,opacity] duration-150 select-none no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:opacity-50 disabled:pointer-events-none aria-disabled:opacity-50 aria-disabled:pointer-events-none';

const sizes: Record<Size, string> = {
  sm: 'h-[30px] px-2.5 text-[13px] rounded-sm',
  md: 'h-9 px-3.5 text-sm',
  lg: 'h-11 px-[18px] text-[15px] rounded-md',
  icon: 'h-9 w-9 p-0',
};

const variants: Record<Variant, string> = {
  default: 'bg-primary text-primary-fg hover:opacity-90',
  secondary:
    'bg-surface-2 text-fg border-border hover:border-border-strong',
  outline:
    'bg-transparent text-fg border-border hover:bg-surface-2 hover:border-border-strong',
  ghost: 'bg-transparent text-fg hover:bg-surface-2',
  destructive: 'bg-danger text-danger-fg hover:opacity-90',
  link: 'bg-transparent text-fg h-auto !p-0 underline underline-offset-4',
};

const classes = cn(base, sizes[size], variants[variant], className);
---

{
  href ? (
    <a href={href} class={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
