---
import { cn } from '@/lib/cn';

export type Props = {
  type?: 'single' | 'multiple';
  name?: string;
  class?: string;
};

const { type = 'single', name, class: className } = Astro.props;
const groupName =
  type === 'single' ? (name ?? `accordion-${Math.random().toString(36).slice(2, 9)}`) : undefined;
---

<div class={cn('accordion', className)} data-group={groupName}>
  <slot />
</div>

<style>
  .accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.accordion[data-group]').forEach((el) => {
    const group = el.dataset.group;
    if (!group) return;
    el.querySelectorAll<HTMLDetailsElement>('details').forEach((d) => {
      if (!d.name) d.name = group;
    });
  });
</script>
