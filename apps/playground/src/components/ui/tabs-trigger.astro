---
import { cn } from '@/lib/cn';

export type Props = {
  value: string;
  class?: string;
};

const { value, class: className } = Astro.props;
---

<button
  type="button"
  role="tab"
  data-tab-trigger
  data-value={value}
  data-active="false"
  aria-selected="false"
  tabindex="-1"
  class={cn('tabs-trigger', className)}
>
  <slot />
</button>

<style>
  .tabs-trigger {
    appearance: none;
    background: transparent;
    border: none;
    border-radius: calc(var(--radius) - 2px);
    padding: 6px 12px;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-fg-muted);
    cursor: pointer;
    line-height: 1;
    transition:
      background 120ms ease,
      color 120ms ease;
  }
  .tabs-trigger:hover {
    color: var(--color-fg);
  }
  .tabs-trigger:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  .tabs-trigger[data-active='true'] {
    background: var(--color-surface);
    color: var(--color-fg);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
  }
</style>
