---
/**
 * Theme toggle — tri-state (light / dark / system) `<details>` dropdown.
 *
 * The anti-flash inline script in BaseLayout sets the initial state. This
 * component handles user toggles: writes 'light' | 'dark' to localStorage, or
 * removes the key for "follow system" mode.
 *
 * Listens to `prefers-color-scheme` change so the page responds when a user
 * in "system" mode flips their OS theme without reloading.
 */

import { useTranslations } from '@/i18n';

const locale = Astro.currentLocale;
const t = useTranslations(locale);
---

<details class="theme-toggle">
  <summary aria-label={t('theme.label')} title={t('theme.label')}>
    <svg
      class="icon icon-sun"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M5 5l1.5 1.5M17.5 17.5L19 19M2 12h2M20 12h2M5 19l1.5-1.5M17.5 6.5L19 5"
      ></path>
    </svg>
    <svg
      class="icon icon-moon"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <svg
      class="icon icon-system"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="2" y="3" width="20" height="14" rx="2"></rect>
      <path d="M8 21h8M12 17v4"></path>
    </svg>
  </summary>
  <ul role="menu" class="theme-menu">
    <li>
      <button type="button" data-theme-set="light" role="menuitem">{t('theme.light')}</button>
    </li>
    <li><button type="button" data-theme-set="dark" role="menuitem">{t('theme.dark')}</button></li>
    <li>
      <button type="button" data-theme-set="system" role="menuitem">{t('theme.system')}</button>
    </li>
  </ul>
</details>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const details = document.querySelector('.theme-toggle');
    if (!details) return;

    const apply = (mode) => {
      // Dark is the default at :root. .light class flips to light theme.
      const isLight =
        mode === 'light' ||
        (mode === 'system' && !matchMedia('(prefers-color-scheme: dark)').matches);
      root.classList.toggle('light', isLight);
      root.dataset.theme = mode;
    };

    const choose = (mode) => {
      if (mode === 'system') {
        localStorage.removeItem('theme');
      } else {
        localStorage.setItem('theme', mode);
      }
      apply(mode);
      details.removeAttribute('open');
    };

    details.querySelectorAll('[data-theme-set]').forEach((btn) => {
      btn.addEventListener('click', () => choose(btn.dataset.themeSet));
    });

    // Live system-preference response (only relevant when in system mode).
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (root.dataset.theme === 'system') apply('system');
    });

    // Close dropdown on outside click.
    document.addEventListener('click', (e) => {
      if (!details.contains(e.target) && details.hasAttribute('open')) {
        details.removeAttribute('open');
      }
    });
  })();
</script>

<style>
  .theme-toggle {
    position: relative;
  }
  .theme-toggle summary {
    list-style: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.5rem;
    color: var(--color-fg-muted);
    transition:
      color 0.15s var(--ease-out-soft),
      background-color 0.15s var(--ease-out-soft);
  }
  .theme-toggle summary::-webkit-details-marker {
    display: none;
  }
  .theme-toggle summary:hover {
    color: var(--color-fg);
    background: var(--color-surface-2);
  }
  .theme-toggle .icon {
    width: 1.125rem;
    height: 1.125rem;
    display: none;
  }

  /* Show the right icon for the active theme via [data-theme] on <html> */
  :global(html[data-theme='light']) .theme-toggle .icon-sun {
    display: block;
  }
  :global(html[data-theme='dark']) .theme-toggle .icon-moon {
    display: block;
  }
  :global(html[data-theme='system']) .theme-toggle .icon-system {
    display: block;
  }

  .theme-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.25rem;
    margin: 0;
    list-style: none;
    min-width: 8rem;
    box-shadow: 0 8px 16px -8px rgb(0 0 0 / 0.2);
    z-index: 30;
  }
  .theme-menu button {
    appearance: none;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    padding: 0.5rem 0.625rem;
    border-radius: 0.375rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.875rem;
    color: var(--color-fg);
    transition: background-color 0.1s var(--ease-out-soft);
  }
  .theme-menu button:hover {
    background: var(--color-surface-2);
  }
</style>
