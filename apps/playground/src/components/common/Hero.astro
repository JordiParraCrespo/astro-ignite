---
/**
 * Above-the-fold hero. Scoped <style> block (NOT Tailwind) so styles inline
 * automatically per-route. Uses CSS variables from the @theme block so it
 * inherits brand color / typography / dark-mode tokens.
 *
 * Buttons route through `ui/button.astro` — don't redefine `.btn` here.
 *
 * Edit freely — this is a reference layout, not a contract.
 */

import Button from '@/components/ui/button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { eyebrow, title, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="hero">
  <div class="hero-inner">
    {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
    <h1 class="hero-title">{title}</h1>
    <p class="hero-description">{description}</p>
    {
      (primaryCta || secondaryCta) && (
        <div class="hero-actions">
          {primaryCta && (
            <Button href={primaryCta.href} variant="default">
              {primaryCta.label}
            </Button>
          )}
          {secondaryCta && (
            <Button href={secondaryCta.href} variant="ghost">
              {secondaryCta.label} →
            </Button>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding: clamp(3rem, 8vw, 6rem) 1.25rem clamp(2rem, 6vw, 4rem);
    overflow: hidden;
  }
  .hero-inner {
    max-width: 56rem;
    margin: 0 auto;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--color-surface-2);
    color: var(--color-fg-muted);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    margin: 0 0 1.5rem;
  }
  .hero-title {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 0 0 1.25rem;
    color: var(--color-fg);
    text-wrap: balance;
  }
  .hero-description {
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-fg-muted);
    margin: 0 auto 2rem;
    max-width: 40rem;
    text-wrap: balance;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
