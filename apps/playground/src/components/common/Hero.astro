---
/**
 * Above-the-fold hero. Tailwind utilities resolve colors via the
 * --color-* tokens declared in src/styles/global.css.
 *
 * Buttons route through `ui/button.astro` — don't redefine them here.
 *
 * Edit freely — this is a reference layout, not a contract.
 */

import Button from '@/components/ui/button.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { eyebrow, title, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="overflow-hidden px-5 pt-[clamp(3rem,8vw,6rem)] pb-[clamp(2rem,6vw,4rem)]">
  <div class="mx-auto max-w-[56rem] text-center">
    {
      eyebrow && (
        <p class="mb-6 inline-block rounded-full bg-[var(--color-surface-2)] px-3 py-1 text-[0.8125rem] font-medium tracking-[0.01em] text-[var(--color-fg-muted)]">
          {eyebrow}
        </p>
      )
    }
    <h1
      class="mb-5 text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.05] font-bold tracking-[-0.025em] text-balance text-[var(--color-fg)]"
    >
      {title}
    </h1>
    <p
      class="mx-auto mb-8 max-w-[40rem] text-[clamp(1.0625rem,1.8vw,1.25rem)] leading-[1.5] text-balance text-[var(--color-fg-muted)]"
    >
      {description}
    </p>
    {
      (primaryCta || secondaryCta) && (
        <div class="flex flex-wrap justify-center gap-3">
          {primaryCta && (
            <Button href={primaryCta.href} variant="default">
              {primaryCta.label}
            </Button>
          )}
          {secondaryCta && (
            <Button href={secondaryCta.href} variant="ghost">
              {secondaryCta.label} →
            </Button>
          )}
        </div>
      )
    }
  </div>
</section>
