---
/**
 * Site footer — links to legal pages, RSS, and social profiles.
 *
 * Below-the-fold component, so it can use Tailwind classes freely.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';

import Text from '@/components/ui/text.astro';
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
const siteName = siteConfig.name[locale] ?? siteConfig.name[siteConfig.defaultLocale]!;

const legalLinks = [
  { label: t('footer.privacy'), href: getRelativeLocaleUrl(locale, '/legal/privacy') },
  { label: t('footer.terms'), href: getRelativeLocaleUrl(locale, '/legal/terms') },
  { label: t('footer.cookies'), href: getRelativeLocaleUrl(locale, '/legal/cookies') },
];

const rssUrl = locale === siteConfig.defaultLocale ? '/rss.xml' : `/${locale}/rss.xml`;

const social = Object.entries(siteConfig.social).filter(
  ([, v]) => typeof v === 'string' && v.length > 0
) as [string, string][];

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-(--color-border)">
  <div class="mx-auto grid max-w-[80rem] gap-8 px-5 py-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <Text variant="body" weight="semibold">{siteName}</Text>
      <Text variant="muted" class="mt-2 max-w-md">
        {siteConfig.description[locale] ?? siteConfig.description[siteConfig.defaultLocale]}
      </Text>
    </div>

    <div>
      <Text variant="h4" as="h3" class="mb-3">{t('footer.legal')}</Text>
      <ul class="space-y-2">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-(--color-fg-muted) hover:text-(--color-fg)">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={rssUrl} class="text-sm text-(--color-fg-muted) hover:text-(--color-fg)">
            {t('footer.rss')}
          </a>
        </li>
      </ul>
    </div>

    {
      social.length > 0 && (
        <div>
          <Text variant="h4" as="h3" class="mb-3">
            {t('footer.social')}
          </Text>
          <ul class="space-y-2">
            {social.map(([platform, url]) => (
              <li>
                <a
                  href={url}
                  rel="noopener noreferrer me"
                  target="_blank"
                  class="text-sm text-(--color-fg-muted) capitalize hover:text-(--color-fg)"
                >
                  {platform}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="border-t border-(--color-border)">
    <div
      class="mx-auto flex max-w-[80rem] flex-col gap-2 px-5 py-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <Text variant="small" tone="muted">
        © {year}
        {siteName}. {t('footer.rights')}
      </Text>
      <Text variant="small" tone="muted">
        {t('footer.builtWith')}
      </Text>
    </div>
  </div>
</footer>
