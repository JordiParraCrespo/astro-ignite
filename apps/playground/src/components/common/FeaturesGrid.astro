---
import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// Numeric `index` + technical English `tag` stay across locales; only title/body
// are translated. Matches the convention used in marketing site landings.
const features = [
  {
    index: '01',
    tag: 'perf',
    title: t('home.features.f01.title'),
    body: t('home.features.f01.body'),
  },
  {
    index: '02',
    tag: 'seo',
    title: t('home.features.f02.title'),
    body: t('home.features.f02.body'),
  },
  {
    index: '03',
    tag: 'i18n',
    title: t('home.features.f03.title'),
    body: t('home.features.f03.body'),
  },
  {
    index: '04',
    tag: 'form',
    title: t('home.features.f04.title'),
    body: t('home.features.f04.body'),
  },
  {
    index: '05',
    tag: 'legal',
    title: t('home.features.f05.title'),
    body: t('home.features.f05.body'),
  },
  {
    index: '06',
    tag: 'core',
    title: t('home.features.f06.title'),
    body: t('home.features.f06.body'),
  },
];
---

<section class="px-5 pt-12 pb-16">
  <div class="mx-auto max-w-7xl">
    <Text variant="h2" class="mb-6 text-center">{t('home.featuresHeading')}</Text>
    <div class="grid grid-cols-1 overflow-hidden rounded-lg border border-border md:grid-cols-3">
      {
        features.map((f) => (
          <div class="flex flex-col gap-2 border-b border-border px-5 py-4 max-md:border-r-0 md:border-r md:border-r-border md:[&:nth-child(3n)]:border-r-0">
            <div class="flex items-center gap-2.5">
              <span class="mono rounded-[3px] border border-border px-1.5 py-px text-[10px] text-fg-muted">
                {f.index}
              </span>
              <span class="mono text-[10px] tracking-[0.08em] text-fg-subtle uppercase">
                {f.tag}
              </span>
            </div>
            <Text variant="h4" class="mt-0.5">
              {f.title}
            </Text>
            <Text variant="small" tone="subtle" class="leading-[1.55]">
              {f.body}
            </Text>
          </div>
        ))
      }
    </div>
  </div>
</section>
