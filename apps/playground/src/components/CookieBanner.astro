---
/**
 * Cookie consent banner — bottom-right floating card.
 *
 * Two-button (Accept / Decline). Persists choice in localStorage under
 * `cookie-consent`. Dispatches a `consent-change` window event with the
 * choice value, which the Analytics component listens to.
 *
 * Renders only on first visit (when no `cookie-consent` value is set).
 * Strings are translated via the i18n dictionary.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';

import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
const cookiesPolicyUrl = getRelativeLocaleUrl(locale, '/legal/cookies');
---

<aside
  id="cookie-banner"
  class="cookie-banner"
  role="region"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-description"
  hidden
>
  <h2 id="cookie-banner-title">{t('cookies.banner.title')}</h2>
  <p id="cookie-banner-description">{t('cookies.banner.description')}</p>
  <div class="cookie-banner-actions">
    <button type="button" data-cookie-action="decline" class="ghost">
      {t('cookies.banner.decline')}
    </button>
    <button type="button" data-cookie-action="accept" class="primary">
      {t('cookies.banner.accept')}
    </button>
  </div>
  <a href={cookiesPolicyUrl} class="cookie-banner-link">
    {t('cookies.banner.policyLink')}
  </a>
</aside>

<script is:inline>
  (() => {
    const KEY = 'cookie-consent';
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;
    if (!localStorage.getItem(KEY)) banner.hidden = false;

    banner.querySelectorAll('[data-cookie-action]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const choice = btn.dataset.cookieAction;
        if (!choice) return;
        localStorage.setItem(KEY, choice);
        banner.hidden = true;
        window.dispatchEvent(new CustomEvent('consent-change', { detail: choice }));
      });
    });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    left: 1.25rem;
    max-width: 26rem;
    margin-left: auto;
    z-index: 50;
    padding: 1.25rem;
    background: var(--color-bg);
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    box-shadow: 0 10px 25px -10px rgb(0 0 0 / 0.25);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .cookie-banner h2 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .cookie-banner p {
    margin: 0 0 0.875rem;
    color: var(--color-fg-muted);
  }
  .cookie-banner-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    margin-bottom: 0.625rem;
  }
  .cookie-banner-actions button {
    appearance: none;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: opacity 0.15s var(--ease-out-soft);
  }
  .cookie-banner-actions .ghost {
    background: transparent;
    color: var(--color-fg-muted);
    border-color: var(--color-border);
  }
  .cookie-banner-actions .ghost:hover {
    color: var(--color-fg);
  }
  .cookie-banner-actions .primary {
    background: var(--color-fg);
    color: var(--color-bg);
  }
  .cookie-banner-actions .primary:hover {
    opacity: 0.9;
  }
  .cookie-banner-link {
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cookie-banner-link:hover {
    color: var(--color-fg);
  }
  @media (min-width: 640px) {
    .cookie-banner {
      left: auto;
    }
  }
</style>
