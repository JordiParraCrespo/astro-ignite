---
import { cn } from '@/lib/cn';

export type TocEntry = {
  id: string;
  label: string;
  depth?: number;
};

export type Props = {
  entries: TocEntry[];
  title?: string;
  class?: string;
};

const { entries, title = 'On this page', class: className } = Astro.props;
---

<aside class={cn('toc-rail', className)} aria-label={title}>
  <span class="toc-rail__title mono">{title}</span>
  <nav>
    <ul>
      {
        entries.map((entry) => (
          <li>
            <a
              href={`#${entry.id}`}
              data-toc-link
              data-target={entry.id}
              class={cn(
                'toc-rail__link',
                entry.depth && entry.depth > 2 && 'toc-rail__link--indent'
              )}
            >
              {entry.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<style>
  .toc-rail {
    position: sticky;
    top: 16px;
    align-self: start;
    padding: 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .toc-rail__title {
    font-size: 10px;
    color: var(--color-fg-subtle);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .toc-rail nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .toc-rail__link {
    display: block;
    font-size: 12px;
    color: var(--color-fg-subtle);
    padding: 3px 0 3px 10px;
    border-left: 2px solid transparent;
    text-decoration: none;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }
  .toc-rail__link:hover {
    color: var(--color-fg);
  }
  .toc-rail__link--indent {
    padding-left: 20px;
  }
  .toc-rail__link[aria-current='true'] {
    color: var(--color-fg);
    border-left-color: var(--color-fg);
    font-weight: 500;
  }
</style>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const idToLink = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => idToLink.set(l.dataset.target!, l));
    const targets = Array.from(idToLink.keys())
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);

    const setCurrent = (id: string | null) => {
      links.forEach((l) => {
        if (l.dataset.target === id) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setCurrent(visible[0].target.id);
      },
      { rootMargin: '0% 0% -70% 0%', threshold: 0 }
    );

    targets.forEach((t) => observer.observe(t));
  }
</script>
