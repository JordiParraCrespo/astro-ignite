---
import { cn } from '@/lib/cn';

export type Props = {
  code?: string;
  title: string;
  description?: string;
  class?: string;
};

const { code = 'Error · 404', title, description, class: className } = Astro.props;
---

<section class={cn('not-found', className)}>
  <span class="not-found__code mono">{code}</span>
  <h1 class="not-found__title">{title}</h1>
  {description && <p class="not-found__desc">{description}</p>}
  {
    Astro.slots.has('default') && (
      <div class="not-found__actions">
        <slot />
      </div>
    )
  }
</section>

<style>
  .not-found {
    max-width: 480px;
    margin: 64px auto 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }
  .not-found__code {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
  }
  .not-found__title {
    margin: 0;
    font-size: clamp(40px, 6vw, 56px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--color-fg);
  }
  .not-found__desc {
    margin: 0;
    font-size: 15px;
    color: var(--color-fg-muted);
    line-height: 1.6;
    max-width: 36ch;
  }
  .not-found__actions {
    display: flex;
    gap: 10px;
    margin-top: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
