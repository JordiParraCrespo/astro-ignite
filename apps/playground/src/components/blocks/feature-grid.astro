---
import { cn } from '@/lib/cn';

export type Feature = {
  index?: string;
  tag?: string;
  title: string;
  body: string;
};

export type Props = {
  features: Feature[];
  columns?: 2 | 3;
  class?: string;
};

const { features, columns = 3, class: className } = Astro.props;
---

<div class={cn('feature-grid', `feature-grid--${columns}`, className)}>
  {
    features.map((f, i) => (
      <div class="feature-grid__item">
        {(f.index || f.tag) && (
          <div class="feature-grid__row">
            {f.index !== undefined && (
              <span class="feature-grid__index mono">
                {f.index || String(i + 1).padStart(2, '0')}
              </span>
            )}
            {f.tag && <span class="feature-grid__tag mono">{f.tag}</span>}
          </div>
        )}
        <h4 class="feature-grid__title">{f.title}</h4>
        <p class="feature-grid__body">{f.body}</p>
      </div>
    ))
  }
</div>

<style>
  .feature-grid {
    display: grid;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .feature-grid--2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .feature-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }
  .feature-grid__item {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .feature-grid--2 .feature-grid__item:nth-child(2n),
  .feature-grid--3 .feature-grid__item:nth-child(3n) {
    border-right: 0;
  }
  .feature-grid__row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .feature-grid__index {
    font-size: 10px;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .feature-grid__tag {
    font-size: 10px;
    color: var(--color-fg-subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .feature-grid__title {
    margin: 2px 0 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-fg);
  }
  .feature-grid__body {
    margin: 0;
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-fg-subtle);
  }
  @media (max-width: 768px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .feature-grid__item {
      border-right: 0;
    }
  }
</style>
