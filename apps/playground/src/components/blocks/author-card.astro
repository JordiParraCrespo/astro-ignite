---
import { cn } from '@/lib/cn';

export type Props = {
  name: string;
  bio?: string;
  src?: string;
  href?: string;
  class?: string;
};

const { name, bio, src, href, class: className } = Astro.props;
const initials = name
  .split(' ')
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();

const Wrapper = href ? 'a' : 'div';
---

<Wrapper
  class={cn(
    'flex gap-3 p-4 border border-border rounded-lg no-underline text-inherit bg-surface',
    href && 'transition-colors duration-150 hover:border-border-strong',
    className,
  )}
  href={href}
>
  <span
    class="w-11 h-11 rounded-full bg-surface-2 text-fg grid place-items-center text-[13px] font-medium shrink-0 overflow-hidden"
    aria-hidden="true"
  >
    {
      src ? (
        <img src={src} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" />
      ) : (
        <span>{initials || '?'}</span>
      )
    }
  </span>
  <div class="flex flex-col gap-0.5 min-w-0">
    <h4 class="m-0 text-sm font-medium text-fg">{name}</h4>
    {bio && (
      <p class="m-0 text-xs text-fg-subtle leading-[1.5]">{bio}</p>
    )}
    <slot />
  </div>
</Wrapper>
