---
import { cn } from '@/lib/cn';

export type Props = {
  path?: string;
  shell?: string;
  caret?: boolean;
  class?: string;
};

const { path = '~/code', shell = 'zsh', caret = true, class: className } = Astro.props;
---

<div
  class={cn(
    'border border-border rounded-lg bg-bg overflow-hidden',
    className,
  )}
>
  <div class="flex items-center gap-1.5 px-3 py-2 bg-surface-2 border-b border-border">
    <span class="w-[9px] h-[9px] rounded-full bg-border-strong" aria-hidden="true"></span>
    <span class="w-[9px] h-[9px] rounded-full bg-border-strong" aria-hidden="true"></span>
    <span class="w-[9px] h-[9px] rounded-full bg-border-strong" aria-hidden="true"></span>
    <span class="mono text-[10px] text-fg-subtle ml-2">{path}</span>
    <span class="mono text-[10px] text-fg-subtle ml-auto">{shell}</span>
  </div>
  <pre
    class="mono m-0 py-3.5 px-4 text-[11.5px] leading-[1.65] text-fg whitespace-pre-wrap"
  ><slot />{caret && <span class="caret inline-block w-[7px] h-3 bg-fg align-[-1px]" aria-hidden="true" />}</pre>
</div>
