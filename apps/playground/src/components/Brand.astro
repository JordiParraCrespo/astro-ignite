---
/**
 * Brand mark — the cursor `>_` lockup.
 *
 * Sourced from the Claude Design handoff (Mark A).
 * - Geist Mono `>` glyph + a solid caret block (blinking via `.caret`)
 * - Optional `astro-ignite` wordmark in Geist Sans (always lowercase)
 * - All sizing scales with the `size` prop (1 = display sizes from the spec)
 *
 * Variants:
 *   <Brand variant="lockup" />   default — mark + wordmark side by side
 *   <Brand variant="mark" />     just `>_` (favicon, small icon contexts)
 *   <Brand variant="word" />     just the wordmark (footer, dense places)
 */

interface Props {
  variant?: 'lockup' | 'mark' | 'word';
  /** Multiplier for all spec sizes. 1 = display (56pt mono / 40pt sans). */
  size?: number;
  /** Optional href; renders as a link (used by Nav). */
  href?: string;
  /** Aria label override; defaults to "astro-ignite". */
  label?: string;
  class?: string;
}

const {
  variant = 'lockup',
  size = 1,
  href,
  label = 'astro-ignite',
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'span';

// Spec sizes (all in pt/px, scaled by size prop)
const monoSize = 56 * size;
const sansSize = 40 * size;
const gap = 14 * size;
const caretWidth = 22 * size;
const caretHeight = 6 * size;
const caretLift = 4 * size;
const caretMargin = 4 * size;
---
<Tag
  class:list={['ig-brand', `ig-brand-${variant}`, className]}
  href={href}
  aria-label={href ? label : undefined}
  style={`
    --ig-mono-size: ${monoSize}px;
    --ig-sans-size: ${sansSize}px;
    --ig-gap: ${gap}px;
    --ig-caret-w: ${caretWidth}px;
    --ig-caret-h: ${caretHeight}px;
    --ig-caret-lift: ${caretLift}px;
    --ig-caret-margin: ${caretMargin}px;
  `}
>
  {variant !== 'word' && (
    <span class="ig-mark mono" aria-hidden={variant === 'lockup' ? 'true' : undefined}>
      <span class="ig-gt">{'>'}</span>
      <span class="ig-caret caret"></span>
    </span>
  )}
  {variant !== 'mark' && (
    <span class="ig-word">astro-ignite</span>
  )}
</Tag>

<style>
  .ig-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--ig-gap);
    text-decoration: none;
    color: var(--color-fg);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  a.ig-brand:hover {
    color: var(--color-fg);
  }
  a.ig-brand:hover .ig-caret {
    background: var(--color-primary);
  }

  /* Mark group: `>` + caret block */
  .ig-mark {
    font-family: var(--font-mono);
    font-size: var(--ig-mono-size);
    font-weight: 500;
    line-height: 1;
    color: var(--color-fg);
    display: inline-flex;
    align-items: baseline;
  }
  .ig-gt {
    /* slight optical correction so the > sits on the baseline cleanly */
    display: inline-block;
  }
  .ig-caret {
    display: inline-block;
    width: var(--ig-caret-w);
    height: var(--ig-caret-h);
    background: var(--color-fg);
    margin-left: var(--ig-caret-margin);
    transform: translateY(calc(var(--ig-caret-lift) * -1));
  }

  /* Wordmark — Geist Sans, always lowercase, tight tracking */
  .ig-word {
    font-family: var(--font-display);
    font-size: var(--ig-sans-size);
    font-weight: 500;
    color: var(--color-fg);
    text-transform: lowercase;
    letter-spacing: -0.04em;
  }

  /* Compact lockup is the default — but the mark-only and word-only variants
     drop the gap. */
  .ig-brand-mark,
  .ig-brand-word {
    gap: 0;
  }
</style>
