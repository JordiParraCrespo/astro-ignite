---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Image from '@/components/image/Image.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { breadcrumbListSchema, collectionPageSchema } from '@/lib/jsonld';

export async function getStaticPaths() {
  return siteConfig.locales
    .filter((l) => l !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}


const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const posts = (
  await getCollection(
    'blog',
    (entry: CollectionEntry<'blog'>) => entry.id.startsWith(`${locale}/`) && !entry.data.draft
  )
).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    +b.data.datePublished - +a.data.datePublished
);

const dateFmt = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

type PostCard = {
  post: CollectionEntry<'blog'>;
  href: string;
  dateText: string;
  dateIso: string;
};

const postCards: PostCard[] = posts.map((post: CollectionEntry<'blog'>) => {
  const slug = post.id.split('/').slice(1).join('/');
  return {
    post,
    href: getRelativeLocaleUrl(locale, `/blog/${slug}`),
    dateText: dateFmt.format(post.data.datePublished),
    dateIso: post.data.datePublished.toISOString(),
  };
});

const schemas = [
  breadcrumbListSchema([
    { name: t('nav.home'), url: '/' },
    { name: t('nav.blog'), url: '/blog' },
  ]),
  collectionPageSchema({
    url: '/blog',
    title: t('seo.blog.title'),
    description: t('seo.blog.description'),
    inLanguage: locale,
  }),
];
---

<BaseLayout title={t('seo.blog.title')} description={t('seo.blog.description')} schemas={schemas}>
  <section class="page">
    <header class="page-header">
      <h1>{t('seo.blog.title')}</h1>
      <p class="lede">{t('seo.blog.description')}</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty">{t('blog.noPosts')}</p>
      ) : (
        <ul class="post-list">
          {postCards.map(({ post, href, dateText, dateIso }: PostCard) => (
            <li>
              <a href={href} class="post-card">
                <div class="post-card-image">
                  <Image
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt}
                    width={800}
                    height={420}
                    sizes="(min-width: 768px) 384px, 100vw"
                  />
                </div>
                <div class="post-card-body">
                  <h2>{post.data.title}</h2>
                  <p class="post-meta">
                    <time datetime={dateIso}>{dateText}</time>
                  </p>
                  <p class="post-description">{post.data.description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .page {
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }
  .page-header {
    margin-bottom: 2.5rem;
  }
  .page-header h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .lede {
    font-size: 1.125rem;
    color: var(--color-fg-muted);
    margin: 0;
  }
  .empty {
    color: var(--color-fg-muted);
    font-size: 1rem;
    text-align: center;
    padding: 3rem 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .post-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    transition:
      border-color 0.15s var(--ease-out-soft),
      transform 0.15s var(--ease-out-soft);
  }
  .post-card:hover {
    border-color: var(--color-primary);
  }
  .post-card-image :global(picture),
  .post-card-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .post-card-body {
    padding: 1.25rem;
  }
  .post-card-body h2 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }
  .post-meta {
    color: var(--color-fg-muted);
    font-size: 0.8125rem;
    margin: 0 0 0.75rem;
  }
  .post-description {
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
  }
</style>
