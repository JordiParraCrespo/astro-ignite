---
import { getRelativeLocaleUrl } from 'astro:i18n';

import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogIndexList from '@/components/blog/BlogIndexList.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { breadcrumbListSchema, collectionPageSchema } from '@/lib/jsonld';
import { getPostsForLocale, nonDefaultLocales, POSTS_PER_PAGE, type PageMeta } from '@/lib/blog';

export async function getStaticPaths() {
  return nonDefaultLocales().map((lang) => ({ params: { lang } }));
}

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const allPosts = await getPostsForLocale(locale);
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice(0, POSTS_PER_PAGE);

const page: PageMeta = {
  current: 1,
  total: totalPages,
  nextUrl: totalPages > 1 ? getRelativeLocaleUrl(locale, '/blog/page/2') : undefined,
};

const schemas = [
  breadcrumbListSchema([
    { name: t('nav.home'), url: '/' },
    { name: t('nav.blog'), url: '/blog' },
  ]),
  collectionPageSchema({
    url: '/blog',
    title: t('seo.blog.title'),
    description: t('seo.blog.description'),
    inLanguage: locale,
  }),
];
---

<BaseLayout title={t('seo.blog.title')} description={t('seo.blog.description')} schemas={schemas}>
  <BlogIndexList posts={posts} page={page} />
</BaseLayout>
