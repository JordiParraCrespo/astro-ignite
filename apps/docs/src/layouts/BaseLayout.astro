---
/**
 * BaseLayout — head + theme + SEO scaffolding for docs pages.
 *
 * Lighter than the starter's BaseLayout: no Nav (the docs sidebar replaces
 * it), no Footer (each page renders its own prev/next + edit link), but
 * still wires SEO, JsonLd, anti-flash theme, analytics, and the
 * cookie banner.
 *
 * Defaults to LIGHT theme on first visit (`siteConfig.defaultTheme`) — docs
 * sites read better in light. The toggle still flips to dark and the choice
 * persists across visits.
 */

import type { ImageMetadata } from 'astro';
import type { Thing } from 'schema-dts';

import '@/styles/global.css';
import { siteConfig } from '@/config/site';
import { siteSchemas } from '@/lib/jsonld';
import SEO from '@/components/seo/SEO.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import CookieBanner from '@/components/legal/CookieBanner.astro';
import Analytics from '@/components/common/Analytics.astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'profile';
  alternates?: Array<{ lang: string; href: string }>;
  schemas?: Thing[];
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  type = 'website',
  alternates,
  schemas = [],
} = Astro.props;

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const allSchemas = [...siteSchemas(locale), ...schemas];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!--
      Anti-flash theme script. Uses siteConfig.defaultTheme (light by default
      for docs) when no preference is stored. Adds .light class to <html>
      when the resolved theme is light.
    -->
    <script is:inline define:vars={{ defaultTheme: siteConfig.defaultTheme }}>
      (() => {
        const root = document.documentElement;
        const stored = localStorage.getItem('theme');
        const systemPrefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
        let isLight;
        if (stored === 'light') isLight = true;
        else if (stored === 'dark') isLight = false;
        else if (defaultTheme === 'light') isLight = true;
        else if (defaultTheme === 'dark') isLight = false;
        else isLight = !systemPrefersDark;
        if (isLight) root.classList.add('light');
        root.dataset.theme = stored ?? 'system';
        // Stamp consent state so the cookie banner is visible from FCP for
        // new visitors and stays hidden for returning ones — no mid-load
        // visibility flip (which was the dominant Speed Index hit).
        if (localStorage.getItem('cookie-consent')) root.dataset.consent = 'recorded';
      })();
    </script>

    <!-- No remote font is shipped. The token chain in global.css already lists
         system fallbacks (ui-sans-serif / ui-monospace) which render
         instantly. The Astro experimental Font integration was emitting
         woff2 fetches into the inlined critical CSS, but the page never
         painted them: the @theme rule in global.css redefines
         --font-display / --font-mono to plain "Geist" / "Geist Mono",
         overriding the hashed family names Astro generates, so no element
         matched any @font-face. To enable Geist (or any custom font), either
         change the token in global.css to the family Astro emits, or drop
         in your own self-hosted @font-face block. -->


    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name[locale] ?? siteConfig.name[siteConfig.defaultLocale]}
      href="/rss.xml"
    />

    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      type={type}
      alternates={alternates}
      locale={locale}
    />
    <JsonLd schemas={allSchemas} />
    <Analytics />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <slot />
    <CookieBanner />
  </body>
</html>
