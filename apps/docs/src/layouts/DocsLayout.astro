---
/**
 * DocsLayout — three-column docs page.
 *
 * Layout: 240px sidebar | flexible main | 220px on-this-page.
 * On smaller viewports the sidebar collapses behind a toggle and the
 * on-this-page TOC moves above the content.
 *
 * Pulls the title/description from the entry frontmatter and renders:
 *   - Sidebar nav with active-link highlighting
 *   - Breadcrumbs + page header (title + lede + tags)
 *   - Slot for the rendered MDX content
 *   - Prev / Next navigation
 *   - On-this-page TOC (right column)
 */

import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import type { Thing } from 'schema-dts';

import BaseLayout from './BaseLayout.astro';
import SidebarNav from '@/components/docs/SidebarNav.astro';
import OnThisPage from '@/components/docs/OnThisPage.astro';
import Breadcrumbs from '@/components/docs/Breadcrumbs.astro';
import PrevNext from '@/components/docs/PrevNext.astro';
import AiActions from '@/components/docs/AiActions.astro';
import ThemeToggle from '@/components/common/ThemeToggle.astro';
import LocaleSwitcher from '@/components/common/LocaleSwitcher.astro';
import Text from '@/components/ui/text.astro';
import { breadcrumbListSchema, webPageSchema } from '@/lib/jsonld';
import { mdHref } from '@/lib/docs-md';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description, tags, lastUpdated, noindex, landing } = entry.data;

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// entry.id format: `<locale>/<slug>`. Strip the locale to get the bare slug.
const slug = entry.id.split('/').slice(1).join('/');
const url = locale === siteConfig.defaultLocale ? `/${slug}` : `/${locale}/${slug}`;

const schemas: Thing[] = [
  breadcrumbListSchema([
    { name: 'Docs', url: '/' },
    { name: title, url },
  ]),
  webPageSchema({
    url,
    title,
    description,
    inLanguage: locale,
    dateModified: lastUpdated,
  }),
];

const dateFmt = new Intl.DateTimeFormat(Astro.currentLocale ?? 'en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} schemas={schemas} noindex={noindex}>
  <div class="docs-shell" data-landing={landing || undefined}>
    <SidebarNav currentPath={Astro.url.pathname} />

    <main id="main" class="docs-main">
      <div class="docs-toolbar">
        <Breadcrumbs currentSlug={slug} currentTitle={title} />
        <div class="docs-toolbar-actions">
          {
            siteConfig.repo && (
              <a
                href={`${siteConfig.repo.url}/edit/${siteConfig.repo.branch ?? 'main'}/${siteConfig.repo.docsDir}/${entry.id}.mdx`}
                rel="noopener noreferrer"
                target="_blank"
                aria-label={t('nav.editPage')}
                title={t('nav.editPage')}
                class="inline-flex items-center gap-1.5 rounded-lg p-2 text-sm text-fg-muted no-underline transition-colors duration-150 hover:bg-surface-2 hover:text-fg"
              >
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 20h9" />
                  <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                </svg>
              </a>
            )
          }
          <AiActions markdownPath={mdHref(entry.id)} />
          <LocaleSwitcher />
          <ThemeToggle />
        </div>
      </div>

      <article class="docs-article" data-pagefind-body>
        {
          !landing && (
            <header class="docs-header">
          {
            tags.length > 0 && (
              <div class="docs-tags">
                {tags.map((t: string) => (
                  <span class="docs-tag mono">{t}</span>
                ))}
              </div>
            )
          }
          <Text variant="h1">{title}</Text>
          <Text variant="lead" class="docs-lede">{description}</Text>
          {
            lastUpdated && (
              <div class="docs-meta mono">
                <span>Last updated</span>
                <time datetime={lastUpdated.toISOString()}>{dateFmt.format(lastUpdated)}</time>
              </div>
            )
          }
            </header>
          )
        }

        <div class="docs-prose">
          <slot />
        </div>

        <PrevNext currentSlug={slug} />
      </article>
    </main>

    <OnThisPage headings={headings} />
  </div>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 240px 1fr 220px;
    min-height: 100vh;
    align-items: start;
  }
  /* Landing docs own their hero and run full width without the TOC column. */
  .docs-shell[data-landing] {
    grid-template-columns: 240px 1fr;
  }
  .docs-shell[data-landing] :global(.on-this-page) {
    display: none;
  }
  .docs-shell[data-landing] .docs-prose {
    max-width: none;
  }
  .docs-shell[data-landing] .docs-prose > p {
    max-width: 64ch;
  }
  @media (max-width: 1024px) {
    .docs-shell {
      grid-template-columns: 240px 1fr;
    }
    .docs-shell :global(.on-this-page) {
      display: none;
    }
  }
  @media (max-width: 767.98px) {
    .docs-shell {
      grid-template-columns: 1fr;
    }
  }

  .docs-main {
    padding: 28px 48px 64px;
    max-width: 100%;
    min-width: 0;
  }
  @media (max-width: 767.98px) {
    .docs-main {
      padding: 24px 20px 48px;
    }
  }

  .docs-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .docs-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .docs-header {
    margin-bottom: 28px;
  }
  .docs-header :global(h1) {
    margin: 0 0 12px;
  }
  .docs-lede {
    max-width: 60ch;
    margin: 0 0 16px;
  }
  .docs-tags {
    display: flex;
    gap: 6px;
    margin-bottom: 12px;
  }
  .docs-tag {
    font-size: 11px;
    color: var(--color-fg-muted);
    padding: 3px 7px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
  }
  .docs-meta {
    display: flex;
    gap: 6px;
    align-items: center;
    font-size: 11px;
    color: var(--color-fg-muted);
    letter-spacing: -0.005em;
  }

  .docs-prose {
    color: var(--color-fg);
    font-size: 16px;
    line-height: 1.7;
    max-width: 64ch;
  }
</style>

<style is:global>
  /* Prose styles for MDX content. Scoped is:global so they apply to elements
     rendered by the MDX compiler. Layered under `components` so atoms rendered
     inside prose (Card, Callout, Steps) keep their own utility margins/type. */
  @layer components {
  .docs-prose h2 {
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.03em;
    margin: 2.5rem 0 1rem;
    color: var(--color-fg);
    scroll-margin-top: 1rem;
  }
  .docs-prose h3 {
    font-size: 19px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.02em;
    margin: 2rem 0 0.5rem;
    color: var(--color-fg);
    scroll-margin-top: 1rem;
  }
  .docs-prose h2 a,
  .docs-prose h3 a {
    color: inherit;
    text-decoration: none;
  }
  .docs-prose p {
    margin: 0 0 1rem;
  }
  .docs-prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklch, var(--color-accent) 40%, transparent);
    text-decoration-thickness: 1px;
  }
  .docs-prose a:hover {
    text-decoration-color: var(--color-accent);
  }
  .docs-prose ul,
  .docs-prose ol {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }
  .docs-prose ul {
    list-style: disc;
  }
  .docs-prose ol {
    list-style: decimal;
  }
  .docs-prose li {
    margin-bottom: 0.25rem;
  }
  .docs-prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 1px 5px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .docs-prose pre {
    margin: 1.25rem 0;
    padding: 14px 16px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.65;
  }
  .docs-prose pre code {
    background: transparent;
    border: none;
    padding: 0;
    font-size: inherit;
  }
  /* Shiki emits `--shiki-light` / `--shiki-dark` per token (defaultColor:
     false in astro.config); pick the pair that matches the theme class so
     fenced blocks share the token surface with CodeBlock in both themes. */
  .docs-prose .astro-code,
  .docs-prose .astro-code span {
    color: var(--shiki-dark);
  }
  :root.light .docs-prose .astro-code,
  :root.light .docs-prose .astro-code span {
    color: var(--shiki-light);
  }
  .docs-prose pre.astro-code {
    position: relative;
  }
  .docs-prose .code-copy {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 6px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.4;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.1s;
  }
  .docs-prose .code-copy:hover {
    color: var(--color-fg);
  }
  .docs-prose pre:hover .code-copy,
  .docs-prose .code-copy:focus-visible,
  .docs-prose .code-copy[data-copied] {
    opacity: 1;
  }
  .docs-prose .code-copy svg {
    width: 12px;
    height: 12px;
  }
  /* Shiki transformers: full-width line bands for `{1,3}` / `[!code highlight]`
     and `[!code ++]` / `[!code --]`, plus a line-number gutter on multi-line
     blocks. Token-resolved, build-time only. */
  .docs-prose .astro-code code {
    display: inline-block;
    min-width: 100%;
  }
  .docs-prose .astro-code .line {
    display: inline-block;
    width: 100%;
  }
  .docs-prose .astro-code code:has(.line:nth-child(2)) {
    counter-reset: docs-ln;
  }
  .docs-prose .astro-code code:has(.line:nth-child(2)) .line {
    counter-increment: docs-ln;
  }
  .docs-prose .astro-code code:has(.line:nth-child(2)) .line::before {
    content: counter(docs-ln);
    display: inline-block;
    width: 1.5rem;
    margin-right: 1.25rem;
    text-align: right;
    color: var(--color-fg-subtle);
    user-select: none;
  }
  .docs-prose .astro-code .line.highlighted {
    background: color-mix(in oklch, var(--color-fg) 7%, transparent);
    box-shadow: inset 2px 0 var(--color-fg);
  }
  .docs-prose .astro-code .line.diff.add {
    background: color-mix(in oklch, var(--color-success) 16%, transparent);
    box-shadow: inset 2px 0 var(--color-success);
  }
  .docs-prose .astro-code .line.diff.remove {
    background: color-mix(in oklch, var(--color-danger) 16%, transparent);
    box-shadow: inset 2px 0 var(--color-danger);
    opacity: 0.65;
  }
  /* `// [!code focus]`: dim everything else until the block is hovered. */
  .docs-prose .astro-code.has-focused .line:not(.focused) {
    opacity: 0.4;
    transition: opacity 0.2s;
  }
  .docs-prose .astro-code.has-focused:hover .line:not(.focused) {
    opacity: 1;
  }
  /* `// [!code word:token]` or `/token/` in the fence meta. */
  .docs-prose .astro-code .highlighted-word {
    background: color-mix(in oklch, var(--color-accent) 16%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--color-accent) 35%, transparent);
    border-radius: 3px;
    padding: 1px 3px;
  }
  /* Fence meta flags (astro.config transformerMetaFlags). */
  .docs-prose .astro-code.wrap .line {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .docs-prose .astro-code.no-lines code .line::before {
    content: none;
  }
  .docs-prose hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
  .docs-prose blockquote {
    margin: 1.25rem 0;
    padding-left: 16px;
    border-left: 2px solid var(--color-border-strong);
    color: var(--color-fg-muted);
  }
  .docs-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 14px;
  }
  .docs-prose th,
  .docs-prose td {
    border-bottom: 1px solid var(--color-border);
    padding: 8px 12px;
    text-align: left;
  }
  .docs-prose th {
    font-weight: 500;
  }
  }
</style>

<script>
  // Copy button on fenced code blocks (CodeBlock.astro ships its own).
  const copyIcon =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  document.querySelectorAll<HTMLPreElement>('.docs-prose pre.astro-code').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.innerHTML = `${copyIcon}<span>copy</span>`;
    btn.addEventListener('click', async () => {
      const text = pre.querySelector('code')?.textContent ?? '';
      if (!navigator.clipboard) return;
      try {
        await navigator.clipboard.writeText(text);
        btn.dataset.copied = '';
        btn.lastElementChild!.textContent = 'copied';
        setTimeout(() => {
          delete btn.dataset.copied;
          btn.lastElementChild!.textContent = 'copy';
        }, 1200);
      } catch {
        // Clipboard permission denied — leave the button as is.
      }
    });
    pre.appendChild(btn);
  });
</script>
