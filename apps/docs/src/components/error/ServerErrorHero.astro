---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
const homeHref = getRelativeLocaleUrl(locale, '/');
---

<section class="server-error">
  <div class="text-stack">
    <span class="eyebrow mono">500</span>
    <h1 class="heading">{t('errors.500.heading')}</h1>
    <p class="body">{t('errors.500.body')}</p>
  </div>
  <a class="action action-primary" href={homeHref}>{t('errors.500.back')} →</a>
</section>

<style>
  .server-error {
    max-width: 40rem;
    margin: 0 auto;
    padding: 5rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }
  .text-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }
  .heading {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-fg);
  }
  .body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-fg-muted);
    max-width: 36ch;
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.875rem;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color 0.12s var(--ease-out-soft),
      background 0.12s var(--ease-out-soft),
      color 0.12s var(--ease-out-soft);
  }
  .action-primary {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
  .action-primary:hover {
    background: var(--color-fg-muted);
    border-color: var(--color-fg-muted);
  }
</style>
