---
/**
 * Theme toggle — binary light/dark switch.
 *
 * Single Contrast icon (lucide-style: half-filled circle) as the button.
 * Click flips between light and dark; the choice persists in localStorage.
 *
 * The anti-flash inline script in BaseLayout still falls back to system
 * preference when localStorage is empty (first visit). Once the user clicks
 * the toggle they commit to an explicit value.
 */

import { useTranslations } from '@/i18n';

const locale = Astro.currentLocale;
const t = useTranslations(locale);
---

<button
  class="theme-toggle inline-flex cursor-pointer items-center justify-center rounded-lg border-0 bg-transparent p-2 text-(--color-fg-muted) transition-colors duration-150 hover:bg-(--color-surface-2) hover:text-(--color-fg) focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-ring)"
  type="button"
  aria-label={t('theme.label')}
  title={t('theme.label')}
>
  <svg
    class="icon block h-[1.125rem] w-[1.125rem] transition-transform duration-200"
    aria-hidden="true"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M12 18a6 6 0 0 0 0-12v12z" fill="currentColor"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    const root = document.documentElement;
    btn.addEventListener('click', () => {
      const isLight = root.classList.toggle('light');
      const next = isLight ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      root.dataset.theme = next;
    });
  })();
</script>

<style>
  /* Why kept: theme-state mirroring rotates the icon when <html> carries
     `.light`. The ancestor selector cannot be expressed with Tailwind
     utilities without restructuring the markup. */
  :global(html.light) .theme-toggle .icon {
    transform: rotate(180deg);
  }
</style>
