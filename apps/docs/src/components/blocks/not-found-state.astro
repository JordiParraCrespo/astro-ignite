---
import { cn } from '@/lib/cn';
import Text from '@/components/ui/text.astro';

export type Props = {
  code?: string;
  title: string;
  description?: string;
  class?: string;
};

const { code = 'Error · 404', title, description, class: className } = Astro.props;
---

<section
  class={cn('mx-auto mt-16 flex max-w-[480px] flex-col items-center gap-4 text-center', className)}
>
  <Text variant="eyebrow" class="mono">{code}</Text>
  <Text variant="h1">{title}</Text>
  {
    description && (
      <Text variant="muted" class="max-w-[36ch]">
        {description}
      </Text>
    )
  }
  {
    Astro.slots.has('default') && (
      <div class="mt-2 flex flex-wrap justify-center gap-2.5">
        <slot />
      </div>
    )
  }
</section>
