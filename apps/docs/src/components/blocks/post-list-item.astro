---
import { cn } from '@/lib/cn';

export type Props = {
  href: string;
  title: string;
  excerpt?: string;
  date?: string | Date;
  author?: string;
  readingTime?: string;
  tags?: string[];
  class?: string;
};

const {
  href,
  title,
  excerpt,
  date,
  author,
  readingTime,
  tags = [],
  class: className,
} = Astro.props;

const dateStr = date instanceof Date ? date.toISOString().slice(0, 10) : (date ?? null);
---

<article
  class={cn(
    'py-5 border-t border-border last:border-b last:border-b-border flex flex-col gap-2',
    className
  )}
>
  <div class="mono flex items-center flex-wrap gap-2 text-[11px] text-fg-subtle">
    {dateStr && <time datetime={dateStr}>{dateStr}</time>}
    {
      author && (
        <>
          <span class="text-border-strong" aria-hidden="true">
            ·
          </span>
          <span>by {author}</span>
        </>
      )
    }
    {
      readingTime && (
        <>
          <span class="text-border-strong" aria-hidden="true">
            ·
          </span>
          <span class="text-[11px] py-[3px] px-[7px] rounded-sm bg-surface-2 text-fg-muted border border-border">
            {readingTime}
          </span>
        </>
      )
    }
  </div>
  <h3 class="m-0 text-[22px] font-medium tracking-[-0.025em]">
    <a href={href} class="text-fg no-underline hover:text-fg-muted">{title}</a>
  </h3>
  {excerpt && <p class="m-0 text-sm text-fg-muted leading-[1.55]">{excerpt}</p>}
  {
    tags.length > 0 && (
      <div class="flex gap-1.5 flex-wrap">
        {tags.map((t) => (
          <span class="mono inline-flex items-center text-[11px] py-0.5 px-[7px] rounded-full border border-border text-fg-muted bg-transparent">
            {t}
          </span>
        ))}
      </div>
    )
  }
</article>
