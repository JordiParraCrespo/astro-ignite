---
import { cn } from '@/lib/cn';

export type PrevNextItem = {
  href: string;
  title: string;
  label?: string;
};

export type Props = {
  prev?: PrevNextItem;
  next?: PrevNextItem;
  prevLabel?: string;
  nextLabel?: string;
  class?: string;
};

const {
  prev,
  next,
  prevLabel = '← Previous',
  nextLabel = 'Next →',
  class: className,
} = Astro.props;

const boxClass =
  'border border-border rounded-md py-3 px-3.5 flex flex-col gap-[3px] no-underline text-fg transition-colors duration-150 hover:border-border-strong';
---

<nav
  aria-label="Previous and next"
  class={cn('grid grid-cols-1 sm:grid-cols-2 gap-2.5', className)}
>
  {
    prev ? (
      <a href={prev.href} class={boxClass}>
        <span class="mono text-[10px] text-fg-subtle">{prev.label ?? prevLabel}</span>
        <span class="text-[13px] font-medium">{prev.title}</span>
      </a>
    ) : (
      <span aria-hidden="true" />
    )
  }
  {
    next ? (
      <a href={next.href} class={cn(boxClass, 'text-right')}>
        <span class="mono text-[10px] text-fg-subtle">{next.label ?? nextLabel}</span>
        <span class="text-[13px] font-medium">{next.title}</span>
      </a>
    ) : (
      <span aria-hidden="true" />
    )
  }
</nav>
