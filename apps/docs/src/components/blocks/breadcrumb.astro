---
import { cn } from '@/lib/cn';

export type Crumb = {
  label: string;
  href?: string;
};

export type Props = {
  items: Crumb[];
  separator?: string;
  ariaLabel?: string;
  class?: string;
};

const { items, separator = '/', ariaLabel = 'Breadcrumb', class: className } = Astro.props;
---

<nav
  aria-label={ariaLabel}
  class={cn('mono text-xs text-fg-subtle', className)}
>
  <ol class="list-none m-0 p-0 flex items-center flex-wrap gap-1.5">
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <li class="inline-flex items-center gap-1.5">
            {item.href && !isLast ? (
              <a
                href={item.href}
                class="text-inherit no-underline transition-colors duration-150 hover:text-fg"
              >
                {item.label}
              </a>
            ) : (
              <span
                aria-current={isLast ? 'page' : undefined}
                class={isLast ? 'text-fg' : ''}
              >
                {item.label}
              </span>
            )}
            {!isLast && (
              <span class="text-border-strong" aria-hidden="true">
                {separator}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
