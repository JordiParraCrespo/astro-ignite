---
import { cn } from '@/lib/cn';

export type Props = {
  content: string;
  side?: 'top' | 'bottom';
  class?: string;
};

const { content, side = 'top', class: className } = Astro.props;
---

<span class={cn('tooltip', `tooltip--${side}`, className)}>
  <slot />
  <span class="tooltip__content" role="tooltip">{content}</span>
</span>

<style>
  .tooltip {
    position: relative;
    display: inline-flex;
  }
  .tooltip__content {
    position: absolute;
    left: 50%;
    transform: translateX(-50%) translateY(0) scale(0.96);
    background: var(--color-fg);
    color: var(--color-bg);
    font-size: 12px;
    line-height: 1.3;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 120ms ease,
      transform 120ms ease;
    z-index: 50;
  }
  .tooltip--top .tooltip__content {
    bottom: calc(100% + 6px);
  }
  .tooltip--bottom .tooltip__content {
    top: calc(100% + 6px);
  }
  .tooltip:hover .tooltip__content,
  .tooltip:focus-within .tooltip__content {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }
</style>
