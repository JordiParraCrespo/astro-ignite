---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'div'> & { class?: string };
const { class: className, ...rest } = Astro.props;
---

<div
  class={cn('overflow-hidden rounded-lg border border-border bg-surface text-fg', className)}
  {...rest}
>
  <slot />
</div>
