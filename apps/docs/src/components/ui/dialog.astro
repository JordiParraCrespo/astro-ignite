---
import { cn } from '@/lib/cn';

export type Props = {
  id: string;
  class?: string;
  labelledBy?: string;
};

const { id, class: className, labelledBy } = Astro.props;
---

<dialog id={id} class={cn('dialog', className)} aria-labelledby={labelledBy}>
  <div class="dialog__panel">
    <slot />
  </div>
</dialog>

<style>
  .dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-fg);
    width: min(90vw, 480px);
    max-width: min(90vw, 480px);
    height: fit-content;
    max-height: calc(100vh - 32px);
    box-shadow: 0 25px 50px -10px rgb(0 0 0 / 0.6);
  }
  .dialog:not([open]) {
    display: none;
  }
  .dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(2px);
  }
  .dialog[open] {
    animation: dialog-in 160ms ease-out;
  }
  .dialog__panel {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  @keyframes dialog-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-dialog-open]');
    if (opener) {
      const id = opener.dataset.dialogOpen!;
      const el = document.getElementById(id) as HTMLDialogElement | null;
      el?.showModal();
      return;
    }
    const closer = target.closest<HTMLElement>('[data-dialog-close]');
    if (closer) {
      closer.closest('dialog')?.close();
      return;
    }
    if (target.tagName === 'DIALOG') {
      const dlg = target as HTMLDialogElement;
      const rect = dlg.getBoundingClientRect();
      const inside =
        e.clientX >= rect.left &&
        e.clientX <= rect.right &&
        e.clientY >= rect.top &&
        e.clientY <= rect.bottom;
      if (!inside) dlg.close();
    }
  });
</script>
