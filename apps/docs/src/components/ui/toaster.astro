---
import { cn } from '@/lib/cn';

export type Props = {
  position?: 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left';
  class?: string;
};

const { position = 'bottom-right', class: className } = Astro.props;
---

<ai-toaster
  data-position={position}
  class={cn('toaster', `toaster--${position}`, className)}
  aria-live="polite"
  aria-atomic="false"></ai-toaster>

<style>
  .toaster {
    position: fixed;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    max-width: min(420px, calc(100vw - 32px));
    pointer-events: none;
  }
  .toaster--top-right {
    top: 0;
    right: 0;
  }
  .toaster--top-left {
    top: 0;
    left: 0;
  }
  .toaster--bottom-right {
    bottom: 0;
    right: 0;
  }
  .toaster--bottom-left {
    bottom: 0;
    left: 0;
  }
  .toaster :global(.toast) {
    pointer-events: auto;
    background: var(--color-surface);
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.6);
    font-size: 13px;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 320px;
    animation: toast-in 200ms ease-out;
  }
  .toaster :global(.toast__icon) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1.5px solid var(--color-fg-muted);
    color: var(--color-fg-muted);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
  }
  .toaster :global(.toast__msg) {
    flex: 1;
  }
  .toaster :global(.toast--destructive .toast__icon) {
    border-color: var(--color-danger);
    color: var(--color-danger);
  }
  .toaster :global(.toast--success .toast__icon) {
    border-color: var(--color-success);
    color: var(--color-success);
  }
  .toaster :global(.toast--warning .toast__icon) {
    border-color: var(--color-warning);
    color: var(--color-warning);
  }
  .toaster :global(.toast__close) {
    margin-left: auto;
    background: transparent;
    border: none;
    color: var(--color-fg-muted);
    cursor: pointer;
    padding: 0 4px;
    font-size: 14px;
    line-height: 1;
  }
  .toaster :global(.toast__close:hover) {
    color: var(--color-fg);
  }
  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  if (!customElements.get('ai-toaster')) {
    class AiToaster extends HTMLElement {
      connectedCallback() {
        window.addEventListener('ai-toast', (e: Event) => {
          const detail = (e as CustomEvent).detail as {
            message: string;
            variant?: 'default' | 'success' | 'destructive' | 'warning';
            duration?: number;
          };
          this.show(detail);
        });
      }
      show(opts: { message: string; variant?: string; duration?: number }) {
        const variant = opts.variant ?? 'default';
        const glyph: Record<string, string> = {
          default: 'i',
          success: '✓',
          warning: '!',
          destructive: '×',
        };
        const el = document.createElement('div');
        el.className = `toast toast--${variant}`;
        el.setAttribute('role', variant === 'destructive' ? 'alert' : 'status');
        const icon = document.createElement('span');
        icon.className = 'toast__icon';
        icon.textContent = glyph[variant] ?? 'i';
        el.appendChild(icon);
        const text = document.createElement('span');
        text.className = 'toast__msg';
        text.textContent = opts.message;
        el.appendChild(text);
        const close = document.createElement('button');
        close.className = 'toast__close';
        close.setAttribute('aria-label', 'Close');
        close.textContent = '×';
        close.addEventListener('click', () => el.remove());
        el.appendChild(close);
        this.appendChild(el);
        const ms = opts.duration ?? 4000;
        if (ms > 0) setTimeout(() => el.remove(), ms);
      }
    }
    customElements.define('ai-toaster', AiToaster);
  }
</script>
