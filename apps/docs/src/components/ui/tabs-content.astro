---
import { cn } from '@/lib/cn';

export type Props = {
  value: string;
  class?: string;
};

const { value, class: className } = Astro.props;
---

<div role="tabpanel" data-tab-panel data-value={value} hidden class={cn('tabs-content', className)}>
  <slot />
</div>

<style>
  .tabs-content {
    padding-top: 16px;
  }
  .tabs-content:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
    border-radius: var(--radius);
  }
</style>
