---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

export type Props = HTMLAttributes<'h3'> & {
  as?: 'h1' | 'h2' | 'h3' | 'h4';
  class?: string;
};

const { as: Tag = 'h3', class: className, ...rest } = Astro.props;
---

<Tag
  class={cn('text-lg font-semibold leading-tight text-fg m-0', className)}
  {...rest}
><slot /></Tag>
