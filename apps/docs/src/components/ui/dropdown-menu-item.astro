---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type AsButton = { href?: undefined } & HTMLAttributes<'button'>;
type AsAnchor = { href: string } & HTMLAttributes<'a'>;

export type Props = (AsButton | AsAnchor) & { class?: string; destructive?: boolean };

const { class: className, href, destructive = false, ...rest } = Astro.props;

const classes = cn(
  'flex items-center gap-2 w-full px-2 py-1.5 rounded-[calc(var(--radius)-2px)] bg-transparent border-none font-inherit text-[13px] leading-snug text-left no-underline cursor-pointer hover:bg-surface-2 focus-visible:bg-surface-2 focus-visible:outline-none',
  destructive ? 'text-danger' : 'text-fg',
  className,
);
---

{
  href ? (
    <a href={href} role="menuitem" class={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button type="button" role="menuitem" class={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
