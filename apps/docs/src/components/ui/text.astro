---
import { cn } from '@/lib/cn';
import type { HTMLAttributes, HTMLTag } from 'astro/types';

type Variant =
  | 'display'
  | 'h1'
  | 'h2'
  | 'h3'
  | 'h4'
  | 'lead'
  | 'body'
  | 'small'
  | 'muted'
  | 'eyebrow'
  | 'code';

type Tone = 'default' | 'muted' | 'subtle';

type Weight = 'normal' | 'medium' | 'semibold' | 'bold';

export type Props = HTMLAttributes<'p'> & {
  variant?: Variant;
  as?: HTMLTag;
  tone?: Tone;
  weight?: Weight;
  class?: string;
};

const defaultTag: Record<Variant, HTMLTag> = {
  display: 'h1',
  h1: 'h1',
  h2: 'h2',
  h3: 'h3',
  h4: 'h4',
  lead: 'p',
  body: 'p',
  small: 'p',
  muted: 'p',
  eyebrow: 'p',
  code: 'code',
};

const variantClasses: Record<Variant, string> = {
  display:
    'text-[clamp(40px,5.6vw,80px)] font-medium tracking-[-0.05em] leading-[0.95] text-balance',
  h1: 'text-[clamp(32px,4.4vw,56px)] font-medium tracking-[-0.045em] leading-[1.05] text-balance',
  h2: 'text-[clamp(24px,3vw,36px)] font-medium tracking-[-0.035em] leading-[1.15] text-balance',
  h3: 'text-[clamp(19px,2vw,24px)] font-medium tracking-[-0.025em] leading-[1.25] text-balance',
  h4: 'text-base font-semibold tracking-[-0.015em] leading-[1.35]',
  lead: 'text-[clamp(16px,1.4vw,19px)] font-normal leading-[1.55] text-fg-muted',
  body: 'text-[14px] leading-[1.6]',
  small: 'text-[12px] leading-[1.5]',
  muted: 'text-[13px] leading-[1.55] text-fg-muted',
  eyebrow: 'text-[11px] font-semibold tracking-[0.12em] uppercase text-fg-muted',
  code: 'font-mono text-[0.92em] px-[0.35em] py-[0.125em] bg-surface-2 border border-border rounded-sm',
};

const toneClasses: Record<Tone, string> = {
  default: 'text-fg',
  muted: 'text-fg-muted',
  subtle: 'text-fg-subtle',
};

const weightClasses: Record<Weight, string> = {
  normal: 'font-normal',
  medium: 'font-medium',
  semibold: 'font-semibold',
  bold: 'font-bold',
};

const { variant = 'body', as, tone, weight, class: className, ...rest } = Astro.props;

const Tag = (as ?? defaultTag[variant]) as HTMLTag;
---

<Tag
  class={cn(
    'm-0',
    variantClasses[variant],
    tone && toneClasses[tone],
    weight && weightClasses[weight],
    className
  )}
  {...rest}><slot /></Tag
>
