---
/**
 * Search box — command palette.
 *
 * Trigger button renders inline. Press it (or ⌘K / Ctrl+K anywhere) to open
 * a <dialog> that lazy-loads `/pagefind/pagefind.js` on first open. The
 * bundle is generated by `postbuild: pagefind --site dist`, so search only
 * works against a built site (`pnpm build && pnpm preview`). Under `astro
 * dev` the dialog shows a hint pointing to the production build.
 *
 * Mirrors Starlight's behaviour: each page result expands into nested
 * sub-results (one per matching heading), with anchors that scroll directly
 * to the section.
 */
---

<button type="button" class="search-box" data-search-open aria-label="Search docs">
  <span class="search-icon mono" aria-hidden="true">⌕</span>
  <span class="search-label mono">Search docs</span>
  <span class="search-kbd mono"><kbd>⌘</kbd><kbd>K</kbd></span>
</button>

<dialog class="search-dialog" id="search-dialog" aria-label="Search docs">
  <form method="dialog" class="search-dialog__form" autocomplete="off">
    <div class="search-dialog__field">
      <span class="search-dialog__icon mono" aria-hidden="true">⌕</span>
      <input
        type="search"
        name="q"
        class="search-dialog__input"
        placeholder="Search docs…"
        aria-label="Search query"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-dialog__esc mono">Esc</kbd>
    </div>
    <div class="search-dialog__results" data-search-results aria-live="polite"></div>
    <div class="search-dialog__footer mono">
      <span>
        <kbd>↑</kbd><kbd>↓</kbd> navigate
      </span>
      <span>
        <kbd>↵</kbd> open
      </span>
      <span>
        <kbd>Esc</kbd> close
      </span>
    </div>
  </form>
</dialog>

<script>
  type PagefindSubResult = {
    title: string;
    url: string;
    excerpt: string;
  };
  type PagefindResultData = {
    url: string;
    excerpt: string;
    meta: { title: string };
    sub_results?: PagefindSubResult[];
  };
  type PagefindResult = {
    id: string;
    data: () => Promise<PagefindResultData>;
  };
  type Pagefind = {
    search: (q: string) => Promise<{ results: PagefindResult[] }>;
    options?: (opts: Record<string, unknown>) => Promise<void>;
  };

  type FlatItem = {
    url: string;
    title: string;
    excerpt: string;
    kind: 'page' | 'sub';
  };
  type Group = {
    page: FlatItem;
    subs: FlatItem[];
  };

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const trigger = document.querySelector<HTMLButtonElement>('[data-search-open]');
  const input = dialog?.querySelector<HTMLInputElement>('input[type="search"]');
  const resultsEl = dialog?.querySelector<HTMLDivElement>('[data-search-results]');

  if (dialog && trigger && input && resultsEl) {
    let pagefind: Pagefind | null = null;
    let pagefindError = false;
    let activeIndex = 0;
    let groups: Group[] = [];
    let flatItems: FlatItem[] = [];

    const open = () => {
      dialog.showModal();
      requestAnimationFrame(() => input.focus());
      void load();
    };

    const close = () => {
      dialog.close();
      input.value = '';
      groups = [];
      flatItems = [];
      activeIndex = 0;
      render('');
    };

    const load = async () => {
      if (pagefind || pagefindError) return;
      try {
        // Build the URL at runtime so Vite/Rollup doesn't try to resolve it —
        // the pagefind bundle is generated by `pnpm build`, not shipped to node_modules.
        const url = ['', 'pagefind', 'pagefind.js'].join('/');
        pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
        await pagefind.options?.({ excerptLength: 25 });
      } catch {
        pagefindError = true;
        render('');
      }
    };

    const escapeHtml = (s: string) =>
      s.replace(
        /[&<>"']/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c
      );

    const renderUnavailable = () => {
      resultsEl.innerHTML = `
        <div class="search-dialog__empty">
          Search is only available on a built site.<br />
          Run <code>pnpm build &amp;&amp; pnpm preview</code>.
        </div>`;
    };

    const render = (query: string) => {
      if (pagefindError) {
        renderUnavailable();
        return;
      }
      if (!query) {
        resultsEl.innerHTML =
          '<div class="search-dialog__empty">Start typing to search the docs.</div>';
        return;
      }
      if (groups.length === 0) {
        resultsEl.innerHTML = `<div class="search-dialog__empty">No results for "${escapeHtml(query)}".</div>`;
        return;
      }
      let cursor = 0;
      const html = groups
        .map((group) => {
          const pageIdx = cursor++;
          const subsHtml = group.subs
            .map((sub) => {
              const idx = cursor++;
              return `
                <a
                  href="${sub.url}"
                  class="search-dialog__sub"
                  data-search-result
                  data-index="${idx}"
                  aria-selected="${idx === activeIndex ? 'true' : 'false'}"
                >
                  <span class="search-dialog__sub-hash mono" aria-hidden="true">#</span>
                  <span class="search-dialog__sub-body">
                    <span class="search-dialog__sub-title">${escapeHtml(sub.title)}</span>
                    <span class="search-dialog__sub-excerpt">${sub.excerpt}</span>
                  </span>
                </a>`;
            })
            .join('');
          return `
            <div class="search-dialog__group">
              <a
                href="${group.page.url}"
                class="search-dialog__page"
                data-search-result
                data-index="${pageIdx}"
                aria-selected="${pageIdx === activeIndex ? 'true' : 'false'}"
              >
                <span class="search-dialog__page-title">${escapeHtml(group.page.title)}</span>
                ${group.page.excerpt ? `<span class="search-dialog__page-excerpt">${group.page.excerpt}</span>` : ''}
              </a>
              ${subsHtml}
            </div>`;
        })
        .join('');
      resultsEl.innerHTML = html;
      scrollActiveIntoView();
    };

    const scrollActiveIntoView = () => {
      const el = resultsEl.querySelector<HTMLElement>(`[data-index="${activeIndex}"]`);
      el?.scrollIntoView({ block: 'nearest' });
    };

    let searchToken = 0;
    const runSearch = async (query: string) => {
      const token = ++searchToken;
      if (!pagefind && !pagefindError) {
        await load();
        if (token !== searchToken) return;
      }
      const trimmed = query.trim();
      if (!trimmed || pagefindError) {
        groups = [];
        flatItems = [];
        render(trimmed);
        return;
      }
      const { results } = await pagefind!.search(trimmed);
      if (token !== searchToken) return;
      const top = await Promise.all(results.slice(0, 5).map((r) => r.data()));
      if (token !== searchToken) return;
      groups = top.map((d) => {
        const page: FlatItem = {
          url: d.url,
          title: d.meta.title || d.url,
          excerpt: d.excerpt,
          kind: 'page',
        };
        const subs: FlatItem[] = (d.sub_results ?? [])
          // Drop the implicit "whole page" sub-result Pagefind adds when its url matches the page url.
          .filter((s) => s.url !== d.url)
          .slice(0, 5)
          .map((s) => ({ url: s.url, title: s.title, excerpt: s.excerpt, kind: 'sub' }));
        return { page, subs };
      });
      flatItems = groups.flatMap((g) => [g.page, ...g.subs]);
      activeIndex = 0;
      render(query);
    };

    trigger.addEventListener('click', open);

    document.addEventListener('keydown', (e) => {
      const mod = e.metaKey || e.ctrlKey;
      if (mod && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) close();
        else open();
      }
    });

    input.addEventListener('input', () => {
      void runSearch(input.value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, flatItems.length - 1);
        render(input.value);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        render(input.value);
      } else if (e.key === 'Enter') {
        const sel = flatItems[activeIndex];
        if (sel) {
          e.preventDefault();
          window.location.href = sel.url;
        }
      }
    });

    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog) {
        close();
        return;
      }
      const link = target.closest<HTMLAnchorElement>('[data-search-result]');
      if (link) {
        // Allow native nav; just close so it doesn't linger.
        close();
      }
    });

    dialog.addEventListener('close', () => {
      input.value = '';
      groups = [];
      flatItems = [];
      activeIndex = 0;
    });
  }
</script>

<style>
  .search-box {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 7px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-fg-subtle);
    cursor: pointer;
    font-family: inherit;
    font-size: 12px;
    line-height: 1;
    text-align: left;
    appearance: none;
    transition: border-color 0.12s var(--ease-out-soft);
  }
  .search-box:hover {
    border-color: var(--color-border-strong);
    color: var(--color-fg-muted);
  }
  .search-icon {
    font-size: 11px;
  }
  .search-label {
    font-size: 12px;
  }
  .search-kbd {
    margin-left: auto;
    display: inline-flex;
    gap: 2px;
  }
  .search-kbd kbd,
  .search-dialog__footer kbd,
  .search-dialog__esc {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    padding: 2px 5px;
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-2);
    color: var(--color-fg-muted);
  }

  .search-dialog {
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-fg);
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 64px));
    position: fixed;
    top: 15vh;
    left: 50%;
    transform: translateX(-50%);
    overflow: hidden;
  }
  .search-dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(2px);
  }

  .search-dialog__form {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .search-dialog__field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--color-border);
  }
  .search-dialog__icon {
    color: var(--color-fg-muted);
    font-size: 14px;
  }
  .search-dialog__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-fg);
    font: inherit;
    font-size: 15px;
    padding: 0;
  }
  .search-dialog__input::placeholder {
    color: var(--color-fg-subtle);
  }

  .search-dialog__results {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
    min-height: 120px;
  }
  .search-dialog__empty {
    padding: 24px 12px;
    text-align: center;
    color: var(--color-fg-subtle);
    font-size: 13px;
    line-height: 1.6;
  }
  .search-dialog__empty code {
    font-family: var(--font-mono);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
    font-size: 12px;
    color: var(--color-fg);
  }

  .search-dialog__group {
    margin-bottom: 4px;
  }
  .search-dialog__group + .search-dialog__group {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
  }

  .search-dialog__page {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-fg);
    cursor: pointer;
  }
  .search-dialog__page:hover,
  .search-dialog__page[aria-selected='true'] {
    background: var(--color-surface-2);
  }
  .search-dialog__page-title {
    font-size: 14px;
    font-weight: 600;
  }
  .search-dialog__page-excerpt {
    font-size: 12px;
    color: var(--color-fg-muted);
    line-height: 1.5;
  }

  .search-dialog__sub {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 12px 8px 18px;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-fg);
    cursor: pointer;
  }
  .search-dialog__sub:hover,
  .search-dialog__sub[aria-selected='true'] {
    background: var(--color-surface-2);
  }
  .search-dialog__sub-hash {
    color: var(--color-fg-subtle);
    font-size: 12px;
    line-height: 1.5;
    flex-shrink: 0;
  }
  .search-dialog__sub-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .search-dialog__sub-title {
    font-size: 13px;
    font-weight: 500;
  }
  .search-dialog__sub-excerpt {
    font-size: 12px;
    color: var(--color-fg-muted);
    line-height: 1.5;
  }

  .search-dialog__page-excerpt :global(mark),
  .search-dialog__sub-excerpt :global(mark) {
    background: color-mix(in oklch, var(--color-primary) 30%, transparent);
    color: var(--color-fg);
    padding: 0 2px;
    border-radius: 2px;
  }

  .search-dialog__footer {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 10px 16px;
    border-top: 1px solid var(--color-border);
    color: var(--color-fg-subtle);
    font-size: 11px;
  }
  .search-dialog__footer span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
</style>
