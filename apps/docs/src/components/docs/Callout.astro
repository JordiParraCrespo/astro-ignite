---
/**
 * Callout / admonition block — used inside MDX content.
 *
 * Variants: note, info, tip, check, warning, danger. Each is a full-border tinted box with
 * a leading icon, a title, and body copy. Status colors resolve through the
 * design tokens (success / warning / danger); the tint + border are derived
 * from them via color-mix so the block adapts to light and dark themes.
 *
 * Usage in MDX:
 *   <Callout variant="warning" title="Heads up">
 *     Setup prompts can be skipped with `--yes`.
 *   </Callout>
 */

type Variant = 'note' | 'info' | 'tip' | 'check' | 'warning' | 'danger';

interface Props {
  variant?: Variant;
  title?: string;
}

const { variant = 'note', title } = Astro.props;

const defaultTitles: Record<Variant, string> = {
  note: 'Note',
  info: 'Info',
  tip: 'Tip',
  check: 'Check',
  warning: 'Heads up',
  danger: 'Warning',
};

const heading = title ?? defaultTitles[variant];
---

<aside
  class:list={['callout', `callout-${variant}`]}
  role={variant === 'danger' || variant === 'warning' ? 'alert' : undefined}
>
  <span class="callout-icon" aria-hidden="true">
    {
      variant === 'note' && (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
      )
    }
    {
      variant === 'info' && (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </svg>
      )
    }
    {
      variant === 'check' && (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="m9 12 2 2 4-4" />
        </svg>
      )
    }
    {
      variant === 'tip' && (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 2v4" />
          <path d="m4.93 4.93 2.83 2.83" />
          <path d="m16.24 7.76 2.83-2.83" />
          <circle cx="12" cy="14" r="6" />
          <path d="M9 20h6" />
        </svg>
      )
    }
    {
      variant === 'warning' && (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m10.29 3.86-8.06 14a2 2 0 0 0 1.71 3h16.12a2 2 0 0 0 1.71-3l-8.06-14a2 2 0 0 0-3.42 0z" />
          <line x1="12" y1="9" x2="12" y2="13" />
          <line x1="12" y1="17" x2="12.01" y2="17" />
        </svg>
      )
    }
    {
      variant === 'danger' && (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10" />
          <line x1="15" y1="9" x2="9" y2="15" />
          <line x1="9" y1="9" x2="15" y2="15" />
        </svg>
      )
    }
  </span>
  <div class="callout-content">
    <div class="callout-title">{heading}</div>
    <div class="callout-body"><slot /></div>
  </div>
</aside>

<!-- tailwind-exception: per-variant tint + border are derived from the status tokens via color-mix(), and the icon column is a prop-driven layout — clearer as one scoped block than arbitrary-value utilities -->
<style>
  .callout {
    display: flex;
    gap: 12px;
    margin: 1.5rem 0;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
  }
  .callout-icon {
    display: flex;
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--color-fg);
  }
  .callout-icon svg {
    width: 16px;
    height: 16px;
  }
  .callout-content {
    min-width: 0;
  }
  .callout-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-fg);
    letter-spacing: -0.005em;
  }
  .callout-body {
    margin-top: 2px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-fg-muted);
  }
  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .callout-info {
    border-color: color-mix(in oklch, var(--color-info) 30%, transparent);
    background: color-mix(in oklch, var(--color-info) 8%, transparent);
  }
  .callout-info .callout-icon {
    color: var(--color-info);
  }

  .callout-check {
    border-color: color-mix(in oklch, var(--color-success) 28%, transparent);
    background: color-mix(in oklch, var(--color-success) 8%, transparent);
  }
  .callout-check .callout-icon {
    color: var(--color-success);
  }

  .callout-tip {
    border-color: color-mix(in oklch, var(--color-success) 28%, transparent);
    background: color-mix(in oklch, var(--color-success) 8%, transparent);
  }
  .callout-tip .callout-icon {
    color: var(--color-success);
  }

  .callout-warning {
    border-color: color-mix(in oklch, var(--color-warning) 30%, transparent);
    background: color-mix(in oklch, var(--color-warning) 8%, transparent);
  }
  .callout-warning .callout-icon {
    color: var(--color-warning);
  }

  .callout-danger {
    border-color: color-mix(in oklch, var(--color-danger) 30%, transparent);
    background: color-mix(in oklch, var(--color-danger) 7%, transparent);
  }
  .callout-danger .callout-icon {
    color: var(--color-danger);
  }
</style>
