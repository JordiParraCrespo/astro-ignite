---
/**
 * Callout / admonition block — used inside MDX content.
 *
 * Variants: note, info, tip, check, warning, danger. Layout follows the
 * shadcn alert: a two-column grid with a fixed icon column, the title tinted
 * to the variant's status color, and the body in muted foreground. Tint +
 * border derive from the status tokens via color-mix so the block adapts to
 * light and dark themes without extra tokens.
 *
 * Usage in MDX:
 *   <Callout variant="warning" title="Heads up">
 *     Setup prompts can be skipped with `--yes`.
 *   </Callout>
 */

import { cn } from '@/lib/cn';

type Variant = 'note' | 'info' | 'tip' | 'check' | 'warning' | 'danger';

interface Props {
  variant?: Variant;
  title?: string;
  class?: string;
}

const { variant = 'note', title, class: className } = Astro.props;

const defaultTitles: Record<Variant, string> = {
  note: 'Note',
  info: 'Info',
  tip: 'Tip',
  check: 'Check',
  warning: 'Heads up',
  danger: 'Warning',
};

// [container, title + icon]
const styles: Record<Variant, [string, string]> = {
  note: ['border-border bg-surface-2', 'text-fg'],
  info: [
    'border-[color-mix(in_oklch,var(--color-info)_35%,transparent)] bg-[color-mix(in_oklch,var(--color-info)_8%,transparent)]',
    'text-info',
  ],
  tip: [
    'border-[color-mix(in_oklch,var(--color-success)_32%,transparent)] bg-[color-mix(in_oklch,var(--color-success)_8%,transparent)]',
    'text-success',
  ],
  check: [
    'border-[color-mix(in_oklch,var(--color-success)_32%,transparent)] bg-[color-mix(in_oklch,var(--color-success)_8%,transparent)]',
    'text-success',
  ],
  warning: [
    'border-[color-mix(in_oklch,var(--color-warning)_38%,transparent)] bg-[color-mix(in_oklch,var(--color-warning)_9%,transparent)]',
    'text-warning',
  ],
  danger: [
    'border-[color-mix(in_oklch,var(--color-danger)_35%,transparent)] bg-[color-mix(in_oklch,var(--color-danger)_7%,transparent)]',
    'text-danger',
  ],
};

const [box, accent] = styles[variant];
const heading = title ?? defaultTitles[variant];
const svgAttrs = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '2',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
  class: 'size-4 translate-y-px',
} as const;
---

<aside
  class={cn(
    'callout my-6 grid grid-cols-[1rem_1fr] items-start gap-x-3 gap-y-1 rounded-lg border px-4 py-3 text-sm',
    box,
    className
  )}
  role={variant === 'danger' || variant === 'warning' ? 'alert' : undefined}
>
  <span class={cn('flex', accent)}>
    {
      variant === 'note' && (
        <svg {...svgAttrs}>
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
      )
    }
    {
      variant === 'info' && (
        <svg {...svgAttrs}>
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4" />
          <path d="M12 8h.01" />
        </svg>
      )
    }
    {
      variant === 'check' && (
        <svg {...svgAttrs}>
          <circle cx="12" cy="12" r="10" />
          <path d="m9 12 2 2 4-4" />
        </svg>
      )
    }
    {
      variant === 'tip' && (
        <svg {...svgAttrs}>
          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
          <path d="M9 18h6" />
          <path d="M10 22h4" />
        </svg>
      )
    }
    {
      variant === 'warning' && (
        <svg {...svgAttrs}>
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
        </svg>
      )
    }
    {
      variant === 'danger' && (
        <svg {...svgAttrs}>
          <circle cx="12" cy="12" r="10" />
          <path d="m15 9-6 6" />
          <path d="m9 9 6 6" />
        </svg>
      )
    }
  </span>
  <div class={cn('min-h-4 leading-tight font-medium tracking-tight', accent)}>{heading}</div>
  <div class="callout-body col-start-2 text-fg-muted [&_p]:leading-relaxed [&_p:last-child]:mb-0!">
    <slot />
  </div>
</aside>
