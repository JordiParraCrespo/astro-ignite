---
/**
 * Sidebar navigation — left column of the docs layout.
 *
 * Reads the `sidebar` config and renders grouped links. Highlights the
 * current page based on `Astro.url.pathname`. Slugs resolve three ways: a
 * doc-collection id, a direct path (`/components/button`), or an external
 * URL (icon + open-in-new-tab). Groups can carry an icon, fold via native
 * `<details>` when `collapsed`, and belong to a top-level `tab`; the tab row
 * renders only once two or more tabs exist.
 */

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';

import Brand from '../common/Brand.astro';
import Icon from './Icon.astro';
import SearchBox from './SearchBox.astro';
import { cn } from '@/lib/cn';
import { sidebar } from '@/config/sidebar';
import type { SidebarGroup, SidebarItem } from '@/config/sidebar';
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';

interface Props {
  /** Path of the current page; used to mark the active item. */
  currentPath: string;
}

const { currentPath } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// Resolve labels from the current-locale entry's frontmatter. Sidebar config
// uses bare slugs (`introduction`); the collection id is `<locale>/<slug>`.
const allDocs = await getCollection('docs', (e: CollectionEntry<'docs'>) => !e.data.draft);
const titleForSlug = (slug: string): string => {
  const entry = allDocs.find((e) => e.id === `${locale}/${slug}`);
  return entry?.data.title ?? slug;
};

// True when a sidebar slug has an entry in the current locale.
const hasLocalizedEntry = (slug: string): boolean =>
  allDocs.some((e) => e.id === `${locale}/${slug}`);

const isExternal = (slug: string) => slug.startsWith('http');
// A slug starting with "/" is a direct path to a non-collection Astro page.
const isPath = (slug: string) => slug.startsWith('/');

// The home doc renders at the locale root (/ or /<lang>/), not at /<slug>.
const homeSlug = siteConfig.homePath.replace(/^\//, '');

const hrefFor = (slug: string) => {
  if (isExternal(slug) || isPath(slug)) return slug;
  if (slug === homeSlug) return getRelativeLocaleUrl(locale, '/');
  return getRelativeLocaleUrl(locale, `/${slug}`);
};

const isActive = (slug: string) => {
  if (isExternal(slug)) return false;
  const path = currentPath.replace(/\/$/, '');
  const target = hrefFor(slug).replace(/\/$/, '');
  return path === target;
};

const labelFor = (item: SidebarItem) =>
  item.labelKey ? t(item.labelKey) : (item.label ?? titleForSlug(item.slug));

const groups = sidebar
  .map((group) => ({
    ...group,
    items: group.items.filter(
      (item) => isExternal(item.slug) || isPath(item.slug) || hasLocalizedEntry(item.slug)
    ),
  }))
  .filter((group) => group.items.length > 0);

// Tabs: distinct `tab` values in config order. The active tab is the one
// holding the current page, else the first. A tab links to its first item.
const tabs = [...new Set(groups.map((g) => g.tab).filter((v): v is string => !!v))];
const activeTab =
  groups.find((g) => g.tab && g.items.some((i) => isActive(i.slug)))?.tab ?? tabs[0];
const tabHref = (tab: string) => {
  const first = groups.find((g) => g.tab === tab)?.items[0];
  return first ? hrefFor(first.slug) : '#';
};
const visibleGroups: SidebarGroup[] =
  tabs.length > 1 ? groups.filter((g) => !g.tab || g.tab === activeTab) : groups;

// `cn` concatenates without merging, so idle and active carry disjoint color
// classes instead of stacking conflicting ones.
const linkBase =
  'flex items-center gap-2 rounded-(--radius-sm) px-2 py-1.5 text-[13px] leading-snug no-underline transition-colors duration-100';
const linkIdle = 'text-fg-muted hover:bg-surface-2 hover:text-fg';
const linkActive =
  'bg-[color-mix(in_oklch,var(--color-accent)_10%,transparent)] font-medium text-accent hover:bg-[color-mix(in_oklch,var(--color-accent)_14%,transparent)]';
const headingBase = 'm-0 flex items-center gap-2 px-2 py-1 text-[12px] font-medium text-fg';
---

<aside
  class="sidebar flex flex-col gap-5 border-b border-border bg-bg px-4 py-4 md:sticky md:top-0 md:h-screen md:overflow-x-hidden md:overflow-y-auto md:border-r md:border-b-0 md:pt-7 md:pb-8"
  aria-label={t('nav.documentation')}
>
  <header class="flex items-center justify-between gap-2 px-1">
    <Brand href={getRelativeLocaleUrl(locale, '/')} variant="lockup" size={0.34} />
    <button
      type="button"
      data-docs-nav-toggle
      aria-controls="docs-nav-panel"
      aria-expanded="false"
      aria-label={t('nav.openMenu')}
      class="inline-flex cursor-pointer appearance-none items-center justify-center rounded-(--radius-sm) border-0 bg-transparent p-2 text-fg transition-colors hover:bg-surface-2 md:hidden"
    >
      <span class="flex w-5 flex-col gap-[4px]" aria-hidden="true">
        <span class="block h-[2px] rounded-[1px] bg-current"></span>
        <span class="block h-[2px] rounded-[1px] bg-current"></span>
        <span class="block h-[2px] rounded-[1px] bg-current"></span>
      </span>
    </button>
  </header>

  <div id="docs-nav-panel" data-docs-nav-panel class="hidden flex-col gap-5 md:flex [&.open]:flex">
    <SearchBox />

    {
      tabs.length > 1 && (
        <div class="flex gap-1 rounded-(--radius) border border-border bg-surface-2 p-1">
          {tabs.map((tab) => (
            <a
              href={tabHref(tab)}
              aria-current={tab === activeTab ? 'true' : undefined}
              class={cn(
                'flex-1 rounded-(--radius-sm) px-2 py-1 text-center text-[12px] font-medium no-underline transition-colors duration-100',
                tab === activeTab
                  ? 'bg-surface text-accent shadow-(--shadow-sm)'
                  : 'text-fg-muted hover:text-fg'
              )}
            >
              {tab}
            </a>
          ))}
        </div>
      )
    }

    <nav class="flex flex-col gap-5" aria-label={t('nav.sidebar')}>
      {
        visibleGroups.map((group) => {
          const hasActive = group.items.some((i) => isActive(i.slug));
          const label = group.groupKey ? t(group.groupKey) : group.group;
          const links = (
            <ul class="m-0 flex list-none flex-col gap-px p-0">
              {group.items.map((item) => (
                <li>
                  <a
                    href={hrefFor(item.slug)}
                    class={cn(linkBase, isActive(item.slug) ? linkActive : linkIdle)}
                    aria-current={isActive(item.slug) ? 'page' : undefined}
                    rel={isExternal(item.slug) ? 'noopener noreferrer' : undefined}
                    target={isExternal(item.slug) ? '_blank' : undefined}
                  >
                    {item.icon && (
                      <span class="flex text-fg-subtle" aria-hidden="true">
                        <Icon name={item.icon} size={14} />
                      </span>
                    )}
                    <span>{labelFor(item)}</span>
                    {item.badge && (
                      <span class="mono ml-auto rounded-(--radius-sm) border border-border px-[5px] py-px text-[10px] text-fg-subtle">
                        {item.badge}
                      </span>
                    )}
                    {isExternal(item.slug) && (
                      <span class="ml-auto flex text-fg-subtle" aria-hidden="true">
                        <Icon name="arrow-up-right" size={12} />
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          );
          const heading = (
            <>
              {group.icon && (
                <span class="flex text-fg-muted" aria-hidden="true">
                  <Icon name={group.icon} size={14} />
                </span>
              )}
              <span>{label}</span>
            </>
          );
          // Collapsible groups fold via native <details>; auto-open when one
          // of the items is the current page.
          return group.collapsed ? (
            <details class="group/nav flex flex-col gap-1" open={hasActive}>
              <summary
                class={cn(
                  headingBase,
                  'cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden'
                )}
              >
                {heading}
                <span
                  class="ml-auto flex text-fg-subtle transition-transform duration-150 group-open/nav:rotate-90"
                  aria-hidden="true"
                >
                  <Icon name="chevron-right" size={12} />
                </span>
              </summary>
              {links}
            </details>
          ) : (
            <div class="flex flex-col gap-1">
              <h2 class={headingBase}>{heading}</h2>
              {links}
            </div>
          );
        })
      }
    </nav>
  </div>
</aside>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-docs-nav-toggle]');
  const panel = document.getElementById('docs-nav-panel');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!panel.classList.contains('open')));
    // Navigating closes the drawer; collapse on in-page anchor clicks too.
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    // Reset state when the viewport grows past the mobile breakpoint.
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
