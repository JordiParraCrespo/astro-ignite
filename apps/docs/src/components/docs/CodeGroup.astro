---
/**
 * CodeGroup — combines several <CodeBlock> children into one tabbed panel.
 * Each child's `filename` becomes a tab label (the npm/pnpm/yarn pattern, or
 * curl/python/node for an API). The custom element synthesizes the tab strip
 * and a single copy button, then shows one block at a time.
 *
 * Usage in MDX:
 *   <CodeGroup>
 *     <CodeBlock filename="npm">{`npm i astro-ignite`}</CodeBlock>
 *     <CodeBlock filename="pnpm">{`pnpm add astro-ignite`}</CodeBlock>
 *   </CodeGroup>
 */

import { cn } from '@/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ai-code-group
  class={cn(
    'code-group my-6 block overflow-hidden rounded-(--radius-md) border border-(--color-border) bg-(--color-surface-2)',
    className
  )}
>
  <slot />
</ai-code-group>

<!-- tailwind-exception: structural overrides reach into slotted CodeBlock children via :global() — not expressible as utilities on this element. The synthesized tab strip is styled with utility classes assigned in the script below (scoped styles can't reach runtime-created elements). -->
<style>
  .code-group :global(.code-block) {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .code-group :global(.code-block [data-cb-header]) {
    display: none;
  }
</style>

<script>
  if (!customElements.get('ai-code-group')) {
    class AiCodeGroup extends HTMLElement {
      connectedCallback() {
        const blocks = Array.from(this.querySelectorAll<HTMLElement>(':scope > .code-block'));
        if (blocks.length === 0) return;

        const tabs = document.createElement('div');
        tabs.className = 'flex items-stretch border-b border-border bg-surface-2 px-2';
        tabs.setAttribute('role', 'tablist');

        const buttons: HTMLButtonElement[] = [];

        const activate = (idx: number) => {
          blocks.forEach((b, i) => {
            b.hidden = i !== idx;
          });
          buttons.forEach((b, i) => {
            const on = i === idx;
            b.dataset.active = on ? 'true' : 'false';
            b.setAttribute('aria-selected', on ? 'true' : 'false');
            b.tabIndex = on ? 0 : -1;
          });
        };

        blocks.forEach((block, i) => {
          const name = block.dataset.filename || `tab ${i + 1}`;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            '-mb-px cursor-pointer appearance-none border-0 border-b-[1.5px] border-solid border-transparent bg-transparent px-3 py-[9px] font-mono text-[11px] text-fg-muted transition-colors duration-100 hover:text-fg data-[active=true]:border-fg data-[active=true]:font-medium data-[active=true]:text-fg';
          btn.setAttribute('role', 'tab');
          btn.textContent = name;
          btn.addEventListener('click', () => activate(i));
          btn.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
            e.preventDefault();
            const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + blocks.length) % blocks.length;
            buttons[next]!.focus();
            activate(next);
          });
          buttons.push(btn);
          tabs.appendChild(btn);
        });

        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className =
          'ml-auto inline-flex cursor-pointer appearance-none items-center gap-1.5 border-0 bg-transparent px-2.5 font-mono text-[11px] text-fg-muted transition-colors duration-100 hover:text-fg';
        copy.innerHTML =
          '<svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span data-copy-label>copy</span>';
        const copyLabel = copy.querySelector('[data-copy-label]')!;
        copy.addEventListener('click', async () => {
          const active = blocks.find((b) => !b.hidden);
          const pre = active?.querySelector('pre');
          if (!pre || !navigator.clipboard) return;
          try {
            await navigator.clipboard.writeText(pre.textContent ?? '');
            copyLabel.textContent = 'copied';
            setTimeout(() => {
              copyLabel.textContent = 'copy';
            }, 1200);
          } catch {
            // Permissions denied — silently fail.
          }
        });
        tabs.appendChild(copy);

        this.prepend(tabs);
        activate(0);
      }
    }
    customElements.define('ai-code-group', AiCodeGroup);
  }
</script>
