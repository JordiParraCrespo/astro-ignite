---
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import { useTranslations, type TranslationKey } from '@/i18n';

const t = useTranslations(Astro.currentLocale);

const blockNames = [
  'page-hero',
  'breadcrumb',
  'release-pill',
  'command-block',
  'terminal-preview',
  'feature-grid',
  'post-list',
  'prev-next-nav',
  'author-card',
  'project-card',
  'metadata-grid',
  'toc-rail',
  'not-found-state',
  'notice-banner',
] as const;
---

<ComponentsLayout title={t('blocks.index.title')} description={t('blocks.index.description')}>
  <main class="page">
    <header class="page__head">
      <p class="page__eyebrow">{t('blocks.index.eyebrow')}</p>
      <h1 class="page__title">{t('blocks.index.title')}</h1>
      <p class="page__desc">
        {t('blocks.index.intro')}
        <code>npx astro-ignite add &lt;name&gt;</code>
        {t('blocks.index.introTail')}
      </p>
    </header>

    <ul class="grid">
      {
        blockNames.map((name) => (
          <li class="card">
            <a href={`/blocks/${name}`} class="card__link">
              <h2 class="card__title">{name}</h2>
              <p class="card__desc">{t(`blocks.summary.${name}` as TranslationKey)}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</ComponentsLayout>

<style>
  .page {
    max-width: 1080px;
  }
  .page__head {
    margin-bottom: 32px;
  }
  .page__eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg-subtle);
    margin: 0 0 8px;
  }
  .page__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 0 12px;
    color: var(--color-fg);
  }
  .page__desc {
    color: var(--color-fg-muted);
    font-size: 16px;
    line-height: 1.55;
    max-width: 60ch;
    margin: 0;
  }
  .page__desc code {
    font-family: var(--font-mono);
    font-size: 13px;
    background: var(--color-surface-2);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .card {
    display: flex;
  }
  .card__link {
    display: block;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-decoration: none;
    width: 100%;
    transition: border-color 120ms ease;
  }
  .card__link:hover {
    border-color: var(--color-border-strong);
  }
  .card__title {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    margin: 0 0 6px;
    color: var(--color-fg);
    text-transform: lowercase;
  }
  .card__desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-fg-muted);
    margin: 0;
  }
</style>
