---
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Skeleton from '@registry/base/skeleton.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`skeleton | ${t('seo.home.title')}`}
  description={t('components.summary.skeleton')}
>
  <ComponentShowcase
    name="skeleton"
    description={t('components.detail.skeleton.description')}
    file="skeleton.astro"
    anno="shimmer animation"
  >
    <div class="col" style="gap: 10px; max-width: 420px;">
      <div class="row" style="gap: 12px;">
        <Skeleton style="width: 36px; height: 36px; border-radius: 999px;" />
        <div class="col" style="gap: 6px; flex: 1;">
          <Skeleton style="width: 65%; height: 12px;" />
          <Skeleton style="width: 40%; height: 10px;" />
        </div>
      </div>
      <Skeleton style="width: 100%; height: 14px;" />
      <Skeleton style="width: 90%; height: 14px;" />
      <Skeleton style="width: 60%; height: 14px;" />
    </div>
  </ComponentShowcase>
</ComponentsLayout>
