---
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Label from '@registry/base/label.astro';
import Input from '@registry/base/input.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`label | ${t('seo.home.title')}`}
  description={t('components.summary.label')}
>
  <ComponentShowcase
    name="label"
    description={t('components.detail.label.description')}
    file="label.astro"
    anno="for form pairing"
  >
    <div class="field">
      <Label for="username">{t('components.detail.label.usernameLabel')}</Label>
      <Input id="username" placeholder="@handle" />
    </div>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 280px;
  }
</style>
