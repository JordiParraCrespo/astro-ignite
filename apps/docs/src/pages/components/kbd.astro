---
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Kbd from '@/components/ui/kbd.astro';
import Text from '@/components/ui/text.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout title={`kbd | ${t('seo.home.title')}`} description={t('components.summary.kbd')}>
  <ComponentShowcase
    name="kbd"
    description={t('components.detail.kbd.description')}
    file="kbd.astro"
    anno="inline keyboard shortcut"
  >
    <Text variant="muted" class="line">
      {t('components.detail.kbd.line1Pre')}
      <Kbd>⌘</Kbd>
      <Kbd>K</Kbd>
      {t('components.detail.kbd.line1Post')}
    </Text>
    <Text variant="muted" class="line">
      {t('components.detail.kbd.line2Pre')}
      <Kbd>Ctrl</Kbd>
      <Kbd>S</Kbd>{t('components.detail.kbd.line2Mid')}
      <Kbd>Ctrl</Kbd>
      <Kbd>Z</Kbd>{t('components.detail.kbd.line2Post')}
    </Text>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  .line {
    margin: 0;
    font-size: 13px;
    color: var(--color-fg-muted);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
