---
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import { useTranslations } from '@/i18n';

import Button from '@/components/ui/button.astro';
import Link from '@/components/ui/link.astro';
import Text from '@/components/ui/text.astro';
import Badge from '@/components/ui/badge.astro';
import Input from '@/components/ui/input.astro';
import Textarea from '@/components/ui/textarea.astro';
import Label from '@/components/ui/label.astro';
import Separator from '@/components/ui/separator.astro';
import Alert from '@/components/ui/alert.astro';
import Avatar from '@/components/ui/avatar.astro';
import Skeleton from '@/components/ui/skeleton.astro';
import Kbd from '@/components/ui/kbd.astro';
import Card from '@/components/ui/card/card.astro';
import CardHeader from '@/components/ui/card/card-header.astro';
import CardTitle from '@/components/ui/card/card-title.astro';
import CardDescription from '@/components/ui/card/card-description.astro';
import CardContent from '@/components/ui/card/card-content.astro';
import CardFooter from '@/components/ui/card/card-footer.astro';
import Tabs from '@/components/ui/tabs/tabs.astro';
import TabsList from '@/components/ui/tabs/tabs-list.astro';
import TabsTrigger from '@/components/ui/tabs/tabs-trigger.astro';
import TabsContent from '@/components/ui/tabs/tabs-content.astro';
import Accordion from '@/components/ui/accordion/accordion.astro';
import AccordionItem from '@/components/ui/accordion/accordion-item.astro';
import Tooltip from '@/components/ui/tooltip.astro';
import Toaster from '@/components/ui/toaster.astro';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`Components | ${t('seo.home.title')}`}
  description="Every visual surface in astro-ignite — registry primitives, site & docs chrome, and the landing composites."
>
  <div class="cat">
    <header class="cat__head">
      <Text variant="eyebrow" class="cat__eyebrow mono">Design system · 0.1.0</Text>
      <Text variant="h1" class="cat__title">Components</Text>
      <Text variant="lead" class="cat__lede">
        Every visual surface in astro-ignite, in one place. Registry primitives, site &amp; docs
        chrome, and the landing composites. All built on a single zinc scale and Geist type pairing.
      </Text>
      <div class="cat__meta mono">
        <span><strong>34</strong> components</span>
        <span><strong>19</strong> registry primitives</span>
        <span><strong>1</strong> brand mark</span>
      </div>

      <nav class="cat__jump mono" aria-label="Jump to section">
        <a href="#brand">Brand</a>
        <a href="#primitives">Primitives</a>
        <a href="#blocks">Blocks</a>
        <a href="#chrome">Chrome</a>
      </nav>
    </header>

    <!-- ============ BRAND ============ -->
    <section class="grp" id="brand">
      <header class="grp__head">
        <div>
          <Text variant="h2">Brand</Text>
          <Text variant="lead" class="grp__lede">
            The <span class="mono">&gt;_</span> mark and lockup. Always Geist Mono, always lowercase wordmark.
          </Text>
        </div>
        <span class="grp__count mono">1 component · 2 variants</span>
      </header>

      <article class="comp">
        <div class="comp__head">
          <Text variant="h3">Brand</Text>
          <span class="comp__file mono">apps/site/src/components/Brand.astro</span>
          <span class="comp__anno mono">variant=lockup | mark</span>
        </div>
        <div class="preview">
          <div class="row" style="gap: 48px; flex-wrap: wrap;">
            <div class="col">
              <span class="label mono">lockup</span>
              <div class="b-lockup">
                <span class="b-lockup__glyph mono">&gt;_</span>
                <span class="b-lockup__name">astro-ignite</span>
              </div>
            </div>
            <div class="col">
              <span class="label mono">mark</span>
              <div class="b-mark mono">&gt;_</div>
            </div>
            <div class="col">
              <span class="label mono">size · sm/md/lg</span>
              <div class="row" style="align-items: baseline; gap: 20px;">
                <span class="mono" style="font-size: 14px;">&gt;_</span>
                <span class="mono" style="font-size: 22px;">&gt;_</span>
                <span class="mono" style="font-size: 36px;">&gt;_</span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- ============ REGISTRY PRIMITIVES ============ -->
    <section class="grp" id="primitives">
      <header class="grp__head">
        <div>
          <Text variant="h2">Registry primitives</Text>
          <Text variant="lead" class="grp__lede">
            shadcn-style copy-paste components. Source in
            <span class="mono">packages/registry/base</span>.
          </Text>
        </div>
        <span class="grp__count mono">19 components</span>
      </header>

      <article class="comp" id="button">
        <div class="comp__head">
          <Text variant="h3">Button</Text><span class="comp__file mono">button.astro</span>
          <span class="comp__anno mono">5 variants · 3 sizes</span>
        </div>
        <div class="preview">
          <div class="row">
            <span class="label mono">variant</span>
            <Button>Default</Button>
            <Button variant="secondary">Secondary</Button>
            <Button variant="outline">Outline</Button>
            <Button variant="ghost">Ghost</Button>
            <Button variant="destructive">Destructive</Button>
          </div>
          <div class="row">
            <span class="label mono">size</span>
            <Button size="sm">Small</Button>
            <Button>Medium</Button>
            <Button size="lg">Large</Button>
          </div>
        </div>
      </article>

      <article class="comp" id="link">
        <div class="comp__head">
          <Text variant="h3">Link</Text><span class="comp__file mono">link.astro</span>
        </div>
        <div class="preview">
          <div class="row">
            <span class="label mono">variants</span>
            <Link href="#">Default link</Link>
            <span class="vsep"></span>
            <Link href="#" variant="muted">Muted link</Link>
            <span class="vsep"></span>
            <Link href="#" variant="underline">Underline link</Link>
          </div>
        </div>
      </article>

      <article class="comp" id="text">
        <div class="comp__head">
          <Text variant="h3">Text</Text><span class="comp__file mono">text.astro</span>
          <span class="comp__anno mono">11 variants · polymorphic</span>
        </div>
        <div class="preview">
          <div class="row">
            <span class="label mono">variant</span>
            <div class="col" style="gap: 12px; min-width: 100%;">
              <Text variant="display" as="p">Display</Text>
              <Text variant="h1" as="p">Heading h1</Text>
              <Text variant="h2" as="p">Heading h2</Text>
              <Text variant="h3" as="p">Heading h3</Text>
              <Text variant="h4" as="p">Heading h4</Text>
              <Text variant="lead">Lead paragraph for intros and ledes.</Text>
              <Text variant="body">Body copy, the default scale.</Text>
              <Text variant="small">Small caption text.</Text>
              <Text variant="muted">Muted de-emphasis text.</Text>
              <Text variant="eyebrow">Eyebrow label</Text>
              <p style="margin: 0;"><Text variant="code">npx astro-ignite</Text></p>
            </div>
          </div>
        </div>
      </article>

      <article class="comp" id="badge">
        <div class="comp__head">
          <Text variant="h3">Badge</Text><span class="comp__file mono">badge.astro</span>
        </div>
        <div class="preview">
          <div class="row">
            <span class="label mono">variants</span>
            <Badge>Default</Badge>
            <Badge variant="secondary">Secondary</Badge>
            <Badge variant="outline">Outline</Badge>
            <Badge variant="destructive">Destructive</Badge>
          </div>
        </div>
      </article>

      <article class="comp" id="card">
        <div class="comp__head">
          <Text variant="h3">Card</Text><span class="comp__file mono">card/*.astro</span>
          <span class="comp__anno mono">composition</span>
        </div>
        <div class="preview">
          <Card class="card-sample">
            <CardHeader>
              <CardTitle>Lighthouse 100s</CardTitle>
              <CardDescription
                >Mobile and desktop. CI budgets fail the build before regressions ship.</CardDescription
              >
            </CardHeader>
            <CardContent>
              Built into every template. Disable per-route with a frontmatter flag.
            </CardContent>
            <CardFooter>
              <Button size="sm">Configure</Button>
              <Button size="sm" variant="ghost">Learn more</Button>
            </CardFooter>
          </Card>
        </div>
      </article>

      <article class="comp" id="input">
        <div class="comp__head">
          <Text variant="h3">Input</Text><span class="comp__file mono">input.astro</span>
        </div>
        <div class="preview">
          <div class="row" style="align-items: flex-start; gap: 16px;">
            <div class="col field"><Label>Default</Label><Input placeholder="my-site" /></div>
            <div class="col field"><Label>Filled</Label><Input value="my-site" /></div>
            <div class="col field"><Label>Disabled</Label><Input disabled value="my-site" /></div>
          </div>
        </div>
      </article>

      <article class="comp" id="textarea">
        <div class="comp__head">
          <Text variant="h3">Textarea</Text><span class="comp__file mono">textarea.astro</span>
        </div>
        <div class="preview">
          <div class="col field" style="max-width: 360px;">
            <Label>Description</Label>
            <Textarea placeholder="Tell us about your site…" />
          </div>
        </div>
      </article>

      <article class="comp" id="label">
        <div class="comp__head">
          <Text variant="h3">Label</Text><span class="comp__file mono">label.astro</span>
        </div>
        <div class="preview">
          <div class="col field" style="max-width: 320px;">
            <Label for="proj">Project name <span class="lbl-aux">· required</span></Label>
            <Input id="proj" placeholder="my-site" />
          </div>
        </div>
      </article>

      <article class="comp" id="separator">
        <div class="comp__head">
          <Text variant="h3">Separator</Text><span class="comp__file mono">separator.astro</span>
        </div>
        <div class="preview">
          <div class="col" style="gap: 12px; max-width: 360px;">
            <span class="mono small-muted">Account settings</span>
            <Separator />
            <span class="mono small-muted">API keys · billing · usage</span>
          </div>
          <div class="row">
            <span class="label mono">vertical</span>
            <span>Docs</span><Separator orientation="vertical" />
            <span>Plan</span><Separator orientation="vertical" />
            <span>Changelog</span>
          </div>
        </div>
      </article>

      <article class="comp" id="alert">
        <div class="comp__head">
          <Text variant="h3">Alert</Text><span class="comp__file mono">alert.astro</span>
        </div>
        <div class="preview" style="max-width: 640px;">
          <Alert>
            <Fragment slot="title">Heads up</Fragment>
            Astro 6 ships strict TypeScript by default. Your existing routes will type-check on build.
          </Alert>
          <Alert variant="destructive">
            <Fragment slot="title">Build failed</Fragment>
            JSON-LD schema validation error in /blog/[slug]. See logs.
          </Alert>
        </div>
      </article>

      <article class="comp" id="avatar">
        <div class="comp__head">
          <Text variant="h3">Avatar</Text><span class="comp__file mono">avatar.astro</span>
        </div>
        <div class="preview">
          <div class="row">
            <span class="label mono">size</span>
            <Avatar size="sm" fallback="AI" />
            <Avatar fallback="AI" />
            <Avatar size="lg" fallback="AI" />
          </div>
          <div class="row">
            <span class="label mono">fallback</span>
            <Avatar fallback="JD" />
            <Avatar fallback="MK" />
            <Avatar fallback="RS" />
          </div>
        </div>

        <article class="comp" id="skeleton">
          <div class="comp__head">
            <Text variant="h3">Skeleton</Text><span class="comp__file mono">skeleton.astro</span>
          </div>
          <div class="preview">
            <div class="col" style="gap: 10px; max-width: 420px;">
              <div class="row" style="gap: 12px;">
                <Skeleton style="width:36px;height:36px;border-radius:99px;" />
                <div class="col" style="gap: 6px; flex: 1;">
                  <Skeleton style="width: 65%; height: 12px;" />
                  <Skeleton style="width: 40%; height: 10px;" />
                </div>
              </div>
              <Skeleton style="width: 100%; height: 14px;" />
              <Skeleton style="width: 90%; height: 14px;" />
              <Skeleton style="width: 60%; height: 14px;" />
            </div>
          </div>
        </article>

        <article class="comp" id="kbd">
          <div class="comp__head">
            <Text variant="h3">Kbd</Text><span class="comp__file mono">kbd.astro</span>
          </div>
          <div class="preview">
            <div class="row" style="gap: 8px;">
              <span class="small-muted">Search</span>
              <Kbd>⌘</Kbd><Kbd>K</Kbd>
              <span class="vsep"></span>
              <span class="small-muted">Toggle theme</span>
              <Kbd>⌘</Kbd><Kbd>⇧</Kbd><Kbd>D</Kbd>
              <span class="vsep"></span>
              <span class="small-muted">Confirm</span>
              <Kbd>↵</Kbd>
            </div>
          </div>
        </article>

        <article class="comp" id="tabs">
          <div class="comp__head">
            <Text variant="h3">Tabs</Text><span class="comp__file mono">tabs/*.astro</span>
          </div>
          <div class="preview">
            <Tabs defaultValue="preview">
              <TabsList>
                <TabsTrigger value="preview">Preview</TabsTrigger>
                <TabsTrigger value="code">Code</TabsTrigger>
                <TabsTrigger value="install">Install</TabsTrigger>
              </TabsList>
              <TabsContent value="preview">Live preview surface.</TabsContent>
              <TabsContent value="code">Source snippet.</TabsContent>
              <TabsContent value="install">npx astro-ignite add tabs</TabsContent>
            </Tabs>
          </div>
        </article>

        <article class="comp" id="accordion">
          <div class="comp__head">
            <Text variant="h3">Accordion</Text><span class="comp__file mono">accordion/*.astro</span
            >
          </div>
          <div class="preview">
            <Accordion>
              <AccordionItem title="Does the CLI vendor framework code?">
                No. Templates are owned by you — no runtime dependency on astro-ignite once
                scaffolded.
              </AccordionItem>
              <AccordionItem title="Can I add custom components after scaffolding?">
                Yes. The registry is shadcn-style: source files copy into your project on demand.
              </AccordionItem>
            </Accordion>
          </div>
        </article>

        <article class="comp" id="dialog">
          <div class="comp__head">
            <Text variant="h3">Dialog</Text><span class="comp__file mono">dialog/*.astro</span>
            <span class="comp__anno mono">native &lt;dialog&gt; element</span>
          </div>
          <div class="preview">
            <p class="small-muted" style="margin:0 0 8px;">
              Open via the registry's <code class="mono">openDialog()</code> helper. Static preview:
            </p>
            <div class="dialog-static">
              <div class="dialog-static__title">Delete project?</div>
              <div class="dialog-static__desc">
                This will permanently remove "my-site" and all its content. This action cannot be
                undone.
              </div>
              <div class="dialog-static__actions">
                <Button variant="ghost" size="sm">Cancel</Button>
                <Button variant="destructive" size="sm">Delete</Button>
              </div>
            </div>
          </div>
        </article>

        <article class="comp" id="dropdown-menu">
          <div class="comp__head">
            <Text variant="h3">Dropdown menu</Text><span class="comp__file mono"
              >dropdown-menu/*.astro</span
            >
            <span class="comp__anno mono">popover API</span>
          </div>
          <div class="preview">
            <div class="dd-static">
              <div class="dd-static__menu">
                <div class="dd-static__item">Profile <Kbd>⌘P</Kbd></div>
                <div class="dd-static__item dd-static__item--hover">Settings <Kbd>⌘,</Kbd></div>
                <div class="dd-static__item">Keyboard shortcuts <Kbd>⌘K</Kbd></div>
                <div class="dd-static__sep"></div>
                <div class="dd-static__item dd-static__item--danger">Sign out</div>
              </div>
            </div>
          </div>
        </article>

        <article class="comp" id="tooltip">
          <div class="comp__head">
            <Text variant="h3">Tooltip</Text><span class="comp__file mono">tooltip.astro</span>
            <span class="comp__anno mono">CSS-only</span>
          </div>
          <div class="preview">
            <div class="row" style="gap: 24px;">
              <Tooltip content="Save changes (⌘S)"
                ><Button variant="outline" size="sm">Hover me</Button></Tooltip
              >
              <Tooltip content="Open in new tab"
                ><Button variant="ghost" size="sm">↗</Button></Tooltip
              >
            </div>
          </div>
        </article>

        <article class="comp" id="toast">
          <div class="comp__head">
            <Text variant="h3">Toast</Text><span class="comp__file mono"
              >toaster.astro + lib/toast.ts</span
            >
          </div>
          <div class="preview">
            <div class="toast-static">
              <span class="toast-static__icon">i</span>
              <span class="toast-static__msg">Settings saved.</span>
              <button class="toast-static__close" aria-label="Close">×</button>
            </div>
            <Toaster />
          </div>
        </article>
      </article>

      <!-- ============ BLOCKS ============ -->
      <section class="grp" id="blocks">
        <header class="grp__head">
          <div>
            <Text variant="h2">Blocks</Text>
            <Text variant="lead" class="grp__lede">
              Drop-in feature blocks. Source in <span class="mono">packages/registry/blocks</span>.
            </Text>
          </div>
          <span class="grp__count mono">1 block</span>
        </header>

        <Text variant="small" class="more-link mono">
          <a href="/blocks/not-found-state">not-found-state</a>
        </Text>
      </section>

      <!-- ============ CHROME ============ -->
      <section class="grp" id="chrome">
        <header class="grp__head">
          <div>
            <Text variant="h2">Chrome</Text>
            <Text variant="lead" class="grp__lede">
              Static previews of the site &amp; docs chrome elements. The live components ship with
              both templates.
            </Text>
          </div>
          <span class="grp__count mono">7 components</span>
        </header>

        <article class="comp" id="nav">
          <div class="comp__head">
            <Text variant="h3">Nav</Text><span class="comp__file mono"
              >src/components/Header.astro</span
            >
          </div>
          <div class="preview">
            <div class="ch-nav">
              <span class="ch-nav__brand"
                ><span class="mono ch-nav__glyph">&gt;_</span> astro-ignite</span
              >
              <span class="ch-nav__links">
                <a href="#">Docs</a>
                <a href="#">Components</a>
                <a href="#">Blog</a>
              </span>
              <span class="ch-nav__cta">
                <Button size="sm" variant="outline">GitHub</Button>
                <Button size="sm">Get started</Button>
              </span>
            </div>
          </div>
        </article>

        <article class="comp" id="footer">
          <div class="comp__head">
            <Text variant="h3">Footer</Text><span class="comp__file mono"
              >src/components/Footer.astro</span
            >
          </div>
          <div class="preview">
            <div class="ch-foot">
              <div class="ch-foot__brand">
                <div class="ch-foot__title"><span class="mono">&gt;_</span> astro-ignite</div>
                <div>Astro sites, built for AI agents.</div>
              </div>
              <div class="ch-foot__cols">
                <div class="ch-foot__col">
                  <span class="ch-foot__head">Project</span><span>Docs</span><span>Roadmap</span
                  ><span>Changelog</span>
                </div>
                <div class="ch-foot__col">
                  <span class="ch-foot__head">Community</span><span>GitHub</span><span>Discord</span
                  >
                </div>
                <div class="ch-foot__col">
                  <span class="ch-foot__head">Legal</span><span>Privacy</span><span>Terms</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <article class="comp" id="locale-switcher">
          <div class="comp__head">
            <Text variant="h3">LocaleSwitcher</Text><span class="comp__file mono"
              >src/components/LocaleSwitcher.astro</span
            >
          </div>
          <div class="preview">
            <div class="loc-static">
              <button class="loc-static__trig"
                ><span class="loc-static__ic"></span> English <span class="mono small-muted"
                  >EN</span
                ></button
              >
              <div class="loc-static__menu">
                <div class="loc-static__item loc-static__item--on">
                  English <span class="mono small-muted">en</span>
                </div>
                <div class="loc-static__item">Español <span class="mono small-muted">es</span></div>
              </div>
            </div>
          </div>
        </article>

        <article class="comp" id="theme-toggle">
          <div class="comp__head">
            <Text variant="h3">ThemeToggle</Text><span class="comp__file mono"
              >src/components/ThemeToggle.astro</span
            >
          </div>
          <div class="preview">
            <div class="row" style="gap: 12px; align-items: center;">
              <button class="theme-btn-static" aria-label="Toggle theme"
                ><span class="theme-btn-static__gl"></span></button
              >
              <span class="small-muted">Tri-state: light → dark → system.</span>
            </div>
          </div>
        </article>

        <article class="comp" id="cookie-banner">
          <div class="comp__head">
            <Text variant="h3">CookieBanner</Text><span class="comp__file mono"
              >src/components/CookieBanner.astro</span
            >
          </div>
          <div class="preview">
            <div class="cookie">
              <span class="cookie__copy"
                >We use first-party cookies to remember your theme. Analytics is consent-gated —
                read our <a href="#">cookie policy</a>.</span
              >
              <span class="cookie__acts">
                <Button size="sm" variant="ghost">Decline</Button>
                <Button size="sm">Allow analytics</Button>
              </span>
            </div>
          </div>
        </article>

        <article class="comp" id="sidebar-nav">
          <div class="comp__head">
            <Text variant="h3">SidebarNav</Text><span class="comp__file mono"
              >src/components/docs/SidebarNav.astro</span
            >
          </div>
          <div class="preview">
            <div class="ch-sidenav">
              <div class="ch-sidenav__search">
                <span class="mono">⌕</span><span class="mono small-muted">Find component</span><Kbd
                  >⌘K</Kbd
                >
              </div>
              <div class="ch-sidenav__grp">
                <div class="ch-sidenav__gt mono">Start here</div>
                <div class="ch-sidenav__it ch-sidenav__it--on">Introduction</div>
                <div class="ch-sidenav__it">Quick start</div>
                <div class="ch-sidenav__it">Features</div>
              </div>
              <div class="ch-sidenav__grp">
                <div class="ch-sidenav__gt mono">Reference</div>
                <div class="ch-sidenav__it">Benchmarks</div>
              </div>
            </div>
          </div>
        </article>

        <article class="comp" id="search-box">
          <div class="comp__head">
            <Text variant="h3">SearchBox</Text><span class="comp__file mono"
              >src/components/docs/SearchBox.astro</span
            >
          </div>
          <div class="preview">
            <div class="ch-search">
              <span class="mono small-muted">⌕</span>
              <span class="small-muted">Search docs…</span>
              <Kbd>⌘K</Kbd>
            </div>
          </div>
        </article>
      </section>
    </section>
  </div>

  <style>
    .cat {
      max-width: 1200px;
    }
    .mono {
      font-family: var(--font-mono, ui-monospace, monospace);
    }
    .small-muted {
      font-size: 12px;
      color: var(--color-fg-muted);
    }

    .cat__head {
      padding-bottom: 28px;
      margin-bottom: 48px;
      border-bottom: 1px solid var(--color-border);
      display: flex;
      flex-direction: column;
      gap: 10px;
