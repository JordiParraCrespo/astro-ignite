---
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Card from '@/components/ui/card.astro';
import CardHeader from '@/components/ui/card-header.astro';
import CardTitle from '@/components/ui/card-title.astro';
import CardDescription from '@/components/ui/card-description.astro';
import CardContent from '@/components/ui/card-content.astro';
import CardFooter from '@/components/ui/card-footer.astro';
import Button from '@/components/ui/button.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`card | ${t('seo.home.title')}`}
  description={t('components.summary.card')}
>
  <ComponentShowcase
    name="card"
    description={t('components.detail.card.description')}
    file="card/card.astro · card-header · card-title · card-description · card-content · card-footer"
    anno="composition"
  >
    <div class="row" style="gap: 20px; align-items: flex-start;">
      <Card class="ai-card">
        <CardHeader>
          <CardTitle>{t('components.detail.card.title')}</CardTitle>
          <CardDescription>{t('components.detail.card.lede')}</CardDescription>
        </CardHeader>
        <CardContent>
          <p>{t('components.detail.card.body')}</p>
        </CardContent>
        <CardFooter>
          <Button size="sm" variant="outline">{t('components.detail.card.dismiss')}</Button>
          <Button size="sm">{t('components.detail.card.viewReport')}</Button>
        </CardFooter>
      </Card>
    </div>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  :global(.showcase__preview .ai-card) {
    width: 320px;
  }
</style>
