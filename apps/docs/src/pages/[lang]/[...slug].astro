---
/**
 * Per-locale docs route — non-default locales only.
 *
 * Default-locale entries render at `/<slug>` via the sibling file at
 * `src/pages/[...slug].astro`. This file generates `/<lang>/<slug>` for
 * every entry in a non-default locale that's also configured in
 * `siteConfig.locales`. Entries in unconfigured locales are skipped.
 */

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import DocsLayout from '@/layouts/DocsLayout.astro';
import Callout from '@/components/docs/Callout.astro';
import CodeBlock from '@/components/docs/CodeBlock.astro';
import { siteConfig } from '@/config/site';

export async function getStaticPaths() {
  const docs = await getCollection('docs', (e: CollectionEntry<'docs'>) => !e.data.draft);
  return docs.flatMap((entry) => {
    const segments = entry.id.split('/');
    const lang = segments[0]!;
    if (lang === siteConfig.defaultLocale) return [];
    if (!siteConfig.locales.includes(lang)) return [];
    const slug = segments.slice(1).join('/');
    return [{ params: { lang, slug }, props: { entry } }];
  });
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const mdxComponents = { Callout, CodeBlock };
---

<DocsLayout entry={entry} headings={headings}>
  <Content components={mdxComponents} />
</DocsLayout>
