---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Alert from '@registry/base/alert.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`alert | ${t('seo.home.title')}`}
  description={t('components.summary.alert')}
>
  <ComponentShowcase name="alert" description={t('components.detail.alert.description')}>
    <Alert>
      <strong>{t('components.detail.alert.defaultTitle')}</strong>
      {t('components.detail.alert.defaultBody')}
    </Alert>
    <Alert variant="success">
      <strong>{t('components.detail.alert.successTitle')}</strong>
      {t('components.detail.alert.successBody')}
    </Alert>
    <Alert variant="warning">
      <strong>{t('components.detail.alert.warningTitle')}</strong>
      {t('components.detail.alert.warningBody')}
    </Alert>
    <Alert variant="destructive">
      <strong>{t('components.detail.alert.destructiveTitle')}</strong>
      {t('components.detail.alert.destructiveBody')}
    </Alert>
  </ComponentShowcase>
</ComponentsLayout>
