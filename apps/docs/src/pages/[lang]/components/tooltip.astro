---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Tooltip from '@registry/base/tooltip.astro';
import Button from '@registry/base/button.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`tooltip | ${t('seo.home.title')}`}
  description={t('components.summary.tooltip')}
>
  <ComponentShowcase name="tooltip" description={t('components.detail.tooltip.description')}>
    <div class="row">
      <Tooltip content={t('components.detail.tooltip.tipTop')}>
        <Button variant="outline">{t('components.detail.tooltip.triggerTop')}</Button>
      </Tooltip>

      <Tooltip content={t('components.detail.tooltip.tipBottom')} side="bottom">
        <Button variant="outline">{t('components.detail.tooltip.triggerBottom')}</Button>
      </Tooltip>
    </div>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
</style>
