---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Accordion from '@/components/ui/accordion.astro';
import AccordionItem from '@/components/ui/accordion-item.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`accordion | ${t('seo.home.title')}`}
  description={t('components.summary.accordion')}
>
  <ComponentShowcase name="accordion" description={t('components.detail.accordion.description')}>
    <Accordion>
      <AccordionItem title={t('components.detail.accordion.q1Title')} open>
        <p>{t('components.detail.accordion.q1Body')}</p>
      </AccordionItem>
      <AccordionItem title={t('components.detail.accordion.q2Title')}>
        <p>{t('components.detail.accordion.q2Body')}</p>
      </AccordionItem>
      <AccordionItem title={t('components.detail.accordion.q3Title')}>
        <p>{t('components.detail.accordion.q3Body')}</p>
      </AccordionItem>
    </Accordion>
  </ComponentShowcase>
</ComponentsLayout>
