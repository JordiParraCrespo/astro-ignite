---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Textarea from '@/components/ui/textarea.astro';
import Label from '@/components/ui/label.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`textarea | ${t('seo.home.title')}`}
  description={t('components.summary.textarea')}
>
  <ComponentShowcase name="textarea" description={t('components.detail.textarea.description')}>
    <div class="field">
      <Label for="msg">{t('components.detail.textarea.messageLabel')}</Label>
      <Textarea
        id="msg"
        placeholder={t('components.detail.textarea.messagePlaceholder')}
        rows={5}
      />
    </div>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 480px;
  }
</style>
