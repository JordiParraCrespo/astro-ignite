---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Label from '@/components/ui/label.astro';
import Input from '@/components/ui/input.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`label | ${t('seo.home.title')}`}
  description={t('components.summary.label')}
>
  <ComponentShowcase name="label" description={t('components.detail.label.description')}>
    <div class="field">
      <Label for="username">{t('components.detail.label.usernameLabel')}</Label>
      <Input id="username" placeholder="@handle" />
    </div>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 320px;
  }
</style>
