---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Dialog from '@/components/ui/dialog/dialog.astro';
import DialogTitle from '@/components/ui/dialog/dialog-title.astro';
import DialogDescription from '@/components/ui/dialog/dialog-description.astro';
import Button from '@/components/ui/button.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`dialog | ${t('seo.home.title')}`}
  description={t('components.summary.dialog')}
>
  <ComponentShowcase name="dialog" description={t('components.detail.dialog.description')}>
    <Button data-dialog-open="demo-dialog">{t('components.detail.dialog.trigger')}</Button>

    <Dialog id="demo-dialog" labelledBy="demo-dialog-title">
      <DialogTitle id="demo-dialog-title">{t('components.detail.dialog.title')}</DialogTitle>
      <DialogDescription>{t('components.detail.dialog.body')}</DialogDescription>
      <div class="actions">
        <Button variant="outline" data-dialog-close>{t('components.detail.dialog.cancel')}</Button>
        <Button variant="destructive" data-dialog-close
          >{t('components.detail.dialog.confirm')}</Button
        >
      </div>
    </Dialog>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  .actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    margin-top: 12px;
  }
</style>
