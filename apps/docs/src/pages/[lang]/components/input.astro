---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}
import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Input from '@/components/ui/input.astro';
import Label from '@/components/ui/label.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`input | ${t('seo.home.title')}`}
  description={t('components.summary.input')}
>
  <ComponentShowcase name="input" description={t('components.detail.input.description')}>
    <div class="field">
      <Label for="email">{t('components.detail.input.emailLabel')}</Label>
      <Input id="email" type="email" placeholder="you@example.com" />
    </div>

    <div class="field">
      <Label for="disabled-input">{t('components.detail.input.disabledLabel')}</Label>
      <Input
        id="disabled-input"
        type="text"
        placeholder={t('components.detail.input.disabledPlaceholder')}
        disabled
      />
    </div>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 320px;
  }
</style>
