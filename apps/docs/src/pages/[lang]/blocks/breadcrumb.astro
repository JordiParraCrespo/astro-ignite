---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import Breadcrumb from '@registry/blocks/breadcrumb.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`breadcrumb | ${t('seo.home.title')}`}
  description={t('blocks.summary.breadcrumb')}
>
  <ComponentShowcase
    kind="block"
    name="breadcrumb"
    description={t('blocks.detail.breadcrumb.description')}
  >
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog', href: '/blog' },
        { label: 'Lighthouse 100s as a build target' },
      ]}
    />
    <Breadcrumb
      separator="›"
      items={[
        { label: 'Home', href: '/' },
        { label: 'Projects', href: '/projects' },
        { label: 'Aurora Health' },
      ]}
    />
  </ComponentShowcase>
</ComponentsLayout>
