---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import TocRail from '@registry/blocks/toc-rail/toc-rail.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`toc-rail | ${t('seo.home.title')}`}
  description={t('blocks.summary.toc-rail')}
>
  <ComponentShowcase
    kind="block"
    name="toc-rail"
    description={t('blocks.detail.toc-rail.description')}
  >
    <div class="layout">
      <article class="body">
        <h2 id="collect">What we collect</h2>
        <p>We collect minimal personal data necessary to operate the service.</p>
        <h2 id="use">How we use it</h2>
        <p>Email is used solely to communicate with you about the service.</p>
        <h2 id="cookies">Cookies</h2>
        <p>We use first-party cookies to remember your theme preference.</p>
        <h2 id="rights">Your rights</h2>
        <p>You may request a copy of your data at any time.</p>
      </article>
      <TocRail
        entries={[
          { id: 'collect', label: 'What we collect' },
          { id: 'use', label: 'How we use it' },
          { id: 'cookies', label: 'Cookies' },
          { id: 'rights', label: 'Your rights' },
        ]}
      />
    </div>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 32px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .body h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
  }
  .body p {
    margin: 0;
    color: var(--color-fg-muted);
    font-size: 14px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
