---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import NoticeBanner from '@/components/blocks/notice-banner.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`notice-banner | ${t('seo.home.title')}`}
  description={t('blocks.summary.notice-banner')}
>
  <ComponentShowcase
    kind="block"
    name="notice-banner"
    description={t('blocks.detail.notice-banner.description')}
  >
    <NoticeBanner
      >This is a template document. Review with legal counsel before publishing.</NoticeBanner
    >
    <NoticeBanner variant="warning"
      >Beta features are subject to change without notice.</NoticeBanner
    >
    <NoticeBanner variant="success">Settings saved.</NoticeBanner>
    <NoticeBanner variant="danger">Action could not be completed. Try again.</NoticeBanner>
  </ComponentShowcase>
</ComponentsLayout>
