---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import ProjectCard from '@registry/blocks/project-card.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`project-card | ${t('seo.home.title')}`}
  description={t('blocks.summary.project-card')}
>
  <ComponentShowcase
    kind="block"
    name="project-card"
    description={t('blocks.detail.project-card.description')}
  >
    <div class="grid">
      <ProjectCard
        href="#"
        status="Shipped"
        title="Aurora Health"
        description="Patient-portal redesign cutting LCP by 64%."
        tags={['astro', 'tailwind', 'i18n']}
      />
      <ProjectCard
        href="#"
        status="In progress"
        title="Lumen Analytics"
        description="Real-time dashboard with edge SSR."
        tags={['astro', 'edge', 'd3']}
      />
    </div>
  </ComponentShowcase>
</ComponentsLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
