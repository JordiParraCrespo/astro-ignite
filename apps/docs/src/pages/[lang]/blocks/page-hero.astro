---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import PageHero from '@registry/blocks/page-hero.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`page-hero | ${t('seo.home.title')}`}
  description={t('blocks.summary.page-hero')}
>
  <ComponentShowcase
    kind="block"
    name="page-hero"
    description={t('blocks.detail.page-hero.description')}
  >
    <PageHero
      eyebrow="About"
      title="A starter you can read in an afternoon."
      lede="We built astro-ignite because every new project burns a week on the same scaffolding. SEO, i18n, perf, legal, email — none of it should be a side quest."
    />
    <PageHero
      align="center"
      size="md"
      eyebrow="Contact"
      title="Drop us a line."
      lede="Questions, feedback, partnership ideas. We reply within two business days."
    />
  </ComponentShowcase>
</ComponentsLayout>
