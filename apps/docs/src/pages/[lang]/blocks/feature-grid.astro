---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import FeatureGrid from '@registry/blocks/feature-grid.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`feature-grid | ${t('seo.home.title')}`}
  description={t('blocks.summary.feature-grid')}
>
  <ComponentShowcase
    kind="block"
    name="feature-grid"
    description={t('blocks.detail.feature-grid.description')}
  >
    <FeatureGrid
      columns={3}
      features={[
        {
          index: '01',
          tag: 'perf',
          title: 'Lighthouse 100s',
          body: 'CI-enforced budgets on mobile + desktop.',
        },
        {
          index: '02',
          tag: 'core',
          title: 'Astro 5 + i18n',
          body: 'Native i18n, strict Zod content schemas.',
        },
        {
          index: '03',
          tag: 'css',
          title: 'Tailwind v4',
          body: 'Layered CSS, critical-CSS extraction.',
        },
        {
          index: '04',
          tag: 'seo',
          title: 'Typed JSON-LD',
          body: 'schema.org via schema-dts. Compile-time checks.',
        },
        {
          index: '05',
          tag: 'media',
          title: 'Image pipeline',
          body: 'AVIF/WebP/srcset. LQIP. Zero CLS.',
        },
        {
          index: '06',
          tag: 'type',
          title: 'Self-hosted fonts',
          body: 'Geist Sans + Mono, subset & preloaded.',
        },
      ]}
    />
  </ComponentShowcase>
</ComponentsLayout>
