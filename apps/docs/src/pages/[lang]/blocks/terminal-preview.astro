---
import { siteConfig } from '@/config/site';
export function getStaticPaths() {
  return siteConfig.locales
    .filter((lang) => lang !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

import ComponentsLayout from '@/layouts/ComponentsLayout.astro';
import ComponentShowcase from '@/components/docs/ComponentShowcase.astro';
import TerminalPreview from '@/components/blocks/terminal-preview.astro';
import { useTranslations } from '@/i18n';

const t = useTranslations(Astro.currentLocale);
---

<ComponentsLayout
  title={`terminal-preview | ${t('seo.home.title')}`}
  description={t('blocks.summary.terminal-preview')}
>
  <ComponentShowcase
    kind="block"
    name="terminal-preview"
    description={t('blocks.detail.terminal-preview.description')}
  >
    <TerminalPreview path="~/code">
      <span class="text-fg-subtle">$</span> npm create astro-ignite my-site<br /><br />
      <span class="text-fg-subtle">^</span> astro-ignite <span class="text-border-strong">v0.1.0</span><br />
      <span class="text-border-strong">│</span><br />
      <span class="text-border-strong">◇</span> Template? <span class="text-fg-subtle">starter</span><br />
      <span class="text-border-strong">◇</span> Languages? <span class="text-fg-subtle">en, es, ja</span><br />
      <span class="text-border-strong">◇</span> Email? <span class="text-fg-subtle">Resend</span><br />
      ◆ Install deps? <span class="inline-block px-1.5 py-px bg-fg text-bg rounded-[3px]">● Yes</span>
      <span class="text-fg-subtle">○ No</span><br />
      <span class="text-border-strong">└</span>{' '}
    </TerminalPreview>
  </ComponentShowcase>
</ComponentsLayout>
