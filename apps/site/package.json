{
  "name": "@astro-ignite/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "registry:build": "node ../../packages/registry/scripts/build-registry.mjs --out public/r",
    "predev": "pnpm run registry:build",
    "dev": "astro dev",
    "prebuild": "pnpm run registry:build",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"**/*.{ts,tsx,astro,md,mdx,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,md,mdx,json,yaml,yml}\""
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.18",
