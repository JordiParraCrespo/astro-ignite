    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.0.2",
    "markdown-it": "^14.1.1",
    "sanitize-html": "^2.17.4",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/sanitize-html": "^2.16.1",
    "prettier": "^3.4.2",
