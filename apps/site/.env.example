# =============================================================================
# astro-ignite environment variables
# =============================================================================
# Copy to .env and fill in real values for production. Local dev works without
# any of these set — the contact form logs to console, analytics is disabled.

# -----------------------------------------------------------------------------
# Email — contact form
# -----------------------------------------------------------------------------
# Resend (https://resend.com) — recommended for transactional email
# Required for the contact form to actually deliver email in production.
RESEND_API_KEY=

# OR — SMTP (uncomment if you chose SMTP at scaffold time)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Where contact form submissions are sent
CONTACT_TO_EMAIL=

# -----------------------------------------------------------------------------
# Analytics — Plausible (privacy-friendly, no cookies, no banner needed)
# -----------------------------------------------------------------------------
# Leave blank to disable analytics entirely.
PUBLIC_PLAUSIBLE_DOMAIN=

# Only set if you self-host Plausible (CE)
# PUBLIC_PLAUSIBLE_HOST=https://your-plausible-instance.example.com
