---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { breadcrumbListSchema, contactPageSchema } from '@/lib/jsonld';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// Static page — the form posts to the /api/contact Pages Function, which sends
// the email and redirects back here with ?status=sent|error. The inline script
// below surfaces the matching banner; the form works without JS (the email
// still sends), only the on-page confirmation needs it.
const here = Astro.url.pathname;

const schemas = [
  breadcrumbListSchema([
    { name: t('nav.home'), url: '/' },
    { name: t('nav.contact'), url: '/contact' },
  ]),
  contactPageSchema({
    url: '/contact',
    title: t('seo.contact.title'),
    description: t('seo.contact.description'),
    inLanguage: locale,
  }),
];
---

<BaseLayout
  title={t('seo.contact.title')}
  description={t('seo.contact.description')}
  schemas={schemas}
>
  <section class="page">
    <header class="page-header">
      <h1>{t('seo.contact.title')}</h1>
      <p class="lede">{t('seo.contact.description')}</p>
    </header>

    <div
      id="contact-status"
      class="alert"
      hidden
      data-sent={`✓ ${t('contact.success')}`}
      data-error={`✗ ${t('contact.error')}`}
    >
    </div>

    <form method="POST" action="/api/contact" class="contact-form">
      <input type="hidden" name="_redirect" value={here} />
      <div class="field">
        <label for="name">{t('contact.name')}</label>
        <input id="name" name="name" type="text" required maxlength="100" autocomplete="name" />
      </div>

      <div class="field">
        <label for="email">{t('contact.email')}</label>
        <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />
      </div>

      <div class="field">
        <label for="message">{t('contact.message')}</label>
        <textarea id="message" name="message" rows="6" required minlength="10" maxlength="5000"
        ></textarea>
      </div>

      {/* Honeypot — bots fill this, humans don't */}
      <div class="honeypot" aria-hidden="true">
        <label for="_website">{t('contact.honeypot')}</label>
        <input id="_website" name="_website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="btn btn-primary">
        {t('contact.send')}
      </button>
    </form>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const status = new URLSearchParams(location.search).get('status');
    if (status !== 'sent' && status !== 'error') return;
    const el = document.getElementById('contact-status');
    if (!el) return;
    const ok = status === 'sent';
    el.classList.add(ok ? 'alert-success' : 'alert-error');
    el.setAttribute('role', ok ? 'status' : 'alert');
    el.textContent = ok ? el.dataset.sent : el.dataset.error;
    el.hidden = false;
    // Drop the query param so a refresh doesn't re-show the banner.
    history.replaceState(null, '', location.pathname);
  })();
</script>

<style>
  .page {
    max-width: 36rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }
  .page-header {
    margin-bottom: 2rem;
  }
  .page-header h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
  }
  .lede {
    font-size: 1.125rem;
    color: var(--color-fg-muted);
    margin: 0;
  }

  .alert {
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
  }
  .alert-success {
    background: color-mix(in oklch, var(--color-success) 12%, var(--color-bg));
    border: 1px solid color-mix(in oklch, var(--color-success) 30%, transparent);
    color: var(--color-success);
  }
  .alert-error {
    background: color-mix(in oklch, var(--color-danger) 10%, var(--color-bg));
    border: 1px solid color-mix(in oklch, var(--color-danger) 30%, transparent);
    color: var(--color-danger);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .field label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-fg);
  }
  .field input,
  .field textarea {
    font-family: inherit;
    font-size: 1rem;
    padding: 0.625rem 0.75rem;
    background: var(--color-bg);
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    transition: border-color 0.15s var(--ease-out-soft);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-primary) 25%, transparent);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    top: -9999px;
    height: 0;
    width: 0;
    overflow: hidden;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.125rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border: 1px solid transparent;
    cursor: pointer;
    align-self: flex-start;
    font-family: inherit;
    transition: opacity 0.15s var(--ease-out-soft);
  }
  .btn-primary {
    background: var(--color-fg);
    color: var(--color-bg);
  }
  .btn-primary:hover {
    opacity: 0.9;
  }
</style>
