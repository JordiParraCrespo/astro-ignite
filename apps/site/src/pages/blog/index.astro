---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import { useTranslations } from '@/i18n';
import { siteConfig } from '@/config/site';
import { breadcrumbListSchema, collectionPageSchema } from '@/lib/jsonld';
import { getBlogCards } from '@/lib/blog';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const cards = await getBlogCards(locale);
const total = cards.length;
const startYear = cards.length
  ? Math.min(...cards.map((c) => c.post.data.datePublished.getFullYear()))
  : new Date().getFullYear();

const [featured, ...rest] = cards;

const schemas = [
  breadcrumbListSchema([
    { name: t('nav.home'), url: '/' },
    { name: t('nav.blog'), url: '/blog' },
  ]),
  collectionPageSchema({
    url: '/blog',
    title: t('seo.blog.title'),
    description: t('seo.blog.description'),
    inLanguage: locale,
  }),
];
---

<BaseLayout title={t('seo.blog.title')} description={t('seo.blog.description')} schemas={schemas}>
  <div class="blog-ct">
    <header class="bi-head">
      <div class="bi-lead">
        <span class="eye mono">{t('nav.blog')}</span>
        <h1>{t('seo.blog.title')}</h1>
        <p>{t('seo.blog.description')}</p>
      </div>
      <div class="bi-meta mono">{total} posts · since {startYear}</div>
    </header>

    {
      cards.length === 0 ? (
        <p class="empty">{t('blog.noPosts')}</p>
      ) : (
        <>
          {featured && (
            <a href={featured.href} class="feat">
              <div class="feat-left">
                <span class="feat-label mono">Featured · most recent</span>
                <h2>{featured.post.data.title}</h2>
                <p class="ex">{featured.post.data.description}</p>
                <div class="feat-meta mono">
                  <time datetime={featured.dateIso}>{featured.dateText}</time>
                  <span class="dot" aria-hidden="true">·</span>
                  <span class="author">
                    <span class="av">{featured.authorInitials}</span>
                    {featured.authorName}
                  </span>
                  <span class="dot" aria-hidden="true">·</span>
                  <span class="badge-mono">{featured.minutes} min read</span>
                </div>
                {featured.tags.length > 0 && (
                  <div class="feat-tags">
                    {featured.tags.map((tag) => (
                      <span class="chip mono">#{tag}</span>
                    ))}
                  </div>
                )}
                <div class="feat-actions">
                  <span class="btn btn-primary btn-sm">Read article →</span>
                </div>
              </div>
              <div class="feat-right" aria-hidden="true">
                <div class="feat-ovl">
                  <div class="feat-top">
                    <span class="mono">{featured.glyph}</span>
                    <span class="mono dim">cover · 4:3</span>
                  </div>
                  <div class="feat-bottom">
                    <span class="num mono">{featured.number}</span>
                    <span class="mono dim">{featured.dateText}</span>
                  </div>
                </div>
              </div>
            </a>
          )}

          {rest.length > 0 && (
            <div class="blog-grid">
              {rest.map((c) => (
                <BlogCard card={c} />
              ))}
            </div>
          )}
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .blog-ct {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 40px 96px;
  }
  @media (max-width: 720px) {
    .blog-ct {
      padding: 48px 24px 72px;
    }
  }

  .bi-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--color-border);
  }
  .bi-lead {
    max-width: 56ch;
  }
  .eye {
    display: inline-block;
    font-size: 11px;
    color: var(--color-fg-subtle);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .bi-head h1 {
    margin: 8px 0 6px;
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--color-fg);
  }
  .bi-head p {
    margin: 0;
    font-size: 15px;
    color: var(--color-fg-muted);
    max-width: 56ch;
    line-height: 1.55;
  }
  .bi-meta {
    font-size: 12px;
    color: var(--color-fg-subtle);
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .bi-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .empty {
    color: var(--color-fg-muted);
    text-align: center;
    padding: 64px 0;
  }

  /* ===== Featured ===== */
  .feat {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    padding: 36px 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }
  @media (max-width: 900px) {
    .feat {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  .feat-left {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-self: center;
  }
  .feat-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--color-fg-subtle);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .feat-label::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--color-fg);
  }
  .feat h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-wrap: balance;
    color: var(--color-fg);
  }
  .feat .ex {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-fg-muted);
    max-width: 50ch;
  }
  .feat-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    color: var(--color-fg-subtle);
    flex-wrap: wrap;
  }
  .feat-meta .dot {
    color: var(--color-border-strong);
  }
  .feat-meta .author {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-fg);
  }
  .feat-meta .author .av {
    width: 20px;
    height: 20px;
    border-radius: 99px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-strong);
    display: inline-grid;
    place-items: center;
    font-size: 9px;
    font-weight: 500;
    color: var(--color-fg);
  }
  .badge-mono {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 6px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-fg-muted);
  }
  .feat-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .feat-actions {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }
  .feat-right {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    aspect-ratio: 4 / 3;
    background: radial-gradient(
      ellipse 60% 80% at 30% 50%,
      var(--color-surface-2) 0%,
      var(--color-bg) 70%
    );
    position: relative;
    overflow: hidden;
    transition: border-color 0.15s var(--ease-out-soft);
  }
  .feat:hover .feat-right {
    border-color: var(--color-border-strong);
  }
  .feat-ovl {
    position: absolute;
    inset: 0;
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .feat-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--color-fg-muted);
  }
  .feat-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .feat .num {
    font-size: 11px;
    color: var(--color-fg-subtle);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .dim {
    color: var(--color-fg-subtle);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    background: transparent;
    white-space: nowrap;
  }
  .feat-tags .chip {
    font-size: 11px;
    padding: 3px 9px;
  }

  /* ===== Grid ===== */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding-top: 36px;
  }
  @media (max-width: 920px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
