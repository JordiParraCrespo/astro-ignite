---
/**
 * Non-default-locale landing page (e.g. /es/, /fr/).
 * The default-locale lives at /, see src/pages/index.astro.
 */

import BaseLayout from '@/layouts/BaseLayout.astro';
import LandingPage from '@/components/LandingPage.astro';
import { siteConfig } from '@/config/site';

export async function getStaticPaths() {
  return siteConfig.locales
    .filter((l) => l !== siteConfig.defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

// SSR (output: 'server') ignores getStaticPaths for dynamic routes, so
// any /<unknown> URL would otherwise match this page. Guard at runtime so
// only the configured non-default locales render here.
const langParam = Astro.params.lang;
if (
  !langParam ||
  !siteConfig.locales.includes(langParam) ||
  langParam === siteConfig.defaultLocale
) {
  return new Response(null, { status: 404 });
}

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const siteName = siteConfig.name[locale] ?? siteConfig.name[siteConfig.defaultLocale]!;
const description =
  siteConfig.description[locale] ?? siteConfig.description[siteConfig.defaultLocale]!;
---

<BaseLayout title={`${siteName} — ${description}`} description={description}>
  <LandingPage />
</BaseLayout>
