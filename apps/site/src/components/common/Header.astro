---
/**
 * Site navigation — shared across the landing and every internal page.
 *
 * Links are driven by `siteConfig.nav`. External links are opened in a new
 * tab; internal root-relative paths are resolved against the current locale.
 * Anchors (`/#templates`, `/#install`) resolve from the locale home so they
 * keep working from any route.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';

import { siteConfig, type NavLink, type NavCta } from '@/config/site';
import { useTranslations, type TranslationKey } from '@/i18n';
import Brand from '@/components/common/Brand.astro';
import ThemeToggle from '@/components/common/ThemeToggle.astro';
import LocaleSwitcher from '@/components/common/LocaleSwitcher.astro';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const homeUrl = getRelativeLocaleUrl(locale, '/');
const localeRoot = homeUrl.replace(/\/$/, '');
const siteName = siteConfig.name[locale] ?? siteConfig.name[siteConfig.defaultLocale]!;

const resolveHref = (link: NavLink | NavCta): string => {
  if (link.href.startsWith('http://') || link.href.startsWith('https://')) {
    return link.href;
  }
  if (link.href.startsWith('/#')) {
    return `${localeRoot}${link.href}`;
  }
  if (link.href.startsWith('/')) {
    return getRelativeLocaleUrl(locale, link.href);
  }
  return link.href;
};

const navLinks = siteConfig.nav.links;
const cta = siteConfig.nav.cta ?? null;
---

<header
  class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-bg)_72%,transparent)] [backdrop-filter:saturate(140%)_blur(14px)] [-webkit-backdrop-filter:saturate(140%)_blur(14px)]"
  aria-label={t('nav.primary')}
>
  <div
    class="mx-auto flex h-[60px] max-w-[1200px] items-center gap-6 px-10 whitespace-nowrap max-[720px]:gap-4 max-[720px]:px-6 max-[420px]:gap-2"
  >
    <Brand href={homeUrl} variant="lockup" size={0.34} label={siteName} />
    <span
      class="mono inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-[5px] pl-2 text-[12px] text-[var(--color-fg-muted)] max-[920px]:hidden"
    >
      <span class="h-[6px] w-[6px] rounded-full bg-[var(--color-fg)]" aria-hidden="true"></span>v0.1.0 · pre-1.0
    </span>
    <div class="ml-auto flex items-center gap-4 max-[720px]:gap-3 max-[420px]:gap-1.5">
      {
        navLinks.map((link) => (
          <a
            class="text-[13px] text-[var(--color-fg-muted)] no-underline transition-colors duration-[0.12s] ease-[var(--ease-out-soft)] hover:text-[var(--color-fg)] max-[560px]:hidden data-[nav-key=github]:max-[720px]:hidden"
            data-nav-key={link.key}
            href={resolveHref(link)}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener' : undefined}
          >
            {t(`landing.nav.${link.key}` as TranslationKey)}
          </a>
        ))
      }
      <LocaleSwitcher />
      <ThemeToggle />
      {
        cta && (
          <a class="btn btn-primary btn-sm" href={resolveHref(cta)}>
            {t(`landing.nav.${cta.key}` as TranslationKey)}
          </a>
        )
      }
    </div>
  </div>
</header>
