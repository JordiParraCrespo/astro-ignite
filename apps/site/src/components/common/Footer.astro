---
/**
 * Site footer — shared across every layout.
 *
 * Below-the-fold component using Tailwind utilities resolved through the
 * --color-* tokens. Brand block on the left, three link columns
 * (Product / Resources / Legal) on the right, mono font throughout.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import Brand from '@/components/common/Brand.astro';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const homeUrl = getRelativeLocaleUrl(locale, '/');
const homeRoot = homeUrl.replace(/\/$/, '');
const blogHref = getRelativeLocaleUrl(locale, '/blog');
const privacyHref = getRelativeLocaleUrl(locale, '/legal/privacy');
const termsHref = getRelativeLocaleUrl(locale, '/legal/terms');
const cookiesHref = getRelativeLocaleUrl(locale, '/legal/cookies');
const rssUrl = locale === siteConfig.defaultLocale ? '/rss.xml' : `/${locale}/rss.xml`;

const docsUrl = siteConfig.urls.docs;
const ghUrl = siteConfig.social.github ?? 'https://github.com/JordiParraCrespo/astro-ignite';
---

<footer
  class="border-t border-[var(--color-border)] pt-10 pb-14 font-mono text-[12px] text-[var(--color-fg-muted)]"
>
  <div
    class="mx-auto flex max-w-[1200px] flex-wrap justify-between gap-8 px-10 max-[720px]:px-6 [&_a]:text-[var(--color-fg-muted)] [&_a]:no-underline [&_a]:transition-colors [&_a]:duration-[0.12s] [&_a]:ease-[var(--ease-out-soft)] hover:[&_a]:text-[var(--color-fg)]"
  >
    <div class="flex max-w-[36ch] flex-col gap-3">
      <Brand variant="lockup" size={0.32} />
      <p class="mono m-0 text-[12px] text-[var(--color-fg-muted)]">{t('landing.footer.lede')}</p>
    </div>
    <div class="flex flex-wrap gap-12">
      <div class="flex flex-col gap-2">
        <span class="mb-1 text-[var(--color-fg)]">{t('landing.footer.productHead')}</span>
        <a href={`${homeRoot}/#templates`}>{t('landing.nav.templates')}</a>
        <a href={blogHref}>{t('landing.nav.blog')}</a>
        <a href={docsUrl} target="_blank" rel="noopener">{t('landing.nav.docs')}</a>
        <a href={`${ghUrl}/blob/main/plan.md`} rel="noopener">{t('landing.nav.plan')}</a>
        <a href={`${ghUrl}/releases`} rel="noopener">{t('landing.nav.changelog')}</a>
      </div>
      <div class="flex flex-col gap-2">
        <span class="mb-1 text-[var(--color-fg)]">{t('landing.footer.resourcesHead')}</span>
        <a href={ghUrl} rel="noopener">GitHub</a>
        <a href={`${ghUrl}/issues`} rel="noopener">{t('landing.footer.issues')}</a>
        <a href={`${ghUrl}/discussions`} rel="noopener">{t('landing.footer.discussions')}</a>
        <a href="https://www.npmjs.com/package/create-astro-ignite" rel="noopener">npm</a>
      </div>
      <div class="flex flex-col gap-2">
        <span class="mb-1 text-[var(--color-fg)]">{t('landing.footer.legalHead')}</span>
        <a href={`${ghUrl}/blob/main/LICENSE`} rel="noopener">{t('landing.footer.license')}</a>
        <a href={privacyHref}>{t('landing.footer.privacy')}</a>
        <a href={termsHref}>{t('landing.footer.terms')}</a>
        <a href={cookiesHref}>{t('landing.footer.cookies')}</a>
        <a href={rssUrl}>{t('footer.rss')}</a>
      </div>
    </div>
  </div>
</footer>
