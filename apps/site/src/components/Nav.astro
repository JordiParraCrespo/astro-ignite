---
/**
 * Site navigation — shared across the landing and every internal page.
 *
 * Above-the-fold component — uses a scoped <style> block so the CSS inlines
 * per-route automatically. Anchor links (#templates, #install) resolve to
 * the home page so they keep working from any route.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import Brand from './Brand.astro';
import ThemeToggle from './ThemeToggle.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const homeUrl = getRelativeLocaleUrl(locale, '/');
const blogHref = getRelativeLocaleUrl(locale, '/blog');
const docsHref = '/docs';
const templatesHref = `${homeUrl.replace(/\/$/, '')}/#templates`;
const installHref = `${homeUrl.replace(/\/$/, '')}/#install`;
const ghUrl = siteConfig.social.github ?? 'https://github.com/JordiParraCrespo/astro-ignite';
const siteName = siteConfig.name[locale] ?? siteConfig.name[siteConfig.defaultLocale]!;
---

<header class="nav" aria-label="Primary">
  <div class="nav-inner">
    <Brand href={homeUrl} variant="lockup" size={0.34} label={siteName} />
    <span class="pill mono"><span class="dot" aria-hidden="true"></span>v0.1.0 · pre-1.0</span>
    <div class="nav-cta">
      <a class="nav-link" href={docsHref}>{t('landing.nav.docs')}</a>
      <a class="nav-link" href={blogHref}>{t('landing.nav.blog')}</a>
      <a class="nav-link" href={templatesHref}>{t('landing.nav.templates')}</a>
      <a class="nav-link" href={ghUrl} rel="noopener">{t('landing.nav.github')}</a>
      <LocaleSwitcher />
      <ThemeToggle />
      <a class="btn btn-primary btn-sm" href={installHref}>{t('landing.nav.getStarted')}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--color-bg) 72%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    white-space: nowrap;
  }
  .nav-cta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-left: auto;
  }
  .nav-link {
    font-size: 13px;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color 0.12s var(--ease-out-soft);
  }
  .nav-link:hover {
    color: var(--color-fg);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px 5px 8px;
    font-size: 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-fg-muted);
  }
  .pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--color-fg);
  }

  @media (max-width: 920px) {
    .nav-inner > .pill {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .nav-inner {
      gap: 16px;
      padding: 0 24px;
    }
    .nav-cta {
      gap: 12px;
    }
    .nav-link[href*='github'] {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .nav-link {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .nav-inner {
      gap: 8px;
    }
    .nav-cta {
      gap: 6px;
    }
  }
</style>
