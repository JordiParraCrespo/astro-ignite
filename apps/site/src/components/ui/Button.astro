---
import { cn } from '@/lib/cn';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'secondary' | 'outline' | 'ghost' | 'link';
type Size = 'sm' | 'md' | 'lg' | 'icon';

type AsButton = { href?: undefined } & HTMLAttributes<'button'>;
type AsAnchor = { href: string } & HTMLAttributes<'a'>;

export type Props = (AsButton | AsAnchor) & {
  variant?: Variant;
  size?: Size;
  class?: string;
};

const { variant = 'default', size = 'md', class: className, href, ...rest } = Astro.props;

const base =
  'inline-flex cursor-pointer select-none items-center justify-center gap-2 whitespace-nowrap rounded-md border border-transparent font-medium leading-none no-underline transition-[background,border-color,color,opacity] duration-150 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2 disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50';

const sizes: Record<Size, string> = {
  sm: 'h-[30px] rounded-sm px-2.5 text-[13px]',
  md: 'h-9 px-3.5 text-sm',
  lg: 'h-11 rounded-md px-[18px] text-[15px]',
  icon: 'h-9 w-9 p-0',
};

const variants: Record<Variant, string> = {
  default: 'bg-primary text-primary-fg hover:opacity-90',
  secondary: 'border-border bg-surface-2 text-fg hover:border-border-strong',
  outline: 'border-border bg-transparent text-fg hover:border-border-strong hover:bg-surface-2',
  ghost: 'bg-transparent text-fg hover:bg-surface-2',
  link: 'h-auto bg-transparent p-0 text-fg underline underline-offset-4',
};

const classes = cn(base, sizes[size], variants[variant], className);
---

{
  href ? (
    <a href={href} class={classes} {...(rest as HTMLAttributes<'a'>)}>
      <slot />
    </a>
  ) : (
    <button class={classes} {...(rest as HTMLAttributes<'button'>)}>
      <slot />
    </button>
  )
}
