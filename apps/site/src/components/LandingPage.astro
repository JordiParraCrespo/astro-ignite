---
/**
 * astro-ignite landing — thin composition of six section components.
 * Each section owns its own scoped CSS, copy fetching, and asset imports.
 * This file only resolves the few props the sections need from siteConfig.
 */

import { siteConfig } from '@/config/site';

import HeroSection from './landing/HeroSection.astro';
import MetaStrip from './landing/MetaStrip.astro';
import FeaturesSection from './landing/FeaturesSection.astro';
import TemplatesSection from './landing/TemplatesSection.astro';
import BlogSection from './landing/BlogSection.astro';
import CtaSection from './landing/CtaSection.astro';

const ghUrl = siteConfig.social.github ?? 'https://github.com/JordiParraCrespo/astro-ignite';
const docsUrl = siteConfig.urls.docs;
const quickStartUrl = `${docsUrl.replace(/\/$/, '')}/quick-start`;
---

<HeroSection ghUrl={ghUrl} quickStartUrl={quickStartUrl} />
<MetaStrip />
<FeaturesSection />
<TemplatesSection ghUrl={ghUrl} />
<BlogSection />
<CtaSection ghUrl={ghUrl} quickStartUrl={quickStartUrl} />
