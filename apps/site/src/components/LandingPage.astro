---
/**
 * astro-ignite landing page — port of the Claude Design Landing.html handoff.
 *
 * Sections (top to bottom):
 *   1. Sticky nav with brand + version pill + nav links + CTAs
 *   2. Hero: split layout — copy + command on the left, terminal preview on the right
 *   3. Meta strip — Lighthouse / Bundle / LCP / CLS / Astro 5 / Tailwind v4 / MIT
 *   4. Features — 9-up grid built only from system tokens
 *   5. Templates — Starter + Docs cards, each with mini-preview
 *   6. CTA — centered "Stop yak-shaving the first 30%" with command + buttons
 *   7. Footer — brand + 3 columns of links
 *
 * Pure Astro. No React. Above-the-fold uses scoped <style>; below-the-fold
 * is also scoped here because the whole page is one component (deviation from
 * the layered-CSS rule is fine for a single-route site — no Tailwind weight
 * to worry about).
 */

import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Brand from '@/components/Brand.astro';
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import starterPreview from '@/assets/templates/starter.png';
import docsPreview from '@/assets/templates/docs.png';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// Numeric IDs (01..09) drive the i18n key lookups: t('landing.features.f01.title') etc.
// Tags ('perf', 'core', 'css', ...) are technical labels — kept English across locales.
const FEATURE_IDS = [
  { id: 'f01', num: '01', tag: 'perf' },
  { id: 'f02', num: '02', tag: 'core' },
  { id: 'f03', num: '03', tag: 'css' },
  { id: 'f04', num: '04', tag: 'seo' },
  { id: 'f05', num: '05', tag: 'media' },
  { id: 'f06', num: '06', tag: 'type' },
  { id: 'f07', num: '07', tag: 'ux' },
  { id: 'f08', num: '08', tag: 'email' },
  { id: 'f09', num: '09', tag: 'legal' },
] as const;

const ghUrl = siteConfig.social.github ?? 'https://github.com/JordiParraCrespo/astro-ignite';
const blogHref = getRelativeLocaleUrl(locale, '/blog');
---

<Fragment>
  <main id="main">
    <header class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="page hero-inner">
        <div class="hero-split">
          <div class="hero-copy">
            <a class="pill pill--release" href={`${ghUrl}/releases`} rel="noopener" target="_blank">
              <span class="dot" aria-hidden="true"></span>
              <span class="pill-tag">{t('landing.hero.pillTag')}</span>
              <span>{t('landing.hero.pillAnnouncement')}</span>
              <span class="pill-arrow" aria-hidden="true">→</span>
            </a>
            <h1>
              <span class="muted">{t('landing.hero.headlineMuted')}</span>{' '}
              {t('landing.hero.headlineTail')}
            </h1>
            <p class="hero-lede">
              {t('landing.hero.lede')}
              {' '}
              <span class="emph">{t('landing.hero.ledeEmph')}</span>
            </p>

            <div class="cmd" id="install">
              <span
                ><span class="cmd-prompt">$</span><span class="cmd-text mono"
                  >npm create astro-ignite@latest my-site</span
                ></span
              >
              <button
                class="cmd-copy"
                type="button"
                data-copy="npm create astro-ignite@latest my-site"
                >{t('landing.hero.copyLabel')}</button
              >
            </div>

            <div class="hero-cta">
              <a class="btn btn-primary btn-lg" href="/docs/quick-start"
                >{t('landing.hero.primaryCta')}</a
              >
              <a class="btn btn-outline btn-lg" href={ghUrl} rel="noopener"
                >{t('landing.hero.secondaryCta')}</a
              >
              <span class="mono hero-meta">MIT · Astro 5 · Tailwind v4</span>
            </div>
          </div>

          <div class="term" aria-label="Scaffold flow preview">
            <div class="term-bar">
              <span class="term-dot" aria-hidden="true"></span>
              <span class="term-dot" aria-hidden="true"></span>
              <span class="term-dot" aria-hidden="true"></span>
              <span class="term-path mono">~/code</span>
              <span class="term-shell mono">zsh</span>
            </div>
            <div class="term-body mono">
              <span class="t-muted">$</span> npm create astro-ignite my-site<br /><br />
              <span class="t-muted">^</span>&nbsp; <span class="t-strong">astro-ignite</span>
              <span class="t-subtle">v0.1.0</span><br />
              <span class="t-subtle">│</span><br />
              <span class="t-subtle">◇</span>&nbsp; Template? <span class="t-muted">starter</span
              ><br />
              <span class="t-subtle">◇</span>&nbsp; Project name? <span class="t-muted"
                >./my-site</span
              ><br />
              <span class="t-subtle">◇</span>&nbsp; Languages? <span class="t-muted"
                >en, es, ja</span
              ><br />
              <span class="t-subtle">◇</span>&nbsp; Email? <span class="t-muted">Resend</span><br />
              ◆&nbsp; Install deps?<br />
              <span class="t-subtle">│</span>&nbsp; <span class="t-pick">● Yes</span>&nbsp;<span
                class="t-muted">○ No ○ pnpm ○ bun</span
              ><br />
              <span class="t-subtle">└</span>&nbsp; <span class="caret"></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="page">
      <div class="meta-strip mono">
        <div class="meta-item">
          <span>Lighthouse</span><span class="meta-value">100 / 100 / 100 / 100</span>
        </div>
        <div class="meta-item"><span>Bundle</span><span class="meta-value">17.4 kB</span></div>
        <div class="meta-item"><span>LCP</span><span class="meta-value">0.4 s</span></div>
        <div class="meta-item"><span>CLS</span><span class="meta-value">0.00</span></div>
        <div class="meta-item meta-spacer"><span>Astro 5</span></div>
        <div class="meta-item"><span>Tailwind v4</span></div>
        <div class="meta-item"><span>MIT</span></div>
      </div>
    </div>

    <section class="features-section">
      <div class="page">
        <div class="section-head">
          <div class="section-lead">
            <span class="eyebrow mono">{t('landing.features.eyebrow')}</span>
            <h2>{t('landing.features.headline')}</h2>
          </div>
          <p class="section-meta mono">{t('landing.features.meta')}</p>
        </div>

        <div class="features">
          {
            FEATURE_IDS.map((f) => (
              <div class="feat">
                <div class="feat-head">
                  <span class="feat-num mono">{f.num}</span>
                  <span class="feat-tag mono">{f.tag}</span>
                </div>
                <h3>{t(`landing.features.${f.id}.title` as const)}</h3>
                <p>{t(`landing.features.${f.id}.body` as const)}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="templates-section" id="templates">
      <div class="page">
        <div class="section-head">
          <div class="section-lead">
            <span class="eyebrow mono">{t('landing.templates.eyebrow')}</span>
            <h2>{t('landing.templates.headline')}</h2>
            <p>
              {t('landing.templates.lede')}
              <span class="mono inline-code">--template</span>{t('landing.templates.ledeTail')}
            </p>
          </div>
          <p class="section-meta mono">{t('landing.templates.meta')}</p>
        </div>

        <div class="tpls">
          <article class="tpl">
            <div class="tpl-preview">
              <Image
                src={starterPreview}
                alt={t('landing.templates.starter.name')}
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 100vw, 50vw"
                loading="lazy"
                class="tpl-preview-img"
              />
            </div>
            <div class="tpl-body">
              <div class="tpl-row">
                <h3>{t('landing.templates.starter.name')}</h3>
                <span class="tpl-meta mono">{t('landing.templates.starter.meta')}</span>
              </div>
              <p class="tpl-desc">{t('landing.templates.starter.desc')}</p>
              <div class="tpl-tags">
                <span class="tag-chip mono">marketing</span>
                <span class="tag-chip mono">blog</span>
                <span class="tag-chip mono">i18n</span>
                <span class="tag-chip mono">resend</span>
                <span class="tag-chip mono">plausible</span>
              </div>
            </div>
            <div class="tpl-foot">
              <span class="tpl-install mono"
                ><span class="tpl-flag">$</span> npm create astro-ignite my-site <span
                  class="tpl-flag">--template</span
                > starter</span
              >
              <a class="btn btn-outline btn-sm" href="/docs">{t('landing.templates.preview')}</a>
            </div>
          </article>

          <article class="tpl">
            <div class="tpl-preview">
              <Image
                src={docsPreview}
                alt={t('landing.templates.docs.name')}
                widths={[640, 960, 1280]}
                sizes="(max-width: 900px) 100vw, 50vw"
                loading="lazy"
                class="tpl-preview-img"
              />
            </div>
            <div class="tpl-body">
              <div class="tpl-row">
                <h3>{t('landing.templates.docs.name')}</h3>
                <span class="tpl-meta mono">{t('landing.templates.docs.meta')}</span>
              </div>
              <p class="tpl-desc">{t('landing.templates.docs.desc')}</p>
              <div class="tpl-tags">
                <span class="tag-chip mono">docs</span>
                <span class="tag-chip mono">mdx</span>
                <span class="tag-chip mono">i18n</span>
                <span class="tag-chip mono">callouts</span>
                <span class="tag-chip mono">code-copy</span>
              </div>
            </div>
            <div class="tpl-foot">
              <span class="tpl-install mono"
                ><span class="tpl-flag">$</span> npm create astro-ignite my-docs <span
                  class="tpl-flag">--template</span
                > docs</span
              >
              <a class="btn btn-outline btn-sm" href="/docs">{t('landing.templates.preview')}</a>
            </div>
          </article>
        </div>

        <div class="tpls-foot">
          <span class="mono tpls-coming"
            >{t('landing.templates.moreLead')}{' '}
            <span class="emph">portfolio</span>, <span class="emph">commerce</span>, <span
              class="emph">changelog</span
            >.</span
          >
          <a class="btn btn-ghost btn-sm" href={ghUrl + '/blob/main/ROADMAP.md'} rel="noopener"
            >{t('landing.templates.browseAll')}</a
          >
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="page">
        <div class="cta-box">
          <span class="pill"
            ><span class="dot" aria-hidden="true"></span><span class="mono"
              >{t('landing.cta.pill')}</span
            ></span
          >
          <h2>
            {t('landing.cta.headlineLead')}{' '}
            <span class="muted">{t('landing.cta.headlineMuted')}</span>{
              t('landing.cta.headlineTail')
            }
          </h2>
          <p>{t('landing.cta.lede')}</p>
          <div class="cmd">
            <span
              ><span class="cmd-prompt">$</span><span class="cmd-text mono"
                >npm create astro-ignite@latest</span
              ></span
            >
            <button class="cmd-copy" type="button" data-copy="npm create astro-ignite@latest"
              >{t('landing.hero.copyLabel')}</button
            >
          </div>
          <div class="cta-actions">
            <a class="btn btn-primary btn-lg" href="/docs/quick-start">Get started</a>
            <a class="btn btn-outline btn-lg" href={ghUrl} rel="noopener">Star on GitHub ★</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="page footer-grid">
      <div class="footer-brand">
        <Brand variant="lockup" size={0.32} />
        <p class="footer-lede mono">{t('landing.footer.lede')}</p>
      </div>
      <div class="footer-cols">
        <div class="footer-col">
          <span class="footer-head">{t('landing.footer.productHead')}</span>
          <a href="#templates">{t('landing.nav.templates')}</a>
          <a href={blogHref}>{t('landing.nav.blog')}</a>
          <a href="/docs">{t('landing.nav.docs')}</a>
          <a
            href="https://github.com/JordiParraCrespo/astro-ignite/blob/main/plan.md"
            rel="noopener">{t('landing.nav.plan')}</a
          >
          <a href="https://github.com/JordiParraCrespo/astro-ignite/releases" rel="noopener"
            >{t('landing.nav.changelog')}</a
          >
        </div>
        <div class="footer-col">
          <span class="footer-head">{t('landing.footer.resourcesHead')}</span>
          <a href={ghUrl} rel="noopener">GitHub</a>
          <a href={ghUrl + '/issues'} rel="noopener">{t('landing.footer.issues')}</a>
          <a href={ghUrl + '/discussions'} rel="noopener">{t('landing.footer.discussions')}</a>
          <a href="https://www.npmjs.com/package/create-astro-ignite" rel="noopener">npm</a>
        </div>
        <div class="footer-col">
          <span class="footer-head">{t('landing.footer.legalHead')}</span>
          <a href={ghUrl + '/blob/main/LICENSE'} rel="noopener">{t('landing.footer.license')}</a>
          <a href="/docs/legal/privacy">{t('landing.footer.privacy')}</a>
          <a href="/docs/legal/cookies">{t('landing.footer.cookies')}</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // Copy-to-clipboard for the .cmd-copy buttons.
    document.querySelectorAll<HTMLButtonElement>('.cmd-copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy;
        if (!text || !navigator.clipboard) return;
        try {
          await navigator.clipboard.writeText(text);
          const original = btn.textContent;
          btn.textContent = 'copied';
          setTimeout(() => {
            btn.textContent = original;
          }, 1200);
        } catch {
          /* permissions denied — silent */
        }
      });
    });
  </script>
</Fragment>

<style>
  /* =============================================================================
   * Layout primitives
   * ============================================================================= */
  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }
  @media (max-width: 720px) {
    .page {
      padding: 0 24px;
    }
  }

  .muted {
    color: var(--color-fg-muted);
  }
  .emph {
    color: var(--color-fg);
  }
  .inline-code {
    font-size: 14px;
    color: var(--color-fg);
  }

  /* =============================================================================
   * Pill (release variant — clickable, links to GitHub releases)
   * The neutral .pill atom lives in Nav.astro alongside the shared header.
   * ============================================================================= */
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 10px 5px 8px;
    font-size: 12px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-fg);
  }
  .pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--color-fg);
  }
  .pill--release {
    text-decoration: none;
    padding-block: 6px;
    font-size: 13px;
    transition:
      border-color 120ms ease,
      background 120ms ease;
  }
  .pill--release:hover {
    border-color: var(--color-border-strong, var(--color-fg-muted));
    background: var(--color-surface);
  }
  .pill--release .pill-tag {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg);
    padding-right: 8px;
    border-right: 1px solid var(--color-border);
  }
  .pill--release .dot {
    background: var(--color-primary, var(--color-fg));
    animation: release-pulse 2.2s ease-in-out infinite;
  }
  .pill--release .pill-arrow {
    color: var(--color-fg-muted);
    transition:
      transform 160ms ease,
      color 160ms ease;
  }
  .pill--release:hover .pill-arrow {
    transform: translateX(2px);
    color: var(--color-fg);
  }
  @keyframes release-pulse {
    0%,
    100% {
      opacity: 0.4;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill--release .dot {
      animation: none;
      opacity: 0.7;
    }
    .pill--release:hover .pill-arrow {
      transform: none;
    }
  }

  /* =============================================================================
   * Hero
   * ============================================================================= */
  .hero {
    padding: 80px 0 56px;
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Use --color-border (zinc-200 light / zinc-800 dark) for visible
       contrast against the bg in both themes. */
    background-image:
      linear-gradient(to right, var(--color-border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-border) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black 30%, transparent 80%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black 30%, transparent 80%);
  }
  /* Light theme: zinc-200 on zinc-50 is lower contrast, so a touch more
     opacity is needed to read at all — but keep it well below 1 so it stays
     a quiet pattern, not a chart. */
  :global(html.light) .hero-grid {
    opacity: 0.65;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }
  .hero-split {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    align-items: center;
  }
  @media (max-width: 920px) {
    .hero-split {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero h1 {
    /* Max 80 (down from 96) — at 96 "Production-grade" hyphen-wraps in the
       split layout's left column on common laptop widths. */
    font-size: clamp(40px, 5.6vw, 80px);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.95;
    margin: 0;
    text-wrap: balance;
    /* Browser auto-hyphenation breaks "Production-grade" awkwardly on narrow
       columns. Disable. */
    hyphens: none;
    word-break: normal;
    overflow-wrap: normal;
  }
  .hero-lede {
    margin: 0;
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.55;
    color: var(--color-fg-muted);
    max-width: 60ch;
    text-wrap: pretty;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-meta {
    font-size: 12px;
    color: var(--color-fg-muted);
  }

  /* =============================================================================
   * Command line
   * ============================================================================= */
  .cmd {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 10px 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface-2);
    font-family: var(--font-mono);
    font-size: 14px;
    width: fit-content;
    max-width: 100%;
  }
  .cmd-prompt {
    color: var(--color-fg-muted);
    margin-right: 6px;
  }
  .cmd-text {
    color: var(--color-fg);
  }
  @media (max-width: 480px) {
    .cmd {
      font-size: 12px;
      gap: 10px;
      padding: 8px 8px 8px 12px;
    }
  }
  .cmd-copy {
    appearance: none;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition:
      color 0.12s,
      border-color 0.12s;
  }
  .cmd-copy:hover {
    color: var(--color-fg);
    border-color: var(--color-border-strong);
  }

  /* =============================================================================
   * Terminal preview
   * ============================================================================= */
  /* Terminal block stays dark regardless of theme — terminals look right
     dark even on a light page (like a code block). Direct zinc hex refs
     make these rules theme-invariant. */
  .term {
    border: 1px solid #27272a;
    border-radius: 12px;
    background: #000;
    overflow: hidden;
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.8),
      0 0 0 1px #27272a;
    /* Prevent the terminal preview from blowing out the column on mobile.
       Grid items default to min-content sizing; we want it to shrink. */
    max-width: 100%;
    min-width: 0;
  }
  .term-body {
    overflow-x: auto;
  }
  @media (max-width: 480px) {
    .term-body {
      font-size: 11px;
      padding: 14px 12px;
    }
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid #27272a;
    background: #18181b;
  }
  .term-dot {
    width: 10px;
    height: 10px;
    border-radius: 99px;
    background: #3f3f46;
  }
  .term-path {
    font-size: 11px;
    color: #71717a;
    margin-left: 8px;
  }
  .term-shell {
    font-size: 11px;
    color: #52525b;
    margin-left: auto;
  }
  .term-body {
    padding: 18px 16px;
    font-size: 13px;
    line-height: 1.7;
    color: #f4f4f5;
  }
  .t-muted {
    color: #71717a;
  }
  .t-subtle {
    color: #52525b;
  }
  .t-strong {
    font-weight: 500;
    color: #fafafa;
  }
  .t-pick {
    display: inline-block;
    padding: 1px 8px;
    background: #fafafa;
    color: #000;
    border-radius: 3px;
  }
  .caret {
    display: inline-block;
    width: 8px;
    height: 14px;
    background: #fafafa;
    vertical-align: -2px;
  }

  /* =============================================================================
   * Meta strip
   * ============================================================================= */
  .meta-strip {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
    padding: 18px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-size: 12px;
    color: var(--color-fg-muted);
  }
  .meta-item {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .meta-value {
    color: var(--color-fg);
    font-size: 14px;
