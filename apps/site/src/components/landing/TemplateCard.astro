---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  preview: ImageMetadata;
  name: string;
  meta: string;
  description: string;
  tags: string[];
  installCommand: string;
  previewUrl: string;
  previewLabel: string;
  eager?: boolean;
}

const {
  preview,
  name,
  meta,
  description,
  tags,
  installCommand,
  previewUrl,
  previewLabel,
  eager = false,
} = Astro.props;
---

<article class="tpl">
  <div class="tpl-preview">
    <Picture
      src={preview}
      alt={name}
      width={1120}
      height={630}
      widths={[400, 560, 1120]}
      sizes="(min-width: 900px) 560px, 100vw"
      formats={['avif', 'webp']}
      quality={70}
      loading={eager ? 'eager' : 'lazy'}
      {...eager ? { fetchpriority: 'high' as const } : {}}
      decoding="async"
      class="tpl-preview-img"
    />
  </div>
  <div class="tpl-body">
    <div class="tpl-row">
      <h3>{name}</h3>
      <span class="tpl-meta mono">{meta}</span>
    </div>
    <p class="tpl-desc">{description}</p>
    <div class="tpl-tags">
      {tags.map((tag) => <span class="tag-chip mono">{tag}</span>)}
    </div>
  </div>
  <div class="tpl-foot">
    <span class="tpl-install mono">
      <span class="tpl-flag">$</span>
      {installCommand}
    </span>
    <a class="btn btn-outline btn-sm" href={previewUrl} target="_blank" rel="noopener">
      {previewLabel}
    </a>
  </div>
</article>

<style>
  .tpl {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    transition: border-color 0.12s var(--ease-out-soft);
  }
  .tpl:hover {
    border-color: var(--color-border-strong);
  }

  .tpl-preview {
    aspect-ratio: 16 / 9;
    background: var(--color-zinc-950, #0a0a0a);
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }
  .tpl-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tpl-body {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tpl-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .tpl-row h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--color-fg);
  }
  .tpl-meta {
    font-size: 11px;
    color: var(--color-fg-muted);
  }
  .tpl-desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-fg-muted);
  }
  .tpl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .tag-chip {
    font-size: 11px;
    color: var(--color-fg-muted);
    padding: 3px 9px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
  .tpl-foot {
    border-top: 1px solid var(--color-border);
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    background: var(--color-surface-2);
  }
  .tpl-install {
    font-size: 12px;
    color: var(--color-fg-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tpl-flag {
    color: var(--color-fg-subtle);
  }
</style>
