---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  preview: ImageMetadata;
  name: string;
  meta: string;
  description: string;
  tags: string[];
  installCommand: string;
  previewUrl: string;
  previewLabel: string;
  eager?: boolean;
}

const {
  preview,
  name,
  meta,
  description,
  tags,
  installCommand,
  previewUrl,
  previewLabel,
  eager = false,
} = Astro.props;
---

<article
  class="flex flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-colors duration-[0.12s] ease-[var(--ease-out-soft)] hover:border-[var(--color-border-strong)]"
>
  <div
    class="relative aspect-[16/9] overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-zinc-950)]"
  >
    <Picture
      src={preview}
      alt={name}
      width={1120}
      height={630}
      widths={[400, 560, 1120]}
      sizes="(min-width: 900px) 560px, 100vw"
      formats={['avif', 'webp']}
      quality={70}
      loading={eager ? 'eager' : 'lazy'}
      {...eager ? { fetchpriority: 'high' as const } : {}}
      decoding="async"
      class="block h-full w-full object-cover"
    />
  </div>
  <div class="flex flex-col gap-3 px-6 py-[22px]">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="m-0 text-[19px] font-medium tracking-[-0.025em] text-[var(--color-fg)]">{name}</h3>
      <span class="mono text-[11px] text-[var(--color-fg-muted)]">{meta}</span>
    </div>
    <p class="m-0 text-[14px] leading-[1.55] text-[var(--color-fg-muted)]">{description}</p>
    <div class="mt-1 flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <span class="mono rounded-full border border-[var(--color-border)] px-[9px] py-[3px] text-[11px] text-[var(--color-fg-muted)]">
            {tag}
          </span>
        ))
      }
    </div>
  </div>
  <div
    class="flex items-center justify-between gap-4 border-t border-[var(--color-border)] bg-[var(--color-surface-2)] px-6 py-3.5"
  >
    <span
      class="mono overflow-hidden text-[12px] text-ellipsis whitespace-nowrap text-[var(--color-fg-muted)]"
    >
      <span class="text-[var(--color-fg-subtle)]">$</span>
      {installCommand}
    </span>
    <a class="btn btn-outline btn-sm" href={previewUrl} target="_blank" rel="noopener">
      {previewLabel}
    </a>
  </div>
</article>
