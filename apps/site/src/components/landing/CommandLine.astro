---
interface Props {
  command: string;
  copyLabel: string;
  copiedLabel: string;
  id?: string;
}

const { command, copyLabel, copiedLabel, id } = Astro.props;
---

<div class="cmd" {...id ? { id } : {}}>
  <span>
    <span class="cmd-prompt">$</span><span class="cmd-text mono">{command}</span>
  </span>
  <button class="cmd-copy" type="button" data-copy={command} data-copied={copiedLabel}>
    {copyLabel}
  </button>
</div>

<style>
  .cmd {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 10px 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface-2);
    font-family: var(--font-mono);
    font-size: 14px;
    width: fit-content;
    max-width: 100%;
  }
  .cmd-prompt {
    color: var(--color-fg);
    margin-right: 6px;
  }
  .cmd-text {
    color: var(--color-fg);
  }
  @media (max-width: 480px) {
    .cmd {
      font-size: 12px;
      gap: 10px;
      padding: 8px 8px 8px 12px;
    }
  }
  .cmd-copy {
    appearance: none;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition:
      color 0.12s,
      border-color 0.12s;
  }
  .cmd-copy:hover {
    color: var(--color-fg);
    border-color: var(--color-border-strong);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cmd-copy').forEach((btn) => {
    if (btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text || !navigator.clipboard) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = btn.dataset.copied ?? 'copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1200);
      } catch {
        /* permissions denied — silent */
      }
    });
  });
</script>
