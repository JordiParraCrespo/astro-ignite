---
interface Props {
  command: string;
  copyLabel: string;
  copiedLabel: string;
  id?: string;
}

const { command, copyLabel, copiedLabel, id } = Astro.props;
---

<div
  class="cmd inline-flex w-fit max-w-full items-center justify-between gap-4 rounded-[10px] border border-(--color-border) bg-(--color-surface-2) py-2.5 pr-2.5 pl-4 font-mono text-[14px] max-[480px]:gap-2.5 max-[480px]:py-2 max-[480px]:pr-2 max-[480px]:pl-3 max-[480px]:text-[12px]"
  {...id ? { id } : {}}
>
  <span>
    <span class="mr-1.5 text-(--color-fg)">$</span><span class="mono text-(--color-fg)"
      >{command}</span
    >
  </span>
  <button
    class="cmd-copy cursor-pointer appearance-none rounded border border-(--color-border) bg-transparent px-2 py-1 font-mono text-[11px] text-(--color-fg) transition-[color,border-color] duration-[0.12s] hover:border-(--color-border-strong) hover:text-(--color-fg)"
    type="button"
    data-copy={command}
    data-copied={copiedLabel}
  >
    {copyLabel}
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.cmd-copy').forEach((btn) => {
    if (btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy;
      if (!text || !navigator.clipboard) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = btn.dataset.copied ?? 'copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 1200);
      } catch {
        /* permissions denied — silent */
      }
    });
  });
</script>
