---
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import CommandLine from './CommandLine.astro';

interface Props {
  ghUrl: string;
  quickStartUrl: string;
}

const { ghUrl, quickStartUrl } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
---

<section class="pb-24 max-[720px]:pb-16">
  <div class="page mx-auto max-w-[1200px] px-10 max-[720px]:px-6">
    <div
      class="flex flex-col items-center gap-6 rounded-2xl border border-[var(--color-border)] p-12 text-center [background:radial-gradient(ellipse_60%_100%_at_50%_0%,var(--color-surface-2)_0%,var(--color-bg)_70%)] max-[560px]:gap-[18px] max-[560px]:rounded-[14px] max-[560px]:px-5 max-[560px]:py-8"
    >
      <span
        class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-[5px] pl-2 text-[12px] text-[var(--color-fg)]"
      >
        <span class="h-[6px] w-[6px] rounded-full bg-[var(--color-fg)]" aria-hidden="true"></span>
        <span class="mono">{t('landing.cta.pill')}</span>
      </span>
      <h2
        class="m-0 max-w-[18ch] text-[clamp(28px,4.4vw,56px)] leading-[1.05] font-medium tracking-[-0.045em] text-balance"
      >
        {t('landing.cta.headlineLead')}{' '}
        <span class="text-[var(--color-fg-muted)]">{t('landing.cta.headlineMuted')}</span>{
          t('landing.cta.headlineTail')
        }
      </h2>
      <p class="m-0 max-w-[52ch] text-[16px] leading-[1.55] text-[var(--color-fg-muted)]">
        {t('landing.cta.lede')}
      </p>
      <CommandLine
        command="npm create astro-ignite@latest"
        copyLabel={t('landing.hero.copyLabel')}
        copiedLabel={t('blog.copied')}
      />
      <div
        class="flex flex-wrap items-center justify-center gap-3 max-[560px]:w-full max-[560px]:max-w-[280px] max-[560px]:flex-col max-[560px]:items-stretch [&_.btn]:max-[560px]:w-full [&_.btn]:max-[560px]:justify-center"
      >
        <a class="btn btn-primary btn-lg" href={quickStartUrl} target="_blank" rel="noopener">
          {t('landing.cta.getStarted')}
        </a>
        <a class="btn btn-outline btn-lg" href={ghUrl} rel="noopener">
          {t('landing.cta.github')}
        </a>
      </div>
    </div>
  </div>
</section>
