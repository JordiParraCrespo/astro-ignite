---
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import starterPreview from '@/assets/templates/starter.png';
import docsPreview from '@/assets/templates/docs.png';
import SectionHead from './SectionHead.astro';
import TemplateCard from './TemplateCard.astro';

interface Props {
  ghUrl: string;
}

const { ghUrl } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const starterPreviewUrl = siteConfig.urls.starterPreview;
const docsPreviewUrl = siteConfig.urls.docsPreview;
---

<section class="templates-section" id="templates">
  <div class="page">
    <SectionHead
      eyebrow={t('landing.templates.eyebrow')}
      heading={t('landing.templates.headline')}
      meta={t('landing.templates.meta')}
    >
      <p>
        {t('landing.templates.lede')}
        <span class="mono inline-code">--template</span>{t('landing.templates.ledeTail')}
      </p>
    </SectionHead>

    <div class="tpls">
      <TemplateCard
        preview={starterPreview}
        name={t('landing.templates.starter.name')}
        meta={t('landing.templates.starter.meta')}
        description={t('landing.templates.starter.desc')}
        tags={['marketing', 'blog', 'i18n', 'resend', 'plausible']}
        installCommand="npm create astro-ignite my-site --template starter"
        previewUrl={starterPreviewUrl}
        previewLabel={t('landing.templates.preview')}
        eager
      />
      <TemplateCard
        preview={docsPreview}
        name={t('landing.templates.docs.name')}
        meta={t('landing.templates.docs.meta')}
        description={t('landing.templates.docs.desc')}
        tags={['docs', 'mdx', 'i18n', 'callouts', 'code-copy']}
        installCommand="npm create astro-ignite my-docs --template docs"
        previewUrl={docsPreviewUrl}
        previewLabel={t('landing.templates.preview')}
      />
    </div>

    <div class="tpls-foot">
      <span class="mono tpls-coming">
        {t('landing.templates.moreLead')}{' '}
        <span class="emph">portfolio</span>, <span class="emph">commerce</span>, <span class="emph"
          >changelog</span
        >.
      </span>
      <a class="btn btn-ghost btn-sm" href={ghUrl + '/blob/main/ROADMAP.md'} rel="noopener">
        {t('landing.templates.browseAll')}
      </a>
    </div>
  </div>
</section>

<style>
  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }
  @media (max-width: 720px) {
    .page {
      padding: 0 24px;
    }
  }
  .emph {
    color: var(--color-fg);
  }
  .inline-code {
    font-size: 14px;
    color: var(--color-fg);
  }
  .templates-section {
    padding: 0 0 96px;
  }
  @media (max-width: 720px) {
    .templates-section {
      padding: 0 0 64px;
    }
  }
  .tpls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  @media (max-width: 900px) {
    .tpls {
      grid-template-columns: 1fr;
    }
  }
  .tpls-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .tpls-coming {
    font-size: 12px;
    color: var(--color-fg-muted);
  }
</style>
