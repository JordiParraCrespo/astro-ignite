---
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import Button from '@/components/ui/Button.astro';
import Terminal from '@/components/ui/terminal/Terminal.astro';
import TermLine from '@/components/ui/terminal/TermLine.astro';
import TermSigil from '@/components/ui/terminal/TermSigil.astro';
import TermOption from '@/components/ui/terminal/TermOption.astro';
import TermCommandLine from '@/components/blocks/terminal/TermCommandLine.astro';
import TermHeader from '@/components/blocks/terminal/TermHeader.astro';
import TermStep from '@/components/blocks/terminal/TermStep.astro';
import TermActiveStep from '@/components/blocks/terminal/TermActiveStep.astro';
import TermPickerRow from '@/components/blocks/terminal/TermPickerRow.astro';
import TermCursorLine from '@/components/blocks/terminal/TermCursorLine.astro';
import CommandLine from './CommandLine.astro';
import Pill from './Pill.astro';

interface Props {
  ghUrl: string;
  quickStartUrl: string;
}

const { ghUrl, quickStartUrl } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);
---

<header class="relative overflow-hidden pt-20 pb-14">
  <div
    class="hero-grid pointer-events-none absolute inset-0 z-0 opacity-50 light:opacity-65"
    aria-hidden="true"
  >
  </div>
  <div class="page relative z-10">
    <div
      class="grid grid-cols-[1.15fr_1fr] items-center gap-14 max-[920px]:grid-cols-1 max-[920px]:gap-8"
    >
      <div class="flex flex-col gap-7">
        <Pill
          href={`${ghUrl}/releases`}
          tag={t('landing.hero.pillTag')}
          rel="noopener"
          target="_blank"
        >
          {t('landing.hero.pillAnnouncement')}
        </Pill>

        <h1
          class="m-0 text-[clamp(40px,5.6vw,80px)] leading-[0.95] font-medium tracking-[-0.05em] [text-wrap:balance] break-normal [overflow-wrap:normal] hyphens-none text-fg"
        >
          {t('landing.hero.headlineTail')}
        </h1>

        <p
          class="m-0 max-w-[60ch] text-[clamp(16px,1.4vw,19px)] leading-[1.55] [text-wrap:pretty] text-fg-muted"
        >
          {t('landing.hero.lede')}
          {' '}
          <span class="text-fg">{t('landing.hero.ledeEmph')}</span>
        </p>

        <CommandLine
          id="install"
          command="npm create astro-ignite@latest my-site"
          copyLabel={t('landing.hero.copyLabel')}
          copiedLabel={t('blog.copied')}
        />

        <div class="flex flex-wrap items-center gap-3">
          <Button href={quickStartUrl} size="lg" target="_blank" rel="noopener">
            {t('landing.hero.primaryCta')}
          </Button>
          <Button href={ghUrl} variant="outline" size="lg" rel="noopener">
            {t('landing.hero.secondaryCta')}
          </Button>
          <span class="mono text-xs text-fg-muted">MIT · Astro 6 · Tailwind v4</span>
        </div>
      </div>

      <Terminal path="~/code" shell="zsh" label={t('nav.scaffoldFlow')}>
        <TermCommandLine>npm create astro-ignite my-site</TermCommandLine>
        <TermLine />
        <TermHeader name="astro-ignite" version="v0.1.0" />
        <TermLine><TermSigil>│</TermSigil></TermLine>
        <TermStep question="Template?" answer="starter" />
        <TermStep question="Project name?" answer="./my-site" />
        <TermStep question="Languages?" answer="en, es, ja" />
        <TermStep question="Email?" answer="Resend" />
        <TermActiveStep question="Install deps?" />
        <TermPickerRow>
          <TermOption selected>Yes</TermOption>
          <TermOption>No</TermOption>
          <TermOption>pnpm</TermOption>
          <TermOption>bun</TermOption>
        </TermPickerRow>
        <TermCursorLine />
      </Terminal>
    </div>
  </div>
</header>
