---
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import SectionHead from './SectionHead.astro';
import FeatureCell from './FeatureCell.astro';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// Numeric IDs (01..09) drive the i18n key lookups: t('landing.features.f01.title') etc.
// Tags ('perf', 'core', 'css', ...) are technical labels — kept English across locales.
const FEATURE_IDS = [
  { id: 'f01', num: '01', tag: 'perf' },
  { id: 'f02', num: '02', tag: 'core' },
  { id: 'f03', num: '03', tag: 'css' },
  { id: 'f04', num: '04', tag: 'seo' },
  { id: 'f05', num: '05', tag: 'media' },
  { id: 'f06', num: '06', tag: 'type' },
  { id: 'f07', num: '07', tag: 'ux' },
  { id: 'f08', num: '08', tag: 'email' },
  { id: 'f09', num: '09', tag: 'legal' },
] as const;
---

<section class="py-24 max-[720px]:py-16">
  <div class="page">
    <SectionHead
      eyebrow={t('landing.features.eyebrow')}
      heading={t('landing.features.headline')}
      meta={t('landing.features.meta')}
    />
    <div
      class="features grid grid-cols-3 max-[920px]:grid-cols-2 max-[560px]:grid-cols-1 overflow-hidden rounded-xl border border-border"
    >
      {
        FEATURE_IDS.map((f) => (
          <FeatureCell
            num={f.num}
            tag={f.tag}
            title={t(`landing.features.${f.id}.title`)}
            body={t(`landing.features.${f.id}.body`)}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Trim outer borders on the grid edges. FeatureCell ships its own `border-r`
     and `border-b`; we cancel those at the grid's right/bottom edge so the
     outer container's rounded border is the only visible perimeter line.
     :global() is Astro's escape hatch for reaching into a child's scope. */
  .features :global(.feat:nth-child(3n)) {
    border-right: none;
  }
  .features :global(.feat:nth-last-child(-n + 3)) {
    border-bottom: none;
  }
  @media (max-width: 920px) {
    .features :global(.feat) {
      border-right: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }
    .features :global(.feat:nth-child(2n)) {
      border-right: none;
    }
    .features :global(.feat:nth-last-child(-n + 2)) {
      border-bottom: none;
    }
  }
  @media (max-width: 560px) {
    .features :global(.feat) {
      border-right: none;
    }
    .features :global(.feat:not(:last-child)) {
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
