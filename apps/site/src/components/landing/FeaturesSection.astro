---
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import SectionHead from './SectionHead.astro';
import FeatureCell from './FeatureCell.astro';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// Numeric IDs (01..09) drive the i18n key lookups: t('landing.features.f01.title') etc.
// Tags ('perf', 'core', 'css', ...) are technical labels — kept English across locales.
const FEATURE_IDS = [
  { id: 'f01', num: '01', tag: 'perf' },
  { id: 'f02', num: '02', tag: 'core' },
  { id: 'f03', num: '03', tag: 'css' },
  { id: 'f04', num: '04', tag: 'seo' },
  { id: 'f05', num: '05', tag: 'media' },
  { id: 'f06', num: '06', tag: 'type' },
  { id: 'f07', num: '07', tag: 'ux' },
  { id: 'f08', num: '08', tag: 'email' },
  { id: 'f09', num: '09', tag: 'legal' },
] as const;
---

<section class="py-24 max-[720px]:py-16">
  <div class="page">
    <SectionHead
      eyebrow={t('landing.features.eyebrow')}
      heading={t('landing.features.headline')}
      meta={t('landing.features.meta')}
    />
    <!--
      The grid trims outer borders via :nth-child selectors that change with
      column count. FeatureCell ships its own border-r / border-b; the
      arbitrary descendant variants below cancel those at each breakpoint's
      grid edge so only the outer rounded container border is visible.
    -->
    <div
      class="grid grid-cols-3 overflow-hidden rounded-xl border border-border max-[920px]:grid-cols-2 max-[560px]:grid-cols-1
        max-[920px]:[&_.feat]:border-r max-[920px]:[&_.feat]:border-b
        max-[920px]:[&_.feat]:border-(--color-border) max-[560px]:[&_.feat]:border-r-0 max-[560px]:[&_.feat:not(:last-child)]:border-b
        max-[560px]:[&_.feat:not(:last-child)]:border-(--color-border) max-[920px]:[&_.feat:nth-child(2n)]:border-r-0
        [&_.feat:nth-child(3n)]:border-r-0 max-[920px]:[&_.feat:nth-last-child(-n+2)]:border-b-0 [&_.feat:nth-last-child(-n+3)]:border-b-0"
    >
      {
        FEATURE_IDS.map((f) => (
          <FeatureCell
            num={f.num}
            tag={f.tag}
            title={t(`landing.features.${f.id}.title`)}
            body={t(`landing.features.${f.id}.body`)}
          />
        ))
      }
    </div>
  </div>
</section>
