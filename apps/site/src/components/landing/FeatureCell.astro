---
interface Props {
  num: string;
  tag: string;
  title: string;
  body: string;
}

const { num, tag, title, body } = Astro.props;
---

<div class="feat">
  <div class="feat-head">
    <span class="feat-num mono">{num}</span>
    <span class="feat-tag mono">{tag}</span>
  </div>
  <h3>{title}</h3>
  <p>{body}</p>
</div>

<style>
  .feat {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .feat-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .feat-num {
    font-size: 10px;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 2px 5px;
  }
  .feat-tag {
    font-size: 10px;
    color: var(--color-fg-subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h3 {
    margin: 4px 0 0;
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--color-fg);
  }
  p {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-fg-muted);
  }
</style>
