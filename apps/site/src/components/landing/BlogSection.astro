---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import { getBlogCards } from '@/lib/blog';
import BlogCard from '@/components/BlogCard.astro';
import SectionHead from './SectionHead.astro';

const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const blogCards = await getBlogCards(locale);
const recentCards = blogCards.slice(0, 3);
const blogHref = getRelativeLocaleUrl(locale, '/blog');
const rssHref = locale === siteConfig.defaultLocale ? '/rss.xml' : `/${locale}/rss.xml`;
---

{
  recentCards.length > 0 && (
    <section class="pb-24 max-[720px]:pb-16">
      <div class="page mx-auto max-w-[1200px] px-10 max-[720px]:px-6">
        <SectionHead
          eyebrow={t('landing.blog.eyebrow')}
          heading={t('landing.blog.headline')}
          meta={t('landing.blog.meta')}
        />

        <div class="grid grid-cols-3 gap-4 max-[920px]:grid-cols-2 max-[620px]:grid-cols-1">
          {recentCards.map((c) => (
            <BlogCard card={c} />
          ))}
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <span class="mono text-[12px] text-(--color-fg-muted) [&_a]:text-(--color-fg-muted) [&_a]:no-underline [&_a]:transition-colors [&_a]:duration-[0.12s] [&_a]:ease-(--ease-out-soft) hover:[&_a]:text-(--color-fg)">
            {t('landing.blog.articles', { count: blogCards.length })} · <a href={rssHref}>RSS ↗</a>
          </span>
          <a class="btn btn-ghost btn-sm" href={blogHref}>
            {t('landing.blog.browseAll')}
          </a>
        </div>
      </div>
    </section>
  )
}
