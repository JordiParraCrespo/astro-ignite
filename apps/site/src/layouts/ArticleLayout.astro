---
/**
 * ArticleLayout — long-form blog post chrome.
 *
 * Matches the Blog.html PostPage design: breadcrumb, pre-tags, big title,
 * dek, mono meta strip, prose body, author block, prev/next.
 */

import { getCollection, getEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';

import type { Thing } from 'schema-dts';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import { absoluteUrl, blogPostingSchema, breadcrumbListSchema, personSchema } from '@/lib/jsonld';

import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const slugSegments = entry.id.split('/');
const slug = slugSegments.slice(1).join('/');

const author = await getEntry(entry.data.author);
const authorBio = author?.data.bio[locale] ?? author?.data.bio[siteConfig.defaultLocale] ?? '';
const authorName = author?.data.name ?? t('blog.anonymous');

const url = `/blog/${slug}`;
const blogHref = getRelativeLocaleUrl(locale, '/blog');
const homeHref = getRelativeLocaleUrl(locale, '/');

const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: t('nav.blog'), url: '/blog' },
  { name: entry.data.title, url },
];

const schemas: Thing[] = [
  breadcrumbListSchema(crumbs),
  blogPostingSchema({
    url,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.datePublished,
    dateModified: entry.data.dateModified,
    authorSlug: entry.data.author.id,
    image: entry.data.ogImage?.src ?? entry.data.heroImage.src,
    imageAlt: entry.data.heroImageAlt,
    keywords: entry.data.tags,
    inLanguage: locale,
  }),
];

if (author) {
  schemas.push(
    personSchema(
      {
        slug: author.id,
        name: authorName,
        bio: authorBio,
        image: author.data.image.src,
        url: author.data.url,
        email: author.data.email,
        social: author.data.social,
      },
      locale
    )
  );
}

const dateFmt = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const initialsFor = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0]!.toUpperCase())
    .slice(0, 2)
    .join('');

const readingTime = (body: string | undefined) => {
  if (!body) return 1;
  const words = body.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};

const datePublishedText = dateFmt.format(entry.data.datePublished);
const datePublishedIso = entry.data.datePublished.toISOString();
const dateModifiedText = entry.data.dateModified
  ? dateFmt.format(entry.data.dateModified)
  : undefined;
const minutes = readingTime(entry.body);
const tags = entry.data.tags ?? [];
const authorInitials = initialsFor(authorName);

// Prev / next within current locale
const localePosts = (
  await getCollection(
    'blog',
    (e: CollectionEntry<'blog'>) => e.id.startsWith(`${locale}/`) && !e.data.draft
  )
).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    +b.data.datePublished - +a.data.datePublished
);

const currentIndex = localePosts.findIndex((e) => e.id === entry.id);
const nextEntry = currentIndex > 0 ? localePosts[currentIndex - 1] : null;
const prevEntry = currentIndex >= 0 ? localePosts[currentIndex + 1] : null;

const linkTo = (e: CollectionEntry<'blog'>) => {
  const s = e.id.split('/').slice(1).join('/');
  return getRelativeLocaleUrl(locale, `/blog/${s}`);
};

// Hreflang alternates — pair translations explicitly when slugs differ between
// locales (e.g. /blog/best-astro-templates ↔ /es/blog/mejores-plantillas-astro).
// Without this, BaseLayout auto-computes alternates by reusing the current
// pathname across locales, which produces 404s for translated-slug posts.
const translationKey = entry.data.translationKey;
let alternates: Array<{ lang: string; href: string }> | undefined;
if (translationKey) {
  const siblings = await getCollection(
    'blog',
    (e: CollectionEntry<'blog'>) => e.data.translationKey === translationKey && !e.data.draft
  );
  const pairs = siblings
    .map((e) => {
      const segs = e.id.split('/');
      const lang = segs[0]!;
      if (!siteConfig.locales.includes(lang)) return null;
      const s = segs.slice(1).join('/');
      return {
        lang: siteConfig.hreflang[lang] ?? lang,
        href: absoluteUrl(getRelativeLocaleUrl(lang, `/blog/${s}`)),
      };
    })
    .filter((p): p is { lang: string; href: string } => p !== null);
  if (pairs.length > 0) alternates = pairs;
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.ogImage ?? entry.data.heroImage}
  imageAlt={entry.data.heroImageAlt}
  type="article"
  noindex={entry.data.noindex}
  schemas={schemas}
  alternates={alternates}
>
  <article class="pp-shell">
    <header class="pp-header">
      <nav class="pp-crumb mono" aria-label={t('nav.breadcrumbs')}>
        <a href={homeHref}>{t('nav.home')}</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href={blogHref}>{t('nav.blog')}</a>
        <span class="sep" aria-hidden="true">/</span>
        <span class="on">{entry.data.title}</span>
      </nav>

      {
        tags.length > 0 && (
          <div class="pp-pretags mono">
            {tags.map((tag: string) => (
              <span class="chip">#{tag}</span>
            ))}
          </div>
        )
      }

      <h1>{entry.data.title}</h1>
      <p class="pp-dek">{entry.data.description}</p>

      <div class="pp-meta mono">
        <span class="author">
          <span class="av">{authorInitials}</span>
          {authorName}
        </span>
        <span class="dot" aria-hidden="true">·</span>
        <time datetime={datePublishedIso}>{datePublishedText}</time>
        {
          dateModifiedText && (
            <>
              <span class="dot" aria-hidden="true">
                ·
              </span>
              <span class="updated">
                {t('blog.updatedOn')} {dateModifiedText}
              </span>
            </>
          )
        }
        <span class="dot" aria-hidden="true">·</span>
        <span class="badge-mono">{t('blog.readingTime', { minutes })}</span>
      </div>
    </header>

    <div class="pp-body">
      <div class="pp-prose">
        <slot />

        <div class="pp-author">
          <span class="av lg">{authorInitials}</span>
          <div class="bio">
            <span class="name">{authorName}</span>
            {authorBio && <span class="text">{authorBio}</span>}
            {
              author?.data.url && (
                <div class="links">
                  <a href={author.data.url} rel="noopener" target="_blank">
                    ↗ {author.data.url.replace(/^https?:\/\//, '')}
                  </a>
                </div>
              )
            }
          </div>
        </div>

        {
          (prevEntry || nextEntry) && (
            <nav class="pp-pn" aria-label={t('nav.adjacentPosts')}>
              {prevEntry ? (
                <a class="pn-block" href={linkTo(prevEntry)}>
                  <span class="l mono">← {t('blog.previousPost')}</span>
                  <span class="t">{prevEntry.data.title}</span>
                </a>
              ) : (
                <span class="pn-block pn-empty" aria-hidden="true" />
              )}
              {nextEntry ? (
                <a class="pn-block next" href={linkTo(nextEntry)}>
                  <span class="l mono">{t('blog.nextPost')} →</span>
                  <span class="t">{nextEntry.data.title}</span>
                </a>
              ) : (
                <span class="pn-block pn-empty" aria-hidden="true" />
              )}
            </nav>
          )
        }

        <slot name="related" />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .pp-shell {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }
  @media (max-width: 720px) {
    .pp-shell {
      padding: 0 24px;
    }
  }

  /* ===== Header ===== */
  .pp-header {
    padding: 32px 0 32px;
    border-bottom: 1px solid var(--color-border);
  }
  .pp-crumb {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    font-size: 11px;
    color: var(--color-fg-subtle);
    margin-bottom: 18px;
    letter-spacing: 0.04em;
  }
  .pp-crumb a {
    color: var(--color-fg-subtle);
    text-decoration: none;
    transition: color 0.12s var(--ease-out-soft);
  }
  .pp-crumb a:hover {
    color: var(--color-fg);
  }
  .pp-crumb .sep {
    color: var(--color-border-strong);
  }
  .pp-crumb .on {
    color: var(--color-fg);
  }

  .pp-pretags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    background: transparent;
  }

  .pp-header h1 {
    margin: 0;
    font-size: clamp(34px, 5.2vw, 48px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    text-wrap: balance;
    color: var(--color-fg);
  }
  .pp-dek {
    margin: 16px 0 0;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.55;
    color: var(--color-fg-muted);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .pp-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
    flex-wrap: wrap;
    font-size: 12px;
    color: var(--color-fg-subtle);
  }
  .pp-meta .dot {
    color: var(--color-border-strong);
  }
  .pp-meta .author {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-fg);
  }
  .pp-meta .av {
    width: 22px;
    height: 22px;
    border-radius: 99px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-strong);
    display: inline-grid;
    place-items: center;
    font-size: 10px;
    font-weight: 500;
    color: var(--color-fg);
  }
  .badge-mono {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 6px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-fg-muted);
  }

  /* ===== Body ===== */
  .pp-body {
    padding: 36px 0 80px;
  }
  .pp-prose {
    max-width: 68ch;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ===== Author block ===== */
  .pp-author {
    margin-top: 40px;
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    display: flex;
    gap: 14px;
    background: var(--color-surface);
  }
  .pp-author .av {
    width: 40px;
    height: 40px;
    border-radius: 99px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-strong);
    display: inline-grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-fg);
    flex-shrink: 0;
  }
  .pp-author .bio {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pp-author .name {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-fg);
  }
  .pp-author .text {
    font-size: 13px;
    color: var(--color-fg-muted);
    line-height: 1.55;
    margin-bottom: 4px;
  }
  .pp-author .links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .pp-author .links a {
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color 0.12s var(--ease-out-soft);
  }
  .pp-author .links a:hover {
    color: var(--color-fg);
  }

  /* ===== Prev / next ===== */
  .pp-pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 12px;
  }
  .pn-block {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.12s var(--ease-out-soft);
  }
  .pn-block:hover {
    border-color: var(--color-border-strong);
  }
  .pn-empty {
    border-style: dashed;
    opacity: 0.35;
  }
  .pn-block .l {
    font-size: 11px;
    color: var(--color-fg-subtle);
  }
  .pn-block .t {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--color-fg);
    line-height: 1.3;
  }
  .pn-block.next {
    text-align: right;
  }
  @media (max-width: 560px) {
    .pp-pn {
      grid-template-columns: 1fr;
    }
    .pn-block.next {
      text-align: left;
    }
  }
</style>

<style is:global>
  /* Prose styles for article body — mirrors PostPage's pp-prose. */
  .pp-prose > p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-fg-muted);
  }
  .pp-prose > h2 {
    margin: 24px 0 0;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--color-fg);
  }
  .pp-prose > h3 {
    margin: 12px 0 0;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: var(--color-fg);
  }
  .pp-prose > h2 + p,
  .pp-prose > h3 + p {
    margin-top: 0;
  }
  .pp-prose p a,
  .pp-prose a:not(.pn-block):not(.btn) {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border-strong);
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.12s ease;
  }
  .pp-prose p a:hover {
    text-decoration-color: var(--color-fg);
  }
  .pp-prose ul,
  .pp-prose ol {
    margin: 0;
    padding-left: 1.5rem;
    color: var(--color-fg-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .pp-prose li {
    margin-bottom: 0.5rem;
  }
  .pp-prose code {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 1px 6px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface-2);
    color: var(--color-fg);
  }
  .pp-prose pre {
    margin: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-fg);
    overflow-x: auto;
  }
  .pp-prose pre code {
    border: 0;
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .pp-prose blockquote {
    padding: 8px 0 8px 20px;
    border-left: 2px solid var(--color-fg);
    margin: 4px 0;
    color: var(--color-fg);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.45;
  }
  .pp-prose blockquote p {
    margin: 0;
    color: var(--color-fg);
    font-size: 18px;
    font-weight: 500;
  }
  .pp-prose hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
  .pp-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 14px;
  }
  .pp-prose th,
  .pp-prose td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
    color: var(--color-fg-muted);
  }
  .pp-prose th {
    color: var(--color-fg);
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pp-prose img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--color-border);
  }
</style>
