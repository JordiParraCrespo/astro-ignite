---
/**
 * ArticleLayout — long-form blog post chrome.
 *
 * Matches the Blog.html PostPage design: breadcrumb, pre-tags, big title,
 * dek, mono meta strip, prose body, author block, prev/next.
 */

import { getCollection, getEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';

import type { Thing } from 'schema-dts';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import { absoluteUrl, blogPostingSchema, breadcrumbListSchema, personSchema } from '@/lib/jsonld';

import PriorityImage from '@/components/image/PriorityImage.astro';

import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const slugSegments = entry.id.split('/');
const slug = slugSegments.slice(1).join('/');

const author = await getEntry(entry.data.author);
const authorBio = author?.data.bio[locale] ?? author?.data.bio[siteConfig.defaultLocale] ?? '';
const authorName = author?.data.name ?? t('blog.anonymous');

const url = `/blog/${slug}`;
const blogHref = getRelativeLocaleUrl(locale, '/blog');
const homeHref = getRelativeLocaleUrl(locale, '/');

const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: t('nav.blog'), url: '/blog' },
  { name: entry.data.title, url },
];

const schemas: Thing[] = [
  breadcrumbListSchema(crumbs),
  blogPostingSchema({
    url,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.datePublished,
    dateModified: entry.data.dateModified,
    authorSlug: entry.data.author.id,
    image: entry.data.ogImage?.src ?? entry.data.heroImage.src,
    imageAlt: entry.data.heroImageAlt,
    keywords: entry.data.tags,
    inLanguage: locale,
  }),
];

if (author) {
  schemas.push(
    personSchema(
      {
        slug: author.id,
        name: authorName,
        bio: authorBio,
        image: author.data.image.src,
        url: author.data.url,
        email: author.data.email,
        social: author.data.social,
      },
      locale
    )
  );
}

const dateFmt = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const initialsFor = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0]!.toUpperCase())
    .slice(0, 2)
    .join('');

const readingTime = (body: string | undefined) => {
  if (!body) return 1;
  const words = body.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};

const datePublishedText = dateFmt.format(entry.data.datePublished);
const datePublishedIso = entry.data.datePublished.toISOString();
const dateModifiedText = entry.data.dateModified
  ? dateFmt.format(entry.data.dateModified)
  : undefined;
const minutes = readingTime(entry.body);
const tags = entry.data.tags ?? [];
const authorInitials = initialsFor(authorName);

// Prev / next within current locale
const localePosts = (
  await getCollection(
    'blog',
    (e: CollectionEntry<'blog'>) => e.id.startsWith(`${locale}/`) && !e.data.draft
  )
).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    +b.data.datePublished - +a.data.datePublished
);

const currentIndex = localePosts.findIndex((e) => e.id === entry.id);
const nextEntry = currentIndex > 0 ? localePosts[currentIndex - 1] : null;
const prevEntry = currentIndex >= 0 ? localePosts[currentIndex + 1] : null;

const linkTo = (e: CollectionEntry<'blog'>) => {
  const s = e.id.split('/').slice(1).join('/');
  return getRelativeLocaleUrl(locale, `/blog/${s}`);
};

const translationKey = entry.data.translationKey;
let alternates: Array<{ lang: string; href: string }> | undefined;
if (translationKey) {
  const siblings = await getCollection(
    'blog',
    (e: CollectionEntry<'blog'>) => e.data.translationKey === translationKey && !e.data.draft
  );
  const pairs = siblings
    .map((e) => {
      const segs = e.id.split('/');
      const lang = segs[0]!;
      if (!siteConfig.locales.includes(lang)) return null;
      const s = segs.slice(1).join('/');
      return {
        lang: siteConfig.hreflang[lang] ?? lang,
        href: absoluteUrl(getRelativeLocaleUrl(lang, `/blog/${s}`)),
      };
    })
    .filter((p): p is { lang: string; href: string } => p !== null);
  if (pairs.length > 0) alternates = pairs;
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.ogImage ?? entry.data.heroImage}
  imageAlt={entry.data.heroImageAlt}
  type="article"
  noindex={entry.data.noindex}
  schemas={schemas}
  alternates={alternates}
  preloadImages={[entry.data.heroImage]}
>
  <article class="mx-auto max-w-[1100px] px-10 max-[720px]:px-6">
    <header class="border-b border-(--color-border) py-8">
      <nav
        class="mono mb-[18px] flex flex-wrap items-center gap-1.5 text-[11px] tracking-[0.04em] text-(--color-fg-subtle)"
        aria-label={t('nav.breadcrumbs')}
      >
        <a
          href={homeHref}
          class="text-(--color-fg-subtle) no-underline transition-colors duration-[0.12s] ease-(--ease-out-soft) hover:text-(--color-fg)"
        >
          {t('nav.home')}
        </a>
        <span class="text-(--color-border-strong)" aria-hidden="true">/</span>
        <a
          href={blogHref}
          class="text-(--color-fg-subtle) no-underline transition-colors duration-[0.12s] ease-(--ease-out-soft) hover:text-(--color-fg)"
        >
          {t('nav.blog')}
        </a>
        <span class="text-(--color-border-strong)" aria-hidden="true">/</span>
        <span class="text-(--color-fg)">{entry.data.title}</span>
      </nav>

      {
        tags.length > 0 && (
          <div class="mono mb-3.5 flex flex-wrap gap-1.5">
            {tags.map((tag: string) => (
              <span class="inline-flex items-center rounded-full border border-(--color-border) bg-transparent px-2 py-0.5 text-[10px] text-(--color-fg-muted)">
                #{tag}
              </span>
            ))}
          </div>
        )
      }

      <h1
        class="m-0 text-[clamp(34px,5.2vw,48px)] leading-none font-medium tracking-[-0.045em] text-balance text-(--color-fg)"
      >
        {entry.data.title}
      </h1>
      <p
        class="mt-4 max-w-[62ch] text-[clamp(16px,1.4vw,18px)] leading-[1.55] text-pretty text-(--color-fg-muted)"
      >
        {entry.data.description}
      </p>

      <div
        class="mono mt-[22px] flex flex-wrap items-center gap-3 text-[12px] text-(--color-fg-subtle)"
      >
        <span class="inline-flex items-center gap-2 text-(--color-fg)">
          <span
            class="inline-grid h-[22px] w-[22px] place-items-center rounded-full border border-(--color-border-strong) bg-(--color-surface-2) text-[10px] font-medium text-(--color-fg)"
          >
            {authorInitials}
          </span>
          {authorName}
        </span>
        <span class="text-(--color-border-strong)" aria-hidden="true">·</span>
        <time datetime={datePublishedIso}>{datePublishedText}</time>
        {
          dateModifiedText && (
            <>
              <span class="text-(--color-border-strong)" aria-hidden="true">
                ·
              </span>
              <span>
                {t('blog.updatedOn')} {dateModifiedText}
              </span>
            </>
          )
        }
        <span class="text-(--color-border-strong)" aria-hidden="true">·</span>
        <span
          class="rounded border border-(--color-border) px-1.5 py-0.5 font-mono text-[10px] text-(--color-fg-muted)"
        >
          {t('blog.readingTime', { minutes })}
        </span>
      </div>
    </header>

    <figure
      class="mt-8 aspect-[1200/630] overflow-hidden rounded-[14px] border border-(--color-border) bg-(--color-bg) [&_img]:block [&_img]:h-full [&_img]:w-full [&_img]:object-cover"
    >
      <PriorityImage
        src={entry.data.heroImage}
        alt={entry.data.heroImageAlt}
        width={1200}
        height={630}
        sizes="(min-width: 1100px) 1040px, (min-width: 720px) 92vw, 100vw"
      />
    </figure>

    <div class="pt-9 pb-20">
      <div class="pp-prose mx-auto flex max-w-[68ch] flex-col gap-4">
        <slot />

        <div
          class="mt-10 flex gap-3.5 rounded-[10px] border border-(--color-border) bg-(--color-surface) p-[18px]"
        >
          <span
            class="inline-grid h-10 w-10 flex-shrink-0 place-items-center rounded-full border border-(--color-border-strong) bg-(--color-surface-2) font-mono text-[13px] font-medium text-(--color-fg)"
          >
            {authorInitials}
          </span>
          <div class="flex flex-col gap-1">
            <span class="text-sm font-medium text-(--color-fg)">{authorName}</span>
            {
              authorBio && (
                <span class="mb-1 text-[13px] leading-[1.55] text-(--color-fg-muted)">
                  {authorBio}
                </span>
              )
            }
            {
              author?.data.url && (
                <div class="flex flex-wrap gap-2.5 font-mono text-[11px]">
                  <a
                    href={author.data.url}
                    rel="noopener"
                    target="_blank"
                    class="text-(--color-fg-muted) no-underline transition-colors duration-[0.12s] ease-(--ease-out-soft) hover:text-(--color-fg)"
                  >
                    ↗ {author.data.url.replace(/^https?:\/\//, '')}
                  </a>
                </div>
              )
            }
          </div>
        </div>

        {
          (prevEntry || nextEntry) && (
            <nav
              class="mt-3 grid grid-cols-2 gap-2.5 max-[560px]:grid-cols-1"
              aria-label={t('nav.adjacentPosts')}
            >
              {prevEntry ? (
                <a
                  class="flex flex-col gap-1 rounded-lg border border-(--color-border) px-4 py-3.5 text-inherit no-underline transition-colors duration-[0.12s] ease-(--ease-out-soft) hover:border-(--color-border-strong)"
                  href={linkTo(prevEntry)}
                >
                  <span class="mono text-[11px] text-(--color-fg-subtle)">
                    ← {t('blog.previousPost')}
                  </span>
                  <span class="text-sm leading-[1.3] font-medium tracking-[-0.015em] text-(--color-fg)">
                    {prevEntry.data.title}
                  </span>
                </a>
              ) : (
                <span
                  class="flex flex-col gap-1 rounded-lg border border-dashed border-(--color-border) px-4 py-3.5 opacity-35"
                  aria-hidden="true"
                />
              )}
              {nextEntry ? (
                <a
                  class="flex flex-col gap-1 rounded-lg border border-(--color-border) px-4 py-3.5 text-right text-inherit no-underline transition-colors duration-[0.12s] ease-(--ease-out-soft) hover:border-(--color-border-strong) max-[560px]:text-left"
                  href={linkTo(nextEntry)}
                >
                  <span class="mono text-[11px] text-(--color-fg-subtle)">
                    {t('blog.nextPost')} →
                  </span>
                  <span class="text-sm leading-[1.3] font-medium tracking-[-0.015em] text-(--color-fg)">
                    {nextEntry.data.title}
                  </span>
                </a>
              ) : (
                <span
                  class="flex flex-col gap-1 rounded-lg border border-dashed border-(--color-border) px-4 py-3.5 opacity-35"
                  aria-hidden="true"
                />
              )}
            </nav>
          )
        }

        <slot name="related" />
      </div>
    </div>
  </article>
</BaseLayout>
