---
/**
 * ArticleLayout — long-form blog post chrome.
 *
 * Matches the Blog.html PostPage design: breadcrumb, pre-tags, big title,
 * dek, mono meta strip, prose body, author block, prev/next.
 */

import { getCollection, getEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';

import type { Thing } from 'schema-dts';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import { absoluteUrl, blogPostingSchema, breadcrumbListSchema, personSchema } from '@/lib/jsonld';

import PriorityImage from '@/components/image/PriorityImage.astro';

import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const slugSegments = entry.id.split('/');
const slug = slugSegments.slice(1).join('/');

const author = await getEntry(entry.data.author);
const authorBio = author?.data.bio[locale] ?? author?.data.bio[siteConfig.defaultLocale] ?? '';
const authorName = author?.data.name ?? t('blog.anonymous');

const url = `/blog/${slug}`;
const blogHref = getRelativeLocaleUrl(locale, '/blog');
const homeHref = getRelativeLocaleUrl(locale, '/');

const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: t('nav.blog'), url: '/blog' },
  { name: entry.data.title, url },
];

const schemas: Thing[] = [
  breadcrumbListSchema(crumbs),
  blogPostingSchema({
    url,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.datePublished,
    dateModified: entry.data.dateModified,
    authorSlug: entry.data.author.id,
    image: entry.data.ogImage?.src ?? entry.data.heroImage.src,
    imageAlt: entry.data.heroImageAlt,
    keywords: entry.data.tags,
    inLanguage: locale,
  }),
];

if (author) {
  schemas.push(
    personSchema(
      {
        slug: author.id,
        name: authorName,
        bio: authorBio,
        image: author.data.image.src,
        url: author.data.url,
        email: author.data.email,
        social: author.data.social,
      },
      locale
    )
  );
}

const dateFmt = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const initialsFor = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .map((part) => part[0]!.toUpperCase())
    .slice(0, 2)
    .join('');

const readingTime = (body: string | undefined) => {
  if (!body) return 1;
  const words = body.split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
};

const datePublishedText = dateFmt.format(entry.data.datePublished);
const datePublishedIso = entry.data.datePublished.toISOString();
const dateModifiedText = entry.data.dateModified
  ? dateFmt.format(entry.data.dateModified)
  : undefined;
const minutes = readingTime(entry.body);
const tags = entry.data.tags ?? [];
const authorInitials = initialsFor(authorName);

// Prev / next within current locale
const localePosts = (
  await getCollection(
    'blog',
    (e: CollectionEntry<'blog'>) => e.id.startsWith(`${locale}/`) && !e.data.draft
  )
).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    +b.data.datePublished - +a.data.datePublished
);

const currentIndex = localePosts.findIndex((e) => e.id === entry.id);
const nextEntry = currentIndex > 0 ? localePosts[currentIndex - 1] : null;
const prevEntry = currentIndex >= 0 ? localePosts[currentIndex + 1] : null;

const linkTo = (e: CollectionEntry<'blog'>) => {
  const s = e.id.split('/').slice(1).join('/');
  return getRelativeLocaleUrl(locale, `/blog/${s}`);
};

const translationKey = entry.data.translationKey;
let alternates: Array<{ lang: string; href: string }> | undefined;
if (translationKey) {
  const siblings = await getCollection(
    'blog',
    (e: CollectionEntry<'blog'>) => e.data.translationKey === translationKey && !e.data.draft
  );
  const pairs = siblings
    .map((e) => {
      const segs = e.id.split('/');
      const lang = segs[0]!;
      if (!siteConfig.locales.includes(lang)) return null;
      const s = segs.slice(1).join('/');
      return {
        lang: siteConfig.hreflang[lang] ?? lang,
        href: absoluteUrl(getRelativeLocaleUrl(lang, `/blog/${s}`)),
      };
    })
    .filter((p): p is { lang: string; href: string } => p !== null);
  if (pairs.length > 0) alternates = pairs;
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.ogImage ?? entry.data.heroImage}
  imageAlt={entry.data.heroImageAlt}
  type="article"
  noindex={entry.data.noindex}
  schemas={schemas}
  alternates={alternates}
  preloadImages={[entry.data.heroImage]}
>
  <article class="mx-auto max-w-[1100px] px-10 max-[720px]:px-6">
    <header class="border-b border-[var(--color-border)] py-8">
      <nav
        class="mono mb-[18px] flex flex-wrap items-center gap-1.5 text-[11px] tracking-[0.04em] text-[var(--color-fg-subtle)]"
        aria-label={t('nav.breadcrumbs')}
      >
        <a
          href={homeHref}
          class="text-[var(--color-fg-subtle)] no-underline transition-colors duration-[0.12s] ease-[var(--ease-out-soft)] hover:text-[var(--color-fg)]"
        >
          {t('nav.home')}
        </a>
        <span class="text-[var(--color-border-strong)]" aria-hidden="true">/</span>
        <a
          href={blogHref}
          class="text-[var(--color-fg-subtle)] no-underline transition-colors duration-[0.12s] ease-[var(--ease-out-soft)] hover:text-[var(--color-fg)]"
        >
          {t('nav.blog')}
        </a>
        <span class="text-[var(--color-border-strong)]" aria-hidden="true">/</span>
        <span class="text-[var(--color-fg)]">{entry.data.title}</span>
      </nav>

      {
        tags.length > 0 && (
          <div class="mono mb-3.5 flex flex-wrap gap-1.5">
            {tags.map((tag: string) => (
              <span class="inline-flex items-center rounded-full border border-[var(--color-border)] bg-transparent px-2 py-0.5 text-[10px] text-[var(--color-fg-muted)]">
                #{tag}
              </span>
            ))}
          </div>
        )
      }

      <h1
        class="m-0 text-[clamp(34px,5.2vw,48px)] leading-none font-medium tracking-[-0.045em] text-balance text-[var(--color-fg)]"
      >
        {entry.data.title}
      </h1>
      <p
        class="mt-4 max-w-[62ch] text-[clamp(16px,1.4vw,18px)] leading-[1.55] text-pretty text-[var(--color-fg-muted)]"
      >
        {entry.data.description}
      </p>

      <div
        class="mono mt-[22px] flex flex-wrap items-center gap-3 text-[12px] text-[var(--color-fg-subtle)]"
      >
        <span class="inline-flex items-center gap-2 text-[var(--color-fg)]">
          <span
            class="inline-grid h-[22px] w-[22px] place-items-center rounded-full border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] text-[10px] font-medium text-[var(--color-fg)]"
          >
            {authorInitials}
          </span>
          {authorName}
        </span>
        <span class="text-[var(--color-border-strong)]" aria-hidden="true">·</span>
        <time datetime={datePublishedIso}>{datePublishedText}</time>
        {
          dateModifiedText && (
            <>
              <span class="text-[var(--color-border-strong)]" aria-hidden="true">
                ·
              </span>
              <span>
                {t('blog.updatedOn')} {dateModifiedText}
              </span>
            </>
          )
        }
        <span class="text-[var(--color-border-strong)]" aria-hidden="true">·</span>
        <span
          class="rounded border border-[var(--color-border)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--color-fg-muted)]"
        >
          {t('blog.readingTime', { minutes })}
        </span>
      </div>
    </header>

    <figure
      class="mt-8 aspect-[1200/630] overflow-hidden rounded-[14px] border border-[var(--color-border)] bg-[var(--color-bg)] [&_img]:block [&_img]:h-full [&_img]:w-full [&_img]:object-cover"
    >
      <PriorityImage
        src={entry.data.heroImage}
        alt={entry.data.heroImageAlt}
        width={1200}
        height={630}
        sizes="(min-width: 1100px) 1040px, (min-width: 720px) 92vw, 100vw"
      />
    </figure>

    <div class="pt-9 pb-20">
      <div class="pp-prose mx-auto flex max-w-[68ch] flex-col gap-4">
        <slot />

        <div
          class="mt-10 flex gap-3.5 rounded-[10px] border border-[var(--color-border)] bg-[var(--color-surface)] p-[18px]"
        >
          <span
            class="inline-grid h-10 w-10 flex-shrink-0 place-items-center rounded-full border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] font-mono text-[13px] font-medium text-[var(--color-fg)]"
          >
            {authorInitials}
          </span>
          <div class="flex flex-col gap-1">
            <span class="text-sm font-medium text-[var(--color-fg)]">{authorName}</span>
            {
              authorBio && (
                <span class="mb-1 text-[13px] leading-[1.55] text-[var(--color-fg-muted)]">
                  {authorBio}
                </span>
              )
            }
            {
              author?.data.url && (
                <div class="flex flex-wrap gap-2.5 font-mono text-[11px]">
                  <a
                    href={author.data.url}
                    rel="noopener"
                    target="_blank"
                    class="text-[var(--color-fg-muted)] no-underline transition-colors duration-[0.12s] ease-[var(--ease-out-soft)] hover:text-[var(--color-fg)]"
                  >
                    ↗ {author.data.url.replace(/^https?:\/\//, '')}
                  </a>
                </div>
              )
            }
          </div>
        </div>

        {
          (prevEntry || nextEntry) && (
            <nav
              class="mt-3 grid grid-cols-2 gap-2.5 max-[560px]:grid-cols-1"
              aria-label={t('nav.adjacentPosts')}
            >
              {prevEntry ? (
                <a
                  class="flex flex-col gap-1 rounded-lg border border-[var(--color-border)] px-4 py-3.5 text-inherit no-underline transition-colors duration-[0.12s] ease-[var(--ease-out-soft)] hover:border-[var(--color-border-strong)]"
                  href={linkTo(prevEntry)}
                >
                  <span class="mono text-[11px] text-[var(--color-fg-subtle)]">
                    ← {t('blog.previousPost')}
                  </span>
                  <span class="text-sm leading-[1.3] font-medium tracking-[-0.015em] text-[var(--color-fg)]">
                    {prevEntry.data.title}
                  </span>
                </a>
              ) : (
                <span
                  class="flex flex-col gap-1 rounded-lg border border-dashed border-[var(--color-border)] px-4 py-3.5 opacity-35"
                  aria-hidden="true"
                />
              )}
              {nextEntry ? (
                <a
                  class="flex flex-col gap-1 rounded-lg border border-[var(--color-border)] px-4 py-3.5 text-right text-inherit no-underline transition-colors duration-[0.12s] ease-[var(--ease-out-soft)] hover:border-[var(--color-border-strong)] max-[560px]:text-left"
                  href={linkTo(nextEntry)}
                >
                  <span class="mono text-[11px] text-[var(--color-fg-subtle)]">
                    {t('blog.nextPost')} →
                  </span>
                  <span class="text-sm leading-[1.3] font-medium tracking-[-0.015em] text-[var(--color-fg)]">
                    {nextEntry.data.title}
                  </span>
                </a>
              ) : (
                <span
                  class="flex flex-col gap-1 rounded-lg border border-dashed border-[var(--color-border)] px-4 py-3.5 opacity-35"
                  aria-hidden="true"
                />
              )}
            </nav>
          )
        }

        <slot name="related" />
      </div>
    </div>
  </article>
</BaseLayout>

<!--
  tailwind-exception: MDX prose styling — `.pp-prose` selectors target
  nodes generated by the MDX renderer at runtime through a <slot/>. There
  is no Tailwind component-scope variant that reaches those nodes; the
  single is:global block is simpler than dozens of [&>h2]/[&>p]/[&_code]
  arbitrary variants on the prose container.
-->
<style is:global>
  .pp-prose > p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-fg-muted);
  }
  .pp-prose > h2 {
    margin: 24px 0 0;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--color-fg);
  }
  .pp-prose > h3 {
    margin: 12px 0 0;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: var(--color-fg);
  }
  .pp-prose > h2 + p,
  .pp-prose > h3 + p {
    margin-top: 0;
  }
  .pp-prose p a,
  .pp-prose a:not(.pn-block):not(.btn) {
    color: var(--color-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-border-strong);
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.12s ease;
  }
  .pp-prose p a:hover {
    text-decoration-color: var(--color-fg);
  }
  .pp-prose ul,
  .pp-prose ol {
    margin: 0;
    padding-left: 1.5rem;
    color: var(--color-fg-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .pp-prose li {
    margin-bottom: 0.5rem;
  }
  .pp-prose code {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 1px 6px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface-2);
    color: var(--color-fg);
  }
  .pp-prose pre {
    margin: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-fg);
    overflow-x: auto;
  }
  .pp-prose pre code {
    border: 0;
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .pp-prose blockquote {
    padding: 8px 0 8px 20px;
    border-left: 2px solid var(--color-fg);
    margin: 4px 0;
    color: var(--color-fg);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.45;
  }
  .pp-prose blockquote p {
    margin: 0;
    color: var(--color-fg);
    font-size: 18px;
    font-weight: 500;
  }
  .pp-prose hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
  .pp-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 14px;
  }
  .pp-prose th,
  .pp-prose td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
    color: var(--color-fg-muted);
  }
  .pp-prose th {
    color: var(--color-fg);
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pp-prose img {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--color-border);
  }
</style>
