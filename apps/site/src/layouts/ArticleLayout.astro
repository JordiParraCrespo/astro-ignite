---
/**
 * ArticleLayout — wraps BaseLayout with blog-post structure.
 *
 * - Auto-supplies BlogPosting + BreadcrumbList JSON-LD from the entry
 * - Hero image with eager loading + preload
 * - Title + author + date byline
 * - Prose container for the slot (MDX content)
 * - Optional `related` slot for related-posts component
 */

import { getRelativeLocaleUrl } from 'astro:i18n';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import type { Thing } from 'schema-dts';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import { blogPostingSchema, breadcrumbListSchema, personSchema } from '@/lib/jsonld';

import BaseLayout from './BaseLayout.astro';
import HeroImage from '@/components/image/HeroImage.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

// entry.id format: `<locale>/<slug>` (e.g. "en/welcome").
const slugSegments = entry.id.split('/');
const slug = slugSegments.slice(1).join('/');

const author = await getEntry(entry.data.author);
const authorBio = author?.data.bio[locale] ?? author?.data.bio[siteConfig.defaultLocale] ?? '';

const url = `/blog/${slug}`;

const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: t('nav.blog'), url: '/blog' },
  { name: entry.data.title, url },
];

const schemas: Thing[] = [
  breadcrumbListSchema(crumbs),
  blogPostingSchema({
    url,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.datePublished,
    dateModified: entry.data.dateModified,
    authorSlug: entry.data.author.id,
    image: entry.data.ogImage?.src ?? entry.data.heroImage.src,
    imageAlt: entry.data.heroImageAlt,
    keywords: entry.data.tags,
    inLanguage: locale,
  }),
];

if (author) {
  schemas.push(
    personSchema(
      {
        slug: author.id,
        name: author.data.name,
        bio: authorBio,
        image: author.data.image.src,
        url: author.data.url,
        email: author.data.email,
        social: author.data.social,
      },
      locale
    )
  );
}

const dateFmt = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.ogImage ?? entry.data.heroImage}
  imageAlt={entry.data.heroImageAlt}
  type="article"
  noindex={entry.data.noindex}
  schemas={schemas}
  preloadImages={[entry.data.heroImage]}
>
  <article class="article">
    <header class="article-header">
      <nav class="breadcrumbs" aria-label="Breadcrumbs">
        <a href={getRelativeLocaleUrl(locale, '/blog')}>← {t('blog.backToBlog')}</a>
      </nav>
      <h1>{entry.data.title}</h1>
      <p class="article-meta">
        {
          author && (
            <>
              <span class="author">
                {t('blog.byAuthor')} {author.data.name}
              </span>
              <span class="dot" aria-hidden="true">
                ·
              </span>
            </>
          )
        }
        <time datetime={entry.data.datePublished.toISOString()}>
          {dateFmt.format(entry.data.datePublished)}
        </time>
      </p>
      <HeroImage
        src={entry.data.heroImage}
        alt={entry.data.heroImageAlt}
        width={1200}
        height={630}
      />
    </header>

    <div class="prose">
      <slot />
    </div>

    <slot name="related" />
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 48rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .article-header {
    margin-bottom: 2.5rem;
  }
  .breadcrumbs {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }
  .breadcrumbs a {
    color: var(--color-fg-muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--color-fg);
  }
  .article-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--color-fg);
  }
  .article-meta {
    color: var(--color-fg-muted);
    font-size: 0.9375rem;
    margin: 0 0 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .article-header :global(picture),
  .article-header :global(img) {
    border-radius: 0.75rem;
    overflow: hidden;
    width: 100%;
    height: auto;
    display: block;
  }
</style>

<style is:global>
  /* Prose styles for article body — Tailwind below-the-fold by convention,
     but a base prose container kept here so MDX content renders well even
     without Tailwind's typography plugin. */
  .prose {
    color: var(--color-fg);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose h2 {
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 3rem 0 1rem;
    color: var(--color-fg);
  }
  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 2rem 0 0.75rem;
    color: var(--color-fg);
  }
  .prose p {
    margin: 0 0 1.25rem;
  }
  .prose a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .prose a:hover {
    text-decoration-thickness: 2px;
  }
  .prose ul,
  .prose ol {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.375rem;
  }
  .prose blockquote {
    border-left: 3px solid var(--color-primary);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-fg-muted);
    font-style: italic;
  }
  .prose code {
    background: var(--color-surface-2);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  .prose pre {
    background: var(--color-surface-2);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .prose pre code {
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }
  .prose th,
  .prose td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.625rem 0.75rem;
    text-align: left;
  }
  .prose th {
    font-weight: 600;
  }
</style>
