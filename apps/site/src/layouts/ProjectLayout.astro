---
/**
 * ProjectLayout — wraps BaseLayout with project case-study structure.
 */

import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CollectionEntry } from 'astro:content';

import { siteConfig } from '@/config/site';
import { useTranslations } from '@/i18n';
import { breadcrumbListSchema, creativeWorkSchema } from '@/lib/jsonld';

import BaseLayout from './BaseLayout.astro';
import HeroImage from '@/components/image/HeroImage.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const locale = Astro.currentLocale ?? siteConfig.defaultLocale;
const t = useTranslations(locale);

const slug = entry.id.split('/').slice(1).join('/');
const url = `/projects/${slug}`;

const crumbs = [
  { name: t('nav.home'), url: '/' },
  { name: t('nav.projects'), url: '/projects' },
  { name: entry.data.title, url },
];

const schemas = [
  breadcrumbListSchema(crumbs),
  creativeWorkSchema({
    url,
    title: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.datePublished,
    dateModified: entry.data.dateUpdated,
    image: entry.data.ogImage?.src ?? entry.data.heroImage.src,
    imageAlt: entry.data.heroImageAlt,
    keywords: entry.data.techStack,
    inLanguage: locale,
    status: entry.data.status,
  }),
];

const dateFmt = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long' });

const statusLabels = {
  shipped: t('projects.status.shipped'),
  'in-progress': t('projects.status.in-progress'),
  archived: t('projects.status.archived'),
} as const;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.ogImage ?? entry.data.heroImage}
  imageAlt={entry.data.heroImageAlt}
  type="article"
  noindex={entry.data.draft}
  schemas={schemas}
  preloadImages={[entry.data.heroImage]}
>
  <article class="mx-auto max-w-[64rem] px-5 pt-8 pb-16">
    <header
      class="mb-12 [&_img]:block [&_img]:h-auto [&_img]:w-full [&_img]:overflow-hidden [&_img]:rounded-xl [&_picture]:block [&_picture]:h-auto [&_picture]:w-full [&_picture]:overflow-hidden [&_picture]:rounded-xl"
    >
      <nav class="mb-6 text-sm" aria-label={t('nav.breadcrumbs')}>
        <a
          href={getRelativeLocaleUrl(locale, '/projects')}
          class="text-(--color-fg-muted) no-underline hover:text-(--color-fg)"
        >
          ← {t('projects.backToProjects')}
        </a>
      </nav>
      <h1
        class="m-0 mb-4 text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.05] font-bold tracking-[-0.025em] text-(--color-fg)"
      >
        {entry.data.title}
      </h1>
      <p class="m-0 mb-8 max-w-[48rem] text-xl leading-[1.5] text-(--color-fg-muted)">
        {entry.data.summary}
      </p>
      <HeroImage
        src={entry.data.heroImage}
        alt={entry.data.heroImageAlt}
        width={1200}
        height={630}
      />
    </header>

    <div class="grid grid-cols-1 gap-10 min-[900px]:grid-cols-[16rem_1fr]">
      <aside class="min-[900px]:sticky min-[900px]:top-20 min-[900px]:self-start">
        <dl class="m-0 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-2 text-[0.9375rem]">
          {
            entry.data.role && (
              <>
                <dt class="font-medium text-(--color-fg-muted)">{t('projects.role')}</dt>
                <dd class="m-0 text-(--color-fg)">{entry.data.role}</dd>
              </>
            )
          }
          {
            entry.data.client && (
              <>
                <dt class="font-medium text-(--color-fg-muted)">{t('projects.client')}</dt>
                <dd class="m-0 text-(--color-fg)">{entry.data.client}</dd>
              </>
            )
          }
          <dt class="font-medium text-(--color-fg-muted)">{t('projects.statusLabel')}</dt>
          <dd class="m-0 text-(--color-fg)">
            {statusLabels[entry.data.status as keyof typeof statusLabels]}
          </dd>
          {
            entry.data.datePublished && (
              <>
                <dt class="font-medium text-(--color-fg-muted)">{t('projects.dateLabel')}</dt>
                <dd class="m-0 text-(--color-fg)">
                  <time datetime={entry.data.datePublished.toISOString()}>
                    {dateFmt.format(entry.data.datePublished)}
                  </time>
                </dd>
              </>
            )
          }
          {
            entry.data.techStack.length > 0 && (
              <>
                <dt class="font-medium text-(--color-fg-muted)">{t('projects.techStack')}</dt>
                <dd class="m-0 text-(--color-fg)">
                  <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
                    {entry.data.techStack.map((tech: string) => (
                      <li class="rounded bg-(--color-surface-2) px-2 py-0.5 text-[0.8125rem]">
                        {tech}
                      </li>
                    ))}
                  </ul>
                </dd>
              </>
            )
          }
        </dl>
        {
          (entry.data.links.live || entry.data.links.repo || entry.data.links.demo) && (
            <ul class="m-0 mt-6 flex list-none flex-col gap-2 p-0 text-[0.9375rem]">
              {entry.data.links.live && (
                <li>
                  <a
                    href={entry.data.links.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-(--color-primary) no-underline hover:underline"
                  >
                    {t('projects.viewLive')} ↗
                  </a>
                </li>
              )}
              {entry.data.links.repo && (
                <li>
                  <a
                    href={entry.data.links.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-(--color-primary) no-underline hover:underline"
                  >
                    {t('projects.viewRepo')} ↗
                  </a>
                </li>
              )}
              {entry.data.links.demo && (
                <li>
                  <a
                    href={entry.data.links.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-(--color-primary) no-underline hover:underline"
                  >
                    {t('projects.viewDemo')} ↗
                  </a>
                </li>
              )}
            </ul>
          )
        }
      </aside>

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
