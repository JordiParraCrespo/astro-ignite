# aig-runner.service — astro-ignite autopilot runner.
#
# Deploy:
#   sudo cp autopilot/systemd/aig-runner.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl restart aig-runner
#
# Verify after deploy:
#   pnpm doctor   # the `npm-cache-writable` check must report `ok`.

[Unit]
Description=astro-ignite autopilot runner
After=network.target

[Service]
Type=simple
User=dev
WorkingDirectory=/home/dev/work/plan
ExecStart=/usr/bin/env node scripts/autopilot/runner.mjs
Restart=on-failure
RestartSec=10

# Hardening — keep ProtectSystem + PrivateTmp on. Loosen only the
# writes the runner genuinely needs:
#   %h/.npm                 — npm cache; `npx lighthouse` writes here
#   %h/.cache               — XDG cache (puppeteer, vitest, etc.)
#   /opt/chrome-for-testing — install prefix used by
#                              scripts/doctor/install-chrome.mjs
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=%h/.npm %h/.cache /opt/chrome-for-testing

[Install]
WantedBy=multi-user.target
